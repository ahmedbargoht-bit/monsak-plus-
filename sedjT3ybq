/* ────────────────────────────────────────────────────────────────
   مسح إجراء المشرف: يمسح الخطة الأسبوعية (weekly_plans) + سجل التنفيذ
   (supervisor_execution) لأسبوع محدّد فقط. حساب المشرف في users
   يبقى سليماً — الهدف إعطاؤه "بداية نظيفة" ليعيد وضع خطته صحيحة.
   تمرّ من بوابة الباسورد عبر secureAction.
   الربط عبر supervisor_name + week_start.
   ──────────────────────────────────────────────────────────────── */
async function clearSupervisorPlan(name, weekStart){
  if(!name){ alert('لا يوجد اسم مشرف صالح'); return; }
  if(!weekStart){ alert('تعذّر تحديد الأسبوع'); return; }
  secureAction(
    `مسح إجراء المشرف "${name}" لهذا الأسبوع؟\nسيُمسح: الخطة الأسبوعية + سجل التنفيذ.\n(حساب المشرف يبقى — يقدر يضع خطة جديدة).`,
    async ()=>{
      // الخطة الأسبوعية لهذا الأسبوع
      const okPlan = await sbDelete('weekly_plans',{supervisor_name:name, week_start:weekStart});
      // سجل التنفيذ لهذا الأسبوع
      const okExec = await sbDelete('supervisor_execution',{supervisor_name:name, week_start:weekStart});

      if(okPlan || okExec) alert(`✓ تم مسح إجراء "${name}" لهذا الأسبوع — يقدر يضع خطة جديدة`);
      else                 alert('لم يُمسح شيء — قد لا توجد خطة لهذا الأسبوع');
      await cpLoad(); // (v3.0) redirected from loadSupMonitor
    }
  );
}

