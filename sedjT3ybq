function admRptFmtDate(d){if(!d)return '—';try{return new Date(d+'-01').toLocaleDateString('en-US',{month:'long',year:'numeric'});}catch(e){return d;}}

function admRptBuildData(rows,meta){
  const map={};
  rows.forEach(p=>{
    const k=p.snf||'—';if(!map[k])map[k]={صنف:k,batches:{}};
    if(+p.shelf_qty>0){const dk=admRptFmtDate(p.date_shelf)||'—';if(!map[k].batches[dk])map[k].batches[dk]={عدد:0,تاريخ:dk};map[k].batches[dk].عدد+=+p.shelf_qty||0;}
    if(+p.stock_qty>0){const dk=(admRptFmtDate(p.date_stock)||'—')+'★';if(!map[k].batches[dk])map[k].batches[dk]={عدد:0,تاريخ:admRptFmtDate(p.date_stock)||'—'};map[k].batches[dk].عدد+=+p.stock_qty||0;}
  });
  return {...meta,تاريخ_التقرير:new Date().toLocaleDateString('en-US',{day:'2-digit',month:'2-digit',year:'numeric'}),
    اصناف:Object.values(map).map(s=>({...s,batches:Object.values(s.batches).slice(0,RPT_MAX_B_A)})).filter(s=>s.batches.length)};
}

function admRptGenerateExcel(data){
  const MB=RPT_MAX_B_A,TC=2+MB*2,VC=TC+1,ALL=VC,DR=RPT_DARK_RED_A,OL=RPT_OLIVE_A;
  const aoa=[];
  aoa.push(['تقرير أصناف الفروع — الطحان جولدن داتس | أصل التمر',...Array(ALL-1).fill('')]);
  aoa.push([`اسم المنطقة: ${data.منطقة}`,'','',`اسم الفرع: ${data.فرع}`,'','',`اسم المنسق: ${data.منسق}`,...Array(ALL-7).fill('')]);
  aoa.push([`من: ${data.من}`,'','',`إلى: ${data.الى}`,'','',`عدد الزيارات: ${data.عدد_الزيارات} زيارة`,...Array(ALL-7).fill('')]);
  aoa.push([`تاريخ التقرير: ${data.تاريخ_التقرير}`,...Array(ALL-1).fill('')]);
  const h1=['اسم الصنف'];for(let i=1;i<=MB;i++){h1.push(`Batch ${i}`);h1.push('');}h1.push('الإجمالي');h1.push('عدد الزيارات');aoa.push(h1);
  const h2=[''];for(let i=0;i<MB;i++){h2.push('العدد');h2.push('تاريخ الانتهاء');}h2.push('');h2.push('');aoa.push(h2);
  data.اصناف.forEach(snf=>{
    const row=[snf.صنف];let tot=0;
    for(let i=0;i<MB;i++){if(i<snf.batches.length){row.push(snf.batches[i].عدد);row.push(snf.batches[i].تاريخ);tot+=snf.batches[i].عدد;}else{row.push('');row.push('');}}
    row.push(tot);row.push(data.عدد_الزيارات);aoa.push(row);
  });
  const trow=['الإجمالي الكلي'];let grand=0;
  for(let i=0;i<MB;i++){const s=data.اصناف.reduce((a,x)=>a+(x.batches[i]?.عدد||0),0);trow.push(s);trow.push('');grand+=s;}
  trow.push(grand);trow.push(data.عدد_الزيارات);aoa.push(trow);
  const wb=XLSX.utils.book_new(),ws=XLSX.utils.aoa_to_sheet(aoa);
  ws['!cols']=[{wch:28}];for(let i=0;i<MB;i++){ws['!cols'].push({wch:9});ws['!cols'].push({wch:16});}ws['!cols'].push({wch:12});ws['!cols'].push({wch:16});
  ws['!merges']=[{s:{r:0,c:0},e:{r:0,c:ALL-1}},{s:{r:1,c:0},e:{r:1,c:2}},{s:{r:1,c:3},e:{r:1,c:5}},{s:{r:1,c:6},e:{r:1,c:ALL-1}},{s:{r:2,c:0},e:{r:2,c:2}},{s:{r:2,c:3},e:{r:2,c:5}},{s:{r:2,c:6},e:{r:2,c:ALL-1}},{s:{r:3,c:0},e:{r:3,c:ALL-1}},{s:{r:4,c:0},e:{r:5,c:0}},{s:{r:4,c:TC-1},e:{r:5,c:TC-1}},{s:{r:4,c:VC-1},e:{r:5,c:VC-1}}];
  for(let i=0;i<MB;i++) ws['!merges'].push({s:{r:4,c:1+i*2},e:{r:4,c:2+i*2}});
  const S=(bg,fc,b,sz,right)=>({fill:{fgColor:{rgb:bg}},font:{bold:b,color:{rgb:fc},sz,name:'Cairo'},alignment:{horizontal:right?'right':'center',vertical:'center',wrapText:true,readingOrder:2},border:{top:{style:'thin'},bottom:{style:'thin'},left:{style:'thin'},right:{style:'thin'}}});
  const set=(r,c,s)=>{const a=XLSX.utils.encode_cell({r,c});if(!ws[a])ws[a]={t:'z',v:''};ws[a].s=s;};
  for(let c=0;c<ALL;c++) set(0,c,S(DR,'FFFFFF',true,14));
  for(let r=1;r<=3;r++) for(let c=0;c<ALL;c++) set(r,c,S('F5E8E8',DR,true,11,true));
  for(let c=0;c<ALL;c++){set(4,c,S([0,TC-1,VC-1].includes(c)?DR:OL,'FFFFFF',true,11));set(5,c,S([0,TC-1,VC-1].includes(c)?DR:OL,'FFFFFF',true,10));}
  data.اصناف.forEach((snf,idx)=>{
    const r=6+idx,bg=idx%2===0?'FFFFFF':'FBF0F0';
    set(r,0,S(bg,'000000',true,11,true));
    for(let i=0;i<MB;i++){set(r,1+i*2,S(bg,'000000',false,11));set(r,2+i*2,S(bg,'555555',false,10));}
    set(r,TC-1,S('F5E8E8',DR,true,11));set(r,VC-1,S('EEF2E6',OL,true,12));
  });
  const TR=6+data.اصناف.length;
  set(TR,0,S(DR,'FFFFFF',true,12,true));
  for(let c=1;c<ALL;c++) set(TR,c,S(c===VC-1?OL:DR,'FFFFFF',true,c===TC-1?13:11));
  ws['!rows']=[{hpt:32},{hpt:22},{hpt:22},{hpt:22},{hpt:20},{hpt:20},...data.اصناف.map(()=>({hpt:20})),{hpt:26}];
  XLSX.utils.book_append_sheet(wb,ws,'تقرير الأصناف');
  XLSX.writeFile(wb,`تقرير_أصناف_${data.فرع}_${data.من.replace(/\//g,'-')}.xlsx`);
}
