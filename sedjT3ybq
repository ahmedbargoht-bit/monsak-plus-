async function attSaveEdit(name, date){
  const status  = document.getElementById('ae-status').value;
  const timeIn  = document.getElementById('ae-time-in').value || null;
  const timeOut = document.getElementById('ae-time-out').value || null;
  const note    = document.getElementById('ae-note').value.trim() || null;
  try{
    const H = {'apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`,'Content-Type':'application/json','Prefer':'resolution=merge-duplicates,return=minimal'};
    const body = [{
      name, date, status,
      time_in:  status==='present' ? timeIn  : null,
      time_out: status==='present' ? timeOut : null,
      note, updated_by: (typeof CU!=='undefined'?CU?.name:'')||'', updated_at: new Date().toISOString()
    }];
    const r = await fetch(`${SUPABASE_URL}/rest/v1/attendance_edits?on_conflict=name,date`,{method:'POST',headers:H,body:JSON.stringify(body)});
    if(!r.ok){ alert('حصل خطأ أثناء الحفظ'); return; }
    document.getElementById('att-edit-modal')?.remove();
    document.getElementById('att-detail-modal')?.remove();
    await loadAttendance();
    const from = document.getElementById('att-from')?.value||'';
    const to   = document.getElementById('att-to')?.value||'';
    attShowDetail(name, from, to);
  }catch(e){ alert('حصل خطأ أثناء الحفظ'); }
}

async function attDeleteEdit(name, date, id){
  if(!confirm('حذف التعديل والرجوع للبيانات الأصلية؟')) return;
  try{
    const H = {'apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`};
    await fetch(`${SUPABASE_URL}/rest/v1/attendance_edits?id=eq.${id}`,{method:'DELETE',headers:H});
    document.getElementById('att-edit-modal')?.remove();
    document.getElementById('att-detail-modal')?.remove();
    await loadAttendance();
    const from = document.getElementById('att-from')?.value||'';
    const to   = document.getElementById('att-to')?.value||'';
    attShowDetail(name, from, to);
  }catch(e){ alert('حصل خطأ أثناء الحذف'); }
}

