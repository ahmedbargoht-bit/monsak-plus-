function compApplyFilters(){
  const from       = document.getElementById('comp-f-from').value;
  const to         = document.getElementById('comp-f-to').value;
  const supervisor = document.getElementById('comp-f-supervisor').value;
  const client     = document.getElementById('comp-f-client').value;
  const company    = document.getElementById('comp-f-company').value;
  const cat        = document.getElementById('comp-f-category').value;

  let data = _compData;
  if(from)       data = data.filter(r=>(r.created_at||'').slice(0,10) >= from);
  if(to)         data = data.filter(r=>(r.created_at||'').slice(0,10) <= to);
  if(supervisor) data = data.filter(r=>r.coordinator_name===supervisor);
  if(client)     data = data.filter(r=>r.client_name===client);
  if(company)    data = data.filter(r=>r.company_name===company);
  if(cat)        data = data.filter(r=>r.category===cat);

  // إحصائيات
  document.getElementById('comp-stat-total').textContent        = data.length;
  document.getElementById('comp-stat-companies').textContent    = new Set(data.map(r=>r.company_name).filter(Boolean)).size;
  document.getElementById('comp-stat-branches').textContent     = new Set(data.map(r=>r.branch_name).filter(Boolean)).size;
  document.getElementById('comp-stat-coordinators').textContent = new Set(data.map(r=>r.coordinator_name).filter(Boolean)).size;

  const catColors = {مصري:'#FEF3C7;color:#92400E',سعودي:'#DBEAFE;color:#1E40AF',دبس:'#FDE8D8;color:#9A3412',أكياس:'#D1FAE5;color:#065F46',معمول:'#EDE9FE;color:#5B21B6'};

  // إعادة تعيين الـ checkbox الكلي
  const chkAll = document.getElementById('comp-check-all');
  if(chkAll) chkAll.checked = false;
  document.getElementById('comp-del-btn').style.display = 'none';
  document.getElementById('comp-del-count').textContent = '0';

  const tbody = document.getElementById('comp-tbody');
  if(!data.length){
    tbody.innerHTML = `<tr><td colspan="11" style="text-align:center;padding:24px;color:var(--text2);font-size:13px">لا توجد بيانات</td></tr>`;
    return;
  }

  tbody.innerHTML = data.map((r,i)=>{
    const date = r.created_at ? r.created_at.slice(0,10) : '—';
    const catStyle = catColors[r.category] || '#F3F4F6;color:#374151';
    const [bg,fg] = catStyle.split(';color:');
    return `<tr style="background:${i%2===0?'#fff':'#FFFBF5'}" id="comp-row-${r.id}">
      <td style="padding:9px 8px;text-align:center"><input type="checkbox" class="comp-row-cb" data-id="${r.id}" onchange="compUpdateDeleteBtn()" style="accent-color:#C0392B;width:14px;height:14px"/></td>
      <td style="padding:9px 12px;font-size:12px;white-space:nowrap">${date}</td>
      <td style="padding:9px 12px;font-size:12px;font-weight:600">${r.coordinator_name||'—'}</td>
      <td style="padding:9px 12px;font-size:12px;color:var(--text2)">${r.route||'—'}</td>
