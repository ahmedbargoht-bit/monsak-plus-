/* ══ err/ok messages ════════════════════════════════════════ */
.err{background:#FFEBEE !important;color:#B71C1C !important;border:1px solid #FFCDD2}
.ok{background:#E8F5E9 !important;color:#1B5E20 !important;border:1px solid #A5D6A7}

/* ══ Table wrap ══════════════════════════════════════════════ */
.table-wrap{border:1px solid #E8D9C0 !important}
.topbar-title{color:#2C1F0A}

/* ══ Admin Plan Enhancements (v3.0) ═════════════════════════ */

/* المستهدفات المزدوجة */
.adm-target-strip{display:grid;grid-template-columns:1fr 1fr;border-top:1px solid rgba(237,229,216,.1);font-size:10px;margin-top:4px;border-radius:0 0 6px 6px;overflow:hidden}
.adm-target-cell{padding:4px 8px;text-align:center}
.adm-target-cell.s{background:rgba(115,30,46,.25);color:#F5B8C0}
.adm-target-cell.c{background:rgba(107,122,59,.2);color:#C8D8A0;border-right:1px solid rgba(237,229,216,.08)}
.adm-target-val{font-weight:700;font-size:11px}

/* Geofencing */
.adm-geo-inside{border-right:3px solid #6B7A3B!important}
.adm-geo-near{border-right:3px solid #C55B48!important}
.adm-geo-outside{border-right:3px solid #731E2E!important}
.adm-geo-badge{display:inline-flex;align-items:center;gap:3px;padding:2px 7px;border-radius:999px;font-size:9px;font-weight:700}
.adm-geo-badge.inside{background:rgba(107,122,59,.25);color:#C8D8A0}
.adm-geo-badge.near{background:rgba(197,91,72,.25);color:#F0C0A0}
.adm-geo-badge.outside{background:rgba(115,30,46,.35);color:#F5B8C0}

/* Approval Screen */
.approval-wrap{background:rgba(61,48,21,.7);border:1px solid rgba(197,91,72,.2);border-radius:14px;padding:16px;margin-bottom:14px}
.approval-header{background:linear-gradient(135deg,#731E2E,#5A1520);border-radius:10px;padding:12px 16px;margin-bottom:14px;display:flex;justify-content:space-between;align-items:center}
.approval-kpi-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:14px}
.approval-kpi{border-radius:10px;padding:10px;text-align:center}
.approval-kpi.sales{background:rgba(115,30,46,.25);border:1px solid rgba(115,30,46,.35)}
.approval-kpi.coord{background:rgba(107,122,59,.2);border:1px solid rgba(107,122,59,.3)}
.approval-kpi.geo{background:rgba(75,60,26,.5);border:1px solid rgba(197,91,72,.2)}
.approval-kpi-val{font-size:20px;font-weight:900;color:#EDE5D8}
.approval-kpi-lbl{font-size:9px;color:rgba(237,229,216,.5);margin-top:2px}
.approval-matrix{width:100%;border-collapse:collapse;font-size:11px}
.approval-matrix th{background:rgba(75,60,26,.95);color:#EDE5D8;padding:7px 8px;text-align:right;font-size:10px}
.approval-matrix td{padding:7px 8px;border-bottom:1px solid rgba(237,229,216,.07);color:#EDE5D8;text-align:right}
.approval-matrix tr:hover td{background:rgba(197,91,72,.08)}
.approval-matrix .total-row td{background:rgba(197,91,72,.12)!important;font-weight:700;border-top:1px solid rgba(197,91,72,.3)}
.pct-bar-wrap{height:5px;background:rgba(237,229,216,.1);border-radius:99px;overflow:hidden;margin-top:3px}
.pct-bar-fill{height:100%;border-radius:99px}
.approve-btn{background:linear-gradient(135deg,#6B7A3B,#4E5C28);color:#EDE5D8;border:none;border-radius:8px;padding:8px 18px;font-size:12px;font-weight:700;cursor:pointer;font-family:Cairo,sans-serif;box-shadow:0 3px 10px rgba(107,122,59,.35);transition:all .18s cubic-bezier(.4,0,.2,1)}
.approve-btn:hover{transform:translateY(-1px);box-shadow:0 5px 14px rgba(107,122,59,.5)}
.approve-btn:active{transform:scale(.96) translateY(1px);box-shadow:inset 0 2px 6px rgba(0,0,0,.2);filter:brightness(.9)}
.reject-btn{background:rgba(115,30,46,.4);color:#F5B8C0;border:1px solid rgba(115,30,46,.5);border-radius:8px;padding:8px 18px;font-size:12px;font-weight:700;cursor:pointer;font-family:Cairo,sans-serif;transition:all .18s cubic-bezier(.4,0,.2,1)}
.reject-btn:active{transform:scale(.96) translateY(1px);filter:brightness(.88)}
.create-tab-btn:active{transform:scale(.97)!important}
/* ══ rd-tab segmented ═══════════════════════════════════════ */
.rd-tabs-wrap{display:flex;gap:4px;flex-wrap:wrap;background:#EDE5D8;border-radius:10px;padding:4px;margin-bottom:12px}
.rd-tab-btn-seg{padding:7px 14px;border:1.5px solid transparent;border-radius:7px;font-size:11px;font-weight:700;cursor:pointer;background:transparent;color:#8B6A42;font-family:Cairo,sans-serif;transition:all .15s}
.rd-tab-btn-seg:hover{background:rgba(255,255,255,.6);color:#3D2E0F}
.rd-tab-btn-seg.active{background:#fff;color:#3D2E0F;border-color:#C8A97A}

/* ══ Nav section label ═══════════════════════════════════════ */
.nav-section-label{color:#B0966F}

/* ══ Responsive ═════════════════════════════════════════════ */
@media(max-width:768px){
  :root{--sidebar:0px}
  .sidebar{display:none}
  .main{margin-right:0}
  .form-grid,.form-grid-3{grid-template-columns:1fr}
}

