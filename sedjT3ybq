  private_chains_cairo:'سلاسل الأسواق الخاصة القاهرة', private_chains_giza:'سلاسل الأسواق الخاصة الجيزة'
};

function sgCalcWorkDays(){
  const wd = parseInt(document.getElementById('sg-workdays-sel')?.value)||26;
  const el = document.getElementById('sg-wd-val');
  if(el) el.textContent = wd;
  return wd;
}

/* ── موديال أيام العمل ─────────────────────────────────── */
let _sgSelectedDays = new Set(); // أرقام الأيام المختارة

function sgOpenWorkDays(){
  const modal = document.getElementById('sg-workdays-modal');
  modal.style.display = 'flex';
  modal.onclick = e=>{ if(e.target===modal) sgCloseWorkDays(); };
  // اجيب الشهر الحالي
  const mainMonth = document.getElementById('sg-month')?.value;
  const wdMonth = document.getElementById('sg-wd-month');
  if(wdMonth) wdMonth.value = mainMonth || `${new Date().getFullYear()}-${String(new Date().getMonth()+1).padStart(2,'0')}`;
  sgBuildCalendar();
}

function sgCloseWorkDays(){
  document.getElementById('sg-workdays-modal').style.display = 'none';
}

function sgBuildCalendar(){
  const val = document.getElementById('sg-wd-month')?.value;
  if(!val) return;
  const [yr, mo] = val.split('-').map(Number);
  const daysInMonth = new Date(yr, mo, 0).getDate();
  const firstDay = new Date(yr, mo-1, 1).getDay(); // 0=أحد

  // ابدأ بكل أيام الشهر مختارة ما عدا الجمع
  _sgSelectedDays.clear();
  for(let d=1; d<=daysInMonth; d++){
    const dow = new Date(yr, mo-1, d).getDay();
    if(dow !== 5) _sgSelectedDays.add(d); // 5=جمعة
  }

  sgRenderCalendar(yr, mo, daysInMonth, firstDay);
}

function sgRenderCalendar(yr, mo, daysInMonth, firstDay){
  const grid = document.getElementById('sg-calendar-grid');
  // احتفظ بصف الأيام
  let html = `
    <div style="font-size:10px;font-weight:700;color:#185FA5">أح</div>
    <div style="font-size:10px;font-weight:700;color:#185FA5">إث</div>
    <div style="font-size:10px;font-weight:700;color:#185FA5">ث</div>
    <div style="font-size:10px;font-weight:700;color:#185FA5">أر</div>
    <div style="font-size:10px;font-weight:700;color:#185FA5">خ</div>
    <div style="font-size:10px;font-weight:700;color:#3B6D11">س</div>
    <div style="font-size:10px;font-weight:700;color:#A32D2D">ج</div>`;

  // خلايا فارغة قبل اليوم الأول
  for(let i=0; i<firstDay; i++) html += `<div></div>`;

  for(let d=1; d<=daysInMonth; d++){
    const dow = new Date(yr, mo-1, d).getDay();
    const isFri = dow === 5;
    const isSat = dow === 6;
    const isWork = _sgSelectedDays.has(d);
    const bg = isFri ? '#FCEBEB' : isWork ? '#EAF3DE' : '#F5F5F5';
    const clr = isFri ? '#A32D2D' : isWork ? '#3B6D11' : '#999';
    const border = isWork ? '2px solid #3B6D11' : '1.5px solid #eee';
    html += `<div onclick="sgToggleDay(${d},${yr},${mo})" style="cursor:pointer;border-radius:8px;padding:6px 2px;font-size:12px;font-weight:700;background:${bg};color:${clr};border:${border};user-select:none">${d}</div>`;
  }

  grid.innerHTML = html;
  sgUpdateWdCounts(daysInMonth);
}

function sgToggleDay(d, yr, mo){
  if(_sgSelectedDays.has(d)) _sgSelectedDays.delete(d);
  else _sgSelectedDays.add(d);
  const daysInMonth = new Date(yr, mo, 0).getDate();
  const firstDay = new Date(yr, mo-1, 1).getDay();
  sgRenderCalendar(yr, mo, daysInMonth, firstDay);
}

function sgUpdateWdCounts(daysInMonth){
  document.getElementById('sg-wd-count').textContent = _sgSelectedDays.size;
  document.getElementById('sg-wd-off-count').textContent = daysInMonth - _sgSelectedDays.size;
}

function sgSelectAllDays(){
  const val = document.getElementById('sg-wd-month')?.value;
  if(!val) return;
  const [yr, mo] = val.split('-').map(Number);
  const daysInMonth = new Date(yr, mo, 0).getDate();
  _sgSelectedDays.clear();
  for(let d=1; d<=daysInMonth; d++) _sgSelectedDays.add(d);
  sgRenderCalendar(yr, mo, daysInMonth, new Date(yr, mo-1, 1).getDay());
}

function sgDeselectFridays(){
  const val = document.getElementById('sg-wd-month')?.value;
  if(!val) return;
  const [yr, mo] = val.split('-').map(Number);
  const daysInMonth = new Date(yr, mo, 0).getDate();
  for(let d=1; d<=daysInMonth; d++){
    if(new Date(yr, mo-1, d).getDay()===5) _sgSelectedDays.delete(d);
  }
  sgRenderCalendar(yr, mo, daysInMonth, new Date(yr, mo-1, 1).getDay());
}

async function sgApplyWorkDays(){
  const val = document.getElementById('sg-wd-month')?.value;
  if(!val){ showToast('اختر الشهر أولاً'); return; }
  const wd = _sgSelectedDays.size;
  if(!wd){ showToast('لم تختر أي يوم عمل'); return; }

  const H = {'apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`,'Content-Type':'application/json','Prefer':'return=minimal'};
  const btn = document.querySelector('#sg-workdays-modal button[onclick="sgApplyWorkDays()"]');
  if(btn){ btn.disabled=true; btn.textContent='جاري التطبيق...'; }

  try{
    const res = await fetch(`${SUPABASE_URL}/rest/v1/rep_targets?month=eq.${val}`,{
      method:'PATCH', headers:H,
      body: JSON.stringify({work_days: wd})
    });
    if(res.ok || res.status===204){
      // حدّث الـ badge وإعادة رسم
      const sel = document.getElementById('sg-workdays-sel');
      if(sel){ sel.value = wd; }
      const wdEl = document.getElementById('sg-wd-val');
      if(wdEl) wdEl.textContent = wd;
      showToast(`✅ تم تطبيق ${wd} يوم عمل على كل المجموعات`);
      sgRender();
      sgCloseWorkDays();
    } else {
      const e = await res.text();
      showToast('❌ خطأ: ' + e.substring(0,60));
    }
  }catch(e){ showToast('❌ '+e.message); }
  finally{ if(btn){ btn.disabled=false; btn.innerHTML='<i class="ti ti-check"></i> تطبيق على كل المجموعات'; } }
}

function sgOnWorkDaysChange(){
  sgCalcWorkDays();
  sgRender();
  // حفظ في Supabase
  sgSaveWorkDays();
}

async function sgSaveWorkDays(){
  const H = {'apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`,'Content-Type':'application/json','Prefer':'return=minimal'};
  const monthSel = document.getElementById('sg-month');
  if(!monthSel?.value) return;
  const monthStr = monthSel.value;
  const wd = parseInt(document.getElementById('sg-workdays-sel')?.value)||26;
  // حدّث كل سجلات الشهر بأيام العمل
  await fetch(`${SUPABASE_URL}/rest/v1/rep_targets?month=eq.${monthStr}`,{
    method:'PATCH', headers:H,
    body: JSON.stringify({work_days: wd})
  });
}

async function sgLoad(){
  const H = {'apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`};
  const now = new Date();
  const monthSel = document.getElementById('sg-month');
  if(!monthSel.value){
    const m = String(now.getMonth()+1).padStart(2,'0');
    monthSel.value = `${now.getFullYear()}-${m}`;
  }
  const [yr,mo] = monthSel.value.split('-').map(Number);
  sgCalcWorkDays();

  const details = document.getElementById('sg-details');
  details.innerHTML = '<div style="text-align:center;padding:40px;color:#aaa"><div class="spin" style="margin:0 auto 10px"></div>جاري التحميل...</div>';

  try{
    // 1. جيب المشرفين — من staff (المصدر الرسمي)، وfallback لـ sales_staff القديم
    const supRes = await fetch(`${SUPABASE_URL}/rest/v1/staff?select=*&active=eq.true&order=name.asc`,{headers:H});
    let supData = supRes.ok ? await supRes.json() : [];
    if(Array.isArray(supData) && supData.length){
      supData = supData.filter(s=>{
        const acc = Array.isArray(s.app_access) ? s.app_access : (s.app_access ? [s.app_access] : []);
        return acc.includes('sales-app');
      });
    }
    if(!Array.isArray(supData) || !supData.length){
      const supRes2 = await fetch(`${SUPABASE_URL}/rest/v1/sales_staff?select=*&active=eq.true&order=name.asc`,{headers:H});
      supData = supRes2.ok ? await supRes2.json() : [];
    } else {
      // تطبيع بيانات staff (grp array + role نوعه group_sup/sales_manager)
      // عشان تتوافق مع باقي كود الأهداف اللي مكتوب على شكل sales_staff القديم (sector نص + role sales_sup/sales_manager/sales_gm)
      const ROLE_NORM = {
        gm: 'sales_gm', sales_gm: 'sales_gm',
        sales_manager: 'sales_manager', manager: 'sales_manager',
        group_sup: 'sales_sup', hyper_sup: 'sales_sup', special_sup: 'sales_sup', hyper_sales_sup: 'sales_sup', sales_sup: 'sales_sup',
      };
      supData = supData.map(s=>({
        ...s,
        sector: Array.isArray(s.grp) ? s.grp.join(',') : (s.sector||''),
        role: ROLE_NORM[s.role] || s.role,
        reports_to: s.reports_to || '',
      }));
    }

    // 2. جيب المناديب + الفروع بالتوازي
    const [repRes, branchesRes] = await Promise.all([
      fetch(`${SUPABASE_URL}/rest/v1/users?select=id,name,route,routes,grp,groups,supervisors,status&role=eq.sales&level=eq.rep&status=eq.active&order=name.asc&limit=500`,{headers:H}),
      fetch(`${SUPABASE_URL}/rest/v1/branches?select=branch_name,route&status=eq.active&limit=2000`,{headers:H}),
    ]);
    const repData     = repRes.ok     ? await repRes.json()     : [];
    const branchesRaw = branchesRes.ok? await branchesRes.json(): [];

    // بناء map: route → عدد الفروع
    const branchCountMap = {};
    branchesRaw.forEach(b=>{ const r=(b.route||'').trim(); if(r) branchCountMap[r]=(branchCountMap[r]||0)+1; });

    // 3. جيب الأهداف الموجودة للشهر ده
    const monthStr = `${yr}-${String(mo).padStart(2,'0')}`;
    const tgtRes = await fetch(`${SUPABASE_URL}/rest/v1/rep_targets?select=*&month=eq.${monthStr}&deleted_at=is.null&limit=500`,{headers:H});
    const tgtData = tgtRes.ok ? await tgtRes.json() : [];

    // 4. جيب المبيعات والمرتجعات للشهر ده (بنفس منطق يومية المندوب: total_net - total_tax)
    const dateFrom = `${yr}-${String(mo).padStart(2,'0')}-01`;
    const dateTo   = `${yr}-${String(mo).padStart(2,'0')}-${new Date(yr,mo,0).getDate()}`;
    // pagination كاملة (مش limit ثابت) — الرقم ده بيتحسب منه "المبيعات الفعلية"
    // ولازم يكون شامل 100% حتى لو عدد الفواتير في الشهر زاد عن 5000
    const [salesData, retsData] = await Promise.all([
      fetchAllRows(`${SUPABASE_URL}/rest/v1/sales_deliveries?select=rep_name,total_net,total_tax&delivery_date=gte.${dateFrom}&delivery_date=lte.${dateTo}&deleted_at=is.null`, H),
      fetchAllRows(`${SUPABASE_URL}/rest/v1/sales_returns?select=rep_name,total_net,total_tax&return_date=gte.${dateFrom}&return_date=lte.${dateTo}&deleted_at=is.null`, H)
    ]);

    // بناء maps
    const tgtMap = {};
    tgtData.forEach(t=>{ tgtMap[t.rep_name] = {...t, goal: t.target_amount}; });
    // اضبط أيام العمل من أول سجل في الشهر
    const savedWd = tgtData.find(t=>t.work_days)?.work_days;
    if(savedWd){
      const sel = document.getElementById('sg-workdays-sel');
      if(sel) sel.value = savedWd;
    }
    // البيع الصافي = (total_net - total_tax) للتسليم − (total_net - total_tax) للمرتجع
    const salesMap = {};
    salesData.forEach(s=>{ salesMap[s.rep_name] = (salesMap[s.rep_name]||0) + ((s.total_net||0)-(s.total_tax||0)); });
    retsData.forEach(r=>{  salesMap[r.rep_name] = (salesMap[r.rep_name]||0) - ((r.total_net||0)-(r.total_tax||0)); });

    _sgData = { supervisors: supData, reps: repData, targets: tgtMap, sales: salesMap, branchCount: branchCountMap };
    sgRender();
  }catch(e){
    details.innerHTML = `<div style="text-align:center;padding:40px;color:#C55B48">تعذر التحميل: ${e.message}</div>`;
  }
}

// ── دوال منطقة الاختيار المتعدد ──
function sgToggleRegionDrop(){
  const drop = document.getElementById('sg-region-drop');
  if(!drop) return;
  const isOpen = drop.style.display !== 'none';
  drop.style.display = isOpen ? 'none' : 'block';
  if(!isOpen){
    // إغلاق عند النقر خارج
    setTimeout(()=>{
      function outsideClick(e){
        if(!document.getElementById('sg-region-btn')?.contains(e.target) &&
           !document.getElementById('sg-region-drop')?.contains(e.target)){
          document.getElementById('sg-region-drop').style.display='none';
          document.removeEventListener('click', outsideClick);
        }
      }
      document.addEventListener('click', outsideClick);
    }, 50);
  }
}
function sgRegionAllChange(cb){
  document.querySelectorAll('.sgr-cb').forEach(c=>c.checked=cb.checked);
  sgUpdateRegionLabel();
  sgRender();
}
function sgRegionCbChange(){
  const cbs = [...document.querySelectorAll('.sgr-cb')];
  const allChecked = cbs.every(c=>c.checked);
  const allCb = document.getElementById('sgr-all');
  if(allCb) allCb.checked = allChecked;
  sgUpdateRegionLabel();
  sgRender();
}
function sgUpdateRegionLabel(){
  const cbs = [...document.querySelectorAll('.sgr-cb')];
  const checked = cbs.filter(c=>c.checked);
  const labelEl = document.getElementById('sg-region-label');
  if(!labelEl) return;
  if(checked.length===0) labelEl.textContent='— بدون اختيار —';
  else if(checked.length===cbs.length) labelEl.textContent='— كل المناطق —';
  else if(checked.length===1) labelEl.textContent=checked[0].closest('label').textContent.trim();
  else labelEl.textContent=`${checked.length} مناطق`;
}
function sgGetSelectedRegions(){
  const cbs = [...document.querySelectorAll('.sgr-cb')];
  const checked = cbs.filter(c=>c.checked).map(c=>c.value);
  if(checked.length===cbs.length || checked.length===0) return 'all';
  return checked;
}

function sgRender(){
  const regions = sgGetSelectedRegions();
  const workDays = sgCalcWorkDays();
  const { supervisors, reps, targets, sales } = _sgData;

  // فلتر المشرفين حسب المنطقة
  const filteredSups = supervisors.filter(s=>{
    if(regions==='all') return true;
    const sec = (s.sector||'').split(',').map(x=>x.trim());
    return sec.some(x=>regions.includes(x));
  });

  // حساب إجمالي
  // ملحوظة: "المبيعات الفعلية" هنا لازم تطابق "الصافي" في تاب يومية المندوب بالظبط —
  // يومية بتجمع كل مندوب ظاهر في الفواتير نفسها من غير ما تفلتر بحالة نشط/غير نشط،
  // فبدل ما نجمع totalSales بس من المناديب النشطين (اللي ممكن يستبعد مندوب سايبته
  // "نشط" لسه ليه فواتير)، بنجمع كل قيم sales[] زي ما هي — نفس مصدر ونفس صيغة يومية بالظبط.
  let totalGoal=0;
  reps.forEach(r=>{
    const t = targets[r.name];
    if(t) totalGoal += (t.goal||0);
  });
  const totalSales = Object.values(sales||{}).reduce((s,v)=>s+(v||0),0);
  const totalPct = totalGoal>0 ? Math.round(totalSales/totalGoal*100) : 0;
  const totalDaily = workDays>0 ? Math.round(totalGoal/workDays) : 0;

  // إجمالي
  const sumEl = document.getElementById('sg-summary');
  if(sumEl) sumEl.innerHTML = `
    <div style="background:var(--surface-2);border:0.5px solid var(--border);border-radius:8px;padding:10px 14px">
      <div style="font-size:10px;color:var(--text-secondary)">إجمالي الأهداف</div>
      <div style="font-size:17px;font-weight:700;color:#7A3B1E;margin-top:3px">${totalGoal.toLocaleString('en-US')} ج</div>
    </div>
    <div style="background:var(--surface-2);border:0.5px solid var(--border);border-radius:8px;padding:10px 14px">
      <div style="font-size:10px;color:var(--text-secondary)">المبيعات الفعلية</div>
      <div style="font-size:17px;font-weight:700;color:#3B6D11;margin-top:3px">${Math.round(totalSales).toLocaleString('en-US')} ج</div>
    </div>
    <div style="background:var(--surface-2);border:0.5px solid var(--border);border-radius:8px;padding:10px 14px">
      <div style="font-size:10px;color:var(--text-secondary)">الهدف اليومي الكلي</div>
      <div style="font-size:17px;font-weight:700;color:#185FA5;margin-top:3px">${totalDaily.toLocaleString('en-US')} ج</div>
    </div>
    <div style="background:var(--surface-2);border:0.5px solid var(--border);border-radius:8px;padding:10px 14px">
      <div style="font-size:10px;color:var(--text-secondary)">نسبة التحقيق الكلية</div>
      <div style="font-size:17px;font-weight:700;color:${totalPct>=80?'#3B6D11':totalPct>=60?'#854F0B':'#A32D2D'};margin-top:3px">${totalPct}%</div>
    </div>`;

  // خطوط السير — إعادة رسم لو مفتوح
  const routesSection = document.getElementById('sg-routes-section');
  if(routesSection && routesSection.style.display !== 'none') routesSection.innerHTML = sgRenderRoutes();

  // كروت المشرفين
  const cardsEl = document.getElementById('sg-sup-cards');
  if(cardsEl){
    let cardsHtml = '';
    const SG_CARD_COLORS = ['#1565C0','#2E7D32','#AD1457','#EF6C00','#6A1B9A','#00838F','#5D4037','#C62828','#4527A0','#00695C'];
    filteredSups.forEach((sup,supIdx)=>{
      const cardClr = SG_CARD_COLORS[supIdx % SG_CARD_COLORS.length];
      const normSup = s => (s||'').trim().replace(/\s+/g,' ');
      const supMatch = (rSup, sName) => { const a=normSup(rSup),b=normSup(sName); return a===b||a.startsWith(b)||b.startsWith(a); };
      let supReps = reps.filter(r=> supMatch(r.supervisors, sup.name));
      // لو مدير (مش عنده مناديب مباشرين) → اجمع من المشرفين التابعين له فعلياً (reports_to)
      if(!supReps.length){
        const subSups = filteredSups.filter(s=> s.name!==sup.name && normSup(s.reports_to)===normSup(sup.name));
        if(subSups.length){
          subSups.forEach(s=>{ supReps = supReps.concat(reps.filter(r=> supMatch(r.supervisors, s.name))); });
        } else if(sup.sector){
          // fallback قديم لبيانات sales_staff اللي معندهاش reports_to
          const dirSectors = new Set((sup.sector||'').split(',').map(x=>x.trim()).filter(Boolean));
          filteredSups.forEach(s=>{
            if(s.name===sup.name) return;
            const sSectors = (s.sector||'').split(',').map(x=>x.trim()).filter(Boolean);
            if(sSectors.some(sec=>dirSectors.has(sec))){
              supReps = supReps.concat(reps.filter(r=> supMatch(r.supervisors, s.name)));
            }
          });
        }
        supReps = [...new Map(supReps.map(r=>[r.id,r])).values()];
      }
      const supGoal = supReps.reduce((s,r)=>s+(targets[r.name]?.goal||0),0);
      const supSales = supReps.reduce((s,r)=>s+(sales[r.name]||0),0);
      const pct = supGoal>0 ? Math.round(supSales/supGoal*100) : 0;
      const daily = workDays>0 ? Math.round(supGoal/workDays) : 0;
      const clr = pct>=80?'#3B6D11':pct>=60?'#854F0B':'#A32D2D';
      const sts = pct>=80?'<span style="padding:2px 8px;border-radius:20px;font-size:10px;font-weight:700;background:#EAF3DE;color:#3B6D11">ممتاز</span>':
                  pct>=60?'<span style="padding:2px 8px;border-radius:20px;font-size:10px;font-weight:700;background:#FAEEDA;color:#854F0B">متوسط</span>':
                  '<span style="padding:2px 8px;border-radius:20px;font-size:10px;font-weight:700;background:#FCEBEB;color:#A32D2D">ضعيف</span>';
      const sectors = (sup.sector||'').split(',').filter(Boolean).map(g=>SG_GROUPS[g]||g).join(' + ');
      cardsHtml += `<div style="background:var(--surface-2);border:0.5px solid var(--border);border-radius:10px;overflow:hidden">
        <div style="background:${cardClr};padding:8px 12px;display:flex;align-items:center;justify-content:space-between">
          <div>
            <div style="color:#fff;font-size:12px;font-weight:700">${sup.name}</div>
            <div style="color:rgba(255,255,255,.75);font-size:10px">${sectors}</div>
          </div>${sts}
        </div>
        <div style="padding:10px 12px">
          <div style="display:flex;justify-content:space-between;margin-bottom:4px"><span style="font-size:10px;color:var(--text-secondary)">الهدف الشهري</span><span style="font-size:12px;font-weight:700;color:#7A3B1E">${supGoal.toLocaleString('en-US')} ج</span></div>
          <div style="display:flex;justify-content:space-between;margin-bottom:6px"><span style="font-size:10px;color:var(--text-secondary)">المحقق</span><span style="font-size:12px;font-weight:700;color:${clr}">${Math.round(supSales).toLocaleString('en-US')} ج</span></div>
          <div style="width:100%;height:6px;background:var(--border);border-radius:3px;overflow:hidden;margin-bottom:6px">
            <div style="height:100%;width:${Math.min(pct,100)}%;background:${clr};border-radius:3px"></div>
          </div>
          <div style="display:flex;justify-content:space-between;border-top:0.5px solid var(--border);padding-top:6px">
            <span style="font-size:10px;color:var(--text-secondary)">يومي: ${daily.toLocaleString('en-US')} ج</span>
            <span style="font-size:14px;font-weight:700;color:${clr}">${pct}%</span>
          </div>
        </div>
      </div>`;
    });
    cardsEl.innerHTML = cardsHtml || '<div style="color:#aaa;font-size:12px">لا يوجد مشرفون في هذه المنطقة</div>';
  }

  // تفاصيل المناديب
  const details = document.getElementById('sg-details');
  if(!details) return;
  let html = '';

  // مجموعة المشرفين مع مدير
  const dirRes = supervisors.filter(s=>s.role==='sales_manager'||s.role==='sales_gm');
  const supsWithDir = new Set();

  dirRes.forEach(dir=>{
    if(regions!=='all'){
      const sec=(dir.sector||'').split(',').map(x=>x.trim());
      if(!sec.some(x=>regions.includes(x))) return;
    }
    const _dsn = s=>(s||'').trim().replace(/\s+/g,' ');
    let dirSups = filteredSups.filter(s=>s.role==='sales_sup'&&_dsn(s.reports_to)===_dsn(dir.name));
    // fallback لبيانات قديمة معندهاش reports_to
    if(!dirSups.length){
      dirSups = filteredSups.filter(s=>s.role==='sales_sup'&&!s.reports_to&&(s.sector||'').split(',').some(g=>(dir.sector||'').split(',').includes(g.trim())));
    }
    if(!dirSups.length) return;
    html += `<div style="background:var(--surface-2);border:0.5px solid var(--border);border-right:4px solid #3B1F12;border-radius:8px;padding:10px 14px;margin-bottom:12px;display:flex;align-items:center;gap:10px">
      <div style="width:38px;height:38px;border-radius:50%;background:#3B1F12;color:#F2E4DC;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;flex-shrink:0">${dir.name.split(' ').map(w=>w[0]).join('').slice(0,2)}</div>
      <div style="flex:1"><div style="font-size:13px;font-weight:700;color:var(--text-primary)">${dir.name}</div><div style="font-size:11px;color:var(--text-secondary);margin-top:2px">مدير البيع — ${(dir.sector||'').split(',').filter(Boolean).map(g=>SG_GROUPS[g]||g).join('، ')}</div></div>
      <span style="padding:3px 10px;border-radius:20px;font-size:11px;font-weight:700;background:#3B1F12;color:#F2E4DC">مدير بيع</span>
    </div>`;
    dirSups.forEach(sup=>{ supsWithDir.add(sup.id); html += sgRenderSupBlock(sup, reps, targets, sales, workDays); });
  });

  // مشرفين بدون مدير
  const supsNoDirList = filteredSups.filter(s=>s.role==='sales_sup'&&!supsWithDir.has(s.id));
  if(supsNoDirList.length){
    html += `<div style="background:#1A3A5C;color:#C0D4E8;font-size:11px;font-weight:700;padding:6px 12px;border-radius:6px;margin-bottom:10px">🌊 مشرفون بدون مدير بيع مباشر</div>`;
    supsNoDirList.forEach(sup=>{ html += sgRenderSupBlock(sup, reps, targets, sales, workDays); });
  }

  // مناديب بدون مشرف (مع إخفاء المشرفين أنفسهم)
  const supNames = new Set(supervisors.map(s=>s.name));
  const _smNorm = s=>(s||'').trim().replace(/\s+/g,' ');
  const _smMatch = (a,b)=>{ const x=_smNorm(a),y=_smNorm(b); return x===y||x.startsWith(y)||y.startsWith(x); };
  const repsNoSup = reps.filter(r=>{
    if(supNames.has(r.name)) return false; // مشرف مش مندوب
    if(!r.supervisors) return true;
    return !supervisors.some(s=>_smMatch(r.supervisors, s.name));
  }).filter(r=> regions==='all'||regions.some(rg=>(r.grp||r.groups||'').includes(rg)));
  if(repsNoSup.length){
    html += `<div style="background:#3D2E0F;color:#EDE5D8;font-size:11px;font-weight:700;padding:6px 12px;border-radius:6px;margin-bottom:10px">مناديب بدون مشرف مبيعات</div>`;
    html += sgRenderTable(repsNoSup, targets, sales, workDays);
  }

  details.innerHTML = html || '<div style="text-align:center;padding:40px;color:#aaa">لا توجد بيانات</div>';
}

// ── toggle خطوط السير ──────────────────────────────────────
function sgToggleRoutes(btn){
  const sec = document.getElementById('sg-routes-section');
  const chev = document.getElementById('sg-routes-chevron');
  if(!sec) return;
  const isOpen = sec.style.display !== 'none';
  if(isOpen){
    sec.style.display = 'none';
    if(chev){ chev.className='ti ti-chevron-down'; }
  } else {
    sec.style.display = 'block';
    if(!sec.innerHTML.trim()) sec.innerHTML = sgRenderRoutes();
    if(chev){ chev.className='ti ti-chevron-up'; }
  }
}

// ── عرض خطوط السير مع الهدف وعدد العملاء ─────────────────
function sgRenderRoutes(){
  const { reps, targets, sales, branchCount } = _sgData;
  const workDays = sgCalcWorkDays();
  const routeMap = {}; // route → { goal, salesAmt, repNames }

  reps.forEach(r=>{
    let routeArr = [];
    if(Array.isArray(r.routes) && r.routes.length) routeArr = r.routes;
    else if(r.route && r.route.trim()) routeArr = [r.route.trim()];

    const goal = targets[r.name]?.goal || 0;
    const act  = sales[r.name] || 0;

    routeArr.forEach(rt=>{
      if(!rt) return;
      if(!routeMap[rt]) routeMap[rt] = { goal:0, sales:0, reps:[] };
      routeMap[rt].goal  += goal;
      routeMap[rt].sales += act;
      routeMap[rt].reps.push(r.name);
    });
  });

  const routeEntries = Object.entries(routeMap).sort((a,b)=>b[1].goal-a[1].goal);
  if(!routeEntries.length) return '';

  let rows = '';
  routeEntries.forEach(([rt, d], i)=>{
    const pct     = d.goal>0 ? Math.round(d.sales/d.goal*100) : 0;
    const daily   = d.goal>0&&workDays>0 ? Math.round(d.goal/workDays) : 0;
    const clr     = pct>=80?'#3B6D11':pct>=60?'#854F0B':'#A32D2D';
    const bgClr   = pct>=80?'#EAF3DE':pct>=60?'#FAEEDA':'#FCEBEB';
    const branches = branchCount?.[rt] || 0;
    const repLabel = d.reps.length ? d.reps.join(' / ') : '—';

    rows += `<tr style="border-bottom:0.5px solid var(--border);${i%2===0?'':'background:#FDFAF5'}">
      <td style="padding:9px 12px;color:#aaa;font-size:11px">${i+1}</td>
      <td style="padding:9px 12px;font-weight:700;font-size:12px">${rt}</td>
      <td style="padding:9px 12px;font-size:11px;color:var(--text-secondary)">${repLabel}</td>
      <td style="padding:9px 12px;text-align:center">
        <span style="background:#E3F2FD;color:#1565C0;font-weight:700;font-size:13px;padding:3px 10px;border-radius:20px">${branches}</span>
      </td>
      <td style="padding:9px 12px;font-weight:700;color:#7A3B1E;font-size:12px">${d.goal>0?d.goal.toLocaleString('en-US')+' ج':'—'}</td>
      <td style="padding:9px 12px;font-size:11px;color:#185FA5">${daily>0?daily.toLocaleString('en-US')+' ج':'—'}</td>
      <td style="padding:9px 12px">
        <div style="font-weight:700;font-size:11px;color:${clr};margin-bottom:3px">${d.sales>0?Math.round(d.sales).toLocaleString('en-US')+' ج':'—'}</div>
        <div style="display:flex;align-items:center;gap:5px">
          <div style="flex:1;height:5px;background:var(--border);border-radius:3px;overflow:hidden;min-width:40px">
            <div style="height:100%;width:${Math.min(pct,100)}%;background:${clr};border-radius:3px"></div>
          </div>
          <span style="font-size:11px;font-weight:700;color:${clr}">${pct}%</span>
        </div>
      </td>
      <td style="padding:9px 12px;text-align:center">
        <span style="background:${bgClr};color:${clr};padding:2px 10px;border-radius:20px;font-size:10px;font-weight:700">${pct>=80?'ممتاز':pct>=60?'متوسط':d.goal>0?'ضعيف':'—'}</span>
      </td>
    </tr>`;
  });

  return `
    <div class="card" style="margin-bottom:12px">
      <div style="font-size:12px;font-weight:700;color:#5C3D2E;margin-bottom:10px;display:flex;align-items:center;gap:6px">
        <i class="ti ti-route" style="color:#C55B48"></i> هدف كل خط سير وعدد عملائه
      </div>
      <div style="overflow-x:auto">
        <table style="width:100%;border-collapse:collapse;font-size:12px">
          <thead>
            <tr style="background:#3B1F12">
              <th style="padding:8px 12px;text-align:right;font-size:11px;color:#F2E4DC">#</th>
              <th style="padding:8px 12px;text-align:right;font-size:11px;color:#F2E4DC">خط السير</th>
              <th style="padding:8px 12px;text-align:right;font-size:11px;color:#F2E4DC">المندوب</th>
              <th style="padding:8px 12px;text-align:center;font-size:11px;color:#F2E4DC">عدد العملاء</th>
              <th style="padding:8px 12px;text-align:right;font-size:11px;color:#F2E4DC">الهدف الشهري</th>
              <th style="padding:8px 12px;text-align:right;font-size:11px;color:#F2E4DC">الهدف اليومي</th>
              <th style="padding:8px 12px;text-align:right;font-size:11px;color:#F2E4DC">التحقيق</th>
              <th style="padding:8px 12px;text-align:center;font-size:11px;color:#F2E4DC">الحالة</th>
            </tr>
          </thead>
          <tbody>${rows}</tbody>
        </table>
      </div>
    </div>`;
}

function sgRenderSupBlock(sup, reps, targets, sales, workDays){
  const _n=s=>(s||'').trim().replace(/\s+/g,' ');
  const supReps = reps.filter(r=>{ const a=_n(r.supervisors),b=_n(sup.name); return a===b||a.startsWith(b)||b.startsWith(a); });
  const sectors = (sup.sector||'').split(',').filter(Boolean).map(g=>SG_GROUPS[g]||g).join(' + ');
  const initials = sup.name.split(' ').map(w=>w[0]).join('').slice(0,2);
  let html = `<div style="margin-bottom:14px;padding-right:14px;border-right:2px solid #F2E4DC">
    <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px">
      <div style="width:30px;height:30px;border-radius:50%;background:#F2E4DC;color:#7A3B1E;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;flex-shrink:0">${initials}</div>
      <div><div style="font-size:12px;font-weight:700;color:var(--text-primary)">${sup.name}</div><div style="font-size:10px;color:var(--text-secondary)">مشرف المجموعة — ${sectors}</div></div>
      <span style="padding:3px 10px;border-radius:20px;font-size:11px;font-weight:700;background:#F2E4DC;color:#7A3B1E;margin-right:auto">مشرف بيع</span>
    </div>`;
  if(supReps.length) html += sgRenderTable(supReps, targets, sales, workDays);
  else html += '<div style="font-size:11px;color:#aaa;padding:8px 12px">لا يوجد مناديب مرتبطون</div>';
  html += '</div>';
  return html;
}

function sgRepRoute(r){
  // كل الخطوط كـ HTML pills
  let arr = [];
  if(Array.isArray(r.routes) && r.routes.length){
    arr = [...r.routes]; // استخدم الـ array لو موجود
  } else if(r.route && r.route.trim()){
    arr = [r.route.trim()]; // fallback لـ route المفرد (للمناديب الثابتين)
  } else if(r.grp && r.grp.trim()){
    arr = [r.grp.trim()];
  } else if(r.groups && r.groups.trim()){
    arr = [r.groups.trim()];
  }
  if(!arr.length) return '—';
  return arr.map(x=>`<span style="display:inline-block;background:#F3F4F6;border-radius:6px;padding:1px 6px;margin:1px 2px;font-size:10px;white-space:nowrap">${x}</span>`).join('');
}

