  ws['!cols']=[{wch:5},{wch:18},{wch:22},{wch:14},{wch:32},{wch:16},{wch:14},{wch:16},{wch:14},{wch:14}];
  ws['!rows']=[{hpt:36},{hpt:28},{hpt:20},{hpt:8},{hpt:26}];
