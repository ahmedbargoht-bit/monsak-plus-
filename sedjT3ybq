        <span style="background:${sc.bg};color:${sc.color};padding:2px 8px;border-radius:999px;font-size:10px;font-weight:600">
          ${sc.label}
        </span>
      </div>
      <div style="font-size:11px;color:var(--text2)">📍 ${o.branch||'الكل'} · ${tag}</div>
      ${o.note?`<div style="font-size:11px;color:var(--text2);margin-top:3px">📝 ${o.note}</div>`:''}
      ${o.reject_reason?`<div style="font-size:11px;color:#B71C1C;margin-top:3px">سبب الرفض: ${o.reject_reason}</div>`:''}
      <div style="display:flex;gap:6px;margin-top:8px">
        ${isPending?`
          <button class="btn btn-ghost btn-xs" style="background:#E8F5E9;color:#1A7A4A;border-color:#C8E6C9"
            onclick="updateOrderStatus(${o.id},'approved')"><i class="ti ti-check"></i> اعتماد</button>
          <button class="btn btn-ghost btn-xs" style="background:#FFEBEE;color:#B71C1C;border-color:#FFCDD2"
            onclick="rejectOrder(${o.id})"><i class="ti ti-x"></i> رفض</button>`:''}
      </div>
    </div>`;
  }).join('')||'<div style="color:var(--text2);font-size:12px;text-align:center;padding:1rem">لا توجد طلبيات</div>';
