// DB STORAGE — مساحة قاعدة البيانات على Supabase
// ══════════════════════════════════════════════════════════════
// باقة Supabase الحالية للمشروع: Pro — بيتضمن 8 GB مساحة قاعدة بيانات مجانية،
// وبعدها بيتحاسب $0.125 لكل GB إضافي. بنجيب الحجم الفعلي عبر RPC (get_db_size_bytes)
// اللي بيرجع pg_database_size() ونقارنه بالـ 8 GB دول.
const DB_STORAGE_QUOTA_BYTES = 8 * 1024 * 1024 * 1024; // 8 GB — حد باقة Pro المجاني

function _fmtBytes(bytes){
  if(bytes >= 1024*1024*1024) return (bytes/1024/1024/1024).toFixed(2)+' GB';
  if(bytes >= 1024*1024) return (bytes/1024/1024).toFixed(1)+' MB';
  if(bytes >= 1024) return (bytes/1024).toFixed(1)+' KB';
  return bytes+' B';
}

