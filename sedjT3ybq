  msg.textContent = '';

  const H = {'Content-Type':'application/json','apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`,'Prefer':'return=minimal'};

  // 1) حفظ السعر والضريبة
  const existing = _splPrices.find(p=>p.snf_name===snfName);
  let r;
  if(existing){
    r = await fetch(`${SUPABASE_URL}/rest/v1/sales_prices?id=eq.${existing.id}`,{
      method:'PATCH', headers:H,
      body:JSON.stringify({price, tax_pct:tax, updated_at:new Date().toISOString()})
    });
  } else {
    r = await fetch(`${SUPABASE_URL}/rest/v1/sales_prices`,{
      method:'POST', headers:{...H,'Prefer':'return=minimal'},
      body:JSON.stringify({snf_name:snfName, price, tax_pct:tax})
    });
  }
  if(!r.ok && r.status!==201 && r.status!==204){
    msg.style.color='#B71C1C'; msg.textContent='❌ خطأ في حفظ السعر: '+await r.text(); return;
  }

  // 2) حفظ خصومات العملاء على التصنيف
  const inputs = document.querySelectorAll('.mep-disc-input');
  for(const inp of inputs){
    const clientName = inp.dataset.client;
    const pct = inp.value.trim();
    const existingDisc = _splCatDiscounts.find(d=>d.client_name===clientName && d.cat===cat);
    if(pct==='' || pct===undefined){
      // لو فاضي وكان موجود → احذفه
      if(existingDisc){
        await fetch(`${SUPABASE_URL}/rest/v1/client_category_discounts?id=eq.${existingDisc.id}`,{
          method:'DELETE', headers:H
        });
      }
    } else {
      const discPct = parseFloat(pct)||0;
      if(existingDisc){
        await fetch(`${SUPABASE_URL}/rest/v1/client_category_discounts?id=eq.${existingDisc.id}`,{
          method:'PATCH', headers:H,
          body:JSON.stringify({discount_pct:discPct, updated_at:new Date().toISOString()})
        });
      } else {
        await fetch(`${SUPABASE_URL}/rest/v1/client_category_discounts`,{
          method:'POST', headers:{...H,'Prefer':'return=minimal'},
          body:JSON.stringify({client_name:clientName, cat, discount_pct:discPct})
        });
      }
    }
  }

  showToast('✅ تم الحفظ');
  closeModal('modal-edit-price');
  await spLoadAll();
}

