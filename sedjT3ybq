function splRenderProducts(){
  const search = (document.getElementById('spl-psearch')?.value||'').toLowerCase();
  const fea    = document.getElementById('spl-pfea')?.value||'all';
  const cat    = document.getElementById('spl-pcat')?.value||'all';
  const tbody  = document.getElementById('spl-prod-tbody');
  const count  = document.getElementById('spl-prod-count');

  let data = _splProducts.map(p=>{
    const pr = _splPrices.find(x=>x.snf_name===p.name);
    return {...p, price:pr?.price||0, tax_pct:pr?.tax_pct||0, prId:pr?.id||null};
  });
  if(fea!=='all') data = data.filter(p=>p.fea===fea);
  if(cat!=='all') data = data.filter(p=>p.cat===cat);
  if(search) data = data.filter(p=>p.name.toLowerCase().includes(search));
  if(count) count.textContent = `${data.length} صنف`;

  tbody.innerHTML = data.map((p,i)=>{
    const priceWithTax = p.tax_pct>0 ? (p.price*(1+p.tax_pct/100)).toFixed(2) : p.price.toFixed(2);
    const taxBadge = p.tax_pct>0
      ? `<span style="background:#FFF3E0;color:#E65100;padding:2px 6px;border-radius:8px;font-size:10px">${p.tax_pct}%</span>`
      : `<span style="color:#ccc;font-size:11px">—</span>`;
    const priceBadge = p.price>0
      ? `<span style="background:#D1FAE5;color:#065F46;padding:2px 6px;border-radius:8px;font-size:10px;font-weight:700">محدد</span>`
      : `<span style="background:#FEE2E2;color:#B91C1C;padding:2px 6px;border-radius:8px;font-size:10px;font-weight:700">لم يحدد</span>`;
    const safeName = p.name.replace(/'/g,"\'");
    return `<tr style="${p.price===0?'background:#FFFBF0':''}">
      <td style="text-align:center"><input type="checkbox" class="spl-prod-cb" value="${safeName}" onchange="splOnProductCheck()"/></td>
      <td>${i+1}</td>
      <td style="font-weight:600;font-size:12px">${p.name}</td>
      <td style="text-align:center;font-size:11px;color:var(--text2)">${p.fea||'—'}</td>
      <td style="text-align:center;font-size:11px;color:var(--text2)">${p.cat||'—'}</td>
      <td style="text-align:center;font-weight:700;color:var(--navy)">${p.price>0?p.price.toFixed(2)+' ج':'—'}</td>
      <td style="text-align:center">${taxBadge}</td>
      <td style="text-align:center;font-weight:700;color:#1A7A4A">${p.price>0?priceWithTax+' ج':'—'}</td>
      <td style="text-align:center">${priceBadge}</td>
      <td style="text-align:center">
        <button onclick="splEditPrice('${safeName}',${p.price},${p.tax_pct},'${(p.cat||'').replace(/'/g,"\\'")}')"
          style="background:#EEF6FF;color:#1D4ED8;border:1px solid #BFDBFE;border-radius:6px;padding:3px 8px;cursor:pointer;font-size:11px">✏️</button>
      </td>
