function calcExpMonths(dateStr,monthsStr){
  if(!dateStr||!monthsStr)return null;
  const prod=new Date(dateStr+'-01');
  const exp=new Date(prod);exp.setMonth(exp.getMonth()+parseInt(monthsStr));
  const today=new Date();today.setDate(1);today.setHours(0,0,0,0);
  const diff=(exp.getFullYear()-today.getFullYear())*12+(exp.getMonth()-today.getMonth());
  const rafa3=new Date(prod);rafa3.setMonth(rafa3.getMonth()+10);
  const rafa3Diff=(rafa3.getFullYear()-today.getFullYear())*12+(rafa3.getMonth()-today.getMonth());
  return{diff,rafa3Diff,expLabel:exp.toLocaleDateString('en-US',{month:'short',year:'numeric'}),rafa3Label:rafa3.toLocaleDateString('en-US',{month:'short',year:'numeric'})};
}

function expBadge(st){
  if(!st)return'<span class="badge b-gray">—</span>';
  if(st.diff<0)return`<span class="badge b-red">🔴 منتهية (${Math.abs(st.diff)} شهر)</span>`;
  if(st.diff===0)return`<span class="badge b-red">🔴 هذا الشهر!</span>`;
  if(st.diff<=2)return`<span class="badge b-orange">🟠 ${st.diff} شهر — ${st.expLabel}</span>`;
  if(st.diff<=4)return`<span class="badge b-yellow">🟡 ${st.diff} شهر</span>`;
  return`<span class="badge b-green">🟢 ${st.diff} شهر</span>`;
}

function loadProducts(){
  const grp=document.getElementById('pr-group').value;
  const fea=document.getElementById('pr-fea').value;
  const search=document.getElementById('pr-search').value.toLowerCase();
  const exp=document.getElementById('pr-exp').value;
  let data=cachedData.products.filter(p=>CU.groups.includes(p.grp||p.group||''));
  if(grp!=='all') data=data.filter(p=>(p.grp||p.group)===grp);
  if(fea!=='all') data=data.filter(p=>p.fea===fea);
  if(search) data=data.filter(p=>(p.snf||'').toLowerCase().includes(search)||(p.name||'').toLowerCase().includes(search));
  if(exp!=='all'){
    data=data.filter(p=>{
      const sh=calcExpMonths(p.date_shelf,p.months_shelf);
      const st=calcExpMonths(p.date_stock,p.months_stock);
      const worst=sh&&st?Math.min(sh.diff,st.diff):sh?sh.diff:st?st.diff:999;
      if(exp==='expired')return worst<0;
      if(exp==='critical')return worst>=0&&worst<=2;
      if(exp==='warning')return worst>2&&worst<=4;
      if(exp==='ok')return worst>4;
      return true;
    });
  }
  document.getElementById('products-table').innerHTML=data.map(p=>{
    const sh=calcExpMonths(p.date_shelf,p.months_shelf);
    const st=calcExpMonths(p.date_stock,p.months_stock);
    const rafa3=sh?sh.rafa3Diff:null;
    const rafa3Badge=rafa3===null?'—':rafa3<=0?'<span class="badge b-red">حان الرفع!</span>':rafa3<=2?`<span class="badge b-orange">بعد ${rafa3} شهور</span>`:`<span class="badge b-gray">بعد ${rafa3} شهور</span>`;
    return`<tr>
      <td><b>${p.name}</b></td>
      <td style="font-size:11px">${p.branch||'—'}</td>
      <td style="font-size:11px;max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${p.snf||'—'}</td>
      <td><span class="badge b-blue">${p.fea||''}</span></td>
      <td>${p.shelf_qty||0}</td>
      <td>${p.stock_qty||0}</td>
      <td>${expBadge(sh)}</td>
      <td>${expBadge(st)}</td>
      <td>${rafa3Badge}</td>
      <td>${sh&&sh.diff<=2||st&&st.diff<=2?'<span class="badge b-red">تحذير</span>':'<span class="badge b-green">سليم</span>'}</td>
    
      <td><button onclick="deleteRecord('products',${p.id},'products')" style="background:#FFEBEE;color:#B71C1C;border:none;border-radius:6px;padding:3px 8px;cursor:pointer;font-size:12px">🗑</button></td></tr>`;
  }).join('')||'<tr><td colspan="10" style="text-align:center;padding:1rem;color:var(--text2)">لا توجد بيانات</td></tr>';
}

