async function loadFieldMonitor(){
  const tbody = document.getElementById('fm-tbody');
  if(!tbody) return;
  tbody.innerHTML = '<tr><td colspan="9" style="text-align:center;padding:2rem;color:var(--text2)">جاري التحميل...</td></tr>';

  // تحديد التاريخ
  const dateEl = document.getElementById('fm-date');
  if(!dateEl.value) dateEl.value = localISO();
  const dateVal  = dateEl.value;
  const supFilter= document.getElementById('fm-sup')?.value||'all';
  const alertFilter = document.getElementById('fm-alert')?.value||'all';

  // جيب نتائج الزيارات
  let url = `${SUPABASE_URL}/rest/v1/visit_results?select=*&visit_date=eq.${dateVal}&order=created_at.desc&limit=200`;
  const res = await fetch(url, {headers:{'apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`}});
  let results = res.ok ? await res.json() : [];
  if(!Array.isArray(results)) results=[];

  // جيب المشرفين لملء الفلتر
  const sups = (await sb('users',{role:'supervisor'}))||[];
  const supSel = document.getElementById('fm-sup');
  if(supSel && supSel.options.length<=1){
    sups.forEach(s=>{ const o=document.createElement('option');o.value=s.name;o.textContent=s.name;supSel.appendChild(o); });
  }

  // فلترة
  if(supFilter!=='all') results = results.filter(r=>r.supervisor_name===supFilter);

  // تصنيف التنبيهات
  const isWarn = r => {
    const d = r.execution_details||{};
    return d.secondary_display==='لا' || !d.promo_talker || !d.promo_display || r.score<40;
  };

  if(alertFilter==='warn') results = results.filter(r=>isWarn(r));
  if(alertFilter==='good') results = results.filter(r=>!isWarn(r));

  // إحصائيات
  const totalR  = results.length;
  const warnR   = results.filter(r=>isWarn(r)).length;
  const goodR   = totalR - warnR;
  const avgScore= totalR>0 ? Math.round(results.reduce((s,r)=>s+(r.score||0),0)/totalR) : 0;

  document.getElementById('fm-total').textContent = totalR;
  document.getElementById('fm-good').textContent  = goodR;
  document.getElementById('fm-warn').textContent  = warnR;
  document.getElementById('fm-avg-score').textContent = avgScore;

  if(!results.length){
    tbody.innerHTML='<tr><td colspan="9" style="text-align:center;padding:2rem;color:var(--text2)">لا توجد بيانات للتاريخ المحدد</td></tr>';
    return;
  }

  tbody.innerHTML = results.map((r,i)=>{
    const d = r.execution_details||{};
    const warn = isWarn(r);
    const rowBg = warn ? '#FFF8E1' : (i%2?'#fafafa':'#fff');
    const rowBorder = warn ? 'border-right:3px solid #E65100' : '';

    // أيقونات الحالة
    const icon = (ok) => ok
      ? '<span style="color:#1A7A4A;font-size:14px">✅</span>'
      : '<span style="color:#B71C1C;font-size:14px">❌</span>';

    const hasDisplay  = d.secondary_display==='نعم';
    const hasPromo    = d.promo_talker && d.promo_display;
    const hasFifo     = d.fifo_status==='ممتاز'||d.fifo_status==='جيد';
    const hasPhoto    = d.photo_quality==='ممتازة'||d.photo_quality==='جيدة';
    const scoreClr    = r.score>=70?'#1A7A4A':r.score>=40?'#E65100':'#B71C1C';
    const shareClr    = d.shelf_share==='مسيطرون'?'#1A7A4A':d.shelf_share==='متوازن'?'#E65100':'#B71C1C';

    return`<tr style="background:${rowBg};${rowBorder};border-bottom:1px solid #f0f0f0">
      <td style="padding:10px">
        <div style="font-weight:600">${r.supervisor_name}</div>
        ${warn?'<span style="font-size:10px;color:#E65100">⚠️ يحتاج متابعة</span>':''}
      </td>
      <td style="padding:10px">
        <div style="font-weight:600;font-size:12px">${r.branch_name}</div>
        <div style="font-size:11px;color:#666">${r.rep_name}</div>
      </td>
      <td style="padding:10px;text-align:center">
        ${icon(hasDisplay)}
        ${hasDisplay && d.display_types?.length?`<div style="font-size:10px;color:#666;margin-top:2px">${d.display_types.join('، ')}</div>`:''}
      </td>
      <td style="padding:10px;text-align:center">
        ${icon(hasPromo)}
        <div style="font-size:10px;color:#666;margin-top:2px">
          ${d.promo_talker?'Talker ✓':''} ${d.promo_display?'عرض ✓':''}
        </div>
      </td>
      <td style="padding:10px;text-align:center">
        ${icon(hasFifo)}
        <div style="font-size:10px;color:#666">${d.fifo_status||'—'}</div>
      </td>
      <td style="padding:10px;text-align:center">
        ${icon(hasPhoto)}
        <div style="font-size:10px;color:#666">${d.photo_quality||'—'}</div>
      </td>
      <td style="padding:10px;text-align:center">
        <div style="font-size:18px;font-weight:900;color:${scoreClr}">${r.score||0}</div>
        <div style="background:#eee;border-radius:999px;height:4px;margin-top:4px;overflow:hidden">
          <div style="height:100%;border-radius:999px;background:${scoreClr};width:${r.score||0}%"></div>
        </div>
      </td>
      <td style="padding:10px;text-align:center">
        <span style="color:${shareClr};font-weight:600;font-size:11px">${d.shelf_share||'—'}</span>
      </td>
      <td style="padding:10px;text-align:center">
        <button class="btn btn-xs" onclick="secureDelete('visit_results',${r.id})"
          style="background:#FFEBEE;color:#B71C1C;border:1px solid #FFCDD2" title="حذف النتيجة">
          <i class="ti ti-trash"></i></button>
      </td>
    </tr>`;
  }).join('');
}



