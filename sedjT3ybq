async function sppExportExcel(){
  if(!_sppPlans.length){ showToast('لا توجد بيانات — اضغط تحديث أولاً','err'); return; }
  if(typeof XLSX==='undefined'){ showToast('جاري تحميل مكتبة Excel...'); return; }

  const C={dark:'2C1F0A',caramel:'4B3C1A',gold:'C8A96E',cream:'EDE5D8',light:'F5F0E8',
    red:'731E2E',green:'1A7A4A',greenBg:'E8F5E9',blue:'1565C0',blueBg:'E3F2FD',
    orange:'E65100',orangeBg:'FFF3E0',white:'FFFFFF',line:'E0D8CC'};
  const fill=c=>({patternType:'solid',fgColor:{rgb:c}});
  const font=(bold,sz,color,italic)=>({bold:!!bold,sz:sz||11,color:{rgb:color||C.dark},italic:!!italic,name:'Arial'});
  const aln=(h,v,wrap)=>({horizontal:h||'right',vertical:v||'center',wrapText:!!wrap,readingOrder:2});
  const brd=(s,c)=>{const b={style:s||'thin',color:{rgb:c||C.line}};return{left:b,right:b,top:b,bottom:b};};
  const now = new Date().toLocaleDateString('en-GB');
  const wb = XLSX.utils.book_new();

  // جيب كل البنود دفعة واحدة
  const ids = _sppPlans.map(p=>p.id).join(',');
  let allItems = [];
  try{
    const iRes = await fetch(`${SUPABASE_URL}/rest/v1/sales_plan_items?plan_id=in.(${ids})&select=*&order=visit_date.asc&limit=5000`,
      {headers:{'apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`}});
    allItems = iRes.ok ? await iRes.json().catch(()=>[]) : [];
  }catch(e){}

  // ── Sheet 1: ملخص الخطط ───────────────────────────────────────
  const SUMCOLS = ['#','المشرف','القطاع','الأسبوع من','الأسبوع إلى','الهدف (ج)','المحقق (ج)','زيارات مخططة','زيارات فعلية','الحالة','ملاحظات'];
  const aoa=[
    ['الطحان جولدن دايتس — Al Tahhan Golden Dates',...Array(SUMCOLS.length-1).fill('')],
    ['خطط مبيعات بلس — ملخص أسبوعي',...Array(SUMCOLS.length-1).fill('')],
    [`تاريخ التصدير: ${now}  |  إجمالي الخطط: ${_sppPlans.length}`,...Array(SUMCOLS.length-1).fill('')],
    Array(SUMCOLS.length).fill(''),
    SUMCOLS,
    ..._sppPlans.map((p,i)=>[
      i+1, p.staff_name, p.sector||'—', p.week_start, p.week_end,
      +p.target_amount||0, +p.achieved_amount||0,
      +p.target_visits||0, +p.actual_visits||0,
      SPP_STATUS[p.status]?.label||p.status, p.notes||''
    ]),
    Array(SUMCOLS.length).fill(''),
    ['الإجمالي','','','','',
      _sppPlans.reduce((s,p)=>s+(+p.target_amount||0),0),
      _sppPlans.reduce((s,p)=>s+(+p.achieved_amount||0),0),
      _sppPlans.reduce((s,p)=>s+(+p.target_visits||0),0),
      _sppPlans.reduce((s,p)=>s+(+p.actual_visits||0),0),'','']
  ];

  const ws=XLSX.utils.aoa_to_sheet(aoa,{cellStyles:true});
  const nc=SUMCOLS.length;
  const enc=(r,c)=>XLSX.utils.encode_cell({r,c});
  const sty=(r,c,s)=>{if(!ws[enc(r,c)])ws[enc(r,c)]={t:'z',v:''};ws[enc(r,c)].s=s;};

  ws['!merges']=[{s:{r:0,c:0},e:{r:0,c:nc-1}},{s:{r:1,c:0},e:{r:1,c:nc-1}},{s:{r:2,c:0},e:{r:2,c:nc-1}},{s:{r:3,c:0},e:{r:3,c:nc-1}}];
  sty(0,0,{font:font(1,15,C.cream),fill:fill(C.dark),alignment:aln('center'),border:brd('medium',C.dark)});
  sty(1,0,{font:font(1,13,C.dark),fill:fill(C.gold),alignment:aln('center'),border:brd('medium',C.caramel)});
  sty(2,0,{font:font(0,10,C.caramel,true),fill:fill(C.light),alignment:aln('center'),border:brd('thin',C.line)});
  for(let c=0;c<nc;c++) sty(3,c,{fill:fill(C.dark)});
  for(let c=0;c<nc;c++) sty(4,c,{font:font(1,10,C.cream),fill:fill(C.caramel),alignment:aln('center'),border:brd('medium',C.dark)});

  const dataStart=5;
  for(let ri=dataStart;ri<aoa.length-2;ri++){
    const p=_sppPlans[ri-dataStart];
    const rowBg=ri%2?'FAF7F0':C.white;
    for(let c=0;c<nc;c++){
      let s={font:font(0,9,C.dark),fill:fill(rowBg),alignment:aln(c===0?'center':'right',undefined,true),border:brd('thin',C.line)};
      if(c===5) s={...s,font:font(1,10,C.blue)};
      if(c===6) s={...s,font:font(1,10,C.green)};
      if(c===9 && p){
        const st=SPP_STATUS[p.status];
        if(st) s={...s,font:font(1,9,p.status==='approved'?C.green:p.status==='rejected'?C.red:C.orange)};
      }
      sty(ri,c,s);
    }
  }
  // footer total
  const lastR=aoa.length-1;
  for(let c=0;c<nc;c++) sty(lastR,c,{font:font(1,10,C.cream),fill:fill(C.caramel),alignment:aln('center'),border:brd('medium',C.dark)});

  ws['!cols']=[{wch:4},{wch:20},{wch:16},{wch:12},{wch:12},{wch:14},{wch:14},{wch:12},{wch:12},{wch:16},{wch:20}];
  ws['!rows']=[{hpt:36},{hpt:28},{hpt:20},{hpt:8},{hpt:26}];
  XLSX.utils.book_append_sheet(wb,ws,'ملخص الخطط');

  // ── Sheet لكل مشرف ────────────────────────────────────────────
  const byStaff = {};
  _sppPlans.forEach(p=>{ if(!byStaff[p.staff_name]) byStaff[p.staff_name]=[]; byStaff[p.staff_name].push(p); });

  for(const [staffName, staffPlans] of Object.entries(byStaff)){
    const ICOLS=['اليوم','التاريخ','العميل','المنطقة','النوع','المندوب','مخطط (ج)','فعلي (ج)','الحالة','الغرض','ملاحظات'];
    const saoa=[
      ['الطحان جولدن دايتس',...Array(ICOLS.length-1).fill('')],
      [staffName,...Array(ICOLS.length-1).fill('')],
      Array(ICOLS.length).fill(''),
      ICOLS
    ];
    const DAYS_AR=['الأحد','الاثنين','الثلاثاء','الأربعاء','الخميس','الجمعة','السبت'];
    staffPlans.forEach(plan=>{
      saoa.push([`📅 الأسبوع: ${plan.week_start} ← ${plan.week_end}  |  الهدف: ${(+plan.target_amount||0).toLocaleString()} ج`,...Array(ICOLS.length-1).fill('')]);
      const planItems=allItems.filter(i=>i.plan_id===plan.id);
      if(planItems.length){
        planItems.forEach(it=>{
          const d=new Date((it.visit_date||'')+'T00:00:00');
          const dayName=isNaN(d)?'—':DAYS_AR[d.getDay()];
          saoa.push([dayName,it.visit_date||'—',it.client_name||'—',it.area||'—',it.client_type||'—',it.rep_name||'—',+it.planned_amount||0,+it.actual_amount||0,SPP_STATUS[it.visit_status]?.label||it.visit_status||'مخطط',it.purpose||'—',it.notes||'']);
        });
      } else {
        saoa.push(['لا توجد بنود','','','','','','','','','','']);
      }
    });

    const sw=XLSX.utils.aoa_to_sheet(saoa,{cellStyles:true});
    const se=(r,c)=>XLSX.utils.encode_cell({r,c});
    const ss=(r,c,s)=>{if(!sw[se(r,c)])sw[se(r,c)]={t:'z',v:''};sw[se(r,c)].s=s;};
    sw['!merges']=[{s:{r:0,c:0},e:{r:0,c:ICOLS.length-1}},{s:{r:1,c:0},e:{r:1,c:ICOLS.length-1}},{s:{r:2,c:0},e:{r:2,c:ICOLS.length-1}}];
    ss(0,0,{font:font(1,13,C.cream),fill:fill(C.dark),alignment:aln('center'),border:brd('medium',C.dark)});
    ss(1,0,{font:font(1,12,C.dark),fill:fill(C.gold),alignment:aln('center'),border:brd('medium',C.caramel)});
    for(let c=0;c<ICOLS.length;c++) ss(2,c,{fill:fill(C.dark)});
    for(let c=0;c<ICOLS.length;c++) ss(3,c,{font:font(1,10,C.cream),fill:fill(C.caramel),alignment:aln('center'),border:brd('medium',C.dark)});
    for(let ri=4;ri<saoa.length;ri++){
      const isWeekHdr=typeof saoa[ri][0]==='string'&&saoa[ri][0].includes('📅');
      if(isWeekHdr){
        sw['!merges'].push({s:{r:ri,c:0},e:{r:ri,c:ICOLS.length-1}});
        ss(ri,0,{font:font(1,10,'4B3C1A'),fill:fill('EDE5D8'),alignment:aln('right'),border:brd('thin',C.line)});
      } else {
        for(let c=0;c<ICOLS.length;c++){
          let s={font:font(0,9,C.dark),fill:fill(ri%2?'FAF7F0':C.white),alignment:aln(c===0?'center':'right',undefined,true),border:brd('thin',C.line)};
          if(c===6) s={...s,font:font(1,9,C.blue)};
          if(c===7) s={...s,font:font(1,9,C.green)};
          ss(ri,c,s);
        }
      }
    }
    sw['!cols']=[{wch:10},{wch:12},{wch:24},{wch:16},{wch:10},{wch:16},{wch:12},{wch:12},{wch:14},{wch:14},{wch:18}];
    sw['!rows']=[{hpt:36},{hpt:28},{hpt:8},{hpt:26}];
    const sheetName=staffName.slice(0,28);
    XLSX.utils.book_append_sheet(wb,sw,sheetName);
  }

  XLSX.writeFile(wb, `خطط_مبيعات_بلس_${localISO()}.xlsx`);
  showToast('✅ تم تصدير Excel بألوان الطحان');
}

