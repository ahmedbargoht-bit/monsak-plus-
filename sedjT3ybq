    splSpecialRenderBranchList(pl.branches||[]);
  } else {
    const pl=_splClientLists.find(p=>p.id===id); if(!pl) return;
    document.getElementById('spl-sp-edit-id').value=pl.id;
    document.getElementById('spl-sp-name').value=pl.name;
    document.getElementById('spl-modal-title').textContent='تعديل: '+pl.name;
