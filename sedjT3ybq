// REPS العادي فيه النشطين بس (كده باقي شاشات لوحة التحكم اللي بتستخدم REPS —
// الداشبورد والتصدير وربط الخطوط... إلخ — تفضل شغالة زي ما هي بدون أي تغيير).
// عشان تاب "إدارة المنسقين" يقدر يعرض المعطّلين كمان لما المستخدم يطلب، بنعمل
// كاش منفصل بيجيب كل المنسقين (نشط وغير نشط) مرة واحدة بس عند الحاجة.
let _allRepsCache = null;
async function _loadAllRepsCache(){
  if(_allRepsCache) return _allRepsCache;
  try{
    const data = await sb('users', {role:'rep'}, {limit:1000});
    _allRepsCache = (Array.isArray(data)?data:[]).map(u=>({
      name:u.name, route:u.route||'', group:u.grp||'', type:u.user_type||'متحرك',
      pass:u.pass_hash||'', goal:u.goal||0, status:u.status||'active', id:u.id, day_off:u.day_off||'none',
      emp_code:u.emp_code||'', fixed_branch:u.fixed_branch||'', supervisors:u.supervisors||''
    }));
  }catch(e){ _allRepsCache = [...REPS]; }
  return _allRepsCache;
}

async function loadUsers(){
  const grp=document.getElementById('usr-group')?.value||'all';
  const type=document.getElementById('usr-type')?.value||'all';
  const status=document.getElementById('usr-status')?.value||'active';
  const search=(document.getElementById('usr-search')?.value||'').toLowerCase();

  // "نشط" (الافتراضي) = نفس REPS القديم بدون أي تغيير — أي فلتر تاني (غير نشط/الكل) يجيب من الكاش الشامل
  let source;
  if(status==='active'){
    source = REPS;
  } else {
    source = await _loadAllRepsCache();
    if(status==='inactive') source = source.filter(r=>(r.status||'active')==='inactive');
  }

  // الأدمين (gm) يشوف كل المنسقين بدون فلتر
  let data = CU.level==='gm' ? [...source] : source.filter(r=>CU.groups.includes(r.group));
  if(grp!=='all') data=data.filter(r=>r.group===grp);
  if(type!=='all') data=data.filter(r=>r.type===type);
  if(search) data=data.filter(r=>r.name.toLowerCase().includes(search) || (r.route||'').toLowerCase().includes(search));

  const {visits}=cachedData;
  const scores={},vc={};
  visits.forEach(v=>{scores[v.name]=(scores[v.name]||0)+(+v.points||0);vc[v.name]=(vc[v.name]||0)+1;});

  document.getElementById('users-table').innerHTML=data.map((r,i)=>`<tr${r.status==='inactive'?' style="opacity:.6"':''}>
    <td>${i+1}</td>
    <td><b>${r.name}</b>${r.status==='inactive'?' <span class="badge b-gray" style="font-size:10px">غير نشط</span>':''}</td>
    <td style="font-size:11px">${r.route}</td>
    <td><span class="badge" style="background:${GROUPS[r.group]?.color||'#ccc'}22;color:${GROUPS[r.group]?.color||'#555'}">${GROUPS[r.group]?.label||r.group}</span></td>
    <td><span class="badge ${r.type==='ثابت'?'b-purple':'b-blue'}">${r.type}</span></td>
    <td><code style="background:#f5f5f5;padding:2px 6px;border-radius:4px;font-size:11px">${r.pass}</code></td>
    <td><span class="badge b-green">${scores[r.name]||0}</span></td>
    <td>${vc[r.name]||0}</td>
    <td>
      <button class="btn btn-ghost btn-xs" onclick="openEditUser(${JSON.stringify(r).replace(/"/g,'&quot;')})"><i class="ti ti-edit"></i></button>
    </td>
  </tr>`).join('')||'<tr><td colspan="9" style="text-align:center;padding:1rem;color:var(--text2)">لا توجد بيانات</td></tr>';
}

// ── خطوط السير حسب المجموعة ─────────────────────────────────
let _routesCache = {}; // grp → [routeNames]

async function _fetchRoutesForGrp(grp){
  if(_routesCache[grp]) return _routesCache[grp];
  try{
    const H = {'apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`};
    const res = await fetch(`${SUPABASE_URL}/rest/v1/routes?select=name&grp=eq.${encodeURIComponent(grp)}&order=name.asc`,{headers:H});
    const data = res.ok ? await res.json() : [];
    _routesCache[grp] = data.map(r=>r.name);
  }catch(e){ _routesCache[grp]=[]; }
  return _routesCache[grp];
}

function _fillRouteSelect(selectId, routes, currentVal){
  const sel = document.getElementById(selectId);
  if(!sel) return;
  sel.innerHTML = '<option value="">— اختر خط السير —</option>';
  routes.forEach(rt=>{
    const opt = document.createElement('option');
    opt.value = rt;
    opt.textContent = rt;
    if(rt === currentVal) opt.selected = true;
    sel.appendChild(opt);
  });
}

// حقل "خط السير" بيتخفي في نموذج الإضافة/التعديل لما النوع يكون "ثابت"/"ثابت كبار عملاء"
// (لأن التخصيص الفعلي بيتم عن طريق الفرع الثابت / coord_route_assignments)، لكن عمود
// "خط السير" في جدول إدارة المنسقين لسه بيعرض users.route مباشرة — فلو سبناه فاضي هيفضل
// فاضي في الجدول للأبد. الدالة دي بتلاقي خط سير "ثابت.." موجود فعلاً لنفس المجموعة ولو
// مفيش، بتبني اسم افتراضي معقول بدل ما يتسجل فاضي.
async function resolveFixedRouteLabel(grp, type, grpLabelFallback){
  const routes = await _fetchRoutesForGrp(grp);
  const match = routes.find(r=>r.startsWith(type));
  if(match) return match;
  return `${type} - ${grpLabelFallback||grp}`;
}

async function nuLoadRoutes(){
  const grp = document.getElementById('nu-group').value;
  const routes = await _fetchRoutesForGrp(grp);
  _fillRouteSelect('nu-route', routes, '');
}

async function euLoadRoutes(keepVal){
  const grp = document.getElementById('eu-group').value;
  const routes = await _fetchRoutesForGrp(grp);
  _fillRouteSelect('eu-route', routes, keepVal||'');
}

// ── فروع المنسق الثابت / ثابت كبار عملاء حسب المجموعة ─────────
let _fixedBranchesCache = {}; // grp → [branchNames]

async function _fetchBranchesForGrp(grp){
  if(_fixedBranchesCache[grp]) return _fixedBranchesCache[grp];
  try{
    const H = {'apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`};
    const res = await fetch(`${SUPABASE_URL}/rest/v1/branches?select=branch_name&grp=eq.${encodeURIComponent(grp)}&status=eq.active&order=branch_name.asc&limit=1000`,{headers:H});
    const data = res.ok ? await res.json() : [];
    _fixedBranchesCache[grp] = [...new Set(data.map(b=>b.branch_name).filter(Boolean))];
  }catch(e){ _fixedBranchesCache[grp]=[]; }
  return _fixedBranchesCache[grp];
}

function _fillBranchSelect(selectId, branches, currentVal){
  const sel = document.getElementById(selectId);
  if(!sel) return;
  sel.innerHTML = '<option value="">— اختر الفرع —</option>';
  branches.forEach(b=>{
    const opt = document.createElement('option');
    opt.value = b; opt.textContent = b;
    if(b === currentVal) opt.selected = true;
    sel.appendChild(opt);
  });
  // لو الفرع المحفوظ مش موجود في قايمة فروع المجموعة الحالية، ضيفه يدوياً عشان ميتفقدش
  if(currentVal && !branches.includes(currentVal)){
    const opt = document.createElement('option');
    opt.value = currentVal; opt.textContent = currentVal+' (محفوظ)'; opt.selected = true;
    sel.appendChild(opt);
  }
}

function euIsFixedType(){
  const t = document.getElementById('eu-type')?.value||'';
  return t==='ثابت' || t==='ثابت كبار عملاء';
}
async function euOnTypeChange(keepVal){
  const wrapRoute    = document.getElementById('eu-route-wrap');
  const wrapBranch   = document.getElementById('eu-fixed-branch-wrap');
  const wrapRouteBrs = document.getElementById('eu-route-branches-wrap');
  if(euIsFixedType()){
    if(wrapRoute)    wrapRoute.style.display='none';
    if(wrapRouteBrs) wrapRouteBrs.style.display='none';
    if(wrapBranch)   wrapBranch.style.display='';
    euLoadFixedBranches(keepVal);
  } else {
    if(wrapRoute)  wrapRoute.style.display='';
    if(wrapBranch) wrapBranch.style.display='none';
    const routeVal = document.getElementById('eu-route')?.value||'';
