  const err=document.getElementById('qb-err');
  ok.style.display='none'; err.style.display='none';

  if(!repName){err.textContent='اختر المنسق أولاً';err.style.display='block';return;}
  if(!brId){err.textContent='اختر فرع من القائمة';err.style.display='block';return;}

  // جيب بيانات الفرع وشوف rep_name الفاضية
  const H={'apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`};
  const [brData]=await fetch(
    `${SUPABASE_URL}/rest/v1/branches?select=id,rep_name,rep_name2,rep_name3&id=eq.${brId}`,
    {headers:H}).then(r=>r.ok?r.json():[]).catch(()=>[]);

  if(!brData){err.textContent='تعذر جلب بيانات الفرع';err.style.display='block';return;}

  // ضع الاسم في أول حقل فاضي
  let field=null;
  if(!brData.rep_name) field='rep_name';
  else if(!brData.rep_name2) field='rep_name2';
  else if(!brData.rep_name3) field='rep_name3';
  else {err.textContent='الفرع ممتلئ (3 منسقين مسجلين)';err.style.display='block';return;}

  const res=await fetch(`${SUPABASE_URL}/rest/v1/branches?id=eq.${brId}`,{
    method:'PATCH',
    headers:{...H,'Content-Type':'application/json','Prefer':'return=minimal'},
    body:JSON.stringify({[field]:repName})
  });

  if(res.ok){
    ok.textContent=`✅ تم تعيين "${brName}" للمنسق`;
    ok.style.display='block';
    await qbOnRepChange();
    loadBranches(); // تحديث جدول الفروع
  } else {
    err.textContent='خطأ في التعيين';err.style.display='block';
  }
}

async function qbRemoveBranch(brId, brName, repName){
  if(!confirm(`إزالة "${brName}" من المنسق "${repName}"؟`)) return;
  const H={'apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`};

  // جيب بيانات الفرع
  const [brData]=await fetch(
    `${SUPABASE_URL}/rest/v1/branches?select=id,rep_name,rep_name2,rep_name3&id=eq.${brId}`,
    {headers:H}).then(r=>r.ok?r.json():[]).catch(()=>[]);
  if(!brData) return;

  // امسح الاسم من الحقل المناسب
  const patch={};
  if(brData.rep_name===repName)  patch.rep_name=null;
  if(brData.rep_name2===repName) patch.rep_name2=null;
  if(brData.rep_name3===repName) patch.rep_name3=null;
  if(!Object.keys(patch).length) return;

  const res=await fetch(`${SUPABASE_URL}/rest/v1/branches?id=eq.${brId}`,{
    method:'PATCH',
    headers:{...H,'Content-Type':'application/json','Prefer':'return=minimal'},
    body:JSON.stringify(patch)
  });

  if(res.ok){
    showToast(`🗑️ تم إزالة "${brName}" من المنسق`);
    await qbOnRepChange();
    loadBranches();
  } else {
    showToast('❌ خطأ في الإزالة');
  }
}

