// كاش خطوط السير مع grp بتاعتها
let _ebRoutesCache = null;
async function ebLoadRoutes(){
  if(_ebRoutesCache) return _ebRoutesCache;
  try{
    const res = await fetch(`${SUPABASE_URL}/rest/v1/routes?select=name,grp&order=name.asc`,{
      headers:{'apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`}
    });
    if(res.ok){ _ebRoutesCache = await res.json(); return _ebRoutesCache; }
  }catch(e){}
  return [];
}

// لما يتغير خط السير — أوتو فيل المجموعة
function ebOnRouteChange(){
  const routeSel = document.getElementById('eb-route');
  const grpSel   = document.getElementById('eb-group');
  const selectedRoute = (_ebRoutesCache||[]).find(r=>r.name===routeSel.value);
  if(selectedRoute?.grp) grpSel.value = selectedRoute.grp;
}

async function openEditBranch(b){
  document.getElementById('eb-id').value       = b.id||'';
  document.getElementById('eb-old-name').value = b.branch_name||'';
  document.getElementById('eb-name').value     = b.branch_name||'';
  document.getElementById('eb-ok').style.display='none';

  // تحميل المجموعات من Supabase (يشمل private_cairo و private_alex)
  await loadGroupsDropdowns();

  // تحميل خطوط السير من Supabase وتعبية القايمة
  const routeSel = document.getElementById('eb-route');
  routeSel.innerHTML = '<option value="">جاري التحميل...</option>';
  const routes = await ebLoadRoutes();
  routeSel.innerHTML = '<option value="">— اختر خط السير —</option>';
  routes.forEach(r=>{
    const o=document.createElement('option');
    o.value=r.name; o.textContent=r.name;
    if(r.name===b.route) o.selected=true;
    routeSel.appendChild(o);
  });
  // لو الخط الحالي مش في القايمة — أضفه كـ option مؤقت
  if(b.route && !routes.find(r=>r.name===b.route)){
    const o=document.createElement('option');
    o.value=b.route; o.textContent=b.route+' ⚠️ (غير مسجل)'; o.selected=true;
    routeSel.insertBefore(o, routeSel.children[1]);
  }

  // المجموعة — أوتو من route أو من بيانات الفرع
  const grpSel = document.getElementById('eb-group');
  const grpVal = b.grp || routes.find(r=>r.name===b.route)?.grp || 'giza';
  if([...grpSel.options].some(o=>o.value===grpVal)) grpSel.value = grpVal;
  else grpSel.selectedIndex = 0;

  // صنف العميل
  const typeSel = document.getElementById('eb-type');
  const typeMap = {'كبير':'A','متوسط':'B','صغير':'C','A':'A','B':'B','C':'C'};
  typeSel.value = typeMap[b.client_type] || 'B';

  // الحالة
  const statusSel = document.getElementById('eb-status');
  const statusMap = {'نشط':'active','متوقف':'suspended','مغلق':'closed','active':'active','suspended':'suspended','closed':'closed'};
  statusSel.value = statusMap[b.status] || 'active';

  openModal('modal-edit-branch');
}

async function saveBranchEdit(){
  const id      = document.getElementById('eb-id').value;
  const oldName = document.getElementById('eb-old-name').value;
  const name    = document.getElementById('eb-name').value.trim();
  const route   = document.getElementById('eb-route').value;
  const grp     = document.getElementById('eb-group').value;
  const type    = document.getElementById('eb-type').value;
  const status  = document.getElementById('eb-status').value;
  const ok      = document.getElementById('eb-ok');

  if(!name||!route){alert('أدخل اسم الفرع وخط السير');return;}

  const headers = {'Content-Type':'application/json','apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`,'Prefer':'return=minimal'};
  const filter  = id ? `id=eq.${id}` : `branch_name=eq.${encodeURIComponent(oldName)}`;

  // 1. تحديث branches
  const res = await fetch(`${SUPABASE_URL}/rest/v1/branches?${filter}`,{
    method:'PATCH', headers,
    body:JSON.stringify({branch_name:name, route, grp, client_type:type, status})
  });

  if(!res.ok){
    const errText = await res.text().catch(()=>'');
    alert(`فشل الحفظ (${res.status})\n${errText.slice(0,200)}`);
    return;
  }

  // 2. Cascade — تحديث كل الجداول اللي فيها اسم الفرع (لو الاسم أو الخط اتغير)
  if(oldName && (oldName!==name || true)){
    const routeFields = route ? { route, grp } : {};
    const cascadeBody = { branch:name, ...routeFields };
    const oldEnc = encodeURIComponent(oldName);
    await Promise.allSettled([
      fetch(`${SUPABASE_URL}/rest/v1/visits?branch=eq.${oldEnc}`,    {method:'PATCH',headers,body:JSON.stringify(cascadeBody)}),
      fetch(`${SUPABASE_URL}/rest/v1/products?branch=eq.${oldEnc}`,  {method:'PATCH',headers,body:JSON.stringify({branch:name,...routeFields})}),
      fetch(`${SUPABASE_URL}/rest/v1/missing?branch=eq.${oldEnc}`,   {method:'PATCH',headers,body:JSON.stringify({branch:name,...routeFields})}),
      fetch(`${SUPABASE_URL}/rest/v1/returns?branch=eq.${oldEnc}`,   {method:'PATCH',headers,body:JSON.stringify({branch:name,...routeFields})}),
      fetch(`${SUPABASE_URL}/rest/v1/location?name=eq.${oldEnc}`,    {method:'PATCH',headers,body:JSON.stringify({name,route,grp})}),
      fetch(`${SUPABASE_URL}/rest/v1/coord_route_assignments?branch_name=eq.${oldEnc}`,{method:'PATCH',headers,body:JSON.stringify({branch_name:name,...routeFields})}),
    ]);
  }

  ok.style.display='block'; ok.textContent='✅ تم الحفظ وتحديث كل الجداول';
  setTimeout(()=>{ closeModal('modal-edit-branch'); loadBranches(); rebuildBranchesMap(); _ebRoutesCache=null; },1200);
}

// إصلاح الفروع اللي عندها route غلط (مش موجود في جدول routes)
async function fixBadRoutes(){
  const btn = document.querySelector('[onclick="fixBadRoutes()"]');
  if(btn){ btn.disabled=true; btn.innerHTML='<i class="ti ti-loader"></i> جاري الفحص...'; }

  try{
    // جيب كل الخطوط الصح من routes
    const rtRes = await fetch(`${SUPABASE_URL}/rest/v1/routes?select=name,grp`,{
      headers:{'apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`}
    });
    const validRoutes = rtRes.ok ? await rtRes.json() : [];
    const validNames  = new Set(validRoutes.map(r=>r.name));
    const routeGrpMap = Object.fromEntries(validRoutes.map(r=>[r.name,r.grp]));

    // جيب كل الفروع
    const brRes = await fetch(`${SUPABASE_URL}/rest/v1/branches?select=id,branch_name,route,grp&limit=5000`,{
      headers:{'apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`}
    });
    const branches = brRes.ok ? await brRes.json() : [];

    // فلتر الفروع اللي route بتاعتها غلط
    const badBranches = branches.filter(b=>b.route && !validNames.has(b.route));

    if(!badBranches.length){
      showToast('✅ كل الفروع عندها خطوط سير صحيحة');
      return;
    }

    // عرض قايمة الفروع الغلط للمستخدم
    const badList = badBranches.map(b=>`• ${b.branch_name} (${b.route})`).join('\n');
    const confirm_ = confirm(`وجدنا ${badBranches.length} فرع بخط سير غلط:\n\n${badList.slice(0,500)}\n\nهل تريد فتح كل فرع للتصحيح اليدوي؟`);
    if(!confirm_) return;

    // افتح أول فرع غلط للتعديل
    openEditBranch(badBranches[0]);
    showToast(`⚠️ ${badBranches.length} فرع محتاج تصحيح — صحح الأول وبعدين اضغط الزرار تاني`);

  }catch(e){
    alert('حدث خطأ: '+e.message);
  }

  if(btn){ btn.disabled=false; btn.innerHTML='<i class="ti ti-tools"></i> إصلاح خطوط السير الغلط'; }
}

async function deleteBranchConfirm(id, name){
  // مودال تأكيد مخصص
  const overlay = document.createElement('div');
  overlay.style.cssText='position:fixed;inset:0;background:rgba(0,0,0,.6);backdrop-filter:blur(4px);z-index:9999;display:flex;align-items:center;justify-content:center';
  overlay.innerHTML=`
    <div style="background:#FFFDF8;border-radius:16px;padding:28px;width:360px;box-shadow:0 8px 32px rgba(75,60,26,.3);border:1px solid #E8D9C0;text-align:center">
      <div style="font-size:40px;margin-bottom:12px">🗑️</div>
      <h3 style="font-size:15px;font-weight:700;color:#2C1F0A;margin-bottom:8px">حذف الفرع</h3>
      <p style="font-size:13px;color:#8B6F47;margin-bottom:6px">هل أنت متأكد من حذف:</p>
      <p style="font-size:14px;font-weight:700;color:#731E2E;margin-bottom:20px;padding:8px 16px;background:#FFEBEE;border-radius:8px">${name}</p>
      <p style="font-size:11px;color:#B71C1C;margin-bottom:20px">⚠️ لن يظهر هذا الفرع للمنسقين بعد الحذف ولا يمكن التراجع</p>
      <div style="display:flex;gap:10px;justify-content:center">
        <button id="del-confirm-yes" style="padding:10px 24px;background:linear-gradient(135deg,#731E2E,#5A1520);color:#fff;border:none;border-radius:8px;font-size:13px;font-weight:700;cursor:pointer;font-family:Cairo,sans-serif">
          <i class="ti ti-trash"></i> نعم، احذف
        </button>
        <button id="del-confirm-no" style="padding:10px 24px;background:#F5F0E8;color:#4B3C1A;border:1.5px solid #D4C4A8;border-radius:8px;font-size:13px;font-weight:600;cursor:pointer;font-family:Cairo,sans-serif">
          إلغاء
        </button>
      </div>
    </div>`;
  document.body.appendChild(overlay);

  await new Promise(resolve=>{
    document.getElementById('del-confirm-yes').onclick=()=>{ overlay.remove(); resolve(true); };
    document.getElementById('del-confirm-no').onclick=()=>{ overlay.remove(); resolve(false); };
    overlay.onclick=(e)=>{ if(e.target===overlay){ overlay.remove(); resolve(false); } };
  }).then(async confirmed=>{
    if(!confirmed) return;
    const filter = id ? `id=eq.${id}` : `branch_name=eq.${encodeURIComponent(name)}`;
    await fetch(`${SUPABASE_URL}/rest/v1/branches?${filter}`,{
      method:'DELETE',
      headers:{'apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`}
    });
    showToast('🗑️ تم حذف الفرع: '+name);
    loadBranches();
    rebuildBranchesMap();
  });
}

async function changeBranchStatus(id, newStatus, branchName){
  const statusText = newStatus==='active'?'نشط':newStatus==='suspended'?'متوقف':'مغلق';
  if(!confirm(`هل تريد تغيير حالة "${branchName}" إلى ${statusText}؟`)){
    loadBranches();
    return;
  }
  // استخدم branch_name بدل id عشان ضمان
  const res = await fetch(`${SUPABASE_URL}/rest/v1/branches?branch_name=eq.${encodeURIComponent(branchName)}`,{
    method:'PATCH',
    headers:{'Content-Type':'application/json','apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`,'Prefer':'return=minimal'},
    body: JSON.stringify({status:newStatus})
  });
  if(res.ok){
    await new Promise(r=>setTimeout(r,500));
    await loadBranches();
    rebuildBranchesMap();
  } else {
    const err = await res.text();
    alert('فشل: '+res.status+' — '+err);
    loadBranches();
  }
}

async function rebuildBranchesMap(){
  try{
    const all = await sb('branches',{status:'active'},{limit:2000});
    const map = {};
    (all||[]).forEach(b=>{ if(!map[b.route]) map[b.route]=[]; map[b.route].push(b.branch_name); });
    await sbUpsert('products_db',{key:'branches_map',value:JSON.stringify(map),updated_at:new Date().toISOString()},'key');
  }catch(e){ console.warn('rebuildBranchesMap failed',e); }
}

