// ── Drag & Drop ──
let _dragId = null;
function navDragStart(e, id){ _dragId=id; e.dataTransfer.effectAllowed='move'; }
function navDragOver(e){ e.preventDefault(); e.currentTarget.style.background='#FFF0EE'; e.currentTarget.style.borderColor='#C55B48'; }
function navDragLeave(e){ e.currentTarget.style.background=''; e.currentTarget.style.borderColor=''; }
function navDrop(e, targetId){
  e.preventDefault();
  e.currentTarget.style.background='';
  e.currentTarget.style.borderColor='';
  if(!_dragId || _dragId===targetId) return;
  const fromIdx = navOrder.findIndex(n=>n.id===_dragId);
  const toIdx   = navOrder.findIndex(n=>n.id===targetId);
  if(fromIdx===-1||toIdx===-1) return;
  const [moved] = navOrder.splice(fromIdx,1);
  navOrder.splice(toIdx,0,moved);
  renderNavReorderList();
}

// ── أعلى/أسفل ──
function navMoveUp(i){
  if(i===0) return;
  [navOrder[i-1],navOrder[i]]=[navOrder[i],navOrder[i-1]];
  renderNavReorderList();
}
function navMoveDown(i){
  if(i>=navOrder.length-1) return;
  [navOrder[i],navOrder[i+1]]=[navOrder[i+1],navOrder[i]];
  renderNavReorderList();
}

// ── إخفاء/إظهار ──
function navToggleVisible(id){
  const item = navOrder.find(n=>n.id===id);
  if(item) item.visible=!item.visible;
  renderNavReorderList();
}

// ── حذف ──
function navDeleteItem(id, label){
  confirmDelete('التاب', label, ()=>{
    navOrder = navOrder.filter(n=>n.id!==id);
    saveNavOrder();
    renderNavReorderList();
    applyNavOrder();
    showToast(`🗑️ تم حذف تاب: ${label}`);
  });
}

// ── تطبيق الترتيب على الـ nav الفعلي ──
function applyNavOrder(){
  saveNavOrder();
  const navSection = document.getElementById('nav-admin-section');
  if(!navSection) return;

  const allNavItems = navSection.querySelectorAll('.nav-item');
  const itemsMap = {};
  allNavItems.forEach(el=>{
    const match = el.getAttribute('onclick')?.match(/showPanel\('([^']+)'\)/);
    if(match) itemsMap[match[1]] = el;
  });

  // أعد ترتيب + إخفاء/إظهار
  navOrder.forEach(item=>{
    const el = itemsMap[item.id];
    if(!el) return;
    el.style.display = item.visible ? '' : 'none';
    navSection.appendChild(el); // يعيد الترتيب
  });

  showToast('✅ تم تطبيق الترتيب الجديد!');
}

// ── استعادة الافتراضي ──
function resetNavOrder(){
  if(!confirm('استعادة الترتيب الافتراضي؟')) return;
  navOrder = JSON.parse(JSON.stringify(NAV_DEFAULT));
  saveNavOrder();
  renderNavReorderList();
  applyNavOrder();
  showToast('✅ تم استعادة الترتيب الافتراضي');
}

