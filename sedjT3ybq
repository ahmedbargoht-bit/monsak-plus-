    return `<tr>
      <td>${i+1}</td>
      <td style="font-weight:700">${u.name}</td>
      <td>${typeBadges}</td>
      <td style="font-size:11px">${(Array.isArray(u.routes)&&u.routes.length?u.routes:u.route?[u.route]:[]).map(r=>`<span style="display:inline-block;background:#F3F4F6;border-radius:6px;padding:1px 6px;margin:1px;font-size:10px">${r}</span>`).join('')||'—'}</td>
      <td>${grpBadge}</td>
      <td style="font-size:11px;color:#888">${u.supervisors||'—'}</td>
