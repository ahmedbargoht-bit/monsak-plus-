// بتشيل أي فواصل ألفية أو مسافات من رقم متكتوب في حقل إدخال قبل ما نسجله في القاعدة —
// عشان "3,454,316" يتسجل "3454316" مش نص فيه فواصل (اللي كان بيمنع caIsNum من التعرف
// عليه كرقم، فيفضل الكارت فاضي حتى بعد الحفظ).
function caCleanNumStr(v){
  const s = String(v||'').trim().replace(/,/g,'').replace(/\s+/g,'');
  return s===''?null:s;
}

