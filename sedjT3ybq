async function splSaveClient(){
  const name = document.getElementById('spl-cname').value.trim();
  const type = document.getElementById('spl-ctype').value;
  const pct  = parseFloat(document.getElementById('spl-cpct').value)||0;
  const msg  = document.getElementById('spl-client-msg');
  if(!name){ msg.style.color='#B71C1C'; msg.textContent='يرجى إدخال اسم العميل'; return; }
  const H = {'Content-Type':'application/json','apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`,'Prefer':'return=minimal'};
  const existing = _splClients.find(c=>c.name===name);
  let r;
  if(existing){
    r = await fetch(`${SUPABASE_URL}/rest/v1/sales_clients?id=eq.${existing.id}`,{
      method:'PATCH', headers:H, body:JSON.stringify({discount_pct:pct, client_type:type})
    });
  } else {
    r = await fetch(`${SUPABASE_URL}/rest/v1/sales_clients`,{
      method:'POST', headers:H, body:JSON.stringify({name, discount_pct:pct, client_type:type})
    });
  }
  if(r.ok||r.status===201||r.status===204){
    msg.style.color='#065F46'; msg.textContent='✅ تم الحفظ';
    document.getElementById('spl-cname').value='';
    document.getElementById('spl-cpct').value='';
    await spLoadAll();
  } else { msg.style.color='#B71C1C'; msg.textContent='❌ خطأ: '+await r.text(); }
  setTimeout(()=>msg.textContent='',3000);
}

async function splEditClient(id, name, pct, type){
  const newNameRaw = prompt(`اسم العميل / السلسلة:`, name); if(newNameRaw===null) return;
  const newName = newNameRaw.trim();
  if(!newName){ showToast('❌ الاسم لا يمكن أن يكون فارغاً'); return; }
  const newPct = prompt(`خصم "${newName}":`, pct); if(newPct===null) return;
  const newType = confirm(`النوع الحالي: ${type}\nاضغط OK لـ "سلاسل الطحان" أو Cancel لـ "أسواق خاصة"`) ? 'سلاسل الطحان' : 'أسواق خاصة';
  const H = {'Content-Type':'application/json','apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`,'Prefer':'return=minimal'};

  await fetch(`${SUPABASE_URL}/rest/v1/sales_clients?id=eq.${id}`,{
    method:'PATCH', headers:H, body:JSON.stringify({name:newName, discount_pct:parseFloat(newPct)||0, client_type:newType})
  });

  // لو الاسم اتغيّر — لازم نحدّث كل الجداول المرتبطة بالاسم القديم عشان الربط ميتكسرش
  if(newName !== name){
    const encOld = encodeURIComponent(name);
    await Promise.all([
      fetch(`${SUPABASE_URL}/rest/v1/branch_client_map?client_name=eq.${encOld}`,{
        method:'PATCH', headers:H, body:JSON.stringify({client_name:newName})
      }),
      fetch(`${SUPABASE_URL}/rest/v1/client_category_discounts?client_name=eq.${encOld}`,{
        method:'PATCH', headers:H, body:JSON.stringify({client_name:newName})
      }),
      fetch(`${SUPABASE_URL}/rest/v1/sales_promotions?client_name=eq.${encOld}`,{
        method:'PATCH', headers:H, body:JSON.stringify({client_name:newName})
      }),
    ]);
  }

  showToast('✅ تم التحديث'); await spLoadAll();
}

async function splDeleteClient(id, name){
  if(!confirm(`حذف العميل "${name}" وكل فروعه المربوطة؟`)) return;
  const H = {'Content-Type':'application/json','apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`,'Prefer':'return=minimal'};
  await fetch(`${SUPABASE_URL}/rest/v1/branch_client_map?client_name=eq.${encodeURIComponent(name)}`,{method:'DELETE',headers:H});
  // حذف ناعم — بيعلّم العميل كمحذوف بدل ما يمسحه فعلياً من القاعدة
  await fetch(`${SUPABASE_URL}/rest/v1/sales_clients?id=eq.${id}`,{method:'PATCH',headers:H,body:JSON.stringify({deleted_at:new Date().toISOString()})});
  showToast('✅ تم الحذف'); await spLoadAll();
}

function splOnMapClientChange(){
  const client = document.getElementById('spl-map-client').value;
  const wrap   = document.getElementById('spl-map-branch-wrap');
  const cbs    = document.getElementById('spl-map-branch-cbs');
  if(!client){ wrap.style.display='none'; return; }

  const mapped = new Set(_splBranchMap.map(m=>m.branch_name));
  // الفروع الغير مربوطة بأي عميل خالص
  const available = _splBranches.filter(b=>!mapped.has(b.branch_name));

  cbs.innerHTML = available.map(b=>`
    <label style="display:flex;align-items:center;gap:5px;background:#fff;border:1px solid #ddd;border-radius:16px;padding:3px 10px;cursor:pointer;font-size:11px;white-space:nowrap">
      <input type="checkbox" class="spl-branch-cb" value="${b.branch_name}"/>
      ${b.branch_name}
    </label>`).join('');

  cbs.querySelectorAll('input').forEach(cb=>{
    cb.addEventListener('change', splUpdateSelectedCount);
  });

  wrap.style.display = available.length ? '' : 'none';
  if(!available.length){
    document.getElementById('spl-map-msg').style.color='#888';
    document.getElementById('spl-map-msg').textContent = 'كل الفروع مربوطة بعملاء';
  }
  splUpdateSelectedCount();
}

function splFilterBranchCbs(){
