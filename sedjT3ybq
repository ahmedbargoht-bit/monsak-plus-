async function executeReset(){
  const pass        = document.getElementById('reset-pass').value;
  const confirmText = document.getElementById('reset-confirm-text').value.trim();
  const fromDate     = document.getElementById('reset-from')?.value||'';
  const toDate       = document.getElementById('reset-to')?.value||'';
  const btn         = document.getElementById('reset-btn');
  const msg         = document.getElementById('reset-msg');
  const progress    = document.getElementById('reset-progress');
  const progressBar = document.getElementById('reset-progress-bar');
  const progressLbl = document.getElementById('reset-progress-label');

  // ✅ الفترة الزمنية بقت إجبارية — بنمنع أي حذف كامل بالغلط لجدول من غير تحديد فترة
  if(!fromDate || !toDate){
    msg.style.display='block'; msg.style.color='#C0392B';
    msg.textContent='❌ حدد "من تاريخ" و"إلى تاريخ" قبل التنفيذ — الحذف بقى مربوط بفترة إجبارياً'; return;
  }
  if(fromDate > toDate){
    msg.style.display='block'; msg.style.color='#C0392B';
    msg.textContent='❌ "من تاريخ" لازم يكون قبل أو يساوي "إلى تاريخ"'; return;
  }

  // تحقق من الباسورد بنفس منطق doAdminLogin
  let adminPass = localStorage.getItem('admin_pass_override') || ADMIN_PASS;
  try{
    const d = await sb('users',{name:'admin',role:'admin'});
    if(d && d[0]) adminPass = d[0].pass_hash || adminPass;
  }catch(e){}

  if(pass !== adminPass){
    msg.style.display='block'; msg.style.color='#C0392B';
    msg.textContent='❌ كلمة المرور غلط'; return;
  }
  if(confirmText !== 'تأكيد الحذف'){
    msg.style.display='block'; msg.style.color='#C0392B';
    msg.textContent='❌ اكتب "تأكيد الحذف" بالضبط'; return;
  }

  const selected = [...document.querySelectorAll('.reset-cb:checked')].map(cb=>cb.value);
  if(!selected.length){
    msg.style.display='block'; msg.style.color='#C0392B';
    msg.textContent='❌ اختر جدولاً واحداً على الأقل'; return;
  }
  if(!confirm(`سيتم حذف بيانات ${selected.length} جدول من ${fromDate} إلى ${toDate} نهائياً. هل أنت متأكد؟`)) return;

  btn.disabled=true; btn.innerHTML='<i class="ti ti-loader"></i> جاري الحذف...';
  progress.style.display='block'; msg.style.display='none';
  progressBar.style.width='30%'; progressLbl.textContent='جاري الاتصال بالخادم...';

  try{
    // استدعاء دالة reset_tables_by_date عبر Supabase RPC — بتحذف بس السجلات في الفترة
    // المحددة (created_at أو updated_at حسب الجدول)، مش الجدول كله
    const res = await fetch(`${SUPABASE_URL}/rest/v1/rpc/reset_tables_by_date`,{
      method:'POST',
      headers:{
        'Content-Type':'application/json',
        'apikey':SUPABASE_KEY,
        'Authorization':`Bearer ${SUPABASE_KEY}`
      },
      body: JSON.stringify({table_names: selected, from_date: fromDate, to_date: toDate})
    });

    progressBar.style.width='80%'; progressLbl.textContent='جاري المعالجة...';
    const result = await res.json();

    progressBar.style.width='100%'; progressLbl.textContent='اكتمل ✅';
    msg.style.display='block';

    if(res.ok && result?.success){
      const counts = result.deleted||{};
      const total  = Object.values(counts).reduce((s,v)=>s+(+v||0),0);
      msg.style.color='#1A7A4A';
      msg.textContent=`✅ تم حذف ${total.toLocaleString('en-US')} سجل من ${selected.length} جدول (${fromDate} → ${toDate})`;
      document.getElementById('reset-pass').value='';
      document.getElementById('reset-confirm-text').value='';
      setTimeout(loadResetStats, 1500);
    } else {
      msg.style.color='#C0392B';
      msg.textContent=`❌ ${result?.message||result?.error||'حدث خطأ — تأكد من تشغيل reset-function.sql أولاً'}`;
    }
  }catch(e){
    progressBar.style.width='100%';
    msg.style.display='block'; msg.style.color='#C0392B';
    msg.textContent='❌ تعذر الاتصال: '+e.message;
  }finally{
    btn.disabled=false; btn.innerHTML='<i class="ti ti-trash"></i> تنفيذ الريستارت';
  }
}

