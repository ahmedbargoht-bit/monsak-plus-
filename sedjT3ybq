function renderDashboard(){
  const today=new Date().toLocaleDateString('en-US');
  const todayStr=localISO();
  const {visits,missing,attendance,location}=cachedData;
  // الأدمين يشوف كل المجموعات بما فيها alex
  const visible = CU.level==='gm' ? Object.keys(GROUPS) : CU.groups;
  const todayV=visits.filter(v=>v.date===today&&visible.includes(v.grp||''));
  const todayM=missing.filter(m=>m.created_at?.startsWith(todayStr)&&visible.includes(m.grp||''));
  const todayA=attendance.filter(a=>a.date===today);
  const TEN=10*60*1000,nowMs=Date.now();
  const online=location.filter(l=>visible.includes(l.grp||'')&&(nowMs-new Date(l.updated_at).getTime())<TEN).length;
  const totalPts=todayV.reduce((s,v)=>s+(+v.points||0),0);

  document.getElementById('dash-stats').innerHTML=`
    <div class="stat-card blue"><div class="stat-n">${todayV.length}</div><div class="stat-l">زيارة اليوم</div></div>
    <div class="stat-card green"><div class="stat-n">${totalPts}</div><div class="stat-l">نقاط اليوم</div></div>
    <div class="stat-card orange"><div class="stat-n">${todayA.filter(a=>a.time_in).length}</div><div class="stat-l">حضروا اليوم</div></div>
    <div class="stat-card red"><div class="stat-n">${todayM.length}</div><div class="stat-l">نواقص اليوم</div></div>
    <div class="stat-card purple"><div class="stat-n">${online}</div><div class="stat-l">متصل الآن</div></div>
    <div class="stat-card yellow"><div class="stat-n">${cachedData.orders.filter(o=>o.status==='pending').length}</div><div class="stat-l">طلبيات معلقة</div></div>
  `;

  // Groups
  const maxPts=Math.max(...visible.map(g=>todayV.filter(v=>v.grp===g).reduce((s,v)=>s+(+v.points||0),0)),1);
  document.getElementById('dash-groups').innerHTML=visible.map(gid=>{
    const g=GROUPS[gid];
    const gv=todayV.filter(v=>v.grp===gid);
    const pts=gv.reduce((s,v)=>s+(+v.points||0),0);
    const pct=Math.round(pts/maxPts*100);
    return`<div style="margin-bottom:10px">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:4px">
        <span style="font-size:12px;font-weight:600">${g.label}</span>
        <span style="font-size:11px;color:var(--text2)">${gv.length} زيارة · ${pts} نقطة</span>
      </div>
      <div style="background:#f0f0f0;border-radius:999px;height:8px;overflow:hidden">
        <div style="height:100%;border-radius:999px;background:${g.color};width:${pct}%;transition:width .5s"></div>
      </div>
    </div>`;
  }).join('');

  // Activity
  const recent=visits.slice(0,15);
  document.getElementById('dash-activity').innerHTML=recent.map(v=>`
    <div style="display:flex;align-items:center;gap:8px;padding:7px 0;border-bottom:1px solid #f5f5f5">
      <div style="width:8px;height:8px;border-radius:50%;background:${GROUPS[v.grp]?.color||'#ccc'};flex-shrink:0"></div>
      <div style="flex:1;min-width:0">
        <div style="font-size:11px;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${v.name}</div>
        <div style="font-size:10px;color:var(--text2)">${v.branch||''}</div>
      </div>
      <span class="badge b-blue">${v.points||0} نقطة</span>
    </div>`).join('') || '<div style="color:var(--text2);font-size:12px;text-align:center;padding:1rem">لا توجد زيارات</div>';

  // Missing
  const todayMiss=missing.filter(m=>m.created_at?.startsWith(localISO()));
  document.getElementById('dash-missing').innerHTML=todayMiss.length?`
    <div class="table-wrap"><table>
      <thead><tr><th>المنسق</th><th>الفرع</th><th>الصنف</th><th>السبب</th></tr></thead>
      <tbody>${todayMiss.map(m=>`<tr>
