}

async function pbDeleteBanner(id){
  if(!confirm('متأكد إنك عايز تحذف البانر ده؟')) return;
  try{
    const H = {'apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`,'Prefer':'return=minimal'};
    await fetch(`${SUPABASE_URL}/rest/v1/promo_banner?id=eq.${id}`,{method:'DELETE', headers:H});
    if(window._pbEditingId===id) pbCancelForm();
    pbLoadList();
  }catch(e){ alert('خطأ في الحذف: '+e.message); }
}

