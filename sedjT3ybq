function splSelectAllBranches(){
  document.querySelectorAll('#spl-map-branch-cbs input:not([style*="none"])').forEach(cb=>{
    const lbl = cb.closest('label');
    if(!lbl || lbl.style.display==='none') return;
    cb.checked=true;
  });
  // اختار الكل المرئيين
  document.querySelectorAll('#spl-map-branch-cbs label').forEach(lbl=>{
    if(lbl.style.display!=='none') lbl.querySelector('input').checked=true;
  });
