function adminGetRoutes(grp){
  const rows = grp==='all' ? ADMIN_ROUTES_DATA : ADMIN_ROUTES_DATA.filter(r=>r.grp===grp);
  return [...new Set(rows.map(r=>r.route))].sort((a,b)=>a.localeCompare(b,'ar'));
}

function adminGetBranches(grp, route){
  let rows = grp==='all' ? ADMIN_ROUTES_DATA : ADMIN_ROUTES_DATA.filter(r=>r.grp===grp);
  if(route && route!=='all') rows = rows.filter(r=>r.route===route);
  return [...new Set(rows.map(r=>r.branch_name))].sort((a,b)=>a.localeCompare(b,'ar'));
}

function adminGetGrps(){
