    <td><span class="badge b-green">${r.presentDays} يوم</span></td>
    <td><span class="badge b-blue">${r.holidayDays} يوم</span></td>
    <td><span class="badge ${r.absentDays>0?'b-red':'b-gray'}">${r.absentDays} يوم</span></td>
    <td><span class="badge ${r.absentNoExcuse>0?'b-red':'b-gray'}">${r.absentNoExcuse} يوم</span></td>
    <td><span class="badge ${r.penaltyDays>0?'b-red':'b-gray'}">${r.penaltyDays}</span></td>
  </tr>`).join('') || '<tr><td colspan="12" style="text-align:center;color:#aaa;padding:1rem">لا توجد بيانات</td></tr>';
  document.getElementById('ae-preview-wrap').style.display = '';
}

function aeExport(){
  const p = aeGetParams();
  if(!p.from||!p.to){ alert('حدد الفترة الزمنية'); return; }
  const rows = aeBuildRows(p);
  if(!rows.length){ alert('لا توجد بيانات'); return; }

  const wb = XLSX.utils.book_new();

  // ── شيت الكشف الرئيسي (بتنسيق الصورة) ──────────────────────
  const headers = ['#','الكود','الاسم','النوع','المجموعة','الأساس','بدل انتقال','مجهود',
    'من','إلى','إجمالي حضور','إجمالي إجازة','إجمالي غياب','غياب بدون إذن','عدد أيام الجزاء','تواريخ الغياب'];

  const sheetData = [
    // عنوان الكشف
    [`كشف حضور وانصراف المنسقين — من ${p.from} إلى ${p.to}`],
    [],
    headers,
    ...rows.map(r=>[
      r.num, r.code, r.name, r.type, r.group,
      r.base, r.transport, r.effort,
      r.from, r.to,
      r.presentDays, r.holidayDays, r.absentDays,
      r.absentNoExcuse, r.penaltyDays,
      r.absentDates||'—'
    ])
  ];

  const ws = XLSX.utils.aoa_to_sheet(sheetData);

  // عرض الأعمدة
  ws['!cols'] = [
    {wch:4},{wch:8},{wch:22},{wch:10},{wch:12},
    {wch:10},{wch:12},{wch:8},
    {wch:12},{wch:12},
    {wch:12},{wch:12},{wch:12},{wch:14},{wch:14},{wch:30}
  ];

  // دمج عنوان الكشف
  ws['!merges'] = [{s:{r:0,c:0}, e:{r:0,c:15}}];

  // تلوين هيدر الأعمدة (الصف 3)
  headers.forEach((_,ci)=>{
    const cell = ws[XLSX.utils.encode_cell({r:2,c:ci})];
    if(cell) cell.s = {
      fill:{fgColor:{rgb:'003049'}},
      font:{bold:true,color:{rgb:'FFFFFF'}},
      alignment:{horizontal:'center',vertical:'center'}
    };
  });

  // تلوين صفوف البيانات — أحمر لو في غياب
  rows.forEach((r,ri)=>{
    const rowIdx = ri+3;
    if(r.absentNoExcuse > 0){
      headers.forEach((_,ci)=>{
        const cell = ws[XLSX.utils.encode_cell({r:rowIdx,c:ci})];
        if(cell) cell.s = {fill:{fgColor:{rgb:'FFEBEE'}}};
      });
    }
  });

  XLSX.utils.book_append_sheet(wb, ws, 'كشف الحضور');

  // ── شيت ملخص مالي ────────────────────────────────────────────
  const finHeaders = ['#','الاسم','النوع','المجموعة','الأساس','بدل انتقال','مجهود',
    'أيام حضور','خصم غياب','صافي المرتب'];

  const finData = [
    [`ملخص المرتبات — من ${p.from} إلى ${p.to}`],
    [],
    finHeaders,
    ...rows.map(r=>{
      const dailyRate = r.base / p.workdays;
      const deduction = Math.round(r.penaltyDays * dailyRate);
      const net = r.base + r.transport + r.effort - deduction;
      return [
        r.num, r.name, r.type, r.group,
        r.base, r.transport, r.effort,
        r.presentDays,
        deduction,
        net
      ];
    })
  ];

  // إجمالي
  const totalNet = rows.reduce((s,r)=>{
    const dailyRate = r.base / p.workdays;
    const deduction = Math.round(r.penaltyDays * dailyRate);
    return s + r.base + r.transport + r.effort - deduction;
  },0);
  finData.push(['','','','','','','','','الإجمالي:', totalNet]);

  const ws2 = XLSX.utils.aoa_to_sheet(finData);
  ws2['!cols'] = [{wch:4},{wch:22},{wch:10},{wch:12},{wch:10},{wch:12},{wch:8},{wch:12},{wch:12},{wch:14}];
  ws2['!merges'] = [{s:{r:0,c:0}, e:{r:0,c:9}}];
  finHeaders.forEach((_,ci)=>{
    const cell = ws2[XLSX.utils.encode_cell({r:2,c:ci})];
    if(cell) cell.s = {fill:{fgColor:{rgb:'1B5E20'}},font:{bold:true,color:{rgb:'FFFFFF'}},alignment:{horizontal:'center'}};
  });
  XLSX.utils.book_append_sheet(wb, ws2, 'الملخص المالي');

  // تصدير
  const fname = `كشف_حضور_${p.from}_${p.to}.xlsx`;
  XLSX.writeFile(wb, fname);
  document.getElementById('ae-status').textContent = `✅ تم تصدير ${rows.length} منسق`;
}

