<title>MT Admin</title>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&display=swap" rel="stylesheet"/>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.19.0/dist/tabler-icons.min.css"/>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.css"/>
<script src="https://cdn.jsdelivr.net/npm/xlsx-js-style@1.2.0/dist/xlsx.bundle.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.js"></script>
<style>
*{margin:0;padding:0;box-sizing:border-box}
:root{
  /* ══ بالتة الطحان للتمور ══════════════════════════════════ */
  --date-brown:  #4B3C1A;
  --caramel:     #C55B48;
  --sand:        #EDE5D8;
  --dark-red:    #731E2E;
  --olive:       #6B7A3B;

  /* ══ متغيرات النظام ══ */
  --navy:    #3D2E0F;   /* sidebar */
  --red:     #731E2E;
  --orange:  #C55B48;
  --yellow:  #E8A020;   /* gold للأرقام */
  --green:   #6B7A3B;
  --blue:    #C55B48;   /* بيرجع للكراميل */
  --purple:  #8B5A9A;

  /* ══ الخلفيات — أفتح عشان تُقرأ ══ */
  --bg:          #F5F0E8;   /* بيج فاتح دافئ للـ main content */
  --card:        #FFFDF8;   /* أبيض دافئ للكروت */
  --card-solid:  #FFFDF8;
  --border:      #E8D9C0;   /* حد بني فاتح */

  /* ══ النصوص ══ */
  --text:   #2C1F0A;   /* بني داكن — واضح على الفاتح */
  --text2:  #8B6F47;   /* بني متوسط للنصوص الثانوية */
  --sidebar: 220px;
}
body{font-family:'Cairo',sans-serif;background:var(--bg);color:var(--text);font-size:13px}
body::before{
  content:'';position:fixed;inset:0;z-index:-1;pointer-events:none;
  background:
    radial-gradient(ellipse 80% 60% at 10% 90%, rgba(197,91,72,.04) 0%, transparent 50%),
    radial-gradient(ellipse 60% 80% at 90% 10%, rgba(107,122,59,.04) 0%, transparent 50%),
    linear-gradient(160deg, #F5F0E8 0%, #EDE5D8 100%);
}
input,select,textarea,button{font-family:inherit}

/* ══ Login ══════════════════════════════════════════════════ */
@import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&display=swap');
#login-screen{
  display:flex;min-height:100vh;align-items:center;justify-content:center;
  background:#03081A;
  font-family:'Cairo',sans-serif;
}
/* grid bg */
#login-screen::before{
  content:'';position:fixed;inset:0;pointer-events:none;
  background-image:linear-gradient(rgba(30,80,200,.06) 1px,transparent 1px),linear-gradient(90deg,rgba(30,80,200,.06) 1px,transparent 1px);
  background-size:36px 36px;z-index:0;
}
.login-page{
  width:960px;min-height:600px;
  background:linear-gradient(140deg,#06122E 0%,#0A1A3D 50%,#071022 100%);
  display:grid;grid-template-columns:1fr 1fr;
  border-radius:20px;overflow:hidden;
  box-shadow:0 24px 80px rgba(0,0,120,.6);
  border:1px solid rgba(40,100,255,.12);
  position:relative;z-index:1;
}
/* LEFT PANEL */
.login-left{
  padding:36px 30px;display:flex;flex-direction:column;justify-content:center;
  position:relative;overflow:hidden;
  border-left:1px solid rgba(40,100,255,.1);
}
.login-left-glow{
  position:absolute;width:280px;height:280px;border-radius:50%;
  background:radial-gradient(circle,rgba(20,80,220,.13),transparent 70%);
  top:-80px;left:-60px;pointer-events:none;
}
/* brand */
.login-brand-name{
  font-family:'Cinzel',serif;font-size:22px;font-weight:700;letter-spacing:2px;
  background:linear-gradient(135deg,#C8A96E,#F0D080,#C8A96E);
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;
  text-align:center;line-height:1.3;
}
.login-brand-sub{
  font-family:'Cinzel',serif;font-size:10px;color:rgba(180,150,80,.45);
  letter-spacing:4px;text-align:center;margin-top:2px;margin-bottom:14px;
}
.login-sep{height:1px;background:linear-gradient(90deg,transparent,rgba(40,100,255,.2),transparent);margin-bottom:12px}
.login-sys{font-size:13px;font-weight:900;color:#fff;text-align:center;margin-bottom:5px}
.login-sys span{color:#3A9AFF}
.login-tagline{
  font-size:11px;color:rgba(120,175,255,.6);line-height:1.6;
  padding:6px 11px;border-right:2px solid rgba(60,140,255,.3);text-align:right;
  background:rgba(20,50,150,.1);border-radius:0 8px 8px 0;margin-bottom:12px;
}
.login-badge{
  display:inline-flex;align-items:center;gap:5px;
  background:rgba(0,180,100,.1);border:1px solid rgba(0,200,110,.18);
  border-radius:20px;padding:3px 10px;font-size:10px;color:rgba(0,220,130,.8);
  margin-bottom:12px;
}
.login-dot{width:6px;height:6px;border-radius:50%;background:#00DC78;animation:ldot 2s infinite}
@keyframes ldot{0%,100%{opacity:1}50%{opacity:.3}}
.login-divider{display:flex;align-items:center;gap:8px;margin-bottom:13px}
.login-divider-line{flex:1;height:1px;background:rgba(40,100,255,.1)}
.login-divider-txt{font-size:10px;color:rgba(80,130,200,.45)}
/* inputs override for login */
.login-left .fld{margin-bottom:11px}
.login-left .lbl{font-size:11px;font-weight:700;color:rgba(140,190,255,.7);margin-bottom:4px;letter-spacing:.5px;display:block}
.login-left input[type=text],
.login-left input[type=password]{
  width:100%;padding:9px 12px;
  background:rgba(4,12,35,.8) !important;
  border:1px solid rgba(40,100,255,.16) !important;
  border-radius:9px !important;color:#e8f0ff !important;
  font-size:12px;font-family:'Cairo',sans-serif;direction:rtl;outline:none;
}
.login-left input::placeholder{color:rgba(80,130,200,.3) !important}
.login-btn{
  width:100%;padding:11px;
  background:linear-gradient(135deg,#0A4ACC,#1A7AFF) !important;
  border:none !important;border-radius:10px !important;
  color:#fff !important;font-size:13px;font-weight:700;
  font-family:'Cairo',sans-serif;cursor:pointer;
  margin-top:4px;letter-spacing:.5px;
  box-shadow:0 4px 20px rgba(26,122,255,.3) !important;
  display:flex;align-items:center;justify-content:center;gap:6px;
}
.login-btn:hover{filter:brightness(1.1);transform:translateY(-1px)}
.login-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:4px;margin-top:12px;direction:rtl}
.login-stat{background:rgba(4,12,38,.7);border:1px solid rgba(40,100,255,.09);border-radius:8px;padding:6px 3px;text-align:center}
.login-stat-n{font-size:15px;font-weight:900;background:linear-gradient(135deg,#C8A96E,#F0D080,#C8A96E);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;line-height:1}
.login-stat-l{font-size:8px;color:rgba(100,155,255,.5);margin-top:2px;line-height:1.2}
.login-copy{font-size:9px;color:rgba(60,110,200,.25);text-align:center;margin-top:9px}
.login-err{font-size:11px;color:#F87171;text-align:center;margin-bottom:6px;display:none}
.login-err.show{display:block}
/* RIGHT PANEL */
.login-right{
  padding:24px 20px;display:flex;flex-direction:column;gap:12px;
  background:rgba(2,8,24,.4);position:relative;overflow:hidden;
}
.login-right-glow{
  position:absolute;width:300px;height:300px;border-radius:50%;
  background:radial-gradient(circle,rgba(0,80,200,.12),transparent 70%);
  bottom:-80px;right:-60px;pointer-events:none;
}
.login-right-title{font-size:17px;font-weight:900;color:#fff;text-align:center;letter-spacing:.5px}
.login-right-title span{color:#3A9AFF}
.login-feat-row{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.login-feat-card{
  background:linear-gradient(145deg,rgba(10,28,80,.9),rgba(6,16,50,.95));
  border:1px solid rgba(40,100,255,.2);border-radius:14px;padding:14px 8px;
  text-align:center;position:relative;overflow:hidden;
  box-shadow:0 8px 24px rgba(0,20,80,.4),inset 0 1px 0 rgba(80,140,255,.1);
  transform:perspective(400px) rotateX(4deg);transition:transform .3s;
}
.login-feat-card:hover{transform:perspective(400px) rotateX(0deg) translateY(-3px)}
.login-feat-card::before{
  content:'';position:absolute;top:0;left:50%;transform:translateX(-50%);
  width:60%;height:1px;background:linear-gradient(90deg,transparent,rgba(80,150,255,.6),transparent);
}
.login-feat-icon{font-size:26px;margin-bottom:7px;display:block;filter:drop-shadow(0 2px 8px rgba(60,140,255,.4))}
.login-feat-name{font-size:12px;font-weight:700;color:#e0eeff}
/* 3D monitor */
.login-monitor-scene{perspective:800px;flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center}
.login-monitor-wrap{
  transform:rotateX(12deg) rotateY(-4deg);transform-style:preserve-3d;
  width:100%;filter:drop-shadow(0 20px 40px rgba(0,30,120,.7));
}
.login-monitor-body{
  background:linear-gradient(160deg,#0D1F50,#071435);
  border:2px solid rgba(50,110,255,.25);border-radius:10px;padding:8px;
  position:relative;
  box-shadow:0 2px 0 rgba(80,150,255,.15),inset 0 1px 0 rgba(80,150,255,.1),0 0 40px rgba(20,80,255,.15);
}
.login-monitor-body::before{
  content:'';position:absolute;top:6px;left:50%;transform:translateX(-50%);
  width:6px;height:6px;border-radius:50%;background:#3A9AFF;box-shadow:0 0 6px #3A9AFF;
}
.login-monitor-screen{
  background:#030B20;border-radius:6px;padding:8px;
  border:1px solid rgba(40,90,200,.2);overflow:hidden;
}
.login-screen-header{
  display:flex;align-items:center;gap:4px;margin-bottom:6px;padding-bottom:4px;
  border-bottom:1px solid rgba(40,100,255,.12);
}
.login-screen-dot{width:5px;height:5px;border-radius:50%}
.login-screen-title{font-size:8px;color:rgba(100,160,255,.5);margin-right:auto;direction:ltr}
.login-charts-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:5px}
.login-mini-chart{background:rgba(6,14,40,.8);border:1px solid rgba(40,100,255,.1);border-radius:5px;padding:5px}
.login-mc-title{font-size:7px;color:rgba(100,150,255,.45);margin-bottom:4px;direction:ltr}
.login-mini-bars{display:flex;gap:1px;align-items:flex-end;height:28px}
.login-mb{border-radius:1px 1px 0 0}
.login-monitor-stand{width:40px;height:10px;background:linear-gradient(to bottom,rgba(20,50,150,.6),rgba(10,30,100,.4));margin:0 auto;border-radius:0 0 4px 4px;border:1px solid rgba(40,100,255,.15);border-top:none}
.login-monitor-base{width:80px;height:5px;background:linear-gradient(to bottom,rgba(15,40,130,.5),rgba(8,22,80,.3));margin:0 auto;border-radius:0 0 6px 6px;border:1px solid rgba(40,100,255,.12);border-top:none}
.login-side-labels{display:flex;justify-content:space-between;padding:0 4px;margin-top:4px}
.login-slbl{font-size:9px;font-weight:700;color:rgba(140,200,255,.65)}
.fld{margin-bottom:12px}
.lbl{font-size:11px;color:var(--text2);margin-bottom:4px;display:block;font-weight:600}
select,input[type=password],input[type=text],input[type=number],input[type=date],input[type=month]{
  width:100%;padding:9px 12px;border:1.5px solid #D4C4A8;border-radius:8px;font-size:13px;
  color:#2C1F0A;background:#FFFDF8;transition:border-color .2s}
select:focus,input:focus,textarea:focus{outline:none;border-color:#C55B48;box-shadow:0 0 0 3px rgba(197,91,72,.12)}
select option{background:#FFFDF8;color:#2C1F0A}
.btn{padding:10px 18px;border:none;border-radius:8px;font-size:13px;font-weight:600;cursor:pointer;display:inline-flex;align-items:center;gap:6px;transition:all .18s cubic-bezier(.4,0,.2,1);user-select:none}
.btn:hover{filter:brightness(1.08);transform:translateY(-1px)}
.btn:active{transform:scale(.96) translateY(1px)!important;filter:brightness(.92)!important;box-shadow:inset 0 2px 6px rgba(0,0,0,.2)!important}
.btn-block{width:100%;justify-content:center}
.btn-blue{background:linear-gradient(135deg,#C55B48,#A8432E);color:#EDE5D8;box-shadow:0 3px 10px rgba(197,91,72,.35)}
.btn-blue:hover{background:linear-gradient(135deg,#D06B58,#C55B48);box-shadow:0 4px 14px rgba(197,91,72,.5);transform:translateY(-1px)}
.btn-navy{background:rgba(75,60,26,.8);color:#EDE5D8;border:1px solid rgba(197,91,72,.2)}
.btn-navy:hover{background:rgba(197,91,72,.25);border-color:rgba(197,91,72,.4)}
.btn-green{background:linear-gradient(135deg,#6B7A3B,#4E5C28);color:#EDE5D8;box-shadow:0 3px 10px rgba(107,122,59,.35)}
.btn-green:hover{background:linear-gradient(135deg,#7B8A4B,#6B7A3B);transform:translateY(-1px)}
.btn-red{background:linear-gradient(135deg,#731E2E,#5A1520);color:#EDE5D8;box-shadow:0 3px 10px rgba(115,30,46,.35)}
.btn-red:hover{background:linear-gradient(135deg,#831E2E,#731E2E);transform:translateY(-1px)}
.btn-orange{background:linear-gradient(135deg,#C55B48,#A8432E);color:#EDE5D8}
.btn-ghost{background:transparent;border:1.5px solid #D4C4A8;color:#8B6F47}
.btn-ghost:hover{border-color:#C55B48;color:#C55B48;background:rgba(197,91,72,.06)}
.btn-sm{padding:6px 12px;font-size:11px}
.btn-xs{padding:4px 8px;font-size:10px;border-radius:6px}
.err{background:#FFEBEE;color:#B71C1C;border-radius:6px;padding:8px 12px;font-size:12px;margin-bottom:10px;display:none}
.ok{background:#E8F5E9;color:#1B5E20;border-radius:6px;padding:8px 12px;font-size:12px;margin-bottom:8px;display:none}

/* ══ App Shell ══════════════════════════════════════════════ */
#app{display:none;min-height:100vh}
.layout{display:flex;min-height:100vh}

/* ══ Sidebar ════════════════════════════════════════════════ */
.sidebar{
  width:var(--sidebar);
  background:#FAF7F2;
  border-left:1.5px solid #E2D9CC;
  display:flex;flex-direction:column;
  position:fixed;top:0;right:0;bottom:0;z-index:100;
}
.sidebar-logo{
  padding:18px 16px;
  border-bottom:1.5px solid #E2D9CC;
  background:#FAF7F2;
  display:flex;align-items:center;gap:10px;
}
.sidebar-logo .icon{font-size:26px;color:#8B5E3C;flex-shrink:0}
.sidebar-logo .text{flex:1;min-width:0}
.sidebar-logo .text h2{color:#2E200A;font-size:14px;font-weight:800;letter-spacing:.01em;font-family:'Cairo','Tajawal',sans-serif}
.sidebar-logo .text p{color:#A0896A;font-size:10px;font-weight:600}
.sidebar-nav{flex:1;padding:10px 8px;overflow-y:auto}
.nav-section{margin-bottom:14px}
.nav-section-label{font-size:9px;font-weight:800;color:#B0966F;letter-spacing:.12em;padding:0 10px;margin-bottom:5px;font-family:'Cairo','Tajawal',sans-serif}
.nav-item{
  display:flex;align-items:center;gap:9px;padding:8px 12px;border-radius:8px;
  cursor:pointer;color:#6B5236;font-size:12px;font-weight:700;
  transition:background .12s,border-color .12s;margin-bottom:2px;
  border:1.5px solid transparent;user-select:none;
  font-family:'Cairo','Tajawal',sans-serif;
}
.nav-item:hover{
  background:#F0E8D8;
  border-color:#DDD0BB;
  color:#3D2E0F;
}
.nav-item:active{
  background:#E8DCCA;
  color:#2E200A;
}
.nav-item.active{
  background:#EDE0C8;
  color:#2E200A;
  border:1.5px solid #C8A97A;
  font-weight:800;
}
.nav-item i{font-size:15px;flex-shrink:0;color:#8B6A42}
.nav-item.active i{color:#7A4F1E}
.nav-badge{margin-right:auto;background:#731E2E;color:#fff;font-size:9px;padding:1px 6px;border-radius:999px;font-weight:700}
.reset-cb-row{display:flex;align-items:center;gap:6px;font-size:12px;padding:5px 0;cursor:pointer;border-bottom:1px solid rgba(0,0,0,.08);color:#333}
.reset-cb-row:last-child{border-bottom:none}
.reset-cb-row input{accent-color:#8B5E3C;width:14px;height:14px}
.reset-count{margin-right:auto;font-size:10px;color:#fff !important;font-weight:700 !important;background:#2C3E50 !important;border-radius:999px;padding:2px 8px;min-width:28px;text-align:center;display:inline-block}
.sidebar-bottom{padding:12px 8px;border-top:1.5px solid #E2D9CC;background:#FAF7F2}
.user-card{
  display:flex;align-items:center;gap:8px;padding:10px 12px;
  background:#EDE0C8;border-radius:10px;border:1.5px solid #C8A97A;
}
.user-av{
  width:32px;height:32px;border-radius:8px;
  background:#D4B896;color:#2E200A;
  display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:800;flex-shrink:0;
  font-family:'Cairo','Tajawal',sans-serif;
}
.user-info{flex:1;min-width:0}
.user-name{font-size:11px;font-weight:800;color:#2E200A;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-family:'Cairo','Tajawal',sans-serif}
.user-role{font-size:9px;color:#8B6A42;font-weight:600}
.logout-btn{background:none;border:none;color:#A0896A;cursor:pointer;font-size:16px;padding:2px}
.logout-btn:hover{color:#2E200A}

/* ══ Main ═══════════════════════════════════════════════════ */
.main{margin-right:var(--sidebar);flex:1;display:flex;flex-direction:column;min-height:100vh}
.topbar{display:none}
.topbar-title{display:none}
.topbar-actions{display:none}
.live-info{display:flex;align-items:center;gap:6px;font-size:11px;color:var(--text2);margin-top:4px}
.page-header{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:20px;flex-wrap:wrap;gap:8px}
.live-dot{width:8px;height:8px;background:#22C55E;border-radius:50%;animation:pulse 1.5s ease-in-out infinite;display:inline-block}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.4}}
.content{flex:1;padding:20px;overflow-y:auto}

/* ══ Panels ═════════════════════════════════════════════════ */
.panel{display:none}.panel.active{display:block!important}

/* ══ Cards ══════════════════════════════════════════════════ */
.card{background:#FFFDF8;border-radius:12px;border:1px solid #E8D9C0;padding:16px 20px;margin-bottom:16px;box-shadow:0 2px 8px rgba(75,60,26,.08)}
.card-title{font-size:13px;font-weight:700;margin-bottom:14px;display:flex;align-items:center;gap:8px}
.card-title i{font-size:16px;color:var(--blue)}

/* ══ Stats Grid ═════════════════════════════════════════════ */
.stats-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:12px;margin-bottom:20px}
.stat-card{
  background:#FFFDF8;border-radius:12px;border:1px solid #E8D9C0;
  padding:14px 16px;position:relative;overflow:hidden;box-shadow:0 2px 6px rgba(75,60,26,.1);
}
.stat-card::before{content:'';position:absolute;top:0;right:0;width:4px;height:100%;border-radius:0 12px 12px 0}
.stat-card.blue::before{background:var(--blue)}
.stat-card.green::before{background:var(--green)}
.stat-card.red::before{background:var(--red)}
.stat-card.orange::before{background:var(--orange)}
.stat-card.purple::before{background:var(--purple)}
.stat-card.yellow::before{background:var(--yellow)}
.stat-n{font-size:28px;font-weight:900;line-height:1;margin-bottom:2px}
.stat-l{font-size:11px;color:var(--text2)}
.stat-card.blue .stat-n{color:var(--blue)}
.stat-card.green .stat-n{color:var(--green)}
.stat-card.red .stat-n{color:var(--red)}
.stat-card.orange .stat-n{color:var(--orange)}
.stat-card.purple .stat-n{color:var(--purple)}
.stat-card.yellow .stat-n{color:var(--orange)}

/* ══ Table ══════════════════════════════════════════════════ */
.table-wrap{overflow-x:auto;border-radius:10px;border:1px solid var(--border)}
table{width:100%;border-collapse:collapse;font-size:12px}
thead th{background:#4B3C1A;color:#EDE5D8;padding:10px 12px;text-align:right;font-weight:600;white-space:nowrap}
tbody td{padding:9px 12px;border-bottom:1px solid #F0E8D8;vertical-align:middle;color:#2C1F0A}
tbody tr:last-child td{border-bottom:none}
tbody tr:hover td{background:#FFF5EC}
.badge{display:inline-flex;align-items:center;padding:2px 8px;border-radius:999px;font-size:10px;font-weight:600;gap:3px}
.b-blue{background:#FFF0EC;color:#A8432E;border:1px solid #F4C4B4}
.b-green{background:#E8F5E9;color:#1B5E20;border:1px solid #A5D6A7}
.b-red{background:#FFEBEE;color:#B71C1C;border:1px solid #FFCDD2}
.b-orange{background:#FFF3E0;color:#E65100;border:1px solid #FFCC80}
.b-yellow{background:#FFF8E1;color:#5D4037}
.b-purple{background:#F3E8FF;color:#6A0DAD}
.b-gray{background:#F5F5F5;color:#555}
/* ── Rep checkbox filter ── */
/* ── ASR chips ── */
.asr-grp-chip{padding:5px 12px;border-radius:20px;border:1.5px solid #DDD0BC;background:#fff;font-family:Cairo,sans-serif;font-size:12px;font-weight:600;cursor:pointer;transition:all .18s;color:#5C3D2E;white-space:nowrap}
.asr-grp-chip:hover{border-color:#731E2E;color:#731E2E;transform:translateY(-1px)}
.asr-grp-chip.active{background:#731E2E;color:#fff;border-color:#731E2E;box-shadow:0 2px 8px rgba(115,30,46,.35)}
.asr-type-btn{padding:5px 12px;border-radius:8px;border:1.5px solid #DDD0BC;background:#fff;font-family:Cairo,sans-serif;font-size:12px;font-weight:600;cursor:pointer;transition:all .15s;color:#666;white-space:nowrap}
.asr-type-btn.active-type{background:#EEF2FF;color:#3730A3;border-color:#C7D2FE}
.asr-rep-card{background:#fff;border-radius:14px;border:1.5px solid #EDE5D8;overflow:hidden;transition:box-shadow .2s,transform .15s}
.asr-rep-card:hover{box-shadow:0 4px 20px rgba(115,30,46,.12);transform:translateY(-1px)}
.asr-route-row{display:flex;align-items:center;gap:8px;padding:6px 10px;background:#F9F6F1;border-radius:8px;margin-bottom:4px;font-size:12px;font-family:Cairo,sans-serif}
/* ── */
.rep-cb-label{display:inline-flex;align-items:center;gap:5px;padding:5px 10px;
/* ── تشيك بوكس الفروع ── */
.br-cb-lbl{display:inline-flex;align-items:center;gap:5px;padding:5px 10px;border:1.5px solid #ddd;border-radius:20px;font-size:12px;cursor:pointer;background:#fff;transition:all .18s cubic-bezier(.4,0,.2,1);user-select:none;white-space:nowrap}
.br-cb-lbl:hover{border-color:#C55B48;color:#C55B48;transform:translateY(-1px)}
.br-cb-lbl:active{transform:scale(.95) translateY(1px);box-shadow:inset 0 1px 4px rgba(0,0,0,.12)}
.br-cb-lbl.active{background:#005CBF;color:#fff;border-color:#005CBF;box-shadow:0 2px 6px rgba(0,92,191,.25)}
.br-cb-lbl:hover{border-color:#005CBF;background:#EFF6FF}
.br-cb-lbl input{display:none}
.br-cb-lbl.active{background:#005CBF;color:#fff;border-color:#005CBF}
  border:1.5px solid #ddd;border-radius:20px;font-size:12px;cursor:pointer;
  background:#fff;transition:all .15s;user-select:none;white-space:nowrap}
.rep-cb-label:hover{border-color:#731E2E;background:#FBF0F0}
.rep-cb-label input{display:none}
.rep-cb-label.active{background:#731E2E;color:#fff;border-color:#731E2E}
/* ── زر إيقاف/تفعيل واضح ── */
.btn-pause{display:inline-flex;align-items:center;gap:4px;padding:5px 10px;
  border-radius:8px;border:none;font-size:11px;font-weight:700;cursor:pointer;
  font-family:inherit;white-space:nowrap}
.btn-pause.active{background:#FFF3E0;color:#E65100;border:1.5px solid #FFB74D}
.btn-pause.inactive{background:#E8F5E9;color:#1A7A4A;border:1.5px solid #81C784}

/* ══ Form Grid ══════════════════════════════════════════════ */
.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px}
.form-grid-3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;margin-bottom:12px}
.form-fld{margin-bottom:10px}
.form-lbl{font-size:11px;color:var(--text2);margin-bottom:4px;display:block;font-weight:600}
textarea{width:100%;padding:8px 12px;border:1.5px solid var(--border);border-radius:8px;font-size:12px;resize:vertical;min-height:70px;color:var(--text)}

/* ══ LB Display ═════════════════════════════════════════════ */
.lb-display{
  background:linear-gradient(135deg,#0A0E1A,#0D1B2A);
  border-radius:16px;padding:24px;color:#fff;
  min-height:500px;
}
.lb-top3{display:flex;align-items:flex-end;justify-content:center;gap:16px;margin:20px 0}
.lb-pos{display:flex;flex-direction:column;align-items:center;gap:6px}
.lb-av-big{
  border-radius:50%;display:flex;align-items:center;justify-content:center;
  font-size:16px;font-weight:900;color:#fff;border:3px solid;
}
.lb-pos-1 .lb-av-big{width:70px;height:70px;border-color:#FFD700;background:linear-gradient(135deg,#003049,#005CBF);box-shadow:0 0 20px rgba(255,215,0,.4)}
.lb-pos-2 .lb-av-big{width:56px;height:56px;border-color:#C0C0C0;background:linear-gradient(135deg,#1A2A1A,#1A7A4A)}
.lb-pos-3 .lb-av-big{width:50px;height:50px;border-color:#CD7F32;background:linear-gradient(135deg,#2A1A0A,#8B5523)}
.lb-pos-name{font-size:12px;font-weight:700;text-align:center;max-width:120px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.lb-pos-pts{font-size:14px;font-weight:900}
.lb-pos-1 .lb-pos-pts{color:#FFD700}
.lb-pos-2 .lb-pos-pts{color:#C0C0C0}
.lb-pos-3 .lb-pos-pts{color:#CD7F32}
.lb-block{border-radius:6px 6px 0 0;width:100%;min-width:100px;display:flex;align-items:center;justify-content:center;font-size:18px;font-weight:900}
.lb-pos-1 .lb-block{height:60px;background:rgba(255,215,0,.2);color:#FFD700;border:1px solid rgba(255,215,0,.3);border-bottom:none}
.lb-pos-2 .lb-block{height:44px;background:rgba(192,192,192,.15);color:#C0C0C0;border:1px solid rgba(192,192,192,.2);border-bottom:none}
.lb-pos-3 .lb-block{height:32px;background:rgba(205,127,50,.15);color:#CD7F32;border:1px solid rgba(205,127,50,.2);border-bottom:none}
.lb-row-item{
  display:flex;align-items:center;gap:10px;padding:8px 12px;
  border-radius:8px;margin-bottom:4px;
}
.lb-row-item.top1{background:rgba(255,215,0,.08);border:1px solid rgba(255,215,0,.15)}
.lb-row-item.top2{background:rgba(192,192,192,.06);border:1px solid rgba(192,192,192,.1)}
.lb-row-item.top3{background:rgba(205,127,50,.07);border:1px solid rgba(205,127,50,.1)}
.lb-row-item.others{background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.06)}
.lb-rank-badge{width:26px;height:26px;border-radius:6px;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;flex-shrink:0}
.lb-bar-bg{flex:1;background:rgba(255,255,255,.08);border-radius:999px;height:5px;overflow:hidden}
.lb-bar-fill{height:100%;border-radius:999px;transition:width 1s ease}
.lb-pts-badge{font-size:13px;font-weight:900;min-width:40px;text-align:left}

/* ══ Goals ══════════════════════════════════════════════════ */
.goal-row{
  display:flex;align-items:center;gap:10px;padding:10px;
  border:1px solid var(--border);border-radius:8px;margin-bottom:8px;
}
.goal-progress{flex:1;background:#f0f0f0;border-radius:999px;height:8px;overflow:hidden}
.goal-bar{height:100%;border-radius:999px;background:var(--blue);transition:width .5s}
.goal-pct{font-size:11px;font-weight:700;min-width:36px;text-align:center}

/* ══ Filter Bar ═════════════════════════════════════════════ */
.filter-bar{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:14px;align-items:center}
.filter-bar select,.filter-bar input{width:auto;padding:7px 12px;font-size:12px}
.filter-bar input{flex:1;min-width:150px}

/* ══ Modal ══════════════════════════════════════════════════ */
.modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,.7);backdrop-filter:blur(4px);z-index:200;display:none;align-items:center;justify-content:center}
.modal-overlay.open{display:flex}
.modal-box{background:#FFFDF8;border:1px solid #E8D9C0;border-radius:16px;padding:24px;box-shadow:0 8px 32px rgba(75,60,26,.25)}
.modal{background:#FFFDF8;border:1px solid #E8D9C0;border-radius:16px;padding:24px;width:90%;max-width:500px;max-height:90vh;overflow-y:auto;position:relative;box-shadow:0 8px 32px rgba(75,60,26,.2)}
.modal-title{font-size:15px;font-weight:700;color:#2C1F0A;margin-bottom:16px;display:flex;align-items:center;justify-content:space-between}
.modal-close{background:none;border:none;font-size:20px;cursor:pointer;color:#8B6F47;padding:2px}
.modal-close:hover{color:#2C1F0A}
.modal-footer{display:flex;gap:8px;justify-content:flex-end;margin-top:16px;padding-top:14px;border-top:1px solid #E8D9C0}

/* ══ Scrollbar ══════════════════════════════════════════════ */
::-webkit-scrollbar{width:5px;height:5px}
::-webkit-scrollbar-track{background:#F0E8D8}
::-webkit-scrollbar-thumb{background:#C55B48;border-radius:3px}
::-webkit-scrollbar-thumb:hover{background:#A8432E}

/* ══ Payroll / كشف الحضور ════════════════════════════════════ */
.kshf-modal-header,.payroll-header{
  background:linear-gradient(135deg,#731E2E,#5A1520) !important;
  border-bottom:1px solid rgba(237,229,216,.15) !important;
}
.payroll-tab-active,.kshf-tab.active{
  background:rgba(197,91,72,.25) !important;
  color:#EDE5D8 !important;
