// ── فروع المنسق الثابت — checkbox متعدد بدل السيليكت الواحد ─────
// (نفس مصدر البيانات اللي بيقرأه تطبيق المنسق popBranches() للمنسق الثابت: coord_route_assignments)
let _euFixedAllBranches = []; // كل فروع المجموعة الحالية (للفلترة بالبحث)
let _euFixedAssignedSet = new Set(); // الفروع المحددة لهذا المنسق تحديداً

async function euLoadFixedBranches(legacyFixedBranch){
  const list = document.getElementById('eu-fixed-branch-list');
  const searchInp = document.getElementById('eu-fixed-branch-search');
  if(!list) return;
  if(searchInp) searchInp.value='';
  list.innerHTML='<div style="color:#999;text-align:center;padding:8px">جاري التحميل...</div>';

  const grp     = document.getElementById('eu-group')?.value||'giza';
  const repName = document.getElementById('eu-id')?.value||'';
  try{
    const H={'apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`};
    const [branchesRes, assignedRes] = await Promise.all([
      fetch(`${SUPABASE_URL}/rest/v1/branches?select=branch_name&grp=eq.${encodeURIComponent(grp)}&status=eq.active&order=branch_name.asc&limit=2000`,{headers:H}),
      repName ? fetch(`${SUPABASE_URL}/rest/v1/coord_route_assignments?rep_name=eq.${encodeURIComponent(repName)}&select=branch_name`,{headers:H}) : Promise.resolve(null)
    ]);
    const branchesData = branchesRes.ok ? await branchesRes.json() : [];
    const assignedData = assignedRes && assignedRes.ok ? await assignedRes.json() : [];

    _euFixedAllBranches = [...new Set(branchesData.map(b=>b.branch_name).filter(Boolean))].sort((a,b)=>a.localeCompare(b,'ar'));
    _euFixedAssignedSet = new Set(assignedData.map(a=>a.branch_name));
    // توافق مع الفرع القديم (users.fixed_branch) لو كان محفوظ ومفيش تخصيص جديد بعد
    if(legacyFixedBranch){
      _euFixedAssignedSet.add(legacyFixedBranch);
      if(!_euFixedAllBranches.includes(legacyFixedBranch)) _euFixedAllBranches.push(legacyFixedBranch);
    }
    euRenderFixedBranchList(_euFixedAllBranches);
  }catch(e){
    list.innerHTML='<div style="color:#B71C1C;text-align:center;padding:8px">تعذر التحميل</div>';
  }
}

function euRenderFixedBranchList(branches){
  const list = document.getElementById('eu-fixed-branch-list');
  if(!list) return;
  if(!branches.length){
    list.innerHTML='<div style="color:#999;text-align:center;padding:8px">لا توجد فروع في هذه المجموعة</div>';
    return;
  }
  list.innerHTML = branches.map(b=>`
    <div style="display:flex;align-items:center;gap:8px;padding:4px 6px;border-bottom:1px solid #F0E8D8">
      <input type="checkbox" class="eu-fixed-branch-cb" data-branch="${b.replace(/"/g,'&quot;')}"
        ${_euFixedAssignedSet.has(b)?'checked':''} onchange="euToggleFixedBranchAssign(this)"
        style="cursor:pointer;width:16px;height:16px"/>
      <span style="flex:1">${b}</span>
    </div>`).join('');
}

function euFilterFixedBranches(){
  const q=(document.getElementById('eu-fixed-branch-search')?.value||'').toLowerCase();
  const filtered = q ? _euFixedAllBranches.filter(b=>b.toLowerCase().includes(q)) : _euFixedAllBranches;
  euRenderFixedBranchList(filtered);
}

async function euToggleFixedBranchAssign(cb){
  const branchName = cb.dataset.branch;
  const repName = document.getElementById('eu-id')?.value||'';
  const grp  = document.getElementById('eu-group')?.value||'giza';
  const type = document.getElementById('eu-type')?.value||'ثابت';
  if(!repName){ cb.checked=!cb.checked; alert('احفظ بيانات المنسق أولاً قبل التخصيص'); return; }
  cb.disabled=true;
  try{
    const H={'Content-Type':'application/json','apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`,'Prefer':'return=minimal'};
    if(cb.checked){
      _euFixedAssignedSet.add(branchName);
      await fetch(`${SUPABASE_URL}/rest/v1/coord_route_assignments`,{
        method:'POST', headers:H,
        body: JSON.stringify({grp, route:'', branch_name:branchName, rep_name:repName, coord_type:type, shift:'كامل'})
      });
    } else {
      _euFixedAssignedSet.delete(branchName);
      await fetch(`${SUPABASE_URL}/rest/v1/coord_route_assignments?rep_name=eq.${encodeURIComponent(repName)}&branch_name=eq.${encodeURIComponent(branchName)}`,{
        method:'DELETE', headers:H
      });
    }
  }catch(e){
    alert('خطأ في حفظ التخصيص: '+e.message);
    cb.checked=!cb.checked;
  }
  cb.disabled=false;
}

async function euSelectAllFixedBranches(checked){
  const boxes = [...document.querySelectorAll('#eu-fixed-branch-list .eu-fixed-branch-cb')];
  for(const cb of boxes){
    if(cb.checked===checked) continue;
    cb.checked = checked;
    await euToggleFixedBranchAssign(cb);
  }
}

// ── فروع خط السير — تُعرض وتُدار مباشرة من مودال تعديل المنسق ─────
// (نفس جدول branches اللي بيقرأ منه تطبيق المنسق popBranches() لخط السير)
async function euLoadRouteBranches(route){
  const wrap = document.getElementById('eu-route-branches-wrap');
  const list = document.getElementById('eu-route-branches-list');
  if(!wrap || !list) return;
  if(euIsFixedType() || !route){
    wrap.style.display='none';
    list.innerHTML='';
    return;
  }
  wrap.style.display='';
  list.innerHTML='<div style="color:#999;text-align:center;padding:8px">جاري التحميل...</div>';
  const repName = document.getElementById('eu-id')?.value||'';
  try{
    const H={'apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`};
    const [branchesRes, assignedRes] = await Promise.all([
      fetch(`${SUPABASE_URL}/rest/v1/branches?select=id,branch_name,status&route=eq.${encodeURIComponent(route)}&order=branch_name.asc&limit=500`,{headers:H}),
      repName ? fetch(`${SUPABASE_URL}/rest/v1/coord_route_assignments?rep_name=eq.${encodeURIComponent(repName)}&select=branch_name`,{headers:H}) : Promise.resolve(null)
    ]);
    const data     = branchesRes.ok ? await branchesRes.json() : [];
    const assigned = assignedRes && assignedRes.ok ? await assignedRes.json() : [];
    const assignedSet = new Set(assigned.map(a=>a.branch_name));

    if(!data.length){
      list.innerHTML='<div style="color:#999;text-align:center;padding:8px">لا توجد فروع مسجلة لهذا الخط بعد</div>';
    } else {
      list.innerHTML = data.map(b=>`
        <div style="display:flex;align-items:center;gap:8px;padding:4px 6px;border-bottom:1px solid #F0E8D8">
          <input type="checkbox" class="eu-branch-assign-cb" data-branch="${(b.branch_name||'').replace(/"/g,'&quot;')}"
            ${assignedSet.has(b.branch_name)?'checked':''} onchange="euToggleBranchAssign(this,'${route.replace(/'/g,"\\'")}')"
            style="cursor:pointer;width:16px;height:16px" title="مخصص لهذا المنسق"/>
          <span style="flex:1">${b.status!=='active' ? '⚪ ' : '🟢 '}${b.branch_name}</span>
          <button type="button" onclick="euDeleteRouteBranch('${b.id}','${(b.branch_name||'').replace(/'/g,"\\'")}','${route.replace(/'/g,"\\'")}')"
            style="background:none;border:none;color:#B71C1C;cursor:pointer;font-size:13px" title="حذف الفرع من النظام">
            <i class="ti ti-trash"></i>
          </button>
        </div>`).join('');
    }
    euUpdateAssignHint(assignedSet.size, data.length);
  }catch(e){
    list.innerHTML='<div style="color:#B71C1C;text-align:center;padding:8px">تعذر التحميل</div>';
  }
  // جهّز قائمة اقتراحات بكل الفروع الموجودة في النظام (لربط فرع حالي بدل تكراره)
  euFillAllBranchesDatalist();
}

function euUpdateAssignHint(assignedCount, total){
  const hint = document.getElementById('eu-assign-hint');
  if(!hint) return;
  if(!assignedCount){
    hint.textContent = 'لو ملهاش أي فرع محدد، هيظهر له كل فروع الخط بالكامل (السلوك الحالي)';
    hint.style.color = '#8B6F47';
  } else {
    hint.textContent = `محدد له ${assignedCount} فرع من أصل ${total} — هيشوف الفروع دي بس في التطبيق`;
    hint.style.color = '#1A7A4A';
  }
}

