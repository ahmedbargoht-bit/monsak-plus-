      <td style="padding:7px 8px;font-size:11px">${r.grp||'—'}</td>
      <td style="padding:7px 8px;font-size:12px;color:#065F46;font-weight:600">${r.snf||'—'}</td>
      <td style="padding:7px 8px;font-size:11px">${r.cat||'—'}</td>
      <td style="padding:7px 8px;font-size:12px;${seAgeColor(r.date_shelf)}">${r.date_shelf||'—'}</td>
      <td style="padding:7px 8px;font-size:12px;text-align:center">${r.total_qty??'—'}</td>
      <td style="padding:7px 8px;font-size:11px;color:#6B7280">${r.last_visit||'—'}</td>
    </tr>`).join('');
}

function seAgeColor(ds){
  if(!ds) return '';
  try{
    const d    = new Date(ds.split('/').reverse().join('-'));
    const days = Math.floor((Date.now()-d)/(86400000));
    if(days>180) return 'color:#DC2626;font-weight:700';
    if(days>90)  return 'color:#D97706;font-weight:600';
    return 'color:#065F46';
  }catch(e){ return ''; }
}

