    const sts = pct>=80?'<span style="padding:2px 7px;border-radius:20px;font-size:10px;font-weight:700;background:#EAF3DE;color:#3B6D11">ممتاز</span>':
                pct>=60?'<span style="padding:2px 7px;border-radius:20px;font-size:10px;font-weight:700;background:#FAEEDA;color:#854F0B">متوسط</span>':
                '<span style="padding:2px 7px;border-radius:20px;font-size:10px;font-weight:700;background:#FCEBEB;color:#A32D2D">ضعيف</span>';
