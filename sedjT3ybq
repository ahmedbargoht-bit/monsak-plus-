// ── مزامنة GROUPS الثابتة مع جدول groups الديناميكي (Supabase) ──────────────
// أي مجموعة جديدة بتتعمل من تاب "إنشاء مجموعة" بتتسجل في جدول groups بس، لكن كل
// أماكن عرض شارات المجموعة (لون + اسم) وكل التشيك بوكسات اللي بتحدد "المجموعات
// المسؤول عنها" لمشرف/مدير بتقرأ من GROUPS الثابتة هنا مباشرة — فكانت أي مجموعة
// جديدة (زي "delta") بتفضل شغالة في إنشاء خط سير بس، ومش ظاهرة ولا قابلة للتخصيص
// في أي مكان تاني (شارة خط السير، تعديل مشرف...). الدالة دي بتضيف أي مجموعة من
// الجدول لـ GROUPS وقت تسجيل الدخول، فكل الشاشات تعرفها فورًا من غير ما نلمس كل
// مكان بيستخدم GROUPS لوحده.
async function syncGroupsFromDB(){
  try{
    const res = await fetch(`${SUPABASE_URL}/rest/v1/groups?select=key_name,name,color,emoji&order=name.asc&limit=200`,
      {headers:{'apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`}});
    if(!res.ok) return;
    const rows = await res.json();
    // مهم: نضيف بس المفاتيح الناقصة — منلمسش لون/اسم أي مجموعة موجودة بالفعل في GROUPS
    // الثابتة، لأن جدول groups فيه صفوف قديمة لنفس الـ6 مجموعات الأساسية بألوان مختلفة
    // شوية عن الألوان المعتمدة في هوية الطحان، فمنكسرش شكل الشارات الحالية بالغلط.
    (Array.isArray(rows)?rows:[]).forEach(g=>{
      if(!g.key_name || GROUPS[g.key_name]) return;
      GROUPS[g.key_name] = {
        label: `${g.emoji||''} ${g.name||g.key_name}`.trim(),
        color: g.color || '#888'
      };
    });
  }catch(e){ console.warn('syncGroupsFromDB error:', e); }
}

// ── تحديث كل قوائم فلتر المجموعات الثابتة في الصفحة (select) بعد مزامنة GROUPS ──────
// اللوحة فيها عشرات الـ<select> المكتوبة يدوي في الـHTML (فلتر المجموعة في كل تاب:
// الحضور، سجل الزيارات، خريطة الفروع، تقارير المنسقين...إلخ) وكل واحد منها كان بيتكتب
// بقايمة ثابتة من الـ6-11 مجموعة الأصلية فقط، فأي مجموعة جديدة (زي "delta") كانت بتفضل
// غير ظاهرة في كل الفلاتر دي رغم إن GROUPS نفسها اتزامنت. الدالة دي بتدور على أي select
// فيه على الأقل مفتاحين من مفاتيح المجموعات الأصلية المعروفة (علامة إنه "فلتر مجموعة")
// وتضيفله أي مجموعة ناقصة من GROUPS المُزامنة، من غير ما تلمس القيمة المختارة حاليًا.
function refreshAllStaticGroupSelects(){
  const knownKeys = ['giza','cairo','south','tajmuat','hyper','alex','markets','fuel_cairo','fuel_alex','private_cairo','private_alex'];
  document.querySelectorAll('select').forEach(sel=>{
    const optValues = new Set([...sel.options].map(o=>o.value));
    const matchCount = knownKeys.filter(k=>optValues.has(k)).length;
    if(matchCount < 2) return; // مش فلتر مجموعات على الأرجح
    Object.keys(GROUPS).forEach(key=>{
      if(optValues.has(key)) return;
      const o = document.createElement('option');
      o.value = key;
      o.textContent = GROUPS[key].label || key;
      sel.appendChild(o);
    });
  });
}

