async function pdbApplyBulkPrice(){
  const price=parseFloat(document.getElementById('bulk-price-input')?.value)||0;
  const tax=parseFloat(document.getElementById('bulk-price-tax-input')?.value)||0;
  if(price<=0){ showToast('ادخل سعر صحيح'); return; }
  const names=[...new Set(_pdbPriceBulkKeys.map(k=>k.snf).filter(Boolean))];
  const H = {'Content-Type':'application/json','apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`,'Prefer':'return=minimal'};
  for(const name of names){
    const existing = (_splPrices||[]).find(p=>p.snf_name===name);
    if(existing){
      await fetch(`${SUPABASE_URL}/rest/v1/sales_prices?id=eq.${existing.id}`,{method:'PATCH',headers:H,body:JSON.stringify({price,tax_pct:tax,updated_at:new Date().toISOString()})});
    } else {
      await fetch(`${SUPABASE_URL}/rest/v1/sales_prices`,{method:'POST',headers:H,body:JSON.stringify({snf_name:name,price,tax_pct:tax})});
    }
  }
  _pdbPriceBulkKeys=[];
  document.getElementById('pdb-price-bulk-overlay')?.remove();
  pdbClearSelection();
  showToast(`✅ تم حفظ السعر لـ ${names.length} صنف`);
  const pricesRes = await fetch(`${SUPABASE_URL}/rest/v1/sales_prices?select=*&order=snf_name.asc&limit=2000`, {headers:H});
  _splPrices = pricesRes.ok ? await pricesRes.json() : _splPrices;
  renderProdDB();
}

