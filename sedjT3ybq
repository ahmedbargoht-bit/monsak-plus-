let _cnNotes = [];

async function loadCoordNotes(){
  const tbody  = document.getElementById('cn-tbody');
  if(!tbody) return;
  tbody.innerHTML = `<tr><td colspan="7" style="text-align:center;padding:2rem"><i class="ti ti-loader spin"></i> جارٍ التحميل...</td></tr>`;

  // تواريخ افتراضية
  const today = localISO();
  const past  = new Date(); past.setDate(past.getDate()-30);
  const fromEl = document.getElementById('cn-from');
  const toEl   = document.getElementById('cn-to');
  if(fromEl && !fromEl.value) fromEl.value = localISO(past);
  if(toEl   && !toEl.value)   toEl.value   = today;
  const from   = fromEl?.value || localISO(past);
  const to     = toEl?.value   || today;
  const status = document.getElementById('cn-status')?.value || 'all';

  // جيب رسائل نتائج الزيارة من messages
  let url = `${SUPABASE_URL}/rest/v1/messages?notif_type=eq.visit_result&created_at=gte.${from}T00:00:00&created_at=lte.${to}T23:59:59&select=*&order=created_at.desc&limit=300`;
  const data = await fetch(url,{headers:{'apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`}}).then(r=>r.ok?r.json():[]).catch(()=>[]);

  // جيب تأكيدات الاستلام
  let confirmUrl = `${SUPABASE_URL}/rest/v1/messages?notif_type=eq.visit_result_confirmed&created_at=gte.${from}T00:00:00&created_at=lte.${to}T23:59:59&select=*&order=created_at.desc&limit=300`;
  const confirms = await fetch(confirmUrl,{headers:{'apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`}}).then(r=>r.ok?r.json():[]).catch(()=>[]);

  // ربط التأكيدات بالرسائل — التأكيد بيرجع من مشرف البيع لمشرف التنسيق
  // مشرف البيع = from_name في رسالة التأكيد، ومشرف التنسيق = to_rep
  const confirmMap = {};
  confirms.forEach(c=>{ confirmMap[c.to_rep] = c; });

  _cnNotes = data;

  // فلتر الحالة
  let filtered = data;
  if(status==='pending')   filtered = data.filter(n=>!n.is_read);
  if(status==='confirmed') filtered = data.filter(n=>n.is_read);

  // إحصائيات
  document.getElementById('cn-stat-total').textContent     = data.length;
  document.getElementById('cn-stat-pending').textContent   = data.filter(n=>!n.is_read).length;
  document.getElementById('cn-stat-confirmed').textContent = data.filter(n=>n.is_read).length;
  document.getElementById('cn-stat-sups').textContent      = new Set(data.map(n=>n.from_name)).size;

  if(!filtered.length){
    tbody.innerHTML = `<tr><td colspan="7" style="text-align:center;padding:2rem;color:#aaa">لا توجد ملاحظات في هذه الفترة</td></tr>`;
    return;
  }

  tbody.innerHTML = filtered.map((n,i)=>{
    const isConfirmed = n.is_read;
    const date = n.created_at ? new Date(n.created_at).toLocaleDateString('ar-EG',{day:'numeric',month:'short',year:'numeric'}) : '—';
    const preview = (n.message||'').split('\n').slice(0,4).join(' | ').substring(0,120);

    // جيب مشرف البيع اللي أكد
    const confirm = confirms.find(c=>c.to_rep===n.from_name && Math.abs(new Date(c.created_at)-new Date(n.created_at)) < 7*864e5);
    const confirmTime = confirm?.created_at ? new Date(confirm.created_at).toLocaleDateString('ar-EG',{day:'numeric',month:'short',hour:'2-digit',minute:'2-digit'}) : '—';

    return `<tr style="${i%2===0?'background:#FFFDF8':''}">
      <td style="color:var(--text2)">${i+1}</td>
      <td style="font-weight:700;color:#6B1E2E">${n.from_name||'—'}</td>
      <td style="font-size:11px">${date}</td>
      <td style="font-size:11px;max-width:280px;line-height:1.5">${preview}...</td>
      <td>
        <span style="padding:3px 10px;border-radius:20px;font-size:11px;font-weight:700;
          background:${isConfirmed?'#E8F5E9':'#FFF3E0'};color:${isConfirmed?'#1A7A4A':'#E65100'}">
          ${isConfirmed?'✅ تم الاستلام':'⏳ لم يستلم'}
        </span>
      </td>
      <td style="font-size:11px;font-weight:700">${confirm?.from_name||'—'}</td>
      <td style="font-size:10px;color:#8B6F47">${isConfirmed?confirmTime:'—'}</td>
    </tr>`;
  }).join('');
}

