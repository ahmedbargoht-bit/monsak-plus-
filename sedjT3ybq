async function euAddRouteBranch(){
  const route = document.getElementById('eu-route')?.value||'';
  const grp   = document.getElementById('eu-group')?.value||'giza';
  const inp   = document.getElementById('eu-new-branch-name');
  const name  = (inp?.value||'').trim();
  if(!route){ alert('اختر خط السير أولاً'); return; }
  if(!name){ alert('أدخل اسم الفرع'); return; }

  // ── لو الفرع ده موجود بالفعل في النظام — اربطه بالخط الحالي بدل إنشاء فرع مكرر ──
  try{
    const H={'apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`};
    const chkRes = await fetch(`${SUPABASE_URL}/rest/v1/branches?branch_name=eq.${encodeURIComponent(name)}&select=id,branch_name,route&limit=1`,{headers:H});
    const chk = chkRes.ok ? await chkRes.json() : [];
    if(chk.length){
      const existing = chk[0];
      if(existing.route===route){
        alert('الفرع "'+name+'" موجود بالفعل على هذا الخط');
        return;
      }
      const moveMsg = existing.route
        ? `الفرع "${name}" مربوط حالياً بخط "${existing.route}" — هل تريد نقله لهذا الخط بدلاً منه؟`
        : `الفرع "${name}" موجود في النظام بدون خط سير — هل تريد ربطه بهذا الخط؟`;
      if(!confirm(moveMsg)) return;
      const patchRes = await fetch(`${SUPABASE_URL}/rest/v1/branches?id=eq.${existing.id}`,{
        method:'PATCH',
        headers:{'Content-Type':'application/json','apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`,'Prefer':'return=minimal'},
        body: JSON.stringify({route, grp})
      });
      if(patchRes.ok){
        if(inp) inp.value='';
        if(typeof showToast==='function') showToast('✅ تم ربط الفرع "'+name+'" بهذا الخط');
        _allBranchesCache = null;
        euLoadRouteBranches(route);
        if(typeof loadBranches==='function') loadBranches();
        if(typeof rebuildBranchesMap==='function') rebuildBranchesMap();
      } else {
        const err = await patchRes.text();
        alert('فشل الربط: '+err.substring(0,150));
      }
      return;
    }
  }catch(e){}

  // ── فرع جديد بالكامل — أنشئه ──
  try{
    const res = await fetch(`${SUPABASE_URL}/rest/v1/branches`,{
      method:'POST',
      headers:{'Content-Type':'application/json','apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`,'Prefer':'return=minimal'},
      body: JSON.stringify({branch_name:name, route, grp, client_type:'B', status:'active', created_at:new Date().toISOString()})
    });
    if(res.ok){
      if(inp) inp.value='';
      if(typeof showToast==='function') showToast('✅ تم إضافة الفرع: '+name);
      _allBranchesCache = null;
      euLoadRouteBranches(route);
      if(typeof loadBranches==='function') loadBranches();
      if(typeof rebuildBranchesMap==='function') rebuildBranchesMap();
      // امسح كاش فروع المنسقين الثابتين لنفس المجموعة عشان الفرع الجديد يظهر فوراً
      if(typeof _fixedBranchesCache==='object') delete _fixedBranchesCache[grp];
    } else {
      const err = await res.text();
      alert('فشل الإضافة: '+err.substring(0,150));
    }
  }catch(e){ alert('خطأ في الاتصال: '+e.message); }
}

function nuIsFixedType(){
  const t = document.getElementById('nu-type')?.value||'';
  return t==='ثابت' || t==='ثابت كبار عملاء';
