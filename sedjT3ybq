async function splSpecialSave(){
  const type = document.getElementById('spl-sp-type').value;
  const id   = document.getElementById('spl-sp-edit-id').value;
  const name = document.getElementById('spl-sp-name').value.trim();
  if(!name){ alert('أدخل اسم القائمة'); return; }

  if(type==='discount'){
    const disc    = parseFloat(document.getElementById('spl-sp-disc').value)||0;
    const checked = [...document.querySelectorAll('.spl-sp-branch-cb:checked')].map(cb=>cb.value);
    if(disc<=0||disc>100){ alert('أدخل نسبة خصم بين 1 و 100'); return; }
    if(!checked.length){ alert('اختر فرعاً واحداً على الأقل'); return; }
    const entry = {id:id||('pl_'+Date.now()),name,discount_pct:disc,branches:checked,active:true};
    if(id){ const i=_splSpecialLists.findIndex(p=>p.id===id); if(i!==-1) _splSpecialLists[i]={..._splSpecialLists[i],...entry}; }
    else _splSpecialLists.push(entry);
    await splSpecialPersist();
  } else {
    const clients  = splCPLGetClients();
    const products = splCPLGetProducts();
    if(!clients.length){ alert('اختر عميلاً واحداً على الأقل'); return; }
    if(!products.length){ alert('أضف صنفاً واحداً على الأقل بسعره'); return; }
    const entry = {id:id||('cpl_'+Date.now()),name,clients,products,active:true};
    if(id){ const i=_splClientLists.findIndex(p=>p.id===id); if(i!==-1) _splClientLists[i]={..._splClientLists[i],...entry}; }
    else _splClientLists.push(entry);
    await splClientPLPersist();
  }
  splSpecialCloseModal();
  splSpecialRender();
}

async function splSpecialToggle(listType, id, active){
  if(listType==='discount'){
    const pl=_splSpecialLists.find(p=>p.id===id); if(pl){ pl.active=active; await splSpecialPersist(); }
  } else {
    const pl=_splClientLists.find(p=>p.id===id); if(pl){ pl.active=active; await splClientPLPersist(); }
  }
  splSpecialRender();
}

async function splSpecialDelete(listType, id){
  if(listType==='discount'){
    const idx=_splSpecialLists.findIndex(p=>p.id===id); if(idx===-1) return;
    if(!confirm(`حذف قائمة "${_splSpecialLists[idx].name}"؟`)) return;
    _splSpecialLists.splice(idx,1); await splSpecialPersist();
  } else {
    const idx=_splClientLists.findIndex(p=>p.id===id); if(idx===-1) return;
    if(!confirm(`حذف قائمة "${_splClientLists[idx].name}"؟`)) return;
    _splClientLists.splice(idx,1); await splClientPLPersist();
  }
  splSpecialRender();
}

function splSpecialEdit(listType, id){
  const modal = () => { document.getElementById('modal-special-pl').style.display='flex'; document.getElementById('modal-special-pl').onclick=e=>{if(e.target===document.getElementById('modal-special-pl'))splSpecialCloseModal();}; };
  if(listType==='discount'){
    const pl=_splSpecialLists.find(p=>p.id===id); if(!pl) return;
    document.getElementById('spl-sp-edit-id').value=pl.id;
    document.getElementById('spl-sp-name').value=pl.name;
    document.getElementById('spl-sp-disc').value=pl.discount_pct;
    document.getElementById('spl-modal-title').textContent='تعديل: '+pl.name;
    _splCPLProdRows={};
    splSetType('discount');
