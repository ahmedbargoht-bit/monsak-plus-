        method:'DELETE',
        headers:{'apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`}
      });
      if(res.ok){
        showToast(`🗑️ تم حذف ${title}: ${name}`);
        if(typeof reloadFn==='function') reloadFn();
        if(table==='groups'){ loadGroupsFilter(); loadGroupsDropdowns(); }
        if(table==='routes'){ loadRoutesDropdown('cb-route'); loadRoutesDropdown('cs-route'); }
      } else {
        const err=await res.text();
        alert('❌ فشل الحذف: '+err.substring(0,120));
      }
    }catch(e){ alert('❌ خطأ: '+e.message); }
  });
}

