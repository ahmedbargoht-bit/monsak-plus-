function locOnDateChange(){
  const v = document.getElementById('loc-filter-date')?.value;
  const cust = document.getElementById('loc-custom-date');
  if(v==='custom'){ if(cust) cust.style.display=''; }
  else { if(cust){ cust.style.display='none'; cust.value=''; } }
  filterLocations();
