let _orderFilter = 'all';
let _ordersPolling = null;

function setOrderFilter(filter){
  _orderFilter = filter;
  ['all','pending','approved','rejected'].forEach(f=>{
    const btn = document.getElementById('ord-f-'+f);
    if(!btn) return;
    const isActive = (f==='all'&&filter==='all') || (f==='pending'&&filter==='pending_supervisor') || f===filter;
    btn.style.background = isActive?'var(--navy)':'#fff';
    btn.style.color = isActive?'#fff':'var(--text)';
    btn.style.borderColor = isActive?'var(--navy)':'var(--border)';
  });
  renderOrders();
}

function renderOrders(){
  const {orders} = cachedData;
  const today = new Date(); today.setHours(0,0,0,0);

  const pending  = orders.filter(o=>o.status==='pending_supervisor'||o.status==='pending').length;
  const approved = orders.filter(o=>o.status==='approved'||o.status==='done').length;
  const rejected = orders.filter(o=>o.status==='rejected').length;

  const upd = (id,v)=>{ const e=document.getElementById(id); if(e) e.textContent=v; };
  upd('ord-count-pending', pending);
  upd('ord-count-approved', approved);
  upd('ord-count-rejected', rejected);

  let filtered = orders;
  if(_orderFilter==='pending_supervisor') filtered = orders.filter(o=>o.status==='pending_supervisor'||o.status==='pending');
  else if(_orderFilter==='approved')      filtered = orders.filter(o=>o.status==='approved'||o.status==='done');
  else if(_orderFilter==='rejected')      filtered = orders.filter(o=>o.status==='rejected');

  const statusConfig = {
    pending_supervisor: {label:'⏳ بانتظار المشرف', bg:'#FFF3E0', color:'#E65100'},
    pending:            {label:'⏳ معلق',            bg:'#FFF3E0', color:'#E65100'},
    approved:           {label:'✅ معتمد',           bg:'#E8F5E9', color:'#1A7A4A'},
    done:               {label:'✅ تم',              bg:'#E8F5E9', color:'#1A7A4A'},
    rejected:           {label:'❌ مرفوض',           bg:'#FFEBEE', color:'#B71C1C'},
  };

  document.getElementById('orders-list').innerHTML = filtered.slice(0,30).map(o=>{
    const d = new Date(o.arrival_date||o.created_at||new Date()); d.setHours(0,0,0,0);
    const diff = Math.round((d-today)/86400000);
    const tag = diff<0?'<span class="badge b-gray">انتهى</span>':
                diff===0?'<span class="badge b-red">اليوم</span>':
                diff===1?'<span class="badge b-orange">غداً</span>':
                `<span class="badge b-blue">بعد ${diff} أيام</span>`;
