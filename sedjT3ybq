window._pbAllBanners = [];
window._pbClients = [];
window._pbEditingId = null;

async function pbLoadList(){
  try{
    const H = {'apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`};
    const [r, scRes, mapRes] = await Promise.all([
      fetch(`${SUPABASE_URL}/rest/v1/promo_banner?select=*&order=id.desc`,{headers:H}),
      fetch(`${SUPABASE_URL}/rest/v1/sales_clients?select=id,name&order=name.asc`,{headers:H}),
      fetch(`${SUPABASE_URL}/rest/v1/branch_client_map?select=client_name,branch_name&limit=5000`,{headers:H}),
    ]);
    window._pbAllBanners     = r.ok      ? await r.json().catch(()=>[])      : [];
    window._pbSalesClients   = scRes.ok  ? await scRes.json().catch(()=>[])  : [];
    window._pbBranchClientMap= mapRes.ok ? await mapRes.json().catch(()=>[]) : [];
    pbRenderList();
    pbBuildClientDatalist();
  }catch(e){ console.warn('pbLoadList error', e); }
}

function pbRenderList(){
  const wrap = document.getElementById('pb-list');
  if(!wrap) return;
  const rows = window._pbAllBanners||[];
  if(!rows.length){
    wrap.innerHTML = '<div style="font-size:12px;color:#888;padding:12px 0">مفيش بانرات لسه — دوس "بانر جديد" عشان تضيف أول بانر.</div>';
    return;
  }
  const todayStr = localISO();
  wrap.innerHTML = rows.map(row=>{
    const clients = row.target_clients||[];
    const chips = clients.length
      ? clients.map(c=>`<span style="font-size:10px;background:#EEF6FF;color:#003A80;padding:2px 8px;border-radius:6px;font-weight:600;margin-left:4px">${c}</span>`).join('')
      : `<span style="font-size:10px;color:#666">🌍 يوصل للكل</span>`;

    // حالة التاريخ — منتهي/لسه ما جاش وقته/شغال دلوقتي (بالإضافة لعلامة تفعيل البانر اليدوية)
    const isExpired  = !!row.date_to   && row.date_to   < todayStr;
    const isUpcoming = !!row.date_from && row.date_from > todayStr;
    let dateBadge = '';
    if(row.date_from || row.date_to){
      const rangeTxt = `${row.date_from||'—'} ← ${row.date_to||'بلا حد'}`;
      if(isExpired)       dateBadge = `<span style="font-size:10px;padding:2px 8px;border-radius:20px;font-weight:700;background:#FEE2E2;color:#B91C1C;margin-right:6px">⏰ منتهي (${rangeTxt})</span>`;
      else if(isUpcoming) dateBadge = `<span style="font-size:10px;padding:2px 8px;border-radius:20px;font-weight:700;background:#EEF6FF;color:#1D4ED8;margin-right:6px">🗓 لسه ما جاش (${rangeTxt})</span>`;
      else                dateBadge = `<span style="font-size:10px;padding:2px 8px;border-radius:20px;font-weight:700;background:#FFF3E0;color:#E65100;margin-right:6px">🗓 ${rangeTxt}</span>`;
    }

    const statusBadge = (row.active && !isExpired)
      ? `<span style="font-size:11px;padding:2px 10px;border-radius:20px;font-weight:700;background:#EAF3DE;color:#3B6D11">🟢 مفعّل</span>`
      : `<span style="font-size:11px;padding:2px 10px;border-radius:20px;font-weight:700;background:#eee;color:#666">⚪ ${isExpired?'منتهي':'متوقف'}</span>`;

    return `<div style="display:flex;align-items:center;gap:10px;padding:10px 4px;border-bottom:1px solid #F0E6D6">
      ${statusBadge}
      <div style="flex:1;min-width:0">
        <div style="font-weight:700;font-size:13px">${(row.title||'بدون عنوان').replace(/</g,'&lt;')}</div>
        <div style="margin-top:4px">${dateBadge}${chips}</div>
      </div>
      <button class="btn btn-sm" onclick="pbEditBanner(${row.id})"><i class="ti ti-edit"></i></button>
      <button class="btn btn-sm" style="color:#B71C1C" onclick="pbDeleteBanner(${row.id})"><i class="ti ti-trash"></i></button>
    </div>`;
  }).join('');
}

function pbNewBanner(){
  window._pbEditingId = null;
