function aeGetParams(){
  return {
    from:         document.getElementById('ae-from').value,
    to:           document.getElementById('ae-to').value,
    grp:          document.getElementById('ae-group').value,
    type:         document.getElementById('ae-type').value,
    baseFixed:    +document.getElementById('ae-base-fixed').value||1000,
    baseMobile:   +document.getElementById('ae-base-mobile').value||1500,
    transport:    +document.getElementById('ae-transport').value||0,
    effortFixed:  +document.getElementById('ae-effort-fixed').value||5,
    effortMobile: +document.getElementById('ae-effort-mobile').value||5,
    workdays:     +document.getElementById('ae-workdays').value||30,
  };
}

function aeBuildRows(p){
  // فلترة المنسقين
  let reps = [...(REPS||[])];
  if(p.grp !== 'all') reps = reps.filter(r=>r.group===p.grp);
  if(p.type !== 'all') reps = reps.filter(r=>r.coordType===p.type);

  // فلترة الحضور بالفترة
  const attAll = [...(cachedData.attendance||[])];
  const fromDate = p.from ? _parseAnyDate(p.from) : null;
  const toDate   = p.to   ? _parseAnyDate(p.to)   : null;
  if(toDate) toDate.setHours(23,59,59,999);

  const attFiltered = attAll.filter(a=>{
    const d = _parseAnyDate(a.date||'');
    if(!d) return false;
    if(fromDate && d < fromDate) return false;
    if(toDate   && d > toDate)   return false;
    return true;
  });

  // جيب إجازات في الفترة
  const holidays = (cachedData.holidays||[]).filter(h=>{
    const d = _parseAnyDate(h.date||h.day||'');
    if(!d) return false;
    if(fromDate && d < fromDate) return false;
    if(toDate   && d > toDate)   return false;
    return true;
  });
  const holidayCount = holidays.length;

  // بناء صف لكل منسق
  return reps.map((rep,i)=>{
    const repAtt = attFiltered.filter(a=>a.name===rep.name);
    const presentDays = repAtt.filter(a=>a.time_in).length;
    const totalHours  = repAtt.reduce((s,a)=>s+(+a.hours||0),0);

    // أيام الغياب بدون إذن (مش معندوش حضور ومش إجازة)
    const absentDays  = Math.max(0, p.workdays - presentDays - holidayCount);
    const absentNoExcuse = absentDays; // يمكن تطويره لاحقاً

    // تواريخ الغياب
    const absentDates = repAtt.filter(a=>!a.time_in).map(a=>a.date||'').filter(Boolean).join('*');

    const isFixed  = rep.coordType==='ثابت';
    const base     = isFixed ? p.baseFixed  : p.baseMobile;
    const effort   = isFixed ? p.effortFixed: p.effortMobile;

    return {
      num:          i+1,
      code:         rep.code||'###',
      name:         rep.name,
      type:         rep.coordType||'—',
      group:        GROUPS[rep.group]?.label||rep.group||'—',
      base,
      transport:    p.transport,
      effort,
      from:         p.from ? new Date(p.from).toLocaleDateString('en-US') : '',
      to:           p.to   ? new Date(p.to).toLocaleDateString('en-US')   : '',
      presentDays,
      totalHours:   Math.round(totalHours*10)/10,
      holidayDays:  holidayCount,
      absentDays,
      absentNoExcuse,
      penaltyDays:  absentNoExcuse, // يوم جزاء لكل يوم غياب بدون إذن
      absentDates,
    };
  });
}

