  sty(1,0,{font:font(1,13,C.dark),fill:fill(C.gold),alignment:align('center'),border:brd('medium',C.caramel)});
  // Row 2 — info
  sty(2,0,{font:font(0,10,C.caramel,true),fill:fill(C.light),alignment:align('center'),border:brd('thin',C.line)});
  // Row 3 — spacer
  for(let c=0;c<10;c++) sty(3,c,{fill:fill(C.dark)});
  // Row 4 — headers
  for(let c=0;c<10;c++) sty(4,c,{font:font(1,10,C.cream),fill:fill(C.caramel),alignment:align('center'),border:brd('medium',C.dark)});

  // Data rows
  for(let ri=5;ri<aoa.length;ri++){
