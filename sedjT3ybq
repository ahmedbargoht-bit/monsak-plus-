async function sretLoad(){
  const grp    = document.getElementById('sret-grp')?.value||'all';
  const route  = document.getElementById('sret-route')?.value||'all';
  const branch = document.getElementById('sret-branch')?.value||'all';
  const status = document.getElementById('sret-status')?.value||'all';
  const from   = document.getElementById('sret-from')?.value;
  const to     = document.getElementById('sret-to')?.value;
  if(!from||!to) return;

  const tbody = document.getElementById('sret-tbody');
  tbody.innerHTML = '<tr><td colspan="10" style="text-align:center;padding:20px"><div class="spinner" style="margin:0 auto"></div></td></tr>';

  const grpStr = grp==='all' ? Object.keys(GROUPS).join(',') : grp;
  let url = `${SUPABASE_URL}/rest/v1/returns?grp=in.(${grpStr})&select=*&order=created_at.desc&limit=2000`;
  url += `&created_at=gte.${from}T00:00:00&created_at=lte.${to}T23:59:59`;
  if(branch!=='all') url += `&branch=eq.${encodeURIComponent(branch)}`;
  if(status==='pending') url += `&pulled=eq.false`;
  if(status==='pulled')  url += `&pulled=eq.true`;

  let data = [];
  try{
    const r = await fetch(url,{headers:{'apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`}});
    data = await r.json(); if(!Array.isArray(data)) data=[];
  }catch(e){}

  if(route!=='all'){
    const branches = adminGetBranches(grp, route);
    data = data.filter(p=>branches.includes(p.branch));
  }

  // ── Deduplication: نفس الفرع + نفس الصنف + نفس الكمية = صف واحد ──
  const dedupMap = {};
  data.forEach(r=>{
    const key = `${r.branch}|${r.snf}|${r.qty}`;
    if(!dedupMap[key]){
      dedupMap[key] = {...r, _visits: 1};
    } else {
      dedupMap[key]._visits++;
      // احتفظ بأحدث حالة رفع وتأكيد
      if(r.pulled)    { dedupMap[key].pulled=true; dedupMap[key].pulled_by=r.pulled_by; dedupMap[key].pulled_at=r.pulled_at; }
      if(r.confirmed) { dedupMap[key].confirmed=true; dedupMap[key].confirmed_by=r.confirmed_by; dedupMap[key].confirmed_at=r.confirmed_at; }
    }
  });
  const dedupData = Object.values(dedupMap);
  _sretLastData = dedupData; // نخزنها عشان تصدير PDF/Excel يبني منها ملخص دقيق بدل قراءة الجدول

  const pending  = dedupData.filter(r=>!r.pulled);
  const done     = dedupData.filter(r=>r.pulled);
  const totalQty = dedupData.reduce((s,r)=>s+(+r.qty||0),0);

  // KPI
  document.getElementById('sret-kpi').innerHTML = `
    <div class="stat-card red"><div class="stat-n">${dedupData.length}</div><div class="stat-l">إجمالي المرتجعات</div></div>
    <div class="stat-card red"><div class="stat-n">${totalQty}</div><div class="stat-l">إجمالي الوحدات</div></div>
    <div class="stat-card orange"><div class="stat-n">${pending.length}</div><div class="stat-l">⏳ لم يُسحب</div></div>
    <div class="stat-card green"><div class="stat-n">${done.length}</div><div class="stat-l">✅ تم السحب</div></div>`;

  // تنبيه المتأخر
  const lateCount = pending.filter(r=>{ return (Date.now()-new Date(r.created_at).getTime())/864e5 >= 3; }).length;
  const warnEl = document.getElementById('sret-warning');
  if(lateCount>0){ warnEl.style.display=''; warnEl.textContent=`⚠️ ${lateCount} مرتجع منذ أكثر من 3 أيام لم يُسحب بعد`; }
  else warnEl.style.display='none';

  // badge
  setBadgeEl('nav-sret-badge', pending.length);

  tbody.innerHTML = dedupData.map((r,i)=>{
    const isPulled    = !!r.pulled;
    const isConfirmed = !!r.confirmed;
    const days   = Math.floor((Date.now()-new Date(r.created_at).getTime())/864e5);
    const isLate = !isPulled && days>=3;
    const grpInfo = GROUPS[r.grp]||{label:r.grp,color:'#888'};

    // خط السير من ADMIN_ROUTES_DATA
    const rdRow  = ADMIN_ROUTES_DATA.find(x=>x.branch_name===r.branch);
    const routeN = rdRow?.route || r.route || '—';

    // حالة الرفع
    const pullStatus = isPulled
      ? `<div style="font-size:10px;color:#065F46;font-weight:700">✅ تم الرفع</div>
         <div style="font-size:9px;color:#888">${r.pulled_by||'—'}</div>`
      : `<span style="background:#FEE2E2;color:#B91C1C;padding:2px 8px;border-radius:10px;font-size:10px;font-weight:700">⚠️ لم يُرفع${isLate?` (${days}ي)`:''}</span>`;

    // تاريخ الرفع
    const pullDate = r.pulled_at
      ? fmtDate(r.pulled_at)
      : '—';

    // تأكيد السحب
    const confirmCell = isConfirmed
      ? `<div style="font-size:10px;color:#065F46;font-weight:700">✅ تم التأكيد من خلال المشرف ${r.confirmed_by||'—'}</div>
         <div style="font-size:9px;color:#888">${r.confirmed_at?new Date(r.confirmed_at).toLocaleDateString('en-GB',{day:'numeric',month:'short'}):'—'}</div>`
      : isPulled
        ? `<button onclick="sretConfirmPull(${r.id},'${(r.branch||'').replace(/'/g,"\\'")}' )"
            style="background:#1A7A4A;color:#fff;border:none;border-radius:6px;padding:4px 10px;cursor:pointer;font-size:11px;font-family:Cairo,sans-serif;font-weight:700">
            ✅ تأكيد الاستلام
          </button>`
        : `<span style="color:#ccc;font-size:11px">—</span>`;

    const dt = r.created_at ? fmtDate(r.created_at) : '—';

    return `<tr style="${isLate?'background:#FFF0F0':''}">
      <td>${i+1}</td>
      <td><span style="background:${grpInfo.color}22;color:${grpInfo.color};padding:2px 6px;border-radius:8px;font-size:10px;font-weight:700">${grpInfo.label}</span></td>
      <td style="font-size:11px">${routeN}</td>
      <td style="font-size:11px;font-weight:700">${r.branch||'—'}${isLate?`<div style="color:#DC2626;font-size:9px">⚠️ ${days} يوم</div>`:''}</td>
      <td style="font-size:11px;max-width:160px">${r.snf||'—'}</td>
      <td style="text-align:center;font-weight:700;color:#B91C1C">${r.qty||0}</td>
      <td style="text-align:center">
        <span style="background:#EFF6FF;color:#1D4ED8;padding:2px 8px;border-radius:10px;font-size:11px;font-weight:700">${r._visits} زيارة</span>
      </td>
      <td>${pullStatus}</td>
      <td style="font-size:11px;color:#888;text-align:center">${pullDate}</td>
      <td style="text-align:center">${confirmCell}</td>
    </tr>`;
  }).join('') || '<tr><td colspan="9" style="text-align:center;padding:20px;color:#888">لا توجد مرتجعات</td></tr>';
}

async function sretConfirmPull(id, branch){
  if(!confirm(`تأكيد استلام المرتجع من:\n${branch}؟`)) return;
  try{
    await fetch(`${SUPABASE_URL}/rest/v1/returns?id=eq.${id}`,{
      method:'PATCH',
      headers:{'Content-Type':'application/json','apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`,'Prefer':'return=minimal'},
      body:JSON.stringify({
        confirmed:    true,
        confirmed_by: CU?.name||'admin',
        confirmed_at: new Date().toISOString()
      })
    });
    showToast('✅ تم تأكيد استلام المرتجع'); sretLoad();
  }catch(e){ showToast('❌ خطأ في التأكيد'); }
}

