  color:#C8D8A0 !important;
}
/* حقول الإدخال داخل payroll */
.payroll-input{
  accent-color:#C55B48 !important;
}
input[type=checkbox]{accent-color:#C55B48}
input[type=radio]{accent-color:#C55B48}

/* ══ Login Logo ══════════════════════════════════════════════ */
.login-logo h1{color:#4B3C1A !important}
.login-logo p{color:#8B6F47 !important}

/* ══ Card title icon ═════════════════════════════════════════ */
.card-title i{color:#C55B48 !important}
.card-title{color:#2C1F0A}

/* ══ Section headings ════════════════════════════════════════ */
h2,h3{color:#2C1F0A}

/* ══ Stat cards numbers ══════════════════════════════════════ */
.stat-card.blue .stat-n{color:#C55B48 !important}
.stat-card.green .stat-n{color:#6B7A3B !important}
.stat-card.red .stat-n{color:#731E2E !important}
.stat-card.orange .stat-n{color:#C55B48 !important}
