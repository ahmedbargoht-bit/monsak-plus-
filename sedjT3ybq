async function sprodLoad(){
  const grp    = document.getElementById('sprod-grp')?.value||'all';
  const route  = document.getElementById('sprod-route')?.value||'all';
  const branch = document.getElementById('sprod-branch')?.value||'all';
  const rep    = document.getElementById('sprod-rep')?.value||'all';
  const from   = document.getElementById('sprod-from')?.value;
  const to     = document.getElementById('sprod-to')?.value;
  if(!from||!to) return;

  const thead = document.getElementById('sprod-thead');
  const tbody = document.getElementById('sprod-tbody');
  tbody.innerHTML = `<tr><td colspan="10" style="text-align:center;padding:20px"><div class="spinner" style="margin:0 auto"></div></td></tr>`;

  // جيب البيانات من products بـ pagination
  const grpStr = grp==='all' ? Object.keys(GROUPS).join(',') : grp;
  const routeFilter = route!=='all' ? `&route=eq.${encodeURIComponent(route)}` : '';
  const branchFilter = branch!=='all' ? `&branch=eq.${encodeURIComponent(branch)}` : '';
  const repFilter = rep!=='all' ? `&name=eq.${encodeURIComponent(rep)}` : '';
  const baseUrl = `${SUPABASE_URL}/rest/v1/products?grp=in.(${grpStr})&select=name,grp,route,branch,snf,shelf_qty,created_at&order=branch.asc,snf.asc,created_at.asc`
    + `&created_at=gte.${from}T00:00:00&created_at=lte.${to}T23:59:59`
    + routeFilter + branchFilter + repFilter;

  let data = [];
  try{
    const PAGE = 2000;
    let offset = 0;
    while(true){
      const r = await fetch(baseUrl + `&limit=${PAGE}&offset=${offset}`,{
        headers:{'apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`,'Range-Unit':'items'}
      });
      const page = await r.json();
      if(!Array.isArray(page)||!page.length) break;
      data = data.concat(page);
      if(page.length < PAGE) break;
      offset += PAGE;
    }
  }catch(e){}

  // الفلتر اتعمل في Supabase مباشرة

  if(!data.length){
    thead.innerHTML=''; tbody.innerHTML='<tr><td colspan="6" style="text-align:center;padding:20px;color:#888">لا توجد بيانات</td></tr>';
    document.getElementById('sprod-kpi').innerHTML='';
    return;
  }

  // استخرج كل التواريخ الفريدة مرتبة
  const allDates = [...new Set(data.map(p=>p.created_at?.slice(0,10)))].filter(Boolean).sort();

  // حوّل البيانات لـ pivot: branch+snf → {تاريخ: shelf_qty}
  const pivot = {}; // key: branch|snf
  const meta  = {}; // key: branch|snf → {grp, branch, snf, name}
  data.forEach(p=>{
    const key = `${p.branch}|${p.snf}`;
    const dt  = p.created_at?.slice(0,10);
    if(!pivot[key]) pivot[key] = {};
    if(!meta[key])  meta[key]  = {grp:p.grp, branch:p.branch, snf:p.snf, name:p.name||'—'};
    pivot[key][dt] = p.shelf_qty ?? 0;
  });

  // KPI
  const keys = Object.keys(pivot);
  document.getElementById('sprod-kpi').innerHTML = `
    <div class="stat-card"><div class="stat-n">${data.length}</div><div class="stat-l">إجمالي السجلات</div></div>
    <div class="stat-card"><div class="stat-n">${new Set(data.map(x=>x.snf)).size}</div><div class="stat-l">أصناف مختلفة</div></div>
    <div class="stat-card"><div class="stat-n">${new Set(data.map(x=>x.branch)).size}</div><div class="stat-l">فروع</div></div>
    <div class="stat-card"><div class="stat-n">${new Set(data.map(x=>x.name)).size}</div><div class="stat-l">منسقون</div></div>`;

  // بناء الهيدر الديناميكي
  const fmtDt = d => {
    const [y,m,day] = d.split('-');
    return `${parseInt(day)}/${parseInt(m)}`;
  };

  thead.innerHTML = `<tr style="background:#4B3C1A;color:#EDE5D8">
    <th>المجموعة</th>
    <th>الفرع</th>
    <th>الصنف</th>
    ${allDates.map(d=>`<th style="min-width:55px;text-align:center">${fmtDt(d)}</th>`).join('')}
    <th style="min-width:70px;text-align:center;background:#1A7A4A;color:#fff">آخر رصيد</th>
    <th style="min-width:80px;text-align:center">الحركة</th>
  </tr>`;

  // بناء الصفوف
  const rows = keys.map(key=>{
    const m   = meta[key];
    const grpInfo = GROUPS[m.grp]||{label:m.grp,color:'#888'};
    const vals = allDates.map(d => pivot[key][d] ?? null);

    // جيب اسم المنسق من ADMIN_ROUTES_DATA
    const rd = ADMIN_ROUTES_DATA.find(r=>r.branch_name===m.branch);
    const repName = rd?.rep_name || m.name || '—';

    // احسب الحركة: أول رصيد - آخر رصيد (موجب = بيع، سالب = توريد)
    const filled = vals.filter(v=>v!==null);
    const first  = filled[0];
    const last   = filled[filled.length-1];
    const diff   = (first!=null && last!=null) ? (first - last) : null;

    let movBadge = '<span style="color:#aaa;font-size:11px">—</span>';
    if(diff !== null){
      if(diff > 0)       movBadge = `<span style="background:#FEE2E2;color:#B91C1C;padding:2px 8px;border-radius:10px;font-size:11px;font-weight:700">🔴 بيع ${diff}</span>`;
      else if(diff < 0)  movBadge = `<span style="background:#D1FAE5;color:#065F46;padding:2px 8px;border-radius:10px;font-size:11px;font-weight:700">🟢 توريد ${Math.abs(diff)}</span>`;
      else               movBadge = `<span style="background:#F3F4F6;color:#6B7280;padding:2px 8px;border-radius:10px;font-size:11px">لا حركة</span>`;
    }

    const lastVal = last ?? '—';

    return `<tr>
      <td><span style="background:${grpInfo.color}22;color:${grpInfo.color};padding:2px 6px;border-radius:8px;font-size:10px;font-weight:700">${grpInfo.label}</span></td>
      <td style="font-size:11px;font-weight:700">${m.branch}</td>
      <td style="font-size:11px;max-width:180px">${m.snf}</td>
      ${vals.map(v=>`<td style="text-align:center;font-size:12px;font-weight:700;color:${v===null?'#ccc':'#2C1F0A'}">${v??'—'}</td>`).join('')}
      <td style="text-align:center;font-size:13px;font-weight:900;color:#1A7A4A;background:#F0FFF4">${lastVal}</td>
      <td style="text-align:center">${movBadge}</td>
    </tr>`;
  });

  tbody.innerHTML = rows.join('');
}

