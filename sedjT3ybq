    const [routesRes, branchesRes, repsRes] = await Promise.all([
      fetch(`${SUPABASE_URL}/rest/v1/routes?select=name,grp&order=grp.asc,name.asc`, {headers:H}),
      fetch(`${SUPABASE_URL}/rest/v1/branches?select=branch_name,route,grp,client_type,status&status=eq.active&order=route.asc,branch_name.asc`, {headers:H}),
