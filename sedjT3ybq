        <td><span class="badge" style="background:${GROUPS[r.grp]?.color||'#ccc'}22;color:${GROUPS[r.grp]?.color||'#555'}">${GROUPS[r.grp]?.label||r.grp||'—'}</span></td>
        <td style="font-size:11px"><b>${r.branch||'—'}</b></td>
        <td style="font-size:11px;max-width:150px">${r.snf||'—'}</td>
        <td><b style="color:#C0392B">${r.qty||0}</b></td>
