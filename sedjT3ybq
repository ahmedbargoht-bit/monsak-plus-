function exportPDBToExcel(){
  if(!PDB || !Object.keys(PDB).length){
    alert('لا توجد أصناف — ارفع شيت Excel أولاً');
    return;
  }
  const rows = [
    ['اسم الصنف', 'الفئة', 'التصنيف', 'المجموعة الفرعية', 'فعال']
  ];
  // بنفس الترتيب: فئة ← تصنيف ← مجموعة فرعية ← أصناف
  Object.entries(PDB).forEach(([fea, cats])=>{
    Object.entries(cats).forEach(([cat, grps])=>{
      Object.entries(grps).forEach(([grp, prods])=>{
        (prods||[]).forEach(snf=>{
          rows.push([snf, fea, cat, grp, 'نعم']);
        });
      });
    });
  });

  const wb = XLSX.utils.book_new();
  const ws = XLSX.utils.aoa_to_sheet(rows);

  // تنسيق الأعمدة
  ws['!cols'] = [{wch:45},{wch:12},{wch:20},{wch:25},{wch:8}];

  // لون الهيدر
  const headerStyle = {font:{bold:true}, fill:{fgColor:{rgb:'003A80'}}, alignment:{horizontal:'center'}};
  ['A1','B1','C1','D1','E1'].forEach(cell=>{
    if(ws[cell]) ws[cell].s = headerStyle;
  });

  XLSX.utils.book_append_sheet(wb, ws, 'قاعدة الأصناف');
  const total = rows.length - 1;
  XLSX.writeFile(wb, `قاعدة_الأصناف_${total}_صنف_${new Date().toLocaleDateString('en-US').replace(/\//g,'-')}.xlsx`);
}

function downloadTemplate(){
  // بناء خريطة المجموعة ← اسم المشرف
  const grpToSup = {};
  const supList = SUPERVISORS.length ? SUPERVISORS : Object.values(USERS_DB_FALLBACK||{});
  supList.forEach(s=>{
    if(s.level==='sup' && s.groups){
      s.groups.forEach(g => { if(!grpToSup[g]) grpToSup[g] = s.name; });
    }
  });
  // Fallback من الـ Hardcoded
  const fallbackSup = {
    giza:'حمدى محمد ربيع', cairo:'احمد علاء هنداوى',
    south:'مصطفى مهدى يوسف', tajmuat:'عمر احمد عبد العظيم',
    hyper:'عبد العظيم محمد عبد العظيم'
  };
  Object.entries(fallbackSup).forEach(([g,n])=>{ if(!grpToSup[g]) grpToSup[g]=n; });

  // هيدر الشيت
  const rows = [
    ['اسم المشرف','اسم المنسق','خط السير','اسم الفرع','نوع المنسق','الباسورد','المجموعة']
  ];

  // بناء الصفوف من REPS + BRANCHES_MAP
  const repsToExport = REPS.length ? REPS : [];
  repsToExport.forEach(rep=>{
    const supName = grpToSup[rep.group] || '';
    const branches = BRANCHES_MAP[rep.route] || [];
    if(branches.length){
      branches.forEach((branch, idx)=>{
        rows.push([
          idx===0 ? supName : '',
          idx===0 ? rep.name : '',
          idx===0 ? (rep.route||'') : '',
          branch,
          idx===0 ? (rep.type||'متحرك') : '',
          idx===0 ? (rep.pass||'') : '',
          idx===0 ? (rep.group||'') : ''
        ]);
      });
    } else {
      // منسق بدون فروع
      rows.push([supName, rep.name, rep.route||'', '', rep.type||'متحرك', rep.pass||'', rep.group||'']);
    }
  });

  // لو مفيش منسقين — اعمل نموذج فاضي
  if(repsToExport.length === 0){
    rows.push(['حمدى محمد ربيع','هاني طارق فتحى','خط سير 6اكتوبر','العثيم -سكوير وان','متحرك','1429','giza']);
    rows.push(['','','','الفرجانى - اكتوبر','','','']);
    rows.push(['💡 كل فرع في صف منفصل — اترك باقي الخلايا فاضية لنفس المنسق','','','','','','']);
  }

  const wb = XLSX.utils.book_new();
  const ws = XLSX.utils.aoa_to_sheet(rows);
  ws['!cols'] = [{wch:30},{wch:28},{wch:35},{wch:28},{wch:13},{wch:12},{wch:12}];
  XLSX.utils.book_append_sheet(wb, ws, 'بيانات المنسقين');

  // شيت ثاني — المشرفين
  const supRows = [['اسم المشرف','المجموعة','الدور','الباسورد']];
  supList.filter(s=>s.level==='sup'||s.level==='dm'||s.level==='gm').forEach(s=>{
    supRows.push([s.name, (s.groups||[]).join(','), s.role||s.level, s.pass||'']);
  });
  if(supRows.length > 1){
    const ws2 = XLSX.utils.aoa_to_sheet(supRows);
    ws2['!cols'] = [{wch:30},{wch:20},{wch:25},{wch:12}];
    XLSX.utils.book_append_sheet(wb, ws2, 'المشرفون والمديرون');
  }

  const date = new Date().toLocaleDateString('en-US').replace(/\//g,'-');
  XLSX.writeFile(wb, `بيانات_المنظومة_${date}.xlsx`);
}

