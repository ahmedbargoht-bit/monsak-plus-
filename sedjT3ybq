// ── استيراد من Excel بنفس قالب "مقارنة العقود" (كل شيت = عميل) ──
async function caImportExcel(evt){
  const file = evt.target.files[0];
  if(!file) return;
  evt.target.value = '';
  try{
    const buf = await file.arrayBuffer();
    const wb = XLSX.read(buf, {type:'array'});
    const clientsData = {};
    wb.SheetNames.forEach(sn=>{
      const ws = wb.Sheets[sn];
      const rows = XLSX.utils.sheet_to_json(ws, {header:1, raw:true, defval:null});
      const clientName = (sn||'').trim();
      if(!clientName) return;
      const items = caParseSheetRows(rows);
      if(items.length) clientsData[clientName] = items;
    });
    const names = Object.keys(clientsData);
    if(!names.length){ showToast('❌ مفيش بيانات متعرفة في الملف — تأكد إنه بنفس قالب مقارنة العقود'); return; }
    if(!confirm(`هيتم استيراد ${names.length} عميل من الملف (${names.join('، ')}). أي بيانات قديمة لنفس اسم العميل هتتمسح وتتستبدل بالجديدة. تكمل؟`)) return;
    for(const [clientName, items] of Object.entries(clientsData)){
      await caImportClientData(clientName, items);
    }
    showToast(`✅ تم استيراد ${names.length} عميل بنجاح`);
    await caLoadClients();
  }catch(e){ showToast('❌ فشل قراءة الملف: '+e.message); }
}

function caParseSheetRows(rows){
  const norm = v => {
    if(v===null||v===undefined) return null;
    if(typeof v==='string'){ const t=v.trim(); return t===''?null:t; }
    return v;
  };
  const R = rows.map(r=>[0,1,2,3,4,5,6,7].map(i=> norm(r? r[i] : null)));
  const items = [];
  let sortOrder = 0;

  R.forEach(r=>{
    const b = r[1];
    if(b && String(b).includes('محقق') && String(b).includes('بدون')){
      items.push({section:'summary', item_name:'محقق بدون الخصم', value_2025:r[3], extra_2025:null, value_2026:null, extra_2026:null, sort_order:sortOrder++});
    }
    if(b && String(b).includes('محقق') && String(b).includes('بعد')){
      items.push({section:'summary', item_name:'محقق بعد الخصم', value_2025:r[3], extra_2025:null, value_2026:null, extra_2026:null, sort_order:sortOrder++});
    }
  });

  const headerIdxs = [];
  R.forEach((r,i)=>{ if(r[1] && String(r[1]).trim()==='البيان') headerIdxs.push(i); });
  const sectionsMap = ['fixed','percentage','tier'];
  headerIdxs.slice(0,3).forEach((hi, idx)=>{
    const sec = sectionsMap[idx];
    let j = hi+1;
    while(j < R.length){
      const r = R[j];
      const b = r[1];
      if(b===null||b===undefined){ j++; continue; }
      const bs = String(b).trim();
      if(bs.startsWith('اجمالي')){
        items.push({section:sec, item_name:bs, value_2025:r[2], extra_2025:r[3], value_2026:r[6], extra_2026:r[7], sort_order:sortOrder++});
        j++; break;
      }
      if(bs.startsWith('فترة الائتمان') || bs==='البيان') break;
      items.push({section:sec, item_name:bs, value_2025:r[2], extra_2025:r[3], value_2026:r[6], extra_2026:r[7], sort_order:sortOrder++});
      j++;
    }
  });

  for(const r of R){
    const b = r[1];
    if(b && String(b).trim().startsWith('فترة الائتمان')){
      const f = r[5];
      items.push({section:'credit', item_name:'فترة الائتمان', value_2025:null, extra_2025:String(b).trim(), value_2026:null, extra_2026: f?String(f).trim():null, sort_order:sortOrder++});
      break;
    }
  }
  return items;
}

async function caImportClientData(clientName, items){
  const H = {'apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`,'Content-Type':'application/json'};
  let clientId;
  const existing = _caClients.find(c=>c.name===clientName);
  if(existing){
    clientId = existing.id;
    await fetch(`${SUPABASE_URL}/rest/v1/contract_items?client_id=eq.${clientId}`,{method:'DELETE',headers:H});
  } else {
    const r = await fetch(`${SUPABASE_URL}/rest/v1/contract_clients`,{method:'POST',headers:{...H,'Prefer':'return=representation'},body:JSON.stringify({name:clientName})});
    if(!r.ok) return;
    const data = await r.json();
    clientId = data[0].id;
  }
  const toStr = v => (v===null||v===undefined) ? null : String(v);
  const payload = items.map(it=>({
    client_id: clientId,
    section: it.section,
    item_name: it.item_name,
    value_2025: toStr(it.value_2025),
    value_2026: toStr(it.value_2026),
    extra_2025: toStr(it.extra_2025),
    extra_2026: toStr(it.extra_2026),
    sort_order: it.sort_order
  }));
  if(payload.length){
    await fetch(`${SUPABASE_URL}/rest/v1/contract_items`,{method:'POST',headers:H,body:JSON.stringify(payload)});
  }
}

