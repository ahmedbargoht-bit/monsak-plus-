// ── تنزيل لوحة التحكم ────────────────────────────────────────
async function downloadDashboard(){
  const btn = event?.currentTarget;
  if(btn){ btn.innerHTML='<i class="ti ti-loader-2" style="animation:spin 1s linear infinite"></i>'; btn.disabled=true; }
  try{
    // أولاً نجرب نجيب الملف من السيرفر
    const res = await fetch(location.href, {cache:'reload'});
    if(res.ok){
      const text = await res.text();
      _triggerDownload(text);
    } else {
      throw new Error('fetch failed');
    }
  }catch(e){
    // fallback: نستخدم الـ DOM الحالي
    const html = '<!DOCTYPE html>\n' + document.documentElement.outerHTML;
    _triggerDownload(html);
  }
  if(btn){ btn.innerHTML='<i class="ti ti-download"></i>'; btn.disabled=false; }
}

function _triggerDownload(htmlContent){
  const today = localISO();
  const blob  = new Blob([htmlContent], {type:'text/html;charset=utf-8'});
  const url   = URL.createObjectURL(blob);
  const a     = document.createElement('a');
  a.href      = url;
  a.download  = `لوحة_التحكم_${today}.html`;
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
  setTimeout(()=>URL.revokeObjectURL(url), 10000);
}

