  if(id==='sales-missing'){ smissInitFilters().then(()=>smissLoad()); }
  if(id==='sales-expiry-report'){ serInit(); }
  if(id==='letters-archive') archiveInit();
  if(id==='sales-archive') salesArchiveInitDates();
  // شاشة "اللوكيشن المباشر" حسّاسة للبيانات القديمة — جدد الحضور واللوكيشن فوراً كل ما الأدمن يفتحها
  // (بدل ما يعتمد بس على الـ 5 دقايق التلقائية اللي ممكن تتوقف لو التاب فضل في الخلفية فترة)
  if(id==='location') refreshAll();
  renderCurrentPanel();
}

