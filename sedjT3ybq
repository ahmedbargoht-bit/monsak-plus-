let _splClients      = [];
let _splBranchMap    = [];
let _splPdbRaw       = {};
let _splProducts     = [];
let _splPrices       = [];
let _splBranches     = [];
let _splCatDiscounts = [];
let _splPromos       = [];

// إعادة بناء _splProducts (المستخدمة في تسعير الأصناف) من PDB مباشرة في الذاكرة — من غير رحلة
// شبكة جديدة لـ Supabase — بتتنادى بعد أي تعديل في "قاعدة الأصناف الكاملة" (إضافة/تعديل/حذف/رفع Excel)
// عشان قسم التسعير في نفس التاب يفضل متزامن فورًا مع قسم القاعدة فوقه.
function splSyncProductsFromPDB(){
  _splPdbRaw = PDB||{};
  _splProducts = [];
  const seen = new Set();
  Object.entries(PDB||{}).forEach(([fea, cats])=>{
    Object.entries(cats||{}).forEach(([cat, grps])=>{
      Object.values(grps||{}).forEach(arr=>{
        (arr||[]).forEach(item=>{
          const name = typeof item==='object' ? (item.name||'') : String(item||'');
          if(name && !seen.has(name)){ seen.add(name); _splProducts.push({name, fea, cat}); }
        });
      });
    });
  });
  _splProducts.sort((a,b)=>a.name.localeCompare(b.name,'ar'));
  const feaSel = document.getElementById('spl-pfea');
  if(feaSel){
    const feas = [...new Set(_splProducts.map(p=>p.fea).filter(Boolean))].sort();
    const cur = feaSel.value;
    feaSel.innerHTML = '<option value="all">كل الأنواع</option>' + feas.map(f=>`<option value="${f}">${f}</option>`).join('');
    feaSel.value = feas.includes(cur) ? cur : 'all';
  }
  renderProdDB();
}

async function spLoadAll(){
  const H = {'apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`};

  // قاعدة الأصناف الكاملة (منقولة هنا من التاب القديم) — تحمّل وترندر مستقلة عن باقي بيانات
  // التسعير عشان لو فشلت لأي سبب متوقفش باقي التاب.
  loadPDBFromSupabase().then(()=>{
    buildPDBPills();
    renderPDBPanel();
    const now = new Date().toLocaleString('ar-EG');
    const lbl = document.getElementById('pdb-last-update');
    if(lbl) lbl.textContent = 'آخر تحديث: ' + now;
  });

  const [pdbRes, pricesRes, clientsRes, mapRes, bRes, cdRes, promosRes] = await Promise.all([
    fetch(`${SUPABASE_URL}/rest/v1/products_db?select=value&key=eq.pdb`, {headers:H}),
    fetch(`${SUPABASE_URL}/rest/v1/sales_prices?select=*&order=snf_name.asc&limit=2000`, {headers:H}),
    fetch(`${SUPABASE_URL}/rest/v1/sales_clients?select=*&deleted_at=is.null&order=name.asc`, {headers:H}),
    fetch(`${SUPABASE_URL}/rest/v1/branch_client_map?select=*&order=branch_name.asc&limit=2000`, {headers:H}),
    fetch(`${SUPABASE_URL}/rest/v1/branches?select=branch_name,grp,route&status=eq.active&order=branch_name.asc&limit=2000`, {headers:H}).then(async r=>{
      if(!r.ok) return [];
      const data = await r.json();
      return [...new Map(data.map(b=>[b.branch_name, b])).values()];
    }),
    fetch(`${SUPABASE_URL}/rest/v1/client_category_discounts?select=*&deleted_at=is.null&order=client_name.asc&limit=2000`, {headers:H}),
    fetch(`${SUPABASE_URL}/rest/v1/sales_promotions?select=*&deleted_at=is.null&order=date_from.desc&limit=2000`, {headers:H}),
  ]);

  // استخرج الأصناف مع fea وcat
  _splProducts = [];
  _splPdbRaw = {};
  if(pdbRes.ok){
    const pdbData = await pdbRes.json();
    if(pdbData && pdbData[0] && pdbData[0].value){
      try{
        const pdb = JSON.parse(pdbData[0].value);
        _splPdbRaw = pdb;
        const seen = new Set();
        Object.entries(pdb).forEach(([fea, cats])=>{
          Object.entries(cats||{}).forEach(([cat, grps])=>{
            Object.values(grps||{}).forEach(arr=>{
              (arr||[]).forEach(item=>{
                const name = typeof item==='object' ? (item.name||'') : String(item||'');
                if(name && !seen.has(name)){ seen.add(name); _splProducts.push({name, fea, cat}); }
              });
            });
          });
        });
        _splProducts.sort((a,b)=>a.name.localeCompare(b.name,'ar'));
      }catch(e){ console.error('PDB parse error',e); }
    }
  }

  _splPrices    = pricesRes.ok  ? await pricesRes.json()  : [];
  _splClients   = clientsRes.ok ? await clientsRes.json() : [];
  _splBranches  = Array.isArray(bRes) ? bRes : [];
  _splBranches  = [...new Map(_splBranches.map(b=>[b.branch_name, b])).values()];
  _splBranchMap = mapRes.ok ? await mapRes.json() : [];
  // أضيف grp و route من _splBranches
  _splBranchMap = _splBranchMap.map(m=>{
    const br = _splBranches.find(b=>b.branch_name===m.branch_name)||{};
    return {...m, grp:br.grp||'', route:br.route||''};
  });
  _splCatDiscounts = cdRes.ok     ? await cdRes.json()      : [];
  _splPromos       = promosRes.ok ? await promosRes.json()  : [];

  // ملء فلاتر النوع والتصنيف
  const feaSel = document.getElementById('spl-pfea');
  if(feaSel){
    const feas = [...new Set(_splProducts.map(p=>p.fea).filter(Boolean))].sort();
    feaSel.innerHTML = '<option value="all">كل الأنواع</option>' +
      feas.map(f=>`<option value="${f}">${f}</option>`).join('');
  }
  renderProdDB();

  // ملء قائمة العملاء في الربط
  const mapClient = document.getElementById('spl-map-client');
  if(mapClient){
    mapClient.innerHTML = '<option value="">اختر العميل أولاً...</option>' +
      _splClients.map(c=>`<option value="${c.name}">${c.name} (${c.discount_pct}%)</option>`).join('');
  }
  document.getElementById('spl-map-branch-wrap').style.display='none';

  // ملء فلتر العميل في جدول الفروع
  const mapClientFilter = document.getElementById('spl-map-client-filter');
  const mapGrpFilter    = document.getElementById('spl-map-grp-filter');
  if(mapClientFilter){
    const current = mapClientFilter.value;
    mapClientFilter.innerHTML = '<option value="all">كل العملاء</option>' +
      _splClients.map(c=>`<option value="${c.name}">${c.name}</option>`).join('');
    if(current) mapClientFilter.value = current;
  }
  if(mapGrpFilter){
    const grps = [...new Set(_splBranchMap.map(m=>m.grp).filter(Boolean))].sort();
    mapGrpFilter.innerHTML = '<option value="all">كل المجموعات</option>' +
      grps.map(g=>`<option value="${g}">${g}</option>`).join('');
