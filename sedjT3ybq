}

function sgEditGoalRow(repId){
  const inp = document.querySelector(`.sg-goal-inp[data-id="${repId}"]`);
  if(!inp) return;
  inp.focus();
  inp.select();
  inp.style.border = '2px solid #185FA5';
  inp.style.background = '#EAF0FB';
  setTimeout(()=>{ inp.style.border=''; inp.style.background=''; }, 2000);
}

async function sgDeleteGoal(encodedName, tgtId, repId){
  const name = decodeURIComponent(encodedName);
  if(!confirm(`هل تريد مسح هدف "${name}"؟`)) return;
  const H = {'Content-Type':'application/json','apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`,'Prefer':'return=minimal'};

  try{
    // لو مفيش id في الداتابيز - صفّر محلياً فقط
    if(!tgtId || tgtId==='null'){
      delete _sgData.targets[name];
      const inp = document.querySelector(`.sg-goal-inp[data-id="${repId}"]`);
      if(inp){ inp.value=0; inp.dataset.tgtId=''; }
      const dailyEl = document.getElementById('sg-daily-'+repId);
      if(dailyEl) dailyEl.textContent='—';
      showToast(`🗑️ تم مسح هدف ${name}`);
      sgRender();
      return;
    }
    // حذف ناعم — بيعلّم الهدف كمحذوف بدل ما يمسحه فعلياً من القاعدة
    const res = await fetch(`${SUPABASE_URL}/rest/v1/rep_targets?id=eq.${tgtId}`,{method:'PATCH',headers:H,body:JSON.stringify({deleted_at:new Date().toISOString()})});
    if(res.ok || res.status===204){
      delete _sgData.targets[name];
      const inp = document.querySelector(`.sg-goal-inp[data-id="${repId}"]`);
      if(inp){ inp.value=0; inp.dataset.tgtId=''; }
      const dailyEl = document.getElementById('sg-daily-'+repId);
      if(dailyEl) dailyEl.textContent='—';
      showToast(`🗑️ تم مسح هدف ${name}`);
      sgRender();
    } else {
      const e = await res.text();
      showToast('❌ فشل المسح: '+e.substring(0,80));
    }
  }catch(e){ showToast('❌ '+e.message); }
}

async function sgDeleteUser(repId, encodedName){
  const name = decodeURIComponent(encodedName);
  if(!confirm(`⚠️ حذف المندوب "${name}" نهائياً من النظام؟\nسيتم حذف بياناته وأهدافه بالكامل.`)) return;
  const H = {'apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`,'Prefer':'return=minimal'};
  try{
    // مسح الأهداف أولاً
    await fetch(`${SUPABASE_URL}/rest/v1/rep_targets?rep_name=eq.${encodeURIComponent(name)}`,{method:'DELETE',headers:H});
    // مسح المندوب من users
    const res = await fetch(`${SUPABASE_URL}/rest/v1/users?id=eq.${repId}`,{method:'DELETE',headers:H});
    if(res.ok || res.status===204){
      showToast(`✅ تم حذف المندوب ${name} نهائياً`);
      // حدّث البيانات المحلية
      if(_sgData.reps) _sgData.reps = _sgData.reps.filter(r=>r.id!=repId);
      delete _sgData.targets[name];
      sgRender();
    } else {
      const e = await res.text();
      showToast('❌ فشل الحذف: '+e.substring(0,80));
    }
  }catch(e){ showToast('❌ '+e.message); }
}

function sgUpdateDaily(inp, workDays){
  const val = parseInt(inp.value)||0;
  const id = inp.dataset.id;
  const daily = workDays>0&&val>0 ? Math.round(val/workDays) : 0;
  const el = document.getElementById('sg-daily-'+id);
  if(el) el.textContent = daily>0 ? daily.toLocaleString('en-US')+' ج' : '—';
  // حدّث الـ targets map
  const name = inp.dataset.name;
  if(!_sgData.targets[name]) _sgData.targets[name]={rep_name:name,goal:0};
  _sgData.targets[name].goal = val;
}

async function sgSaveAll(){
  const BASE_H = {'apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`,'Content-Type':'application/json','Prefer':'return=minimal'};
  const monthSel = document.getElementById('sg-month');
  const [yr,mo] = monthSel.value.split('-').map(Number);
  const inputs = document.querySelectorAll('.sg-goal-inp');
  if(!inputs.length){ showToast('لا توجد بيانات للحفظ'); return; }

  const toInsert = [];
  const toUpdate = []; // [{tgtId, goal}]

  inputs.forEach(inp=>{
    const name   = inp.dataset.name;
    const repId  = parseInt(inp.dataset.id)||null;
    const goal   = parseInt(inp.value)||0;
    const tgtId  = inp.dataset.tgtId;
    const sup    = _sgData.reps.find(r=>r.name===name)?.supervisors||null;
    if(tgtId && tgtId!=='null' && tgtId!==''){
      toUpdate.push({ tgtId, goal });
    } else {
      const wd = parseInt(document.getElementById('sg-workdays-sel')?.value)||26;
      toInsert.push({ rep_name:name, month:`${yr}-${String(mo).padStart(2,'0')}`, target_amount:goal, supervisor_name:sup, work_days:wd });
    }
  });

  try{
    let ok = true;
    // INSERT الجديد
    if(toInsert.length){
