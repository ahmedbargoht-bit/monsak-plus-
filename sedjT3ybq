  const item=arr[k.idx];
  const snf=typeof item==='object'?(item.name||JSON.stringify(item)):String(item);
  arr.splice(k.idx,1);
  try{ localStorage.setItem('pdb_cache',JSON.stringify(PDB)); }catch(e){}
