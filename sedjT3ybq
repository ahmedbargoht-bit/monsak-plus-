        <div style="display:flex;gap:4px">
          <button onclick="editSalesStaff('${u.id}')" class="btn btn-sm" style="background:#E3F2FD;color:#1565C0"><i class="ti ti-edit"></i></button>
          <button onclick="toggleSalesStaff('${u.id}',${u.active})" class="btn btn-sm" style="background:${u.active?'#FFF8E1':'#E8F5E9'};color:${u.active?'#E65100':'#1A7A4A'}">
