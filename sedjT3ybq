let SUPERVISORS = []; // يتملى من loadSupervisors()

const LEVEL_LABELS = {gm:'مدير عام', dm:'مدير تنسيق', sup:'مشرف'};
const LEVEL_COLORS = {gm:'#D62828', dm:'#005CBF', sup:'#1A7A4A'};

async function loadSupervisors(){
  const H = {'apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`};
  SUPERVISORS = [];

  try{
    // المصدر الوحيد: جدول staff
    const [staffRes, usersRes] = await Promise.all([
      fetch(`${SUPABASE_URL}/rest/v1/staff?select=*&active=eq.true&order=id.asc`,{headers:H}),
      // فريق التنسيق عنده role='supervisor' وفريق المبيعات عنده role='sales' في users —
      // لازم الاتنين هنا وإلا باسورد فريق المبيعات مش هيظهر أبداً حتى لو اتحفظ صح
      fetch(`${SUPABASE_URL}/rest/v1/users?select=name,pass_hash,supervisors&role=in.(supervisor,sales)`,{headers:H})
    ]);
    const staffData = staffRes.ok ? await staffRes.json().catch(()=>[]) : [];
    const usersData = usersRes.ok ? await usersRes.json().catch(()=>[]) : [];

    // map الباسورد والصلاحيات من users بالاسم
    const usersMap = {};
    (Array.isArray(usersData)?usersData:[]).forEach(u=>{
      usersMap[u.name] = {pass: u.pass_hash||'—', supervisors: u.supervisors||null};
    });

    // بناء SUPERVISORS من staff فقط
    SUPERVISORS = (Array.isArray(staffData)?staffData:[]).map(u=>{
      const userData = usersMap[u.name]||{};
      const grp = Array.isArray(u.grp) ? u.grp : (u.grp||'').replace(/[{}"]/g,'').split(',').filter(Boolean);
      const appAccess = Array.isArray(u.app_access) ? u.app_access : [];
      const level = u.role==='gm'?'gm': u.role.includes('manager')?'dm':'sup';
      // المسمى الوظيفي
      const userType = ROLE_LABELS_MAP[u.role] || u.role;
      // نوع التطبيق
      const appType = appAccess.some(a=>a.includes('sales')) ? 'sales' : 'coord';
      return {
        id:         u.id,
        name:       u.name,
        pass:       userData.pass || '—',
        role:       u.role,
        user_type:  userType,
        level,
        groups:     grp,
        status:     u.active ? 'active' : 'inactive',
        source:     'staff',
        notes:      u.notes||'',
        reports_to: u.reports_to||null,
        app_access: appAccess,
        app_type:   appType,
        supervisors: userData.supervisors||null,
      };
    });

  }catch(e){
    console.warn('loadSupervisors error:', e);
  }
  renderSupervisors();
}

const ROLE_LABELS_MAP = {
  'gm':'مدير عام','merch_manager':'مدير التنسيق','sales_manager':'مدير البيع',
  'hyper_sup':'مشرف الهايبر','group_sup':'مشرف المجموعة',
  'merch_sup':'مشرف التنسيق','special_sup':'مشرف الأسواق الخاصة',
  'hyper_sales_sup':'مشرف بيع هايبر','supervisor':'مشرف'
};
const ROLE_COLORS_MAP = {
  'gm':'#D62828','merch_manager':'#005CBF','sales_manager':'#1A7A4A',
  'hyper_sup':'#6B3D15','group_sup':'#4A1942','merch_sup':'#005CBF',
  'special_sup':'#C55B48','hyper_sales_sup':'#1A7A4A','supervisor':'#555'
};

function renderSupervisors(){
  const tbody = document.getElementById('supervisors-table');
  if(!tbody) return;
  if(!SUPERVISORS.length){
    tbody.innerHTML='<tr><td colspan="8" style="text-align:center;padding:1rem;color:var(--text2)">لا توجد بيانات</td></tr>';
    return;
  }

  // تقسيم: تنسيق vs بيع
  const coordRoles = ['merch_sup','merch_manager','hyper_sup','special_sup'];
  const salesRoles  = ['group_sup','sales_manager','hyper_sales_sup'];
  const coordTeam  = SUPERVISORS.filter(s=>coordRoles.includes(s.role)||s.app_type==='coord');
  const salesTeam  = SUPERVISORS.filter(s=>salesRoles.includes(s.role)||s.app_type==='sales');
  const otherTeam  = SUPERVISORS.filter(s=>!coordTeam.includes(s)&&!salesTeam.includes(s));

  let html = '';
  const renderRow = (sup, i) => {
    const roleClr  = ROLE_COLORS_MAP[sup.role] || '#666';
    const levelClr = LEVEL_COLORS[sup.level] || roleClr;
    const roleLabel= sup.user_type || ROLE_LABELS_MAP[sup.role] || sup.role;
    const groups   = Array.isArray(sup.groups)?sup.groups:(sup.groups||'').split(',').filter(Boolean);
    const grpBadges= groups.map(g=>`<span class="badge" style="background:${GROUPS[g]?.color||'#ccc'}22;color:${GROUPS[g]?.color||'#555'};font-size:10px">◆ ${GROUPS[g]?.label||g}</span>`).join(' ');
    const statusBadge = sup.status==='active'?'<span class="badge b-green">نشط</span>':'<span class="badge b-gray">موقوف</span>';
    const appBadge = sup.app_access?.length
      ? sup.app_access.map(a=>`<span style="background:#E3F2FD;color:#0D47A1;padding:1px 5px;border-radius:4px;font-size:9px">${a}</span>`).join(' ')
      : '—';
    const idx = SUPERVISORS.indexOf(sup);
    return `<tr style="${sup.status!=='active'?'opacity:.5':''}">
      <td>${i+1}</td>
      <td><b>${sup.name}</b>${sup.notes?`<div style="font-size:10px;color:#aaa">${sup.notes}</div>`:''}</td>
      <td><span style="font-size:11px;font-weight:700;color:${levelClr}">${roleLabel}</span></td>
      <td><code style="background:#f5f5f5;padding:2px 6px;border-radius:4px;font-size:11px">${sup.pass}</code></td>
      <td style="font-size:11px">${grpBadges||'—'}</td>
      <td style="font-size:10px">${appBadge}</td>
      <td>${statusBadge}</td>
      <td>
        <div style="display:flex;gap:4px">
          <button class="btn btn-ghost btn-xs" onclick="supEditDispatch(${idx})" title="تعديل"><i class="ti ti-edit"></i></button>
          <button class="btn btn-xs" style="background:${sup.status==='active'?'#FFF3E0':'#E8F5E9'};color:${sup.status==='active'?'#E65100':'#1B5E20'}" onclick="supToggleDispatch(${idx})">${sup.status==='active'?'إيقاف':'تفعيل'}</button>
          <button class="btn btn-xs" style="background:#FFEBEE;color:#B71C1C" onclick="supDeleteDispatch(${idx})" title="حذف"><i class="ti ti-trash"></i></button>
          <button class="btn btn-xs" style="background:#E3F2FD;color:#0D47A1" onclick="openStaffPermissions(${idx})" title="الصلاحيات"><i class="ti ti-key"></i></button>
        </div>
      </td>
    </tr>`;
  };

  if(coordTeam.length){
    html += `<tr><td colspan="8" style="background:linear-gradient(135deg,#2D4A1A,#1A3A0A);color:#C8D8A0;font-size:11px;font-weight:700;padding:6px 12px">🧑‍💼 فريق التنسيق الميداني</td></tr>`;
    coordTeam.forEach((s,i)=>{ html += renderRow(s,i+1); });
  }
  if(salesTeam.length){
    html += `<tr><td colspan="8" style="background:linear-gradient(135deg,#1A2A4A,#0A1A3A);color:#C0C8D8;font-size:11px;font-weight:700;padding:6px 12px">💼 فريق المبيعات</td></tr>`;
    salesTeam.forEach((s,i)=>{ html += renderRow(s,i+1); });
  }
  if(otherTeam.length){
    html += `<tr><td colspan="8" style="background:#3D2E0F;color:#EDE5D8;font-size:11px;font-weight:700;padding:6px 12px">🏢 المديرون والمشرفون الإداريون</td></tr>`;
    otherTeam.forEach((s,i)=>{ html += renderRow(s,i+1); });
  }

  tbody.innerHTML = html;
}
function openEditSup(idx){
  const s = SUPERVISORS[idx];
  // لو من staff — جيب id من users لو موجود
  document.getElementById('es-id').value = s.source==='users' ? (s.id||'') : '';
  document.getElementById('es-old-name').value = s.name;
  document.getElementById('es-name').value = s.name;
  document.getElementById('es-pass').value = s.pass||'';
  document.getElementById('es-level').value = s.level||'sup';
  // ضبط المسمى الوظيفي من user_type
  const esRole = document.getElementById('es-role');
  const roleVal = s.user_type||s.role||'مشرف التنسيق';
  esRole.value = roleVal;
  if(!esRole.value){
    const opts = [...esRole.options].map(o=>o.value);
    const closest = opts.find(o=>o.includes(roleVal)||roleVal.includes(o));
    esRole.value = closest || 'مشرف التنسيق';
  }
  document.getElementById('es-status').value = s.status||'active';
  const groups = Array.isArray(s.groups) ? s.groups : (s.groups||'').split(',').filter(Boolean);
  loadEditSupGroups(groups);
  openModal('modal-edit-sup');
}

async function loadEditSupGroups(checkedGroups=[]){
  const container = document.getElementById('es-grp-container');
  if(!container) return;

  const staticGroups = Object.entries(GROUPS).map(([key,v])=>({key_name:key, label:v.label}));
  let dbGroups=[];
  try{
    const res=await fetch(`${SUPABASE_URL}/rest/v1/groups?select=*&order=name.asc&limit=200`,
      {headers:{'apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`}});
    if(res.ok) dbGroups=await res.json();
  }catch(e){}

  const allGroups=[...staticGroups];
  dbGroups.forEach(g=>{
    if(!allGroups.find(s=>s.key_name===g.key_name)){
      allGroups.push({key_name:g.key_name, label:(g.emoji||'')+' '+(g.name||g.key_name)});
    }
  });

  container.innerHTML = allGroups.map(g=>`
    <label style="display:flex;align-items:center;gap:4px;font-size:13px">
      <input type="checkbox" value="${g.key_name}" class="es-grp-cb" ${checkedGroups.includes(g.key_name)?'checked':''}/> ${g.label}
    </label>`).join('');
}

