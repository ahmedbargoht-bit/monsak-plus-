async function loadRoutes(){
  const tbody  = document.getElementById('routes-tbody');
  const grp    = document.getElementById('rt-group')?.value||'all';
  const search = (document.getElementById('rt-search')?.value||'').trim().toLowerCase();

  tbody.innerHTML = '<tr><td colspan="7" style="text-align:center;padding:1.5rem"><div class="spinner"></div></td></tr>';

  try{
    // جيب خطوط السير من جدول routes (فيه name و grp الصح)
    const routesRes = await fetch(`${SUPABASE_URL}/rest/v1/routes?select=name,grp&order=name.asc`,{
      headers:{'apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`}
    });
    const routesList = routesRes.ok ? await routesRes.json() : [];

    // جيب الفروع من جدول branches (عشان نعد عدد الفروع لكل route)
    const branchesRes = await fetch(`${SUPABASE_URL}/rest/v1/branches?select=route,status`,{
      headers:{'apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`}
    });
    const branchesList = branchesRes.ok ? await branchesRes.json() : [];

    // بناء map: route → عدد الفروع النشطة
    const branchCountMap = {};
    branchesList.forEach(b=>{
      const r = (b.route||'').trim();
      if(!r) return;
      branchCountMap[r] = (branchCountMap[r]||0) + 1;
    });

    // جيب المنسقين لربطهم بخطوط السير
    let reps = [...(REPS||[])];
    if(!reps.length){
      const res = await sb('users',{});
      reps = (Array.isArray(res)?res:[]).filter(u=>u.role==='rep');
    }

    // بناء map: route → [أسماء المنسقين]
    const repsMap = {};
    reps.forEach(u=>{
      const r = (u.route||'').trim();
      if(!r) return;
      if(!repsMap[r]) repsMap[r] = [];
      repsMap[r].push(u.name||'');
    });

    // بناء البيانات من جدول routes كمصدر أساسي
    let data = routesList.map(rt=>({
      name:   rt.name,
      group:  rt.grp||'',
      reps:   repsMap[rt.name]||[],
      status: (repsMap[rt.name]||[]).length > 0 ? 'active' : 'inactive'
    }));

    // فلترة
    if(grp!=='all')  data = data.filter(r=>r.group===grp);
    if(search)       data = data.filter(r=>r.name.toLowerCase().includes(search));

    // ترتيب: بالمجموعة ثم الاسم
    data.sort((a,b)=>(a.group||'').localeCompare(b.group||'')||a.name.localeCompare(b.name));

    if(!data.length){
      tbody.innerHTML='<tr><td colspan="7" style="text-align:center;padding:1.5rem;color:#aaa">لا توجد خطوط سير مطابقة</td></tr>';
      return;
    }

    tbody.innerHTML = data.map((r,i)=>{
      const branchCount = branchCountMap[r.name] ?? '—';
      const repNames    = r.reps.join('، ')||'—';
      const grpLabel    = GROUPS[r.group]?.label||r.group||'—';
      const grpColor    = GROUPS[r.group]?.color||'#999';
      const activeCount = (REPS||[]).filter(u=>(u.route===r.name)&&(u.active!==false)&&(u.status!=='inactive')).length;
      const statusBadge = r.status==='active'
        ? `<span class="badge b-green">نشط</span>`
        : `<span class="badge b-gray">موقوف</span>`;
      const routeEncoded = encodeURIComponent(r.name);
      return `<tr style="cursor:pointer" onclick="openRouteDetail('${routeEncoded}')">
        <td>${i+1}</td>
        <td><b style="color:var(--navy);text-decoration:underline dotted">${r.name}</b></td>
        <td><span class="badge" style="background:${grpColor}22;color:${grpColor}">${grpLabel}</span></td>
        <td style="font-size:11px;max-width:180px">${repNames}</td>
        <td><span class="badge b-navy">${branchCount} فرع</span></td>
        <td>${statusBadge}</td>
        <td><span style="font-size:11px;color:var(--text2)">${activeCount} منسق نشط</span></td>
      </tr>`;
    }).join('');

  }catch(e){
    tbody.innerHTML='<tr><td colspan="7" style="text-align:center;padding:1.5rem;color:var(--red)">تعذر التحميل</td></tr>';
    console.warn('loadRoutes error:', e);
  }
}

