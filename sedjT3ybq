async function smissInitFilters(){
  await loadAdminRoutesData();
  const grpSel = document.getElementById('smiss-grp');
  if(grpSel && grpSel.options.length<=1){
    adminGetGrps().forEach(g=>{ const o=document.createElement('option');o.value=g;o.textContent=GROUPS[g]?.label||g;grpSel.appendChild(o); });
  }
  const today = localISO();
  const past  = new Date(); past.setDate(past.getDate()-30);
  if(!document.getElementById('smiss-from').value) document.getElementById('smiss-from').value = localISO(past);
  if(!document.getElementById('smiss-to').value)   document.getElementById('smiss-to').value   = today;
}

async function smissOnGrpChange(){
  await loadAdminRoutesData();
  const grp       = document.getElementById('smiss-grp').value;
  const routeSel  = document.getElementById('smiss-route');
  const branchSel = document.getElementById('smiss-branch');
  routeSel.innerHTML  = '<option value="all">كل الخطوط</option>' +
    adminGetRoutes(grp).map(r=>`<option value="${r}">${r}</option>`).join('');
