<script>
(function(){
  const charts=[
    {title:'Q1 Sales by Region',bars:[{h:70,c:'#3A9AFF'},{h:45,c:'#34D399'},{h:85,c:'#F59E0B'},{h:55,c:'#3A9AFF'},{h:65,c:'#A78BFA'}]},
    {title:'Visit Adherence',type:'pie'},
    {title:'Sales by Region',bars:[{h:50,c:'#34D399'},{h:80,c:'#3A9AFF'},{h:40,c:'#F87171'},{h:90,c:'#34D399'},{h:60,c:'#F59E0B'}]},
    {title:'Monthly Trend',type:'line',color:'#3A9AFF'},
    {title:'Visit Rate',bars:[{h:60,c:'#A78BFA'},{h:75,c:'#3A9AFF'},{h:50,c:'#34D399'},{h:85,c:'#F59E0B'},{h:40,c:'#F87171'}]},
    {title:'Performance',type:'line',color:'#34D399'},
  ];
  const grid=document.getElementById('login-charts-grid');
  if(!grid)return;
  charts.forEach(ch=>{
    const card=document.createElement('div');card.className='login-mini-chart';
    if(ch.type==='pie'){
      card.innerHTML=`<div class="login-mc-title">${ch.title}</div><svg viewBox="0 0 40 40" style="width:100%;height:28px"><circle cx="20" cy="20" r="14" fill="none" stroke="#3A9AFF" stroke-width="6" stroke-dasharray="35 53" stroke-dashoffset="0" transform="rotate(-90 20 20)"/><circle cx="20" cy="20" r="14" fill="none" stroke="#34D399" stroke-width="6" stroke-dasharray="22 66" stroke-dashoffset="-35" transform="rotate(-90 20 20)"/><circle cx="20" cy="20" r="14" fill="none" stroke="#F59E0B" stroke-width="6" stroke-dasharray="20 68" stroke-dashoffset="-57" transform="rotate(-90 20 20)"/><circle cx="20" cy="20" r="8" fill="#030B20"/></svg>`;
    } else if(ch.type==='line'){
      card.innerHTML=`<div class="login-mc-title">${ch.title}</div><svg viewBox="0 0 60 30" style="width:100%;height:28px"><polyline points="0,28 12,20 24,14 36,18 48,8 60,5" fill="none" stroke="${ch.color}" stroke-width="1.5" stroke-linecap="round"/><polyline points="0,26 12,22 24,18 36,22 48,14 60,10" fill="none" stroke="rgba(255,255,255,.15)" stroke-width="1" stroke-linecap="round" stroke-dasharray="2 2"/></svg>`;
    } else {
      const barHTML=ch.bars.map(b=>`<div class="login-mb" style="height:${b.h}%;background:${b.c};opacity:.85;flex:1"></div>`).join('');
      card.innerHTML=`<div class="login-mc-title">${ch.title}</div><div class="login-mini-bars">${barHTML}</div>`;
    }
    grid.appendChild(card);
  });
  // fix error div display
  const errDiv=document.getElementById('l-err');
  if(errDiv){errDiv.style.display='none';errDiv.style.fontSize='11px';errDiv.style.color='#F87171';errDiv.style.textAlign='center';errDiv.style.marginBottom='6px';}

  // ══ Load stats from Supabase ══
  async function loadLoginStats(){
    const URL = localStorage.getItem('sb_url') || 'https://tneeosrbxedexsrigapg.supabase.co';
    const KEY = localStorage.getItem('sb_key') || 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InRuZWVvc3JieGVkZXhzcmlnYXBnIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzkxMTcxMTQsImV4cCI6MjA5NDY5MzExNH0.JHXgJ6EeDcdeofD5HShRnWvwPazCIfY7q7pCC2GMOFw';
    const H = {'apikey':KEY,'Authorization':`Bearer ${KEY}`,'Prefer':'count=exact','Range':'0-0'};

    function setVal(id, val){ const el=document.getElementById(id); if(el) el.textContent=val; }
    function parseCount(res){ const cr=res.headers.get('Content-Range'); return cr ? (cr.split('/')[1]||'—') : '—'; }

    try {
      const KA = encodeURIComponent('ثابت كبار عملاء');
      const grpExclude = encodeURIComponent('(hyper,private_cairo)');
      const [brTahhan, brPrivate, brClient, sales, repMob, repFix, repKey, sup] = await Promise.all([
        // سلاسل الطحان (هايبر) — grp=hyper
        fetch(`${URL}/rest/v1/branches?grp=eq.hyper&status=eq.active&select=id`, {headers:H}),
        // أسواق خاصة — grp=private_cairo
        fetch(`${URL}/rest/v1/branches?grp=eq.private_cairo&status=eq.active&select=id`, {headers:H}),
        // فروع العملاء — باقي المناطق
        fetch(`${URL}/rest/v1/branches?grp=not.in.(hyper,private_cairo)&status=eq.active&select=id`, {headers:H}),
        // مناديب فعليين — role=sales & active
        fetch(`${URL}/rest/v1/users?role=eq.sales&status=eq.active&select=id`, {headers:H}),
        // منسقين متحرك (بستثني تحت التعيين)
        fetch(`${URL}/rest/v1/users?role=eq.rep&user_type=eq.${encodeURIComponent('متحرك')}&status=eq.active&name=neq.${encodeURIComponent('تحت التعيين')}&select=id`, {headers:H}),
        // منسقين ثابت (بستثني تحت التعيين)
        fetch(`${URL}/rest/v1/users?role=eq.rep&user_type=eq.${encodeURIComponent('ثابت')}&status=eq.active&name=neq.${encodeURIComponent('تحت التعيين')}&select=id`, {headers:H}),
        // كبار العملاء (بستثني تحت التعيين)
        fetch(`${URL}/rest/v1/users?role=eq.rep&user_type=eq.${KA}&status=eq.active&name=neq.${encodeURIComponent('تحت التعيين')}&select=id`, {headers:H}),
        // مشرفين
        fetch(`${URL}/rest/v1/users?role=eq.supervisor&status=eq.active&select=id`, {headers:H}),
      ]);
      setVal('ls-tahhan', parseCount(brTahhan));
      setVal('ls-private', parseCount(brPrivate));
      setVal('ls-client',  parseCount(brClient));
      setVal('ls-sales',   parseCount(sales));
      setVal('ls-mob',     parseCount(repMob));
      setVal('ls-fix',     parseCount(repFix));
      setVal('ls-key',     parseCount(repKey));
      setVal('ls-sup',     parseCount(sup));
    } catch(e){ console.warn('login stats error',e); }
  }
  loadLoginStats();
})();
</script>

