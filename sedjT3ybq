let _seData = [];  // كاش البيانات

async function seInit(){ await seLoadData(); }

async function seLoadData(){
  const tbody = document.getElementById('se-tbody');
  const stats = document.getElementById('se-stats');
  if(tbody) tbody.innerHTML = '<tr><td colspan="9" style="text-align:center;padding:2rem;color:#6B7280">⏳ جاري التحميل...</td></tr>';
  if(stats) stats.innerHTML = '';

  const H = {'apikey':SUPABASE_KEY,'Authorization':'Bearer '+SUPABASE_KEY,'Accept':'application/json'};
  try{
    const rows = await fetch(
      SUPABASE_URL+'/rest/v1/market_expiry?select=branch,route,grp,snf,cat,fea,date_shelf,total_qty,last_visit&order=last_visit.desc&limit=3000',
      {headers:H}
    ).then(r=>r.json());

    if(!Array.isArray(rows)){ throw new Error(JSON.stringify(rows)); }
    _seData = rows;

    // ── تعبئة الفلاتر ──
    const fill = (id, vals, allLabel)=>{
      const el = document.getElementById(id);
      if(!el) return;
      const cur = el.value;
      el.innerHTML = `<option value="all">${allLabel}</option>`
        + [...new Set(vals.filter(Boolean).sort())].map(v=>`<option value="${v}">${v}</option>`).join('');
      if([...el.options].some(o=>o.value===cur)) el.value = cur;
    };
    fill('se-grp',   rows.map(r=>r.grp),   'كل المجموعات');
    fill('se-route', rows.map(r=>r.route), 'كل الخطوط');
    fill('se-branch',rows.map(r=>r.branch),'كل الفروع');
    fill('se-fea',   rows.map(r=>r.fea),   'كل الفئات');
    fill('se-cat',   rows.map(r=>r.cat),   'كل التصنيفات');
    fill('se-snf',   rows.map(r=>r.snf),   'كل الأصناف');

    seSearch();
  }catch(e){
    if(tbody) tbody.innerHTML = `<tr><td colspan="9" style="text-align:center;padding:2rem;color:#DC2626">❌ ${e.message}</td></tr>`;
  }
}

function seOnGrpChange(){
  const grp = document.getElementById('se-grp')?.value;
  const fil = grp==='all' ? _seData : _seData.filter(r=>r.grp===grp);
  const fill = (id, vals, allLabel)=>{
    const el = document.getElementById(id);
    if(!el) return;
    el.innerHTML = `<option value="all">${allLabel}</option>`
      + [...new Set(vals.filter(Boolean).sort())].map(v=>`<option value="${v}">${v}</option>`).join('');
  };
  fill('se-route', fil.map(r=>r.route), 'كل الخطوط');
  fill('se-branch',fil.map(r=>r.branch),'كل الفروع');
  seSearch();
}

function seOnRouteChange(){
  const grp   = document.getElementById('se-grp')?.value;
  const route = document.getElementById('se-route')?.value;
  let fil = _seData;
  if(grp  !=='all') fil = fil.filter(r=>r.grp===grp);
  if(route!=='all') fil = fil.filter(r=>r.route===route);
  const el = document.getElementById('se-branch');
  if(el){
    el.innerHTML = '<option value="all">كل الفروع</option>'
      + [...new Set(fil.map(r=>r.branch).filter(Boolean).sort())].map(v=>`<option value="${v}">${v}</option>`).join('');
  }
  seSearch();
}

function seOnFeaChange(){
  const fea = document.getElementById('se-fea')?.value;
  const fil = fea==='all' ? _seData : _seData.filter(r=>r.fea===fea);
  const el  = document.getElementById('se-cat');
  if(el){
    el.innerHTML = '<option value="all">كل التصنيفات</option>'
      + [...new Set(fil.map(r=>r.cat).filter(Boolean).sort())].map(v=>`<option value="${v}">${v}</option>`).join('');
