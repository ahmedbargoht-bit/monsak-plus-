async function qbInitReps(){
  const sel=document.getElementById('qb-rep');
  if(!sel) return;
  sel.innerHTML='<option value="">⏳ جاري التحميل...</option>';

  // جيب المنسقين من Supabase مباشرة (مش من REPS المحلي)
  try{
    const res=await fetch(
      `${SUPABASE_URL}/rest/v1/users?select=name,route,grp&role=eq.rep&status=eq.active&order=name.asc&limit=500`,
      {headers:{'apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`}}
    );
    const data=res.ok?await res.json():[];
    sel.innerHTML='<option value="">اختر المنسق</option>';
    const visible=CU?.groups||[];
    const filtered=visible.includes('all')||CU?.level==='gm'
      ? data
      : data.filter(r=>visible.includes(r.grp||''));
    filtered.forEach(r=>{
      const o=document.createElement('option');
      o.value=r.name;
      o.textContent=r.name+' — '+(r.route||'');
      o.dataset.route=r.route||'';
      o.dataset.grp=r.grp||'';
      sel.appendChild(o);
    });
  }catch(e){
    // fallback للـ REPS المحلي
    sel.innerHTML='<option value="">اختر المنسق</option>';
    REPS.filter(r=>!CU?.groups||CU.groups.includes(r.group)).forEach(r=>{
      const o=document.createElement('option');
      o.value=r.name;
      o.textContent=r.name+' — '+(r.route||'');
      o.dataset.route=r.route||'';
      sel.appendChild(o);
    });
  }
}

async function qbOnRepChange(){
  const sel=document.getElementById('qb-rep');
  const opt=sel.options[sel.selectedIndex];
  const route=opt?.dataset?.route||'';
  const grp=opt?.dataset?.grp||'';
  const repName=sel.value;

  document.getElementById('qb-route').value=route;
  document.getElementById('qb-ok').style.display='none';
  document.getElementById('qb-err').style.display='none';
  document.getElementById('qb-branch').value='';

  const wrap=document.getElementById('qb-branches-wrap');
  const addWrap=document.getElementById('qb-add-wrap');
  const list=document.getElementById('qb-branches-list');
  const count=document.getElementById('qb-branches-count');

  if(!repName){ wrap.style.display='none'; addWrap.style.display='none'; return; }

  wrap.style.display='block';
  addWrap.style.display='block';
  list.innerHTML='<span style="color:#aaa;font-size:11px">جاري التحميل...</span>';

  const H={'apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`};
  const enc=encodeURIComponent(repName);

  // جيب فروع المنسق الحالية (4 مصادر بالتوازي)
  const [byRep1,byRep2,byRep3,byCoord]=await Promise.all([
    fetch(`${SUPABASE_URL}/rest/v1/branches?select=id,branch_name,client_type,status&rep_name=eq.${enc}&status=neq.inactive`,{headers:H}).then(r=>r.ok?r.json():[]).catch(()=>[]),
    fetch(`${SUPABASE_URL}/rest/v1/branches?select=id,branch_name,client_type,status&rep_name2=eq.${enc}&status=neq.inactive`,{headers:H}).then(r=>r.ok?r.json():[]).catch(()=>[]),
    fetch(`${SUPABASE_URL}/rest/v1/branches?select=id,branch_name,client_type,status&rep_name3=eq.${enc}&status=neq.inactive`,{headers:H}).then(r=>r.ok?r.json():[]).catch(()=>[]),
    fetch(`${SUPABASE_URL}/rest/v1/coord_route_assignments?select=id,branch_name&rep_name=eq.${enc}`,{headers:H}).then(r=>r.ok?r.json():[]).catch(()=>[]),
  ]);

  const seen=new Set();
  const repBranches=[...byRep1,...byRep2,...byRep3].filter(b=>{
    if(!b.branch_name||seen.has(b.branch_name)) return false;
    seen.add(b.branch_name); return true;
  }).sort((a,b)=>a.branch_name.localeCompare(b.branch_name,'ar'));

  count.textContent=`(${repBranches.length} فرع)`;

  if(!repBranches.length){
    list.innerHTML='<span style="color:#aaa;font-size:11px">لا توجد فروع مسجلة بعد — أضف من الأسفل</span>';
  } else {
    list.innerHTML=repBranches.map(b=>{
      const tc=b.client_type==='A'?'#1A7A4A':b.client_type==='C'?'#B71C1C':'#005CBF';
      return `<span style="display:inline-flex;align-items:center;gap:5px;background:#EEF6FF;
        color:#003A80;padding:4px 8px;border-radius:6px;font-size:11px;font-weight:600;
        border:1px solid #C8DDF8">
        ${b.branch_name}
        <span style="background:${tc}22;color:${tc};padding:0 4px;border-radius:3px;font-size:10px">${b.client_type||'B'}</span>
        <button onclick="qbRemoveBranch(${b.id},'${b.branch_name.replace(/'/g,"\\'")}','${repName.replace(/'/g,"\\'")}')"
          style="background:#FFEBEE;border:none;color:#B71C1C;border-radius:4px;padding:1px 5px;
          cursor:pointer;font-size:11px;font-weight:700;line-height:1.2" title="إزالة من المنسق">×</button>
      </span>`;
    }).join('');
  }

  // ملأ قائمة فروع المجموعة للإضافة
  await qbLoadGrpBranches(grp, repName, repBranches.map(b=>b.branch_name));
}

async function qbLoadGrpBranches(grp, repName, existingBranches){
  const sel=document.getElementById('qb-grp-branches');
  if(!sel) return;
  sel.innerHTML='<option value="">جاري التحميل...</option>';
  if(!grp){ sel.innerHTML='<option value="">— اختر مجموعة أولاً —</option>'; return; }

  const H={'apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`};
  const data=await fetch(
    `${SUPABASE_URL}/rest/v1/branches?select=id,branch_name,client_type&grp=eq.${encodeURIComponent(grp)}&status=neq.inactive&order=branch_name.asc&limit=500`,
    {headers:H}).then(r=>r.ok?r.json():[]).catch(()=>[]);

  // استبعد الفروع اللي المنسق مسجل فيها مسبقاً
  const available=data.filter(b=>!existingBranches.includes(b.branch_name));
  sel.innerHTML=available.length
    ? '<option value="">— اختر فرع —</option>'+available.map(b=>
        `<option value="${b.id}" data-name="${b.branch_name}">${b.branch_name} (${b.client_type||'B'})</option>`).join('')
    : '<option value="">لا توجد فروع إضافية في المجموعة</option>';
}

