function seGetFiltered(){
  const g = document.getElementById('se-grp')?.value;
  const ro= document.getElementById('se-route')?.value;
  const b = document.getElementById('se-branch')?.value;
  const fe= document.getElementById('se-fea')?.value;
  const ca= document.getElementById('se-cat')?.value;
  const sn= document.getElementById('se-snf')?.value;
  return _seData.filter(r=>
    (g ==='all'||r.grp===g) &&
    (ro==='all'||r.route===ro) &&
    (b ==='all'||r.branch===b) &&
    (fe==='all'||r.fea===fe) &&
    (ca==='all'||r.cat===ca) &&
    (sn==='all'||r.snf===sn)
  );
}

