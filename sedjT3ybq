function retToggleAll(cb){
  document.querySelectorAll('.ret-row-cb').forEach(c=>c.checked=cb.checked);
  const h=document.getElementById('ret-hdr-cb'), a=document.getElementById('ret-select-all');
  if(h) h.checked=cb.checked; if(a) a.checked=cb.checked;
  retUpdateCount();
}
function retUpdateCount(){
  const all=document.querySelectorAll('.ret-row-cb'), sel=document.querySelectorAll('.ret-row-cb:checked');
  const el=document.getElementById('ret-sel-count');
  if(el) el.textContent=sel.length+' محدد من '+all.length;
  const h=document.getElementById('ret-hdr-cb'), a=document.getElementById('ret-select-all');
  const allChk=sel.length===all.length&&all.length>0;
  if(h) h.checked=allChk; if(a) a.checked=allChk;
}
function retGetData(onlySelected){
  const all=window._retData||[];
  if(!onlySelected) return all;
  const idxs=new Set([...document.querySelectorAll('.ret-row-cb:checked')].map(c=>+c.dataset.idx));
  return idxs.size?all.filter((_,i)=>idxs.has(i)):all;
}

function exportReturnsExcelStyled(onlySelected){
  if(typeof XLSX==='undefined'){showToast('جاري تحميل مكتبة Excel...');return;}
  const data=retGetData(onlySelected);
  if(!data.length){showToast('لا توجد بيانات للتصدير','err');return;}

  const C={dark:'2C1F0A',caramel:'4B3C1A',gold:'C8A96E',cream:'EDE5D8',light:'F5F0E8',
    red:'731E2E',orange:'E65100',green:'2E7D32',white:'FFFFFF',grey:'F8F9FA',line:'E0D8CC'};
