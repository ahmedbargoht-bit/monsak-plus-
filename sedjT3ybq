  }
}

async function editSalesStaff(id){
  const res = await fetch(`${SUPABASE_URL}/rest/v1/sales_staff?id=eq.${id}&select=*`,
    {headers:{'apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`}});
  const data = await res.json();
  const u = data[0]; if(!u) return;

  // تعبئة modal التعديل الموجود
  document.getElementById('sale-edit-id').value   = id;
  document.getElementById('sale-edit-name').value = u.name||'';
  document.getElementById('sale-edit-pass').value = u.pass_hash||'';
  document.getElementById('sale-edit-level').value = u.role==='sales_gm'?'gm':u.role==='sales_manager'?'manager':'sup';

  // المجموعات
  const grps = (u.sector||'').split(',').map(g=>g.trim());
  document.querySelectorAll('.sale-edit-grp-cb').forEach(c=>c.checked=grps.includes(c.value));

  // إخفاء قسم المشرفين (غير متعلق بـ sales_staff)
  const wrap = document.getElementById('sale-edit-sups-wrap');
  if(wrap) wrap.innerHTML='<div style="color:#aaa;font-size:12px">— غير متاح في هذا النظام —</div>';

  openModal('modal-edit-sales');
}

async function saveSalesUser(){
  const id    = document.getElementById('sale-edit-id').value;
  const name  = document.getElementById('sale-edit-name').value.trim();
  const pass  = document.getElementById('sale-edit-pass').value.trim();
  const level = document.getElementById('sale-edit-level').value;
  const grps  = [...document.querySelectorAll('.sale-edit-grp-cb:checked')].map(c=>c.value).join(',');
  const ok    = document.getElementById('sale-edit-ok');
  if(!name||!pass){alert('أدخل الاسم وكلمة المرور');return;}

  const roleMap = {gm:'sales_gm', manager:'sales_manager', sup:'sales_sup'};

  // حدّث في sales_staff
  const r1 = await fetch(`${SUPABASE_URL}/rest/v1/sales_staff?id=eq.${id}`,{
    method:'PATCH',
    headers:{'Content-Type':'application/json','apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`,'Prefer':'return=minimal'},
    body:JSON.stringify({name, pass_hash:pass, role:roleMap[level]||'sales_sup', sector:grps})
  });

  // حدّث في users أيضاً للتزامن
  await fetch(`${SUPABASE_URL}/rest/v1/users?name=eq.${encodeURIComponent(name)}&role=eq.sales`,{
    method:'PATCH',
    headers:{'Content-Type':'application/json','apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`,'Prefer':'return=minimal'},
    body:JSON.stringify({pass_hash:pass, level, groups:grps})
  });

  if(r1.ok){
    ok.style.display='block'; ok.textContent='✅ تم الحفظ';
    setTimeout(()=>{closeModal('modal-edit-sales'); loadSalesUsersPanel();},1000);
  }
}

async function toggleSalesStaff(id, currentActive){
  const newActive = !currentActive;
  const label = newActive?'تفعيل':'إيقاف';
  if(!confirm(`${label} هذا المشرف؟`)) return;
  await fetch(`${SUPABASE_URL}/rest/v1/sales_staff?id=eq.${id}`,{
    method:'PATCH',
    headers:{'Content-Type':'application/json','apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`,'Prefer':'return=minimal'},
    body:JSON.stringify({active:newActive})
  });
  loadSalesUsersPanel();
}

async function deleteSalesStaff(id, name){
  confirmDelete('مشرف المبيعات', name, async()=>{
    // احذف من sales_staff
    await fetch(`${SUPABASE_URL}/rest/v1/sales_staff?id=eq.${id}`,{
      method:'DELETE', headers:{'apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`}
    });
    showToast('🗑️ تم حذف المشرف: '+name);
    loadSalesUsersPanel();
    loadSppStaffDropdowns();
  });
}

async function addSalesUser(){
  const name  = document.getElementById('sale-name').value.trim();
  const pass  = document.getElementById('sale-pass').value.trim();
  const level = document.getElementById('sale-level').value;
  const grps  = [...document.querySelectorAll('.sale-grp-cb:checked')].map(c=>c.value).join(',');
  const ok    = document.getElementById('sale-add-ok');
  ok.style.display='none';
  if(!name||!pass){alert('أدخل الاسم وكلمة المرور');return;}

  const roleMap = {gm:'sales_gm', manager:'sales_manager', sup:'sales_sup'};

  // احفظ في users
  const r1 = await fetch(`${SUPABASE_URL}/rest/v1/users`,{
    method:'POST',
    headers:{'Content-Type':'application/json','apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`,'Prefer':'return=minimal'},
    body:JSON.stringify({name, pass_hash:pass, role:'sales', level, groups:grps, status:'active'})
  });

  // احفظ في sales_staff
  await fetch(`${SUPABASE_URL}/rest/v1/sales_staff`,{
    method:'POST',
    headers:{'Content-Type':'application/json','apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`,'Prefer':'return=minimal'},
    body:JSON.stringify({name, pass_hash:pass, role:roleMap[level]||'sales_sup', sector:grps, active:true})
  });

  if(r1.ok||r1.status===201){
    ok.style.display='block'; ok.textContent='✅ تم إضافة '+name;
    document.getElementById('sale-name').value='';
    document.getElementById('sale-pass').value='';
    document.querySelectorAll('.sale-grp-cb').forEach(c=>c.checked=false);
    setTimeout(()=>{closeModal('modal-add-sales'); loadSalesUsersPanel(); loadSppStaffDropdowns();},1200);
  } else {
    alert('خطأ في الإضافة — تحقق من الاسم');
  }
}

