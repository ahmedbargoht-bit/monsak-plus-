async function uploadPDBFile(input){
  const file=input.files[0]; if(!file) return;
  const statusEl=document.getElementById('pdb-upload-status');
  statusEl.textContent='⏳ جاري قراءة الملف...'; statusEl.style.color='#F77F00';
  try{
    const buf=await file.arrayBuffer();
    const wb=XLSX.read(buf,{type:'array'});
    const ws=wb.Sheets[wb.SheetNames[0]];
    const rows=XLSX.utils.sheet_to_json(ws,{header:1,defval:''});
    let headerIdx=-1, colMap={};
    for(let i=0;i<rows.length;i++){
      const r=rows[i].map(c=>(c||'').toString().trim());
      if(r.includes('اسم الصنف')){ headerIdx=i; r.forEach((col,j)=>colMap[col]=j); break; }
    }
    if(headerIdx===-1){ statusEl.textContent='❌ مش لاقي عمود "اسم الصنف"'; statusEl.style.color='#B71C1C'; return; }
    const pdb={}; let count=0;
    for(let i=headerIdx+1;i<rows.length;i++){
      const row=rows[i];
      const fea=(row[colMap['الفئة']]||'').toString().trim();
      const cat=(row[colMap['التصنيف']]||'').toString().trim();
      const grp=(row[colMap['المجموعة الفرعية']]||'').toString().trim();
      const snf=(row[colMap['اسم الصنف']]||'').toString().trim();
      const active=(row[colMap['فعال']]||'').toString().trim();
      if(!snf||active==='لا'||!fea||!cat) continue;
      if(!pdb[fea]) pdb[fea]={};
      if(!pdb[fea][cat]) pdb[fea][cat]={};
      if(!pdb[fea][cat][grp]) pdb[fea][cat][grp]=[];
      pdb[fea][cat][grp].push(snf); count++;
    }
    if(!count){ statusEl.textContent='❌ مفيش أصناف فعّالة'; statusEl.style.color='#B71C1C'; return; }
    statusEl.textContent=`⏳ ${count} صنف — جاري الرفع...`;
    const val=JSON.stringify(pdb);
    await sbUpsert('products_db',{key:'pdb',value:val,updated_at:new Date().toISOString()},'key');
    try{ localStorage.setItem('pdb_cache',val); }catch(e){}
    PDB=pdb;
    statusEl.textContent=`✅ تم رفع ${count} صنف من ${Object.keys(pdb).length} فئة!`;
    statusEl.style.color='#1A7A4A';
    // اظهر وقت آخر تحديث
    const now = new Date().toLocaleString('ar-EG');
    const lbl = document.getElementById('pdb-last-update');
    if(lbl) lbl.textContent = 'آخر تحديث: ' + now;
    renderProdDB();
    splSyncProductsFromPDB();
  }catch(err){ statusEl.textContent='❌ خطأ: '+err.message; statusEl.style.color='#B71C1C'; console.error(err); }
  input.value='';
}

