async function saveSppStaff(){
  const name   = (document.getElementById('spp-modal-name')?.value||'').trim();
  const role   = document.getElementById('spp-modal-role')?.value;
  const sector = (document.getElementById('spp-modal-sector')?.value||'').trim();
  const pass   = (document.getElementById('spp-modal-pass')?.value||'').trim();
  const msg    = document.getElementById('spp-modal-msg');

  if(!name){ msg.style.display='block';msg.style.background='#FFEBEE';msg.style.color='#B71C1C';msg.textContent='❌ الاسم مطلوب'; return; }

  const res = await fetch(`${SUPABASE_URL}/rest/v1/sales_staff`,{
    method:'POST',
    headers:{'Content-Type':'application/json','apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`,'Prefer':'return=minimal'},
    body:JSON.stringify({name,role,sector,pass_hash:pass,active:true})
  });

  if(res.ok){
    showToast('✅ تم إضافة مشرف المبيعات');
    document.querySelector('[style*="position:fixed"]')?.remove();
    loadSppStaff();
    loadSppStaffDropdowns();
  } else {
    msg.style.display='block';msg.style.background='#FFEBEE';msg.style.color='#B71C1C';
    msg.textContent='❌ فشل الحفظ';
  }
}

async function saveSppAchievement(){
  const staffId = document.getElementById('spp-modal-staff')?.value;
  const date    = document.getElementById('spp-modal-date')?.value;
  const amount  = +document.getElementById('spp-modal-amount')?.value||0;
  const client  = (document.getElementById('spp-modal-client')?.value||'').trim();
  const area    = (document.getElementById('spp-modal-area')?.value||'').trim();
  const msg     = document.getElementById('spp-modal-msg2');

  if(!staffId){ msg.style.display='block';msg.style.background='#FFEBEE';msg.style.color='#B71C1C';msg.textContent='❌ اختر المشرف'; return; }
  if(!date)   { msg.style.display='block';msg.style.background='#FFEBEE';msg.style.color='#B71C1C';msg.textContent='❌ التاريخ مطلوب'; return; }

  const staff = _sppStaff.find(s=>s.id===staffId)||{};
  const res = await fetch(`${SUPABASE_URL}/rest/v1/sales_achievements`,{
    method:'POST',
    headers:{'Content-Type':'application/json','apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`,'Prefer':'return=minimal'},
    body:JSON.stringify({staff_id:staffId,staff_name:staff.name,sector:staff.sector,sale_date:date,month:date.slice(0,7),amount,client_name:client,area,entered_by:'admin'})
