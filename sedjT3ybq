async function smissLoad(){
  const grp    = document.getElementById('smiss-grp')?.value||'all';
  const route  = document.getElementById('smiss-route')?.value||'all';
  const branch = document.getElementById('smiss-branch')?.value||'all';
  const status = document.getElementById('smiss-status')?.value||'all';
  const from   = document.getElementById('smiss-from')?.value;
  const to     = document.getElementById('smiss-to')?.value;
  if(!from||!to) return;

  const tbody = document.getElementById('smiss-tbody');
  tbody.innerHTML = '<tr><td colspan="9" style="text-align:center;padding:20px"><div class="spinner" style="margin:0 auto"></div></td></tr>';

  const grpStr = grp==='all' ? Object.keys(GROUPS).join(',') : grp;
  let url = `${SUPABASE_URL}/rest/v1/missing?grp=in.(${grpStr})&select=*&order=created_at.desc&limit=2000`;
  url += `&created_at=gte.${from}T00:00:00&created_at=lte.${to}T23:59:59`;
  if(branch!=='all') url += `&branch=eq.${encodeURIComponent(branch)}`;
  if(status==='pending') url += `&delivered=eq.false`;
  if(status==='done')    url += `&delivered=eq.true`;

  let data = [];
  try{
    const r = await fetch(url,{headers:{'apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`}});
    data = await r.json(); if(!Array.isArray(data)) data=[];
  }catch(e){}

  if(route!=='all'){
    const branches = adminGetBranches(grp, route);
    data = data.filter(p=>branches.includes(p.branch));
  }

  const pending = data.filter(m=>!m.delivered);
  const done    = data.filter(m=>m.delivered);

  // KPI
  document.getElementById('smiss-kpi').innerHTML = `
    <div class="stat-card orange"><div class="stat-n">${data.length}</div><div class="stat-l">إجمالي النواقص</div></div>
    <div class="stat-card red"><div class="stat-n">${pending.length}</div><div class="stat-l">⏳ لم يُوَرَّد</div></div>
    <div class="stat-card green"><div class="stat-n">${done.length}</div><div class="stat-l">✅ تم التوريد</div></div>
    <div class="stat-card"><div class="stat-n">${new Set(data.map(x=>x.snf)).size}</div><div class="stat-l">أصناف مختلفة</div></div>`;

  // تنبيه
  const lateCount = pending.filter(m=>(Date.now()-new Date(m.created_at).getTime())/864e5>=3).length;
  const warnEl = document.getElementById('smiss-warning');
  if(lateCount>0){ warnEl.style.display=''; warnEl.textContent=`⚠️ ${lateCount} ناقص منذ أكثر من 3 أيام لم يُوَرَّد بعد — يحتاج متابعة عاجلة!`; }
  else warnEl.style.display='none';

  // badge
  setBadgeEl('nav-smiss-badge', pending.length);

  const STAGE_LABELS = {
    new:         {label:'🆕 جديد',                 color:'#888'},
    seen:        {label:'👀 اطّلع عليه المشرف',      color:'#1D4ED8'},
    transferred: {label:'📤 محوّل لمشرف البيع',       color:'#7C3AED'}
  };

  tbody.innerHTML = data.map((m,i)=>{
    const isDelivered = !!m.delivered;
    const isConfirmed = !!m.confirmed;
    const days = Math.floor((Date.now()-new Date(m.created_at).getTime())/864e5);
    const isLate = !isDelivered && days>=3;
    const grpInfo = GROUPS[m.grp]||{label:m.grp,color:'#888'};
    const rdRow  = ADMIN_ROUTES_DATA.find(x=>x.branch_name===m.branch);
    const routeN = rdRow?.route || m.route || '—';

    // مراحل الحركة: جديد → اطّلع عليه المشرف → محوّل لمشرف البيع (status) ثم رفع المندوب (delivered) ثم تأكيد الإدارة (confirmed)
    const stageInfo = STAGE_LABELS[m.status] || STAGE_LABELS.new;
    const stageBadge = `<div style="font-size:9px;color:${stageInfo.color};font-weight:700;margin-bottom:2px">${stageInfo.label}</div>`;
    const deliveredBadge = isDelivered
      ? `<div style="font-size:10px;color:#065F46;font-weight:700">✅ تم التوريد</div><div style="font-size:9px;color:#888">${m.delivered_by||'—'}</div>`
      : `<span style="background:#FEF3C7;color:#B45309;padding:2px 8px;border-radius:10px;font-size:10px;font-weight:700">⏳ لم يُوَرَّد${isLate?` (${days}ي)`:''}</span>`;
    const statusBadge = stageBadge + deliveredBadge;

    // تأكيد الإدارة — نفس منطق تأكيد استلام المرتجعات بالظبط
    const confirmCell = isConfirmed
      ? `<div style="font-size:10px;color:#065F46;font-weight:700">✅ تم التأكيد من خلال المشرف ${m.confirmed_by||'—'}</div>
         <div style="font-size:9px;color:#888">${m.confirmed_at?new Date(m.confirmed_at).toLocaleDateString('en-GB',{day:'numeric',month:'short'}):'—'}</div>`
      : isDelivered
        ? `<button onclick="smissConfirmDelivery(${m.id},'${(m.branch||'').replace(/'/g,"\\'")}','${(m.snf||'').replace(/'/g,"\\'")}' )"
            style="background:#7C2D12;color:#fff;border:none;border-radius:6px;padding:4px 10px;cursor:pointer;font-size:11px;font-family:Cairo,sans-serif;font-weight:700">✅ تأكيد التوريد</button>`
        : `<span style="color:#ccc;font-size:11px">—</span>`;

    const dt = m.created_at ? fmtDate(m.created_at) : '—';
    return `<tr style="${isLate?'background:#FFF8E1':''}">
      <td>${i+1}</td>
      <td><span style="background:${grpInfo.color}22;color:${grpInfo.color};padding:2px 8px;border-radius:10px;font-size:10px;font-weight:700">${grpInfo.label}</span></td>
      <td style="font-size:11px">${routeN}</td>
      <td style="font-size:11px;font-weight:700">${m.branch||'—'}${isLate?`<div style="color:#E65100;font-size:9px">⚠️ منذ ${days} يوم</div>`:''}</td>
      <td style="font-size:11px">${m.snf||'—'}</td>
      <td style="font-size:11px;color:#888">${m.reason||'—'}</td>
      <td>${statusBadge}</td>
      <td>${confirmCell}</td>
      <td style="font-size:11px;color:#888">${dt}</td>
    </tr>`;
  }).join('') || '<tr><td colspan="9" style="text-align:center;padding:20px;color:#888">لا توجد نواقص</td></tr>';
}

