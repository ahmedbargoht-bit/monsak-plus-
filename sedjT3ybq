function splOnMapClientFilterChange(){
  // لما تختار عميل → حدّث المجموعات
  const fClient = document.getElementById('spl-map-client-filter')?.value||'all';
  const grpSel  = document.getElementById('spl-map-grp-filter');
  const routeSel= document.getElementById('spl-map-route-filter');
  if(grpSel){
    let branches = _splBranchMap;
    if(fClient!=='all') branches = branches.filter(m=>m.client_name===fClient);
    const grps = [...new Set(branches.map(m=>m.grp).filter(Boolean))].sort();
    grpSel.innerHTML = '<option value="all">كل المجموعات</option>' +
      grps.map(g=>`<option value="${g}">${g}</option>`).join('');
  }
  if(routeSel) routeSel.innerHTML = '<option value="all">كل خطوط السير</option>';
  splRenderBranchMap();
}

function splOnMapGrpFilterChange(){
  // لما تختار مجموعة → حدّث خطوط السير
  const fClient = document.getElementById('spl-map-client-filter')?.value||'all';
  const fGrp    = document.getElementById('spl-map-grp-filter')?.value||'all';
  const routeSel= document.getElementById('spl-map-route-filter');
  if(routeSel){
    let branches = _splBranchMap;
    if(fClient!=='all') branches = branches.filter(m=>m.client_name===fClient);
    if(fGrp!=='all')    branches = branches.filter(m=>m.grp===fGrp);
    const routes = [...new Set(branches.map(m=>m.route).filter(Boolean))].sort();
