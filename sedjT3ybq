let _rdCurrentRoute = null; // بيانات الخط المفتوح حالياً في المودال

async function openRouteDetail(routeEncoded){
  const routeName = decodeURIComponent(routeEncoded);
  _rdCurrentRoute = { name: routeName };
  document.getElementById('rd-title').textContent = routeName;
  document.getElementById('rd-grp').innerHTML = '<span style="color:#aaa">جاري التحميل...</span>';
  document.getElementById('rd-rep').innerHTML = '<span style="color:#aaa">جاري التحميل...</span>';
  document.getElementById('rd-supervisor').innerHTML = '<span style="color:#aaa">جاري التحميل...</span>';
  document.getElementById('rd-branches-tbody').innerHTML = '<tr><td colspan="5" style="text-align:center;padding:1rem"><div class="spinner"></div></td></tr>';
  openModal('modal-route-detail');

  try{
    // جيب بيانات الخط من routes
    const rtRes = await fetch(`${SUPABASE_URL}/rest/v1/routes?select=name,grp&name=eq.${encodeURIComponent(routeName)}`,{
      headers:{'apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`}
    });
    const rtData = rtRes.ok ? await rtRes.json() : [];
    let grp = rtData[0]?.grp || '';

    // fallback: لو grp فاضية في routes، جيبها من users
    if(!grp){
      const uRes = await fetch(`${SUPABASE_URL}/rest/v1/users?select=grp&route=eq.${encodeURIComponent(routeName)}&role=eq.rep&limit=1`,{
        headers:{'apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`}
      });
      const uData = uRes.ok ? await uRes.json() : [];
      grp = uData[0]?.grp || '';
    }

    _rdCurrentRoute.grp = grp;

    // المجموعة
    const grpLabel = GROUPS[grp]?.label || grp || '—';
    const grpColor = GROUPS[grp]?.color || '#999';
    document.getElementById('rd-grp').innerHTML = `<span style="color:${grpColor}">${grpLabel}</span>`;

    // المنسق (من users)
    const repRes = await fetch(`${SUPABASE_URL}/rest/v1/users?select=name,route&role=eq.rep&route=eq.${encodeURIComponent(routeName)}`,{
      headers:{'apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`}
    });
    const repData = repRes.ok ? await repRes.json() : [];
    const repNames = repData.map(r=>r.name).join('، ') || '—';
    _rdCurrentRoute.reps = repData.map(r=>r.name);
    document.getElementById('rd-rep').textContent = repNames;

    // مشرف المنطقة (من grp_supervisors)
    let supervisor = '—';
    if(grp){
      const supRes = await fetch(`${SUPABASE_URL}/rest/v1/grp_supervisors?select=supervisor&grp=eq.${encodeURIComponent(grp)}`,{
        headers:{'apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`}
      });
      const supData = supRes.ok ? await supRes.json() : [];
      supervisor = supData[0]?.supervisor || '—';
    }
    _rdCurrentRoute.supervisor = supervisor;
    document.getElementById('rd-supervisor').textContent = supervisor;

    // الفروع (من branches) مع المنسقين
    const brRes = await fetch(`${SUPABASE_URL}/rest/v1/branches?select=id,branch_name,client_type,status,rep_name,rep_name2,rep_name3&route=eq.${encodeURIComponent(routeName)}&order=branch_name.asc`,{
      headers:{'apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`}
    });
    const branches = brRes.ok ? await brRes.json() : [];
    _rdCurrentRoute.branches = branches;
    document.getElementById('rd-branch-count').textContent = `(${branches.length} فرع)`;

    if(!branches.length){
      document.getElementById('rd-branches-tbody').innerHTML = '<tr><td colspan="6" style="text-align:center;padding:1rem;color:#aaa">لا توجد فروع مسجلة</td></tr>';
      return;
    }

    document.getElementById('rd-branches-tbody').innerHTML = branches.map((b,i)=>{
      const statusBadge = b.status==='active'
        ? `<span class="badge b-green">نشط</span>`
        : `<span class="badge b-gray">موقوف</span>`;
      const typeBadge = b.client_type
        ? `<span class="badge" style="background:${b.client_type==='A'?'#E8F5E9':'#FFF3E0'};color:${b.client_type==='A'?'#1A7A4A':'#E65100'}">${b.client_type}</span>`
        : '—';
      // عرض المنسقين المسجلين على الفرع
      const reps=[b.rep_name,b.rep_name2,b.rep_name3].filter(Boolean);
      const repsHtml=reps.length
        ? reps.map(r=>`<span style="display:inline-block;background:#EEF6FF;color:#003A80;
            padding:1px 6px;border-radius:4px;font-size:10px;font-weight:600;margin:1px;
            cursor:pointer" onclick="rdEditRepOnBranch(${b.id},'${(b.branch_name||'').replace(/'/g,"\\'")}',
            '${r.replace(/'/g,"\\'")}','${routeName.replace(/'/g,"\\'")}')">
            ${r} <span style="color:#C55B48">✎</span></span>`).join('')
        : `<span style="color:#aaa;font-size:10px">— <button class="btn btn-xs" style="background:#F5F0E8;color:#8B6F47;padding:1px 5px"
            onclick="rdAssignRep(${b.id},'${(b.branch_name||'').replace(/'/g,"\\'")}','${routeName.replace(/'/g,"\\'")}')">
            تعيين منسق</button></span>`;
      const brName=(b.branch_name||'').replace(/'/g,"\\'");
      const rt=routeName.replace(/'/g,"\\'");
      return `<tr>
        <td>${i+1}</td>
        <td><b>${b.branch_name||'—'}</b></td>
        <td>${typeBadge}</td>
        <td style="max-width:200px">${repsHtml}</td>
        <td>${statusBadge}</td>
        <td style="white-space:nowrap">
          <button class="btn btn-xs btn-blue" onclick="openEditBranch({id:${b.id},branch_name:'${brName}',status:'${b.status||'active'}',client_type:'${b.client_type||'B'}',route:'${rt}',grp:'${b.grp||''}'})">
            <i class="ti ti-edit"></i>
          </button>
          <button class="btn btn-xs" style="background:#FFEBEE;color:#B71C1C" onclick="toggleBranchStatus(${b.id},'${b.status==='active'?'inactive':'active'}','${rt}')">
            <i class="ti ti-power"></i>
          </button>
          <button class="btn btn-xs" style="background:#FFEBEE;color:#B71C1C" onclick="deleteBranchFromRoute(${b.id},'${brName}','${rt}')">
            <i class="ti ti-trash"></i>
          </button>
        </td>
      </tr>`;
    }).join('');

  }catch(e){
    console.error('openRouteDetail error:', e);
    document.getElementById('rd-branches-tbody').innerHTML = '<tr><td colspan="5" style="text-align:center;color:var(--red);padding:1rem">تعذر التحميل</td></tr>';
  }
}

