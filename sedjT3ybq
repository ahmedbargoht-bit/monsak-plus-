let _splSpecialLists = []; // [{id,name,branches:[],discount_pct,active}]
let _splClientLists  = []; // [{id,name,clients:[],products:[{name,price}],active}]
let _splAllBranches  = []; // [{branch_name, grp}]
let _splCPLProdRows  = {}; // {productName: price} — الأصناف في المودال الحالي

async function splSpecialInit(){
  // جيب الفروع لو لم تُحمّل بعد
  if(!_splAllBranches.length){
    try{
      const H={'apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`};
      const res = await fetch(`${SUPABASE_URL}/rest/v1/branches?select=branch_name,grp&status=eq.active&order=branch_name.asc&limit=2000`,{headers:H});
      _splAllBranches = res.ok ? await res.json() : [];
    }catch(e){ _splAllBranches=[]; }
  }
  const H={'apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`};
  // جيب قوائم الخصم % على الفروع
  try{
    const res = await fetch(`${SUPABASE_URL}/rest/v1/products_db?key=eq.branch_pricelists&select=value`,{headers:H});
    const data = res.ok ? await res.json() : [];
    _splSpecialLists = data.length ? JSON.parse(data[0].value||'[]') : [];
  }catch(e){ _splSpecialLists=[]; }
  // جيب قوائم الأسعار الخاصة للعملاء
  try{
    const res = await fetch(`${SUPABASE_URL}/rest/v1/products_db?key=eq.client_pricelists&select=value`,{headers:H});
    const data = res.ok ? await res.json() : [];
    _splClientLists = data.length ? JSON.parse(data[0].value||'[]') : [];
  }catch(e){ _splClientLists=[]; }
  splSpecialRender();
}

function splSpecialRender(){
  const tbody = document.getElementById('spl-special-tbody');
  if(!tbody) return;
  const allLists = [
    ..._splSpecialLists.map(pl=>({...pl,_t:'discount'})),
    ..._splClientLists.map(pl=>({...pl,_t:'prices'}))
  ];
  if(!allLists.length){
    tbody.innerHTML='<tr><td colspan="6" style="text-align:center;padding:30px;color:#aaa">لا توجد قوائم — أضف قائمة جديدة</td></tr>';
    return;
  }
  tbody.innerHTML = allLists.map((pl,i)=>{
    const isDisc = pl._t==='discount';
    const typeBadge = isDisc
      ? `<span style="background:#FFF3CD;color:#856404;padding:2px 8px;border-radius:10px;font-size:10px;font-weight:700">🏷️ خصم %</span>`
      : `<span style="background:#E8F5E9;color:#2E7D32;padding:2px 8px;border-radius:10px;font-size:10px;font-weight:700">💲 أسعار خاصة</span>`;
    const detailsCell = isDisc
      ? `<span style="background:#FFF3CD;color:#856404;font-weight:800;font-size:14px;padding:3px 12px;border-radius:20px">${pl.discount_pct}%</span>`
      : `<span style="background:#E8F5E9;color:#2E7D32;font-weight:700;padding:3px 10px;border-radius:20px">${(pl.products||[]).length} صنف</span>`;
    const members = isDisc ? (pl.branches||[]) : (pl.clients||[]);
    const membersCell = members.slice(0,2).map(m=>`<span style="background:#F0F7FF;color:#1565C0;padding:2px 7px;border-radius:10px;font-size:10px;margin:1px 2px;display:inline-block">${m}</span>`).join('')
      + (members.length>2?`<span style="font-size:10px;color:#666;margin-right:4px">+${members.length-2} أخرى</span>`:'');
    return `<tr style="border-bottom:1px solid var(--border);${i%2===0?'':'background:#FDFAF5'}">
      <td style="padding:10px 14px;font-weight:700;font-size:13px">${pl.name}</td>
      <td style="padding:10px;text-align:center">${typeBadge}</td>
      <td style="padding:10px;text-align:center">${detailsCell}</td>
      <td style="padding:10px;font-size:11px">${membersCell||'—'}</td>
      <td style="padding:10px;text-align:center">
        <label style="display:inline-flex;align-items:center;gap:5px;cursor:pointer">
          <input type="checkbox" ${pl.active?'checked':''} onchange="splSpecialToggle('${pl._t}','${pl.id}',this.checked)"
            style="width:16px;height:16px;accent-color:#2E7D32;cursor:pointer"/>
          <span style="font-size:11px;color:${pl.active?'#2E7D32':'#999'};font-weight:700">${pl.active?'نشط':'موقوف'}</span>
        </label>
      </td>
