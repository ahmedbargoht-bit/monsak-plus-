function pdbApplyBulkShelf(){
  const shelfVal=document.getElementById('bulk-shelf-input')?.value.trim();
  const stockVal=document.getElementById('bulk-stock-input')?.value.trim();
  if(shelfVal===''&&stockVal===''){ alert('أدخل قيمة واحدة على الأقل'); return; }
  let count=0;
  // نجمّع الـ keys حسب fea+cat+grp عشان نعدّل كل array مرة وحدة
  // ونستخدم snf كـ identifier مستقر بدل index
  _pdbBulkKeys.forEach(k=>{
    const arr=PDB[k.fea]?.[k.cat]?.[k.grp];
    if(!arr) return;
    // نلاقي العنصر بالـ snf المخزّنة في الـ key
    const snfKey=k.snf||'';
    // نجرب بالـ idx أولاً (الأسرع)، ولو الـ item مش مطابق نعدّل بالاسم
    let realIdx=k.idx;
    if(realIdx>=arr.length||
       (typeof arr[realIdx]==='string'&&arr[realIdx]!==snfKey)||
       (typeof arr[realIdx]==='object'&&arr[realIdx]!==null&&(arr[realIdx].name||'')!==snfKey)){
      // fallback: ابحث بالاسم
      realIdx=arr.findIndex(item=>{
        const name=typeof item==='object'&&item!==null?(item.name||''):String(item);
        return name===snfKey;
      });
    }
    if(realIdx===-1||realIdx>=arr.length) return;
    const item=arr[realIdx];
    const isObj=typeof item==='object'&&item!==null;
    const name=isObj?(item.name||String(item)):String(item);
    const updated=isObj?{...item}:{name};
    if(shelfVal!=='') updated.monthsShelf=Number(shelfVal);
    if(stockVal!=='') updated.monthsStock=Number(stockVal);
    arr[realIdx]=updated;
    count++;
  });
  _pdbBulkKeys=[];
  try{ localStorage.setItem('pdb_cache',JSON.stringify(PDB)); }catch(e){}
  saveProductsToSupabase(PDB);
  document.getElementById('pdb-bulk-overlay')?.remove();
  pdbClearSelection();
  renderProdDB();
  splSyncProductsFromPDB();
  showToast(`✅ تم تعديل الصلاحية على ${count} صنف`);
}

