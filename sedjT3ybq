<script>

// ══ CREATE ENTITIES FUNCTIONS ══
// ── تبديل التابات الداخلية ──────────────────────────────────
function switchCreateTab(tab){
  document.querySelectorAll('.create-tab-panel').forEach(p=>p.style.display='none');
  document.querySelectorAll('.create-tab-btn').forEach(b=>{
    b.style.color='#8B6A42';
    b.style.background='transparent';
    b.style.borderColor='transparent';
  });
  const panel=document.getElementById('create-tab-'+tab);
  const btn=document.getElementById('ctab-'+tab);
  if(panel) panel.style.display='block';
  if(btn){ btn.style.color='#3D2E0F'; btn.style.background='#fff'; btn.style.borderColor='#C8A97A'; }

  // تحميل الـ dropdowns عند فتح التابات
  if(tab==='routes') loadGroupsDropdowns();
  if(tab==='cbranch'){ loadGroupsDropdowns(); loadRoutesDropdown('cb-route'); }
  if(tab==='supervisor'){ loadGroupsDropdowns(); loadRoutesDropdown('cs-route'); }
  if(tab==='manage') manageSwitch('groups');
}

function showCreateMsg(id, ok, msg){
  const el=document.getElementById(id);
  if(!el) return;
  el.style.display='block';
  el.style.background = ok ? '#E8F5E9' : '#FFEBEE';
  el.style.color       = ok ? '#1A7A4A' : '#B71C1C';
  el.style.border      = ok ? '1px solid #A5D6A7' : '1px solid #FFCDD2';
  el.textContent       = msg;
  if(ok) setTimeout(()=>el.style.display='none', 3000);
}

// ── تحميل المجموعات في الـ dropdowns ──────────────────────────
async function loadGroupsDropdowns(){
  let groups=[];
  try{
    const res=await fetch(`${SUPABASE_URL}/rest/v1/groups?select=*&order=name.asc&limit=200`,
      {headers:{'apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`}});
    if(res.ok) groups=await res.json();
  }catch(e){}

  // fallback للـ GROUPS الثابتة
  if(!groups.length){
    groups=Object.entries(GROUPS).map(([key,v])=>({key_name:key, name:v.label.replace(/^[^\s]+ /,''), emoji:''}));
  }

  const selIds=['cr-group','cb-group','cs-group','eb-group','era-group','eu-group'];
  selIds.forEach(id=>{
    const sel=document.getElementById(id);
    if(!sel) return;
    const cur=sel.value;
    sel.innerHTML='<option value="">اختر المجموعة...</option>';
    groups.forEach(g=>{
      const opt=document.createElement('option');
      opt.value=g.key_name||g.id;
      opt.textContent=(g.emoji||'')+' '+(g.name||g.key_name);
      if(opt.value===cur) opt.selected=true;
      sel.appendChild(opt);
    });
    // أضف المجموعات الثابتة اللي مش في الـ DB
    Object.entries(GROUPS).forEach(([key,v])=>{
      if(!groups.find(g=>g.key_name===key)){
        const opt=document.createElement('option');
        opt.value=key;
        opt.textContent=v.label;
        if(opt.value===cur) opt.selected=true;
        sel.appendChild(opt);
      }
    });
  });
}

// ── تحميل خطوط السير في الـ dropdown ──────────────────────────
async function loadRoutesDropdown(selId, grpFilter){
  const sel=document.getElementById(selId);
  if(!sel) return;
  const cur=sel.value;
  sel.innerHTML='<option value="">اختر خط السير...</option>';

  // جيب خطوط السير من routes — المصدر الوحيد
  let allRoutes=[];
  try{
    const H={'apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`};
    let routesUrl=`${SUPABASE_URL}/rest/v1/routes?select=name,grp&order=name.asc&limit=2000`;
    if(grpFilter) routesUrl+=`&grp=eq.${grpFilter}`;
    const routesRes=await fetch(routesUrl,{headers:H});
    if(routesRes.ok){
      const data=await routesRes.json();
      data.forEach(r=>{ if(r.name) allRoutes.push(r.name); });
    }
  }catch(e){}

  // أضف خطوط BRANCHES_MAP الثابتة لو مش موجودة
  const staticRoutes = Object.keys(BRANCHES_MAP||{});
  staticRoutes.forEach(r=>{ if(!allRoutes.includes(r)) allRoutes.push(r); });
  allRoutes.sort((a,b)=>a.localeCompare(b,'ar'));

  allRoutes.forEach(name=>{
    const opt=document.createElement('option');
    opt.value=name; opt.textContent=name;
