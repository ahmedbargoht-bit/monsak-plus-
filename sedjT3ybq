  window._pbEditingId = id;
  window._pbClients = [...(row.target_clients||[])];
  document.getElementById('pb-form-title').textContent = 'تعديل بانر';
  document.getElementById('pb-active').checked = !!row.active;
  document.getElementById('pb-title').value = row.title||'';
  document.getElementById('pb-body').value = row.body||'';
  document.getElementById('pb-date-from').value = row.date_from||'';
  document.getElementById('pb-date-to').value = row.date_to||'';
