async function addSupervisor(){
  const name     = document.getElementById('ns-name').value.trim();
  const pass     = document.getElementById('ns-pass').value.trim();
  const level    = document.getElementById('ns-level').value;
  const jobTitle = document.getElementById('ns-role').value.trim();
  const groups   = [...document.querySelectorAll('.ns-grp-cb:checked')].map(c=>c.value);
  const appAccess= [...document.querySelectorAll('.ns-app-cb:checked')].map(c=>c.value);
  if(!name||!pass){alert('أدخل الاسم والباسورد');return;}

  const roleMap = {
    'مدير عام':'gm','مدير التنسيق':'merch_manager','مدير البيع':'sales_manager',
    'مشرف الهايبر':'hyper_sup','مشرف المجموعة':'group_sup','مشرف التنسيق':'merch_sup',
    'مشرف الأسواق الخاصة':'special_sup','مشرف بيع هايبر':'hyper_sales_sup',
  };
  const staffRole = roleMap[jobTitle]||'merch_sup';
  const H = {'Content-Type':'application/json','apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`,'Prefer':'return=minimal'};

  try{
    // 1. staff — المصدر الرئيسي
    const staffEx = await fetch(`${SUPABASE_URL}/rest/v1/staff?name=eq.${encodeURIComponent(name)}`,
      {headers:{'apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`}}).then(r=>r.ok?r.json():[]).catch(()=>[]);
    if(staffEx.length>0){
      await fetch(`${SUPABASE_URL}/rest/v1/staff?name=eq.${encodeURIComponent(name)}`,{
        method:'PATCH',headers:H,
        body:JSON.stringify({role:staffRole,grp:groups,app_access:appAccess,active:true})
      });
    } else {
      await fetch(`${SUPABASE_URL}/rest/v1/staff`,{
        method:'POST',headers:H,
        body:JSON.stringify({name,role:staffRole,grp:groups,app_access:appAccess,active:true,reports_to:''})
      });
    }

    // 2. users — للباسورد والدخول
    const usersEx = await fetch(`${SUPABASE_URL}/rest/v1/users?name=eq.${encodeURIComponent(name)}&role=eq.supervisor`,
      {headers:{'apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`}}).then(r=>r.ok?r.json():[]).catch(()=>[]);
    const uData = {name,pass_hash:pass,role:'supervisor',level,user_type:jobTitle,
      groups:groups.join(','),grp:groups[0]||null,status:'active',goal:0,route:null};
    if(usersEx.length>0){
      await fetch(`${SUPABASE_URL}/rest/v1/users?name=eq.${encodeURIComponent(name)}&role=eq.supervisor`,
        {method:'PATCH',headers:H,body:JSON.stringify(uData)});
    } else {
      await fetch(`${SUPABASE_URL}/rest/v1/users`,{method:'POST',headers:H,body:JSON.stringify(uData)});
    }

    document.getElementById('ns-name').value='';
    document.getElementById('ns-pass').value='';
    document.querySelectorAll('.ns-grp-cb,.ns-app-cb').forEach(c=>c.checked=false);
    showToast('✅ تم إضافة '+name);
    closeModal('modal-add-sup');
    await loadSupervisors();
  }catch(e){
    alert('خطأ: '+e.message);
  }
}

async function editSupervisor(){
  const id = document.getElementById('es-id').value;
  const oldName = document.getElementById('es-old-name').value;
  const name = document.getElementById('es-name').value.trim();
  const pass = document.getElementById('es-pass').value.trim();
  const level = document.getElementById('es-level').value;
  const jobTitle = document.getElementById('es-role').value.trim();
  const status = document.getElementById('es-status').value;
  const groups = [...document.querySelectorAll('.es-grp-cb:checked')].map(c=>c.value).join(',');
  if(!name) return;

  const data = {name, pass_hash:pass, level, groups, status,
    user_type:jobTitle||'مشرف التنسيق', role:'supervisor',
    grp:groups.split(',')[0]||null};

  // تحقق هل موجود في users
  const existing = await sb('users',{name:oldName, role:'supervisor'});
  if(existing && existing.length > 0){
    // موجود — حدّث
    const uid = existing[0].id;
    await sbUpdate('users',{id:uid},data);
  } else {
    // مش موجود في users (من staff فقط) — أضفه
    await sbInsert('users',{...data, goal:0, route:null});
  }

  closeModal('modal-edit-sup');
  await loadSupervisors();
  showOk('nu-ok','✓ تم تعديل '+name);
}

async function toggleSupStatus(idx){
  const s = SUPERVISORS[idx];
  const newStatus = s.status==='active'?'inactive':'active';
  let ok;
  if(s.id) ok = await sbUpdate('users',{id:s.id},{status:newStatus});
  else      ok = await sbUpdateByName('users',s.name,{status:newStatus});
  if(ok){
    alert(newStatus==='inactive'
      ? `✓ تم إيقاف "${s.name}" — لن يستطيع الدخول للتطبيق بعد الآن`
      : `✓ تم تفعيل "${s.name}" — يستطيع الدخول مجدداً`);
  }else{
    alert('تعذّر تغيير الحالة — تحقق من الاتصال');
  }
  await loadSupervisors();
}

async function deleteSup(idx){
  const s = SUPERVISORS[idx];
  secureAction(`حذف المشرف "${s.name}"؟`, async ()=>{
    if(s.id) await sbDelete('users',{id:s.id});
    else      await sbDelete('users',{name:s.name});
    await loadSupervisors();
  });
}

