// ── نظام الاستخراج بالـ Vision (بيقرأ صورة الصفحة زي ما هي بعينها) ──
// السبب: pdf.js بيسحب النص بترتيب رسمه جوه ملف الـ PDF مش بترتيب القراءة البصرية،
// وده بيبوّظ خالص أي عقد فيه جداول مركبة (زي جدول "البند التاسع - الشروط التجارية" في
// عقود سبينيس) — الأرقام والمسميات بتتقطع عن بعض ومترتبش صح، فالـ AI كان بيخمّن/يخترع
// ربط غلط بين الاسم والرقم. الحل: نحوّل كل صفحة لصورة ونديها لموديل يقرأ صور (Gemini/Claude)
// عشان يشوف الجدول زي ما هو مرسوم بالظبط، بدل ما يعتمد على نص متقطّع.
async function caRenderPDFPagesToImages(file, maxPages){
  if(typeof pdfjsLib === 'undefined') throw new Error('مكتبة قراءة PDF لم يتم تحميلها — حدّث الصفحة وجرب تاني');
  if(!pdfjsLib.GlobalWorkerOptions.workerSrc){
    pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
  }
  const buf = await file.arrayBuffer();
  const pdf = await pdfjsLib.getDocument({data:buf}).promise;
  const images = [];
  const total = Math.min(pdf.numPages, maxPages||12);
  for(let i=1;i<=total;i++){
    const page = await pdf.getPage(i);
    const viewport = page.getViewport({scale:2}); // دقة عالية كفاية لقراءة الجداول الصغيرة والنسب
    const canvas = document.createElement('canvas');
    canvas.width = viewport.width; canvas.height = viewport.height;
    const ctx = canvas.getContext('2d');
    await page.render({canvasContext:ctx, viewport}).promise;
    images.push(canvas.toDataURL('image/png').split(',')[1]); // base64 بس من غير الـ prefix
  }
  return images;
}

function caBuildExtractionSysPrompt(){
  return `أنت محلل عقود تجاري متخصص في عقود التوريد لسلاسل السوبر ماركت والهايبر ماركت في مصر.
هتشوف صور صفحات عقد فعلي (ممكن يكون فيها جداول مركّبة بأعمدة وصفوف). مطلوب منك تستخرج كل البنود المالية والنسب المذكورة في العقد وترجعها فقط كـ JSON array بدون أي نص إضافي أو markdown، بالشكل ده بالظبط:
[{"section":"fixed","item_name":"اسم البند","value":"الرقم","notes":"أي ملاحظة أو تارجت"}]

مهم جدًا — دقة الربط بين الاسم والرقم:
- item_name لازم يكون النص الحرفي المكتوب فعليًا في الجدول/العقد بالظبط (زي "نسبة خصم الفاتورة" أو "Monthly Fixed Rebate" أو "مهرجان رمضان")، من غير ما تلخصه أو تعيد صياغته أو تستبدله بمسمى عام.
- الأمثلة المذكورة تحت في قواعد التصنيف هي بس لمساعدتك تفهم نوع كل قسم — مش أسماء بنود جاهزة تستخدمها بدل الاسم الحقيقي في الصورة.
- في أي جدول بعمودين (اسم البند | القيمة)، الرقم اللي بتاخده لازم يكون في نفس الصف بالظبط جنب اسم البند — ممنوع تاخد رقم من صف فوق أو تحت حتى لو قريب أو الصفحة زحمة. لو الصف مقطوع بين صفحتين، ارجع لصورة الصفحة اللي فيها الاسم والرقم مع بعض.
- ممنوع منعًا باتًا تخلط بين جدولين مختلفين حتى لو متجاورين في نفس الصفحة أو الصفحة اللي بعدها — مثال حقيقي حصل: جدول "تسعير إعلانات المجلة" اتلخبط مع جدول "المرتجعات" لأنهم كانوا قريبين من بعض. قبل ما تربط رقم باسم، تأكد إن الاثنين فعلاً تحت نفس عنوان الجدول (نفس البند/الفقرة في العقد).
- "Progressive Rebate" / خصم الشرائح التصاعدي: ده مش رقم واحد ثابت — لازم يطلع كذا بند منفصل، كل بند يمثل شريحة واحدة برقمها الصحيح (مش نفس رقم بند تاني زي Monthly Fixed Rebate)، والـ notes فيها حد الشريحة (مثلاً "لحد 1,000,000" أو "من 1,000,000 لحد 2,000,000" أو "فوق 2,000,000").
- خصومات المرتجعات (زي "خصم مقابل عدم قبول المرتجع"): لو الجدول بيبيّن بس "يقبل"/"لا يوجد" أو علامة صح/خطأ من غير رقم نسبة مكتوب صراحة جنبه، متختلقش نسبة — سيب value فاضي واكتب في notes الحالة المكتوبة زي ما هي ("يقبل" أو "لا يوجد"). لو نفس النوع اتكرر لأكتر من صنف مرتجع مختلف (تالفة/منتهية الصلاحية/اقتربت من الانتهاء/زيادة عن المبيعات)، سجّل كل واحد ببند منفصل باسم واضح يوضح نوع المرتجع اللي بيتكلم عنه.
- أي بند اتكرر ذكره في أكتر من صفحة بنفس الرقم (زي فترة الائتمان)، خد الرقم المكتوب فعليًا في الصفحة المخصصة له، ولو لقيت رقمين مختلفين لنفس البند في صفحتين، اكتب الاتنين في notes ووضح إنه فيه تعارض بدل ما تختار واحد عشوائي.

قواعد التصنيف لحقل section — القاعدة الأهم: لو القيمة مكتوبة كنسبة مئوية (فيها علامة % أو مذكورة كـ "نسبة") فهي لازم تروح لـ "percentage" أو "tier" — مش "fixed" أو "fees" — حتى لو الرقم صغير زي 1% أو 0.5% وحتى لو مكتوب جنب كلمة "مساهمة" أو "دعم" اللي ممكن تفتكرها مبلغ ثابت. العكس: أي مبلغ بالجنيه (رقم كبير من غير %) لازم يروح "fixed" أو "fees" مش "percentage":
- "summary": بنود التحقيق الكلي مثل "محقق بدون الخصم" أو "محقق بعد الخصم" لو مذكورة كأرقام فعلية
- "fixed": بنود خصم بمبالغ ثابتة بالجنيه زي (خصم إداري، عيد ميلاد، رمضان، إيجار استاندات، مجلات/دعاية/تسويق، تكويد أصناف) — وبند "اجمالي الخصم" لو مجموع مذكور
- "fees": أي رسوم بمبلغ ثابت مش خصم مباشر (رسوم إدارية سنوية، رسوم تسجيل منتج جديد، رسوم منسق، قيمة بضاعة مجانية، رسوم تحصيل شيكات، وأي رسوم تانية)
- "openings": أي بند خاص بافتتاح فروع جديدة (افتتاح فرع، خصومات افتتاح، رسوم افتتاح فرع جديد)
- "percentage": نسب خصم على المبيعات (خصم الفاتورة، خصم شهري، خصم سنوي، إيجار مساحة، مساهمات/دعم بنسبة مئوية زي مساهمة توسعات الشركة لو مكتوبة %) — القيمة نسبة عشرية (7% تُكتب 0.07) — وبند "اجمالي النسب" لو موجود
- "tier": خصومات شرائح حسب حجم المبيعات (خصم شريحة 1، خصم شريحة 2...) — value نسبة عشرية، notes فيها رقم التارجت/المستهدف بالظبط
- "credit": فترة الائتمان — item_name="فترة الائتمان"، value فاضي، notes النص الكامل (مثلاً "70 يوم")

لو بند مش موجود صراحة في العقد متضيفوش، ولو مش متأكد من رقم أو ربط سيبه فاضي بدل ما تخترعه. قبل ما ترجع الإجابة، راجع كل بند مرة تانية وقارنه بالصورة الأصلية تأكيدًا إن الاسم والرقم والتصنيف الثلاثة متطابقين مع اللي في الصورة بالظبط. رجّع الـ JSON بس من غير أي شرح أو تعليق.`;
}

async function caVisionExtractGemini(base64Images, sys, userText){
  await aiEnsureGeminiKey();
  if(!_GEMINI_KEY) throw new Error('مفتاح Gemini غير متاح');
  const parts = [{text:userText}, ...base64Images.map(b64=>({inline_data:{mime_type:'image/png', data:b64}}))];
  const body = {
    contents: [{role:'user', parts}],
    systemInstruction: {parts:[{text:sys}]},
    generationConfig: { maxOutputTokens: 4000, temperature: 0.2 }
  };
  const res = await fetch(GEMINI_URL+'?key='+_GEMINI_KEY, {
    method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(body)
  });
  if(!res.ok){ const er = await res.json().catch(()=>({})); throw new Error('[Gemini Vision] '+(er?.error?.message||'HTTP '+res.status)); }
  const data = await res.json();
  const text = data?.candidates?.[0]?.content?.parts?.[0]?.text||'';
  if(!text) throw new Error('[Gemini Vision] رد فارغ');
  console.log('[Gemini Vision] ✅ تم');
  return text;
}

async function caVisionExtractClaude(base64Images, sys, userText){
  await aiEnsureClaudeKey();
  if(!_CLAUDE_KEY) throw new Error('مفتاح Claude غير متاح');
  const content = [
    ...base64Images.map(b64=>({type:'image', source:{type:'base64', media_type:'image/png', data:b64}})),
    {type:'text', text:userText}
  ];
  const body = { model: CLAUDE_MODEL, max_tokens: 8000, system: sys, messages:[{role:'user', content}] };
  const res = await fetch(CLAUDE_URL, {
    method:'POST',
    headers:{'Content-Type':'application/json','x-api-key':_CLAUDE_KEY,'anthropic-version':'2023-06-01','anthropic-dangerous-direct-browser-access':'true'},
    body: JSON.stringify(body)
  });
  if(!res.ok){ const er = await res.json().catch(()=>({})); throw new Error('[Claude Vision] '+(er?.error?.message||'HTTP '+res.status)); }
  const data = await res.json();
  // ملحوظة: content[0] ممكن ميكونش نص (زي بلوك thinking) — بندور على كل بلوكات النص مش بس أول عنصر
  const text = (data?.content||[]).filter(c=>c && c.type==='text' && c.text).map(c=>c.text).join('\n');
  if(!text){
    // تشخيص مفصّل بدل التخمين: نعرض شكل الرد الفعلي (نوع البلوكات + عدد التوكنز) عشان نعرف السبب الحقيقي لو اتكرر
    const blockTypes = (data?.content||[]).map(c=>c?.type).join(',') || 'مفيش بلوكات خالص';
    const usage = data?.usage ? JSON.stringify(data.usage) : 'غير متاح';
    throw new Error(`[Claude Vision] رد فارغ (stop_reason: ${data?.stop_reason||'؟'}, أنواع البلوكات: [${blockTypes}], usage: ${usage})`);
  }
  console.log('[Claude Vision] ✅ تم');
  return text;
}

async function caRunAIExtraction(){
  const file = document.getElementById('ca-ai-pdf-file').files[0];
  if(!file){ showToast('❌ اختار ملف PDF الأول'); return; }
  const statusEl = document.getElementById('ca-ai-status');
  const btn = document.getElementById('ca-ai-extract-btn');
  btn.disabled = true;
  const sys = caBuildExtractionSysPrompt();
  let resp = null, usedVision = false;

  // ── المحاولة الأولى (الأدق): قراءة صور صفحات الملف مباشرة بموديل يفهم صور ──
  try{
    statusEl.textContent = '⏳ جاري تحويل صفحات الملف لصور...';
    const images = await caRenderPDFPagesToImages(file, 10);
    if(!images.length) throw new Error('مفيش صفحات اتقرت من الملف');
    const userText = 'دي صور صفحات عقد توريد فعلي — اقرأ كل الجداول والبنود المالية بدقة زي ما هي مرسومة، واستخرجها حسب التعليمات.';
    statusEl.textContent = '⏳ جاري تحليل العقد بالذكاء الاصطناعي (قراءة بصرية للجداول)...';
    try{
      resp = await caVisionExtractGemini(images, sys, userText);
      usedVision = true;
    }catch(e1){
      console.warn('[CA] Gemini Vision فشل:', e1.message, '— جاري تجربة Claude Vision...');
      resp = await caVisionExtractClaude(images, sys, userText);
      usedVision = true;
    }
  }catch(visionErr){
    console.warn('[CA] الاستخراج البصري فشل بالكامل:', visionErr.message, '— هنرجع لاستخراج النص كحل بديل (دقة أقل في الجداول المركبة)');
  }

  try{
    // ── لو الاستخراج البصري فشل بالكامل (مفيش مفاتيح Gemini/Claude مثلاً) — نرجع للطريقة القديمة بالنص ──
    if(!resp){
      statusEl.textContent = '⏳ جاري قراءة نص الملف (طريقة احتياطية)...';
      const text = await caExtractPDFText(file);
      if(!text || text.length < 20){ throw new Error('مقدرتش أقرا نص من الملف — لو الملف صورة ممسوحة (سكانر) الاستخراج التلقائي مش هيشتغل حاليًا'); }
      statusEl.textContent = '⏳ جاري تحليل العقد بالذكاء الاصطناعي...';
      await aiEnsureGroqKey();
      const userMsg = `نص العقد المستخرج من PDF (ملحوظة: النص ده ممكن يكون ترتيبه مش دقيق 100% في الجداول المركبة):\n\n${text.slice(0,15000)}`;
      resp = await groqChat([{role:'system',content:sys},{role:'user',content:userMsg}], 8000);
    }

    const jsonStr = caExtractJSON(resp);
    const items = JSON.parse(jsonStr);
    if(!Array.isArray(items) || !items.length) throw new Error('الذكاء الاصطناعي مقدرش يستخرج بنود واضحة من الملف');
    _caAIPreviewItems = items.map(it=>({
      section: ['summary','fixed','fees','openings','percentage','tier','credit'].includes(it.section) ? it.section : 'fixed',
      item_name: String(it.item_name||'').trim(),
      value: (it.value===undefined||it.value===null) ? '' : String(it.value).trim(),
      notes: (it.notes===undefined||it.notes===null) ? '' : String(it.notes).trim(),
    })).filter(it=>it.item_name);
    if(!_caAIPreviewItems.length) throw new Error('الذكاء الاصطناعي رجّع بنود فاضية');
    caRenderAIPreview();
    const flaggedCount = _caAIPreviewItems.filter(it=>{
      const isPerc = it.section==='percentage'||it.section==='tier';
      const rawNum = parseFloat(it.value);
      const hasNum = it.value!==null && it.value!==undefined && String(it.value).trim()!=='' && !isNaN(rawNum);
      const valStr = String(it.value||''), notesStr = String(it.notes||'');
      if((it.section==='fixed'||it.section==='fees'||it.section==='openings') && (valStr.includes('%')||notesStr.includes('%'))) return true;
      if(isPerc && hasNum && Math.abs(rawNum) > 1) return true;
      return false;
    }).length;
    const flagMsg = flaggedCount ? ` — ⚠️ ${flaggedCount} بند محتاج مراجعة (اتلوّن بالأصفر)` : '';
    statusEl.textContent = (usedVision
      ? '✅ تم الاستخراج بالقراءة البصرية للجداول — راجع البنود تحت قبل الاستيراد'
      : '⚠️ تم الاستخراج بقراءة النص فقط (الطريقة الأدق فشلت) — راجع البنود بعناية خصوصًا الجداول المركبة') + flagMsg;
    document.getElementById('ca-ai-step1').style.display = 'none';
    document.getElementById('ca-ai-step2').style.display = '';
  }catch(e){
    statusEl.textContent = '❌ '+e.message;
    showToast('❌ فشل الاستخراج: '+e.message);
  }finally{
    btn.disabled = false;
  }
}

function caRenderAIPreview(){
  const el = document.getElementById('ca-ai-preview-body');
  el.innerHTML = _caAIPreviewItems.map((it,idx)=>{
    const isPerc = it.section==='percentage' || it.section==='tier';
    const rawNum = parseFloat(it.value);
    const hasNum = it.value!==null && it.value!==undefined && String(it.value).trim()!=='' && !isNaN(rawNum);
    // في أقسام النسب والشرائح نعرض القيمة كنسبة مئوية (0.01 → 1) بدل الكسر العشري، عشان تبقى مفهومة بصريًا وأنت بتراجع
    const valueCell = isPerc
      ? `<div style="display:flex;align-items:center;gap:3px">
           <input type="text" value="${hasNum ? (rawNum*100).toString().replace(/"/g,'&quot;') : (it.value||'').replace(/"/g,'&quot;')}"
             oninput="const n=parseFloat(this.value); _caAIPreviewItems[${idx}].value = (this.value.trim()===''||isNaN(n)) ? this.value : String(n/100);"
             style="width:65px;font-size:11px;padding:4px"/>
           <span style="font-size:11px;color:var(--text2)">%</span>
         </div>`
      : `<input type="text" value="${(it.value||'').replace(/"/g,'&quot;')}" oninput="_caAIPreviewItems[${idx}].value=this.value" style="width:90px;font-size:11px;padding:4px"/>`;
    // تحذير آلي بسيط لالتقاط أخطاء تصنيف محتملة قبل الاستيراد (زي نسبة % اتحطت غلط في قسم مبلغ ثابت)
    const valStr = String(it.value||''), notesStr = String(it.notes||'');
    let flag = '';
    if((it.section==='fixed'||it.section==='fees'||it.section==='openings') && (valStr.includes('%')||notesStr.includes('%'))){
      flag = 'الرقم شكله نسبة % بس متصنف كمبلغ ثابت — راجع القسم';
    } else if(isPerc && hasNum && Math.abs(rawNum) > 1){
      flag = 'الرقم أكبر من 1 في قسم نسبة — لو النسبة الحقيقية مثلاً 3% المفروض تتكتب هنا 3 بس في خانة % (مش 300%)، راجعه';
    }
    const rowStyle = flag ? ' style="background:#FFF8E1"' : '';
    const flagIcon = flag ? `<span title="⚠️ ${flag.replace(/"/g,'&quot;')}" style="color:#E65100;cursor:help;margin-inline-end:4px">⚠️</span>` : '';
    return `<tr${rowStyle}>
      <td>
        <select onchange="_caAIPreviewItems[${idx}].section=this.value; caRenderAIPreview();" style="font-size:11px;padding:4px">
          ${Object.entries(CA_SECTION_LABELS).map(([v,l])=>`<option value="${v}" ${it.section===v?'selected':''}>${l}</option>`).join('')}
        </select>
      </td>
      <td>${flagIcon}<input type="text" value="${(it.item_name||'').replace(/"/g,'&quot;')}" oninput="_caAIPreviewItems[${idx}].item_name=this.value" style="width:100%;font-size:11px;padding:4px"/></td>
      <td>${valueCell}</td>
      <td><input type="text" value="${(it.notes||'').replace(/"/g,'&quot;')}" oninput="_caAIPreviewItems[${idx}].notes=this.value" style="width:100%;font-size:11px;padding:4px"/></td>
      <td><button class="btn btn-xs" style="background:#FFEBEE;color:#B71C1C" onclick="caRemoveAIPreviewRow(${idx})"><i class="ti ti-trash"></i></button></td>
    </tr>`;
  }).join('') || '<tr><td colspan="5" style="text-align:center;color:var(--text2)">لا توجد بنود</td></tr>';
}
function caRemoveAIPreviewRow(idx){
  _caAIPreviewItems.splice(idx,1);
  caRenderAIPreview();
}

async function caConfirmAIImport(){
  const yearCol = document.getElementById('ca-ai-year').value; // value_2025 or value_2026
  const notesCol = yearCol==='value_2025' ? 'extra_2025' : 'extra_2026';
  let clientId = document.getElementById('ca-ai-client-select').value;
  const newName = document.getElementById('ca-ai-new-client').value.trim();
  const H = {'apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`,'Content-Type':'application/json'};
  if(newName){
    const r = await fetch(`${SUPABASE_URL}/rest/v1/contract_clients`,{method:'POST',headers:{...H,'Prefer':'return=representation'},body:JSON.stringify({name:newName})});
    if(!r.ok){ showToast('❌ فشل إضافة العميل الجديد (ممكن الاسم موجود)'); return; }
    const data = await r.json();
    clientId = data[0].id;
  }
  if(!clientId){ showToast('❌ اختار عميل أو اكتب اسم عميل جديد'); return; }

  const rExisting = await fetch(`${SUPABASE_URL}/rest/v1/contract_items?client_id=eq.${clientId}&select=*`,{headers:H});
  const existing = rExisting.ok ? await rExisting.json().catch(()=>[]) : [];

  let addedCount=0, updatedCount=0;
  for(const it of _caAIPreviewItems){
    if(!it.item_name) continue;
    const match = existing.find(e=>e.section===it.section && (e.item_name||'').trim()===it.item_name.trim());
    if(match){
      const payload = {}; payload[yearCol]=it.value||null; payload[notesCol]=it.notes||null;
      await fetch(`${SUPABASE_URL}/rest/v1/contract_items?id=eq.${match.id}`,{method:'PATCH',headers:H,body:JSON.stringify(payload)});
      updatedCount++;
    } else {
      const payload = {client_id:+clientId, section:it.section, item_name:it.item_name, sort_order: existing.length+addedCount+200};
      payload[yearCol]=it.value||null; payload[notesCol]=it.notes||null;
      await fetch(`${SUPABASE_URL}/rest/v1/contract_items`,{method:'POST',headers:H,body:JSON.stringify(payload)});
      addedCount++;
    }
  }
  showToast(`✅ تم الاستيراد: ${addedCount} بند جديد، ${updatedCount} بند اتحدّث`);
  caCloseAIModal();
  await caLoadClients();
  document.getElementById('ca-client-select').value = clientId;
  caSelectClient(clientId);
}

// ── تحليل AI للفروقات بين سنتي العقد للعميل المختار حاليًا ──
async function caRunAIInsights(){
  if(!_caCurrentClientId){ showToast('❌ اختار عميل الأول'); return; }
  const btn = document.getElementById('ca-ai-insights-btn');
  const resultEl = document.getElementById('ca-ai-insights-result');
  btn.disabled = true;
  resultEl.style.display = '';
  resultEl.textContent = '⏳ جاري التحليل...';
  try{
    await aiEnsureGroqKey();
    const client = _caClients.find(c=>String(c.id)===String(_caCurrentClientId));
    const lines = _caItems.map(it=>{
      const v25 = (it.value_2025!==null&&it.value_2025!==undefined&&it.value_2025!=='') ? it.value_2025 : '—';
      const v26 = (it.value_2026!==null&&it.value_2026!==undefined&&it.value_2026!=='') ? it.value_2026 : '—';
      return `[${it.section}] ${it.item_name}: 2025=${v25} | 2026=${v26}${it.extra_2026?` (ملاحظة 2026: ${it.extra_2026})`:''}`;
    }).join('\n');
    const sys = `أنت مستشار تجاري خبير في عقود التوريد لسلاسل السوبر ماركت. هيتم إعطاؤك بنود عقد عميل معين لسنتين (2025 و2026) وعايزك تعمل تحليل مختصر واضح بالعربي (بدون markdown، فقرات قصيرة وواضحة):
1. أهم الزيادات في تكلفة الخصومات على الشركة من 2025 لـ2026 وقيمتها.
2. أهم النسب اللي زادت أو قلّت وتأثيرها على هامش الربح.
3. أي بنود جديدة اتضافت أو اتشالت.
4. توصية مختصرة: هل شروط 2026 أفضل أو أسوأ من 2025 للشركة، وليه.
خليك مباشر ومختصر، من غير مقدمات طويلة.
مهم جدًا: اكتب بالعربي بالكامل، وممنوع تستخدم أي اختصارات أو كلمات إنجليزية زي N/A أو TBD أو غيرها — لو معلومة مش موجودة اكتب "غير مذكور" بدل كده. استخدم الأرقام الإنجليزية العادية (0-9) بس من غير أي حروف إنجليزية جنبها.`;
    const userMsg = `عميل: ${client?client.name:''}\n\nبنود العقد:\n${lines}`;
    const resp = await groqChat([{role:'system',content:sys},{role:'user',content:userMsg}], 1500);
    // تنظيف دفاعي لأي رمز إنجليزي شائع ممكن الـ AI يرجعه رغم التعليمات، عشان نتجنب مشاكل عرض النص المختلط (bidi) في الـ PDF
    const cleaned = resp
      .replace(/\bN\/A\b/gi, 'غير مذكور')
      .replace(/\bTBD\b/gi, 'غير محدد')
      .replace(/\bN\.A\.?\b/gi, 'غير مذكور');
    resultEl.textContent = cleaned;
    _caLastInsight = cleaned;
  }catch(e){
    resultEl.textContent = '❌ فشل التحليل: '+e.message;
  }finally{
    btn.disabled = false;
  }
}

// ── استخراج كلمات مفتاحية من اسم العميل عشان نطابقها مع أسماء الفروع في القاعدة ──
// (مفيش عمود client_id مباشر في جدول branches، فبنعتمد على إن اسم العميل غالبًا موجود كجزء من اسم الفرع
// زي "بنده -المعادى" أو "خير زمان - جليم" — فبنستخرج الكلمات المميزة من اسم العميل ونطابقها كـ substring)
function caDeriveKeywords(clientName){
  const name = (clientName||'').trim();
  if(!name) return [];
  const tokens = name.split(/\s+/).map(t=>t.replace(/^و/,'').trim()).filter(t=>t.length>=2);
  return tokens.length ? tokens : [name];
}

// جلب عدد فروع العميل وعدد الأصناف المكودة عنده
// المصدر الأساسي: جدول sales_clients (أسماء العملاء الرسمية) + branch_client_map (ربط فرع↔عميل تم توثيقه يدويًا من لوحة "أسعار الأصناف والخصومات")
// ده مصدر دقيق وموثّق بعكس التخمين بمطابقة الاسم كنص داخل اسم الفرع. لو مفيش تطابق هناك، نرجع لطريقة المطابقة النصية القديمة كـ fallback فقط.
async function caFetchClientContext(clientName){
  const H = {'apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`};
  const keywords = caDeriveKeywords(clientName);
  const result = {branchCount:null, itemsCount:null, keywords, matchedName:null, source:null};
  if(!keywords.length) return result;

  let matchedBranchNames = [];
  try{
    const [scRes, mapRes] = await Promise.all([
      fetch(`${SUPABASE_URL}/rest/v1/sales_clients?select=id,name`, {headers:H}),
      fetch(`${SUPABASE_URL}/rest/v1/branch_client_map?select=client_name,branch_name&limit=5000`, {headers:H}),
    ]);
    const salesClients = scRes.ok ? await scRes.json().catch(()=>[]) : [];
    const branchMap    = mapRes.ok ? await mapRes.json().catch(()=>[]) : [];

    // اختيار أفضل عميل من sales_clients عن طريق عدد الكلمات المفتاحية المطابقة داخل الاسم الرسمي
    let best = null, bestScore = 0;
    salesClients.forEach(sc=>{
      const score = keywords.filter(k=>k.length>=2 && (sc.name||'').includes(k)).length;
      if(score > bestScore){ bestScore = score; best = sc; }
    });

    if(best && bestScore>0){
      const branches = branchMap.filter(m=>m.client_name===best.name);
      if(branches.length){
        result.matchedName  = best.name;
        result.source       = 'branch_client_map';
        result.branchCount  = branches.length;
        matchedBranchNames  = [...new Set(branches.map(m=>m.branch_name).filter(Boolean))];
      }
    }
  }catch(e){}

  // fallback: لو مفيش ربط موثّق في branch_client_map، استخدم المطابقة النصية القديمة على اسم الفرع
  if(!matchedBranchNames.length){
    try{
      const orFilter = 'or=(' + keywords.map(k=>`branch_name.ilike.*${encodeURIComponent(k)}*`).join(',') + ')';
      const rB = await fetch(`${SUPABASE_URL}/rest/v1/branches?select=branch_name&${orFilter}&limit=3000`,{headers:H});
      if(rB.ok){
        const data = await rB.json().catch(()=>[]);
        matchedBranchNames = [...new Set(data.map(b=>b.branch_name).filter(Boolean))];
        result.branchCount = matchedBranchNames.length;
        result.source = 'ilike_fallback';
      }
    }catch(e){}
  }

  // عدد الأصناف المكودة: لو عندنا قائمة فروع دقيقة (من branch_client_map) استخدمها لفلترة products.branch مباشرة
  try{
    let productsUrl;
    if(matchedBranchNames.length){
      const params = new URLSearchParams();
      params.set('select','snf');
      params.set('branch', `in.(${matchedBranchNames.map(b=>`"${b.replace(/"/g,'')}"`).join(',')})`);
      params.set('limit','8000');
      productsUrl = `${SUPABASE_URL}/rest/v1/products?${params.toString()}`;
    } else {
      const orFilterP = 'or=(' + keywords.map(k=>`branch.ilike.*${encodeURIComponent(k)}*`).join(',') + ')';
      productsUrl = `${SUPABASE_URL}/rest/v1/products?select=snf&${orFilterP}&limit=8000`;
    }
    const rP = await fetch(productsUrl,{headers:H});
    if(rP.ok){
      const data = await rP.json().catch(()=>[]);
      result.itemsCount = new Set(data.map(p=>p.snf).filter(Boolean)).size;
    }
  }catch(e){}

  return result;
}

// ── اقتراحات AI لتفاوض عقد جديد أقوى، باستخدام بيانات فعلية من القاعدة (فروع + أصناف مكودة) ──
async function caRunAIRecommendations(){
  if(!_caCurrentClientId){ showToast('❌ اختار عميل الأول'); return; }
  const btn = document.getElementById('ca-ai-reco-btn');
  const resultEl = document.getElementById('ca-ai-reco-result');
  btn.disabled = true;
  resultEl.style.display = '';
  resultEl.textContent = '⏳ جاري جمع بيانات العميل (الفروع والأصناف) وتحليلها...';
  try{
    await aiEnsureGroqKey();
    const client = _caClients.find(c=>String(c.id)===String(_caCurrentClientId));
    const clientName = client ? client.name : '';
    const ctx = await caFetchClientContext(clientName);

    const summary = _caItems.filter(it=>it.section==='summary');
    const beforeIt = summary.find(it=>(it.item_name||'').includes('بدون'));
    const afterIt  = summary.find(it=>(it.item_name||'').includes('بعد'));

    const lines = _caItems.filter(it=>it.section!=='summary').map(it=>{
      const v25 = (it.value_2025!==null&&it.value_2025!==undefined&&it.value_2025!=='') ? it.value_2025 : '—';
      const v26 = (it.value_2026!==null&&it.value_2026!==undefined&&it.value_2026!=='') ? it.value_2026 : '—';
      return `[${it.section}] ${it.item_name}: 2025=${v25} | 2026=${v26}`;
    }).join('\n');

    const sys = `أنت مستشار تفاوض تجاري خبير في عقود التوريد لسلاسل السوبر ماركت في مصر. الشركة اللي بتستشيرك عايزة تدخل مفاوضة عقد جديد مع العميل ده وعايزة رقم أكبر وشروط أفضل ماليًا.
هيتم إعطاؤك: بنود العقد الحالية (2025 مقابل 2026)، المبيعات المحققة، عدد فروع العميل، وعدد الأصناف المسجلة/المكودة عنده. اديني توصيات عملية ومباشرة (بدون markdown، فقرات قصيرة) تساعد فريق المبيعات ياخد رقم أكبر أو شروط أفضل في التفاوض الجاي، تغطي:
1. أي بنود في العقد الحالي أعلى من المعتاد وممكن نفاوض عليها للأقل، ونطالب بتخفيضها.
2. إزاي نستغل عدد الفروع وعدد الأصناف المسجلة كأوراق ضغط تفاوضية لصالح الشركة.
3. اقتراحات لبنود جديدة أو شروط ممكن تزود العائد المالي للشركة.
4. رقم أو نسبة مستهدفة واقعية نطمح نوصلها في تحسين الشروط أو تقليل الخصومات.
خليك عملي ومباشر، من غير مقدمات طويلة.
مهم جدًا: اكتب بالعربي بالكامل، وممنوع تستخدم أي كلمة إنجليزية زي N/A أو TBD — لو معلومة مش موجودة اكتب "غير مذكور" بدل كده.`;

    const userMsg = `عميل: ${clientName}
عدد الفروع المعروفة في النظام: ${ctx.branchCount!==null?ctx.branchCount:'غير معروف'}
عدد الأصناف المسجلة/المكودة عنده: ${ctx.itemsCount!==null?ctx.itemsCount:'غير معروف'}
المبيعات المحققة 2025 قبل الخصم: ${beforeIt&&caIsNum(beforeIt.value_2025)?caNum(beforeIt.value_2025).toLocaleString('en-US'):'غير مذكور'}
المبيعات المحققة 2025 بعد الخصم: ${afterIt&&caIsNum(afterIt.value_2025)?caNum(afterIt.value_2025).toLocaleString('en-US'):'غير مذكور'}

بنود العقد:
${lines}`;

    const resp = await groqChat([{role:'system',content:sys},{role:'user',content:userMsg}], 1700);
    const cleaned = resp
      .replace(/\bN\/A\b/gi, 'غير مذكور')
      .replace(/\bTBD\b/gi, 'غير محدد')
      .replace(/\bN\.A\.?\b/gi, 'غير مذكور');
    const matchNote = ctx.matchedName ? ` (مطابق لعميل "${ctx.matchedName}" ${ctx.source==='branch_client_map'?'— من ربط الفروع الموثّق':'— بمطابقة تقريبية'})` : '';
    const dataNote = `📊 البيانات المستخدمة من القاعدة: ${ctx.branchCount!==null?ctx.branchCount+' فرع':'عدد الفروع غير معروف'} | ${ctx.itemsCount!==null?ctx.itemsCount+' صنف مكوّد':'عدد الأصناف غير معروف'}${matchNote}\n\n`;
    resultEl.textContent = dataNote + cleaned;
  }catch(e){
    resultEl.textContent = '❌ فشل التحليل: '+e.message;
  }finally{
    btn.disabled = false;
  }
}

