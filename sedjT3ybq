  const lastV    = data.map(r=>r.last_visit).filter(Boolean).sort().reverse()[0]||'—';
  if(stats) stats.innerHTML = [
    {icon:'📦',label:'سجلات',val:data.length},
    {icon:'🏪',label:'فروع',val:branches},
    {icon:'🏷️',label:'أصناف',val:snfs},
    {icon:'🔢',label:'إجمالي الكميات',val:totalQty.toLocaleString()},
    {icon:'📅',label:'آخر زيارة',val:lastV},
  ].map(s=>`<div class="stat-card"><div class="stat-icon">${s.icon}</div><div class="stat-value">${s.val}</div><div class="stat-label">${s.label}</div></div>`).join('');

  // ── الجدول ──
  if(thead) thead.innerHTML = `<tr style="background:var(--surface-2)">
    <th style="padding:8px;text-align:right;font-size:11px">#</th>
    <th style="padding:8px;text-align:right;font-size:11px">الفرع</th>
    <th style="padding:8px;text-align:right;font-size:11px">خط السير</th>
    <th style="padding:8px;text-align:right;font-size:11px">المجموعة</th>
    <th style="padding:8px;text-align:right;font-size:11px">الصنف</th>
    <th style="padding:8px;text-align:right;font-size:11px">التصنيف</th>
    <th style="padding:8px;text-align:right;font-size:11px">تاريخ الإنتاج</th>
    <th style="padding:8px;text-align:right;font-size:11px">الكمية</th>
    <th style="padding:8px;text-align:right;font-size:11px">آخر زيارة</th>
  </tr>`;

  if(!data.length){
    tbody.innerHTML = '<tr><td colspan="9" style="text-align:center;padding:2rem;color:#6B7280">لا توجد نتائج</td></tr>';
    return;
  }

  tbody.innerHTML = data.slice(0,500).map((r,i)=>`
    <tr style="border-bottom:1px solid var(--border);${i%2?'background:var(--surface-1)':''}">
      <td style="padding:7px 8px;font-size:11px;color:#6B7280">${i+1}</td>
