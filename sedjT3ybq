  const regionLabel = document.getElementById('sg-region-label')?.textContent||'كل المناطق';

  // فلتر المشرفين حسب المناطق المختارة
  const filteredSupsPDF = supervisors.filter(s=>{
    if(regions==='all') return true;
    const sec=(s.sector||'').split(',').map(x=>x.trim());
    return sec.some(x=>regions.includes(x));
  });

  // فلتر المناديب حسب المناطق المختارة
  const filteredRepsPDF = reps.filter(r=>{
    if(regions==='all') return true;
    return regions.some(rg=>(r.grp||r.groups||'').includes(rg));
  });

  let totalGoal=0,totalSales=0;
  filteredRepsPDF.forEach(r=>{ totalGoal+=(targets[r.name]?.goal||0); totalSales+=(sales[r.name]||0); });
