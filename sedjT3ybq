// طلبيات مشرفي البيع لمشرفي التنسيق (supply_requests / deal_source=sales_supervisor)
// نفس الجدول اللي بيستخدمه sales-app.html (إرسال) و mansek-supervisor.html (استلام + تحويل للمنسق)
// ══════════════════════════════════════════════════════════════
let _ssoList = [];
let _ssoFilter = 'all';
let _ssoMonth  = 'all';
let _ssoGrpSupMap = null;

// تحويل أرقام لاتينية لعربية (٠١٢٣٤٥٦٧٨٩)
function toArabicNum(v){
  return String(v); // المستخدم عايز أرقام لاتينية عادية (1,2,3) مش أرقام هندية (١,٢,٣)
}

const SSO_AR_MONTHS = ['يناير','فبراير','مارس','أبريل','مايو','يونيو','يوليو','أغسطس','سبتمبر','أكتوبر','نوفمبر','ديسمبر'];

async function loadSalesSupOrders(){
  try{
    const H = {'apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`};
    const [res, supRes] = await Promise.all([
      fetch(`${SUPABASE_URL}/rest/v1/supply_requests?deal_source=eq.sales_supervisor&select=*&order=created_at.desc&limit=300`,{headers:H}),
      fetch(`${SUPABASE_URL}/rest/v1/grp_supervisors?select=grp,supervisor`,{headers:H})
    ]);
    _ssoList = res.ok ? await res.json().catch(()=>[]) : [];
    if(!Array.isArray(_ssoList)) _ssoList=[];

    _ssoGrpSupMap = {};
    if(supRes.ok){
      const supData = await supRes.json().catch(()=>[]);
      (Array.isArray(supData)?supData:[]).forEach(s=>{ if(s.grp) _ssoGrpSupMap[s.grp]=s.supervisor||'—'; });
    }
  }catch(e){ _ssoList=[]; _ssoGrpSupMap={}; }
  renderSalesSupOrders();
}

function setSsoFilter(f){
  _ssoFilter = f;
  ['all','pending','received','assigned','done'].forEach(k=>{
    const btn = document.getElementById('sso-f-'+k);
    if(!btn) return;
    const isActive = k===f;
    btn.style.background = isActive?'var(--navy)':'#fff';
    btn.style.color = isActive?'#fff':'var(--text)';
    btn.style.borderColor = isActive?'var(--navy)':'var(--border)';
  });
  renderSalesSupOrders();
}

function renderSalesSupOrders(){
  const tbody = document.getElementById('sso-table');
  if(!tbody) return;

  // ── دروب داون الشهر — بيتبني من الشهور الموجودة فعليًا في البيانات ──
  const monthSel = document.getElementById('sso-month');
  if(monthSel){
    _ssoMonth = monthSel.value || 'all';
    if(monthSel.dataset.built !== '1'){
      const monthsSet = new Set();
      _ssoList.forEach(o=>{
        const d = o.created_at||o.delivery_date;
        if(!d) return;
        monthsSet.add(d.slice(0,7)); // YYYY-MM
      });
      const monthsArr = [...monthsSet].sort().reverse();
      monthSel.innerHTML = '<option value="all">كل الشهور</option>' + monthsArr.map(ym=>{
        const [y,m] = ym.split('-');
        const label = `${SSO_AR_MONTHS[(+m)-1]||m} ${toArabicNum(y)}`;
        return `<option value="${ym}">${label}</option>`;
      }).join('');
      monthSel.dataset.built = '1';
      monthSel.value = _ssoMonth;
    }
  }

  const upd = (id,v)=>{ const e=document.getElementById(id); if(e) e.textContent=toArabicNum(v); };
  upd('sso-count-pending',  _ssoList.filter(o=>o.status==='pending').length);
  upd('sso-count-received', _ssoList.filter(o=>o.status==='received').length);
  upd('sso-count-assigned', _ssoList.filter(o=>o.status==='assigned').length);
  upd('sso-count-done',     _ssoList.filter(o=>o.status==='done').length);

  let filtered = _ssoList;
  if(_ssoFilter!=='all') filtered = filtered.filter(o=>o.status===_ssoFilter);
  if(_ssoMonth!=='all')  filtered = filtered.filter(o=>(o.created_at||o.delivery_date||'').slice(0,7)===_ssoMonth);

  const sMap = {
    pending:  {label:'⏳ بانتظار التحويل', bg:'#FEF3C7', color:'#B45309'},
    received: {label:'📥 تم الاستلام',      bg:'#EFF6FF', color:'#1D4ED8'},
    assigned: {label:'📋 حُوِّل للمنسق',    bg:'#F0FFF4', color:'#065F46'},
    done:     {label:'✅ تم التوريد',        bg:'#D1FAE5', color:'#065F46'},
  };

  tbody.innerHTML = filtered.map(o=>{
    const s = sMap[o.status]||{label:o.status||'—', bg:'#f5f5f5', color:'#666'};
    const dt = o.delivery_date ? toArabicNum(new Date(o.delivery_date).toLocaleDateString('en-GB')) : '—';
    const supName = (_ssoGrpSupMap && _ssoGrpSupMap[o.grp]) || o.supervisor || '—';
    return `<tr>
      <td><input type="checkbox" class="sso-cb" value="${o.id}"/></td>
      <td><b>${o.from_name||'—'}</b></td>
      <td>${supName}</td>
      <td style="font-size:11px">${o.branch||'—'}${o.route?' · '+o.route:''}</td>
      <td><span style="background:${s.bg};color:${s.color};padding:2px 8px;border-radius:999px;font-size:10px;font-weight:700;white-space:nowrap">${s.label}</span></td>
      <td>${o.to_name?`<span style="color:#065F46;font-weight:700">${o.to_name}</span>`:'<span style="color:#9CA3AF">—</span>'}</td>
      <td style="font-size:11px">${dt}</td>
      <td style="font-size:11px;color:var(--text2)">${o.note||'—'}</td>
    </tr>`;
  }).join('') || `<tr><td colspan="8" style="text-align:center;padding:1rem;color:var(--text2)">لا توجد طلبيات</td></tr>`;
}

function ssoToggleAll(cb){
  document.querySelectorAll('.sso-cb').forEach(c=>c.checked=cb.checked);
}

async function ssoDeleteSelected(){
  const ids = [...document.querySelectorAll('.sso-cb:checked')].map(cb=>cb.value);
  if(!ids.length){ alert('اختر طلبية واحدة على الأقل'); return; }
  if(!confirm(`هيتم حذف ${ids.length} طلبية نهائيًا من قاعدة البيانات — الإجراء ده لا يمكن التراجع عنه. متأكد؟`)) return;
  try{
    const res = await fetch(`${SUPABASE_URL}/rest/v1/supply_requests?id=in.(${ids.join(',')})`,{
      method:'DELETE',
      headers:{'apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`,'Prefer':'return=minimal'}
    });
    if(!res.ok) throw new Error('failed');
    _ssoList = _ssoList.filter(o=>!ids.includes(String(o.id)));
    const allCb = document.getElementById('sso-check-all');
    if(allCb) allCb.checked=false;
    renderSalesSupOrders();
  }catch(e){
    alert('حصل خطأ أثناء الحذف — حاول تاني');
  }
}

async function updateOrderStatus(id, status){
  await fetch(`${SUPABASE_URL}/rest/v1/orders?id=eq.${id}`,{
    method:'PATCH',
    headers:{'Content-Type':'application/json','apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`,'Prefer':'return=minimal'},
    body: JSON.stringify({status})
  });
  const idx = cachedData.orders.findIndex(o=>o.id===id);
  if(idx!==-1) cachedData.orders[idx].status = status;
  renderOrders();
}

async function rejectOrder(id){
  const reason = prompt('سبب الرفض:');
  if(!reason) return;
  await fetch(`${SUPABASE_URL}/rest/v1/orders?id=eq.${id}`,{
    method:'PATCH',
    headers:{'Content-Type':'application/json','apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`,'Prefer':'return=minimal'},
    body: JSON.stringify({status:'rejected', reject_reason:reason})
  });
  const idx = cachedData.orders.findIndex(o=>o.id===id);
  if(idx!==-1){ cachedData.orders[idx].status='rejected'; cachedData.orders[idx].reject_reason=reason; }
  renderOrders();
}

async function markOrderDone(id){ await updateOrderStatus(id,'done'); }

function startOrdersPolling(){
  if(_ordersPolling) return;
  _ordersPolling = setInterval(async()=>{
    if(!document.getElementById('panel-orders')?.classList.contains('active')) return;
    const res = await sb('orders',{},{order:'created_at.desc',limit:500});
    if(Array.isArray(res)){ cachedData.orders=res; renderOrders(); }
  }, 90000);
}

function loadOrders(){ renderOrders(); startOrdersPolling(); }

