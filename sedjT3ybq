// كاش كل الفروع في النظام (لكل خط) — يُستخدم للربط بدل التكرار
let _allBranchesCache = null;
async function euFillAllBranchesDatalist(){
  const dl = document.getElementById('eu-all-branches-datalist');
  if(!dl) return;
  try{
    if(!_allBranchesCache){
      const H={'apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`};
      const res = await fetch(`${SUPABASE_URL}/rest/v1/branches?select=id,branch_name,route,grp&order=branch_name.asc&limit=5000`,{headers:H});
      _allBranchesCache = res.ok ? await res.json() : [];
    }
    const seen = new Set();
    dl.innerHTML = _allBranchesCache
      .filter(b=>{ if(!b.branch_name||seen.has(b.branch_name)) return false; seen.add(b.branch_name); return true; })
      .map(b=>`<option value="${b.branch_name}">${b.branch_name} — ${b.route||'بدون خط'}</option>`).join('');
  }catch(e){}
}

