function splRenderBranchMap(){
  const search  = (document.getElementById('spl-map-search')?.value||'').toLowerCase();
  const fClient = document.getElementById('spl-map-client-filter')?.value||'all';
  const fGrp    = document.getElementById('spl-map-grp-filter')?.value||'all';
  const fRoute  = document.getElementById('spl-map-route-filter')?.value||'all';
  const tbody   = document.getElementById('spl-map-tbody');
  const count   = document.getElementById('spl-map-count');
  if(!tbody) return;

  let data = _splBranchMap;
  if(fClient!=='all') data = data.filter(m=>m.client_name===fClient);
  if(fGrp!=='all')    data = data.filter(m=>m.grp===fGrp);
  if(fRoute!=='all')  data = data.filter(m=>m.route===fRoute);
  if(search) data = data.filter(m=>(m.branch_name||'').toLowerCase().includes(search)||(m.client_name||'').toLowerCase().includes(search));
  if(count) count.textContent = `${data.length} فرع مربوط`;

  const today = new Date(); today.setHours(0,0,0,0);

  // جيب ألوان المجموعات
  const grpColors = {};
  if(typeof GROUPS !== 'undefined'){
    Object.entries(GROUPS).forEach(([k,v])=>{ grpColors[k]=v.color||'#888'; });
  }

  tbody.innerHTML = data.map((m,i)=>{
    // جيب بيانات الفرع من _splBranches
    const branchData = _splBranches.find(b=>b.branch_name===m.branch_name)||{};
    const grp   = m.grp   || branchData.grp   || '—';
    const route = m.route || branchData.route || '—';
    const grpColor = grpColors[grp]||'#888';

    const grpBadge = grp!=='—'
      ? `<span style="background:${grpColor}22;color:${grpColor};padding:2px 8px;border-radius:8px;font-size:10px;font-weight:700">${grp}</span>`
      : `<span style="color:#ccc;font-size:11px">—</span>`;

    const clientDiscs = _splCatDiscounts.filter(d=>d.client_name===m.client_name);
    const discSummary = clientDiscs.length
      ? clientDiscs.map(d=>`<span style="background:#D1FAE5;color:#065F46;padding:1px 6px;border-radius:8px;font-size:10px;margin-left:3px">${d.cat}: ${d.discount_pct}%</span>`).join('')
      : `<span style="color:#ccc;font-size:11px">—</span>`;

    const activePromos = (_splPromos||[]).filter(p=>{
      const from=new Date(p.date_from); const to=new Date(p.date_to);
      return p.client_name===m.client_name && p.active!==false && from<=today && to>=today;
    });
    const promosSummary = activePromos.length
      ? activePromos.map(p=>`<span style="background:#FFF3E0;color:#E65100;padding:1px 6px;border-radius:8px;font-size:10px;margin-left:3px">${p.snf_name}: ${p.promo_price}ج</span>`).join('')
      : `<span style="color:#ccc;font-size:11px">—</span>`;

    return `<tr style="border-bottom:0.5px solid var(--border);${i%2===1?'background:var(--surface-1)':''}">
      <td style="padding:8px;font-size:12px;color:var(--text2)">${i+1}</td>
      <td style="padding:8px;font-size:12px;font-weight:500">${m.branch_name}</td>
      <td style="padding:8px">${grpBadge}</td>
      <td style="padding:8px;font-size:11px;color:var(--text2)">${route}</td>
      <td style="padding:8px;font-weight:600;color:var(--navy);font-size:12px">${m.client_name}</td>
      <td style="padding:8px">${discSummary}</td>
      <td style="padding:8px">${promosSummary}</td>
      <td style="padding:8px;text-align:center">
        <button onclick="splDeleteBranchMap(${m.id},'${(m.branch_name).replace(/'/g,"\\'")}')"
          style="background:#FFEBEE;color:#B71C1C;border:1px solid #FFCDD2;border-radius:6px;padding:3px 8px;cursor:pointer;font-size:11px">🗑 إلغاء الربط</button>
      </td>
    </tr>`;
  }).join('') || `<tr><td colspan="8" style="text-align:center;padding:20px;color:#888">لا توجد فروع مربوطة</td></tr>`;
}

