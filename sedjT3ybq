// هل القيمة رقم حقيقي (مش نص وصفي زي "عبوة توفير" أو "1+2 - 1+3")
// بنشيل الفواصل الألفية (3,454,316) قبل الفحص عشان أرقام متكتوبة بفواصل متتعرفش كنص
function caIsNum(v){
  if(v===null||v===undefined) return false;
  const s = String(v).trim().replace(/,/g,'');
  if(s==='') return false;
  return /^-?\d+(\.\d+)?$/.test(s);
}
// نفس فكرة parseFloat بس بيشيل الفواصل الألفية الأول — استخدمها بدل parseFloat في كل
// كود تحليل العقود عشان "3,454,316" متترجمش غلط لـ 3 بس
function caNum(v){
  return parseFloat(String(v).replace(/,/g,''));
}
function caFmtVal(v, section){
  if(v===null||v===undefined||String(v).trim()==='') return '<span style="color:#ccc">—</span>';
  if(!caIsNum(v)) return String(v).replace(/</g,'&lt;');
  const n = caNum(v);
  if(section==='percentage'||section==='tier') return (n*100).toLocaleString('en-US',{maximumFractionDigits:2})+'%';
  return n.toLocaleString('en-US');
}
function caDiffHtml(v25, v26, section){
  const a = (v25===null||v25===undefined)?'':String(v25).trim();
  const b = (v26===null||v26===undefined)?'':String(v26).trim();
  if(!caIsNum(a) || !caIsNum(b)){
    if(a===b) return '<span style="color:#9CA3AF;font-size:11px">—</span>';
    if(!a && b) return '<span class="badge b-blue" style="font-size:10px">بند جديد</span>';
    if(a && !b) return '<span class="badge b-orange" style="font-size:10px">اتشال 2026</span>';
    return '<span class="badge b-orange" style="font-size:10px">تغيّر النص</span>';
  }
  const n25=caNum(a), n26=caNum(b);
  const diff = n26-n25;
  if(diff===0) return '<span style="color:#9CA3AF;font-size:11px">= بدون تغيير</span>';
  const isPerc = section==='percentage'||section==='tier';
  const diffDisp = isPerc ? (Math.abs(diff)*100).toLocaleString('en-US',{maximumFractionDigits:2})+' نقطة' : Math.abs(diff).toLocaleString('en-US');
  const color = diff>0 ? '#16A34A' : '#DC2626';
  const arrow = diff>0 ? '▲' : '▼';
  return `<span style="color:${color};font-weight:700;font-size:12px">${arrow} ${diffDisp}</span>`;
}

// نسبة الخصم الفعلية من المبيعات = (المحقق قبل الخصم - المحقق بعد الخصم) / المحقق قبل الخصم
function caDiscountPct(beforeV, afterV){
  if(!caIsNum(beforeV) || !caIsNum(afterV)) return null;
  const b = caNum(beforeV), a = caNum(afterV);
  if(b===0) return null;
  return (b-a)/b*100;
}

function caRenderAll(){
