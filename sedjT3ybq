async function editUser(){
  const oldName=document.getElementById('eu-id').value;
  const name=document.getElementById('eu-name').value.trim();
  const pass=document.getElementById('eu-pass').value.trim();
  let route=document.getElementById('eu-route').value.trim();
  const group=document.getElementById('eu-group').value;
  const type=document.getElementById('eu-type').value;
  const dayOff=document.getElementById('eu-dayoff')?document.getElementById('eu-dayoff').value:'none';
  const goal=parseInt(document.getElementById('eu-goal')?document.getElementById('eu-goal').value:1)||1;
  const status=document.getElementById('eu-status')?document.getElementById('eu-status').value:'active';
  const empCode=(document.getElementById('eu-empcode')?.value||'').trim();
  const isFixed=euIsFixedType();
  const fixedBranch=isFixed ? (document.getElementById('eu-fixed-branch')?.value||'').trim() : '';
  if(!name)return;
  // نفس الحل المطبّق في نموذج الإضافة — حقل خط السير مخفي للأنواع الثابتة
  if(isFixed && !route){
    const grpLabel = document.getElementById('eu-group')?.selectedOptions[0]?.text||group;
    route = await resolveFixedRouteLabel(group, type, grpLabel);
  }

  // التحديث يتم مباشرة في Supabase

  // 2. تحديث في Supabase لو الجدول موجود
  const updatePayload={name,pass_hash:pass,route,grp:group,user_type:type,goal,status,day_off:dayOff,emp_code:empCode||null,fixed_branch:fixedBranch||null};
  try{
    const r=REPS.find(x=>x.name===oldName);
    if(r&&r.id) await sbUpdate('users',{id:r.id},updatePayload);
    else         await sbUpdateByName('users',oldName,updatePayload);
  }catch(e){console.warn('Supabase update failed, saved locally');}

  // 3. تحديث في REPS المحلي
  const repIdx=REPS.findIndex(x=>x.name===oldName);
  if(repIdx!==-1) REPS[repIdx]={...REPS[repIdx],name,pass,route,group,type,goal,status,day_off:dayOff,emp_code:empCode,fixed_branch:fixedBranch};

  // إلغاء كاش "كل المنسقين" (نشط+غير نشط) عشان لو حد فعّل/عطّل منسق من هنا يبان فوراً
  // في فلتر "نشط"/"غير نشط" بتاب إدارة المنسقين من غير ما يحتاج يعمل reload للصفحة
  _allRepsCache = null;
  if(repIdx===-1) await loadAdminUsers(); // المنسق مكانش في REPS (كان غير نشط) — لو اتفعّل دلوقتي لازم يدخل REPS

  closeModal('modal-edit-user');
  loadUsers();
  showOk('nu-ok','✓ تم تعديل '+name+' بنجاح');
  saveRepsToDB(); // حفظ كل REPS في Supabase
}

async function saveRepsToDB(){
  try{
    const repsData = REPS.map(r=>({name:r.name,route:r.route,group:r.group,type:r.type,pass:r.pass,goal:r.goal||0}));
    const val = JSON.stringify(repsData);
    await sbUpsert('products_db',{key:'reps',value:val,updated_at:new Date().toISOString()},'key');
    console.log('✅ REPS saved to Supabase');
  }catch(e){console.warn('saveRepsToDB failed',e);}
}

