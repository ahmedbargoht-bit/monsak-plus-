// تنظيف سجلات الحضور المكررة
// ══════════════════════════════════════════════════════════════
async function cleanDuplicateAttendance(){
  const btn = event.currentTarget;
  btn.disabled = true;
  btn.innerHTML = '<i class="ti ti-loader"></i> جاري التحليل...';

  try{
    const all = [...(cachedData.attendance||[])];
    const map = {};
    all.forEach(r=>{
      const key = `${r.name}__${r.date}`;
      if(!map[key]) map[key] = [];
      map[key].push(r);
    });

    const toDelete = [];
    Object.values(map).forEach(recs=>{
      if(recs.length <= 1) return;
      recs.sort((a,b)=>{
        if(a.time_in && !b.time_in) return -1;
        if(!a.time_in && b.time_in) return 1;
        return (a.id||0)-(b.id||0);
      });
      recs.slice(1).forEach(r=> toDelete.push(r.id));
    });

    if(!toDelete.length){ showToast('✅ لا توجد سجلات مكررة'); return; }

    if(!confirm(`سيتم حذف ${toDelete.length} سجل مكرر. متأكد؟`)) return;

    const res = await fetch(`${SUPABASE_URL}/rest/v1/rpc/delete_attendance_ids`,{
      method:'POST',
      headers:{'Content-Type':'application/json','apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`},
      body: JSON.stringify({ids: toDelete})
    });
    const result = await res.json();

    if(res.ok && result?.success){
      showToast(`✅ تم حذف ${result.deleted} سجل مكرر`);
      await reloadData();
      loadAttendance();
    } else {
      showToast('⚠️ شغّل delete_attendance_ids.sql في Supabase أولاً');
    }
  }catch(e){
    showToast('خطأ: '+e.message);
  }finally{
    btn.disabled=false;
    btn.innerHTML='<i class="ti ti-eraser"></i> تنظيف المكرر';
  }
}

// حساب عدد الأيام بين تاريخين (شامل)
function attDaysBetween(from, to){
  if(!from||!to) return 0;
  const d1 = new Date(from), d2 = new Date(to);
  return Math.max(0, Math.floor((d2-d1)/86400000)+1);
}

// تحويل اسم اليوم (عربي أو إنجليزي) لرقم (0=أحد ... 6=سبت)
function attDayNameToNum(name){
  if(!name) return -1;
  const map = {
    الأحد:0, الاثنين:1, الثلاثاء:2, الأربعاء:3, الخميس:4, الجمعة:5, السبت:6,
    sunday:0, monday:1, tuesday:2, wednesday:3, thursday:4, friday:5, saturday:6
  };
  return map[name]??map[name.toLowerCase()]??-1;
}

// تحويل قيمة day_off لاسم عربي للعرض
function attDayOffLabel(name){
  if(!name||name==='none') return '—';
  const map = {
    friday:'الجمعة', saturday:'السبت', sunday:'الأحد',
    monday:'الاثنين', tuesday:'الثلاثاء', wednesday:'الأربعاء', thursday:'الخميس'
  };
  return map[name.toLowerCase()]||name;
}

// عدد مرات وقوع يوم معين في الفترة
function attCountDayOff(dayOffName, from, to){
  if(!dayOffName||dayOffName==='none'||!from||!to) return 0;
  const dow = attDayNameToNum(dayOffName);
  if(dow<0) return 0;
  let count=0;
  const cur=new Date(from), end=new Date(to);
  while(cur<=end){ if(cur.getDay()===dow) count++; cur.setDate(cur.getDate()+1); }
  return count;
}

// بناء قائمة كل أيام الفترة
function attAllDays(from, to){
  const days = [];
  if(!from||!to) return days;
  const cur = new Date(from);
  const end = new Date(to);
  while(cur <= end){
    days.push(cur.toISOString().slice(0,10));
    cur.setDate(cur.getDate()+1);
  }
  return days;
}

// تصنيفات الغياب اللي المشرف بيختارها من تطبيق المشرف بلص (نفس القيم المخزّنة في عمود
// reason_type بجدول attendance_edits) — نفس الألوان بالظبط زي mansek-supervisor.html.
const ATT_REASON_META = {
  inventory:     { label:'حاضر — جرد',            icon:'📦', bg:'#D1FAE5', clr:'#065F46' },
  unpaid_leave:  { label:'إجازة بالخصم',           icon:'🔴', bg:'#FEE2E2', clr:'#B91C1C' },
  leave_balance: { label:'إجازة من رصيد الإجازات', icon:'🔵', bg:'#DBEAFE', clr:'#1D4ED8' },
  sick_leave:    { label:'إجازة مرضية',            icon:'🟡', bg:'#FEF3C7', clr:'#92400E' },
  other:         { label:'أخرى',                   icon:'⚪', bg:'#F3F4F6', clr:'#4B5563' },
};

// عشان نعرض ملاحظة داخل خاصية title بأمان (زي تعليق الخلية في الإكسل) من غير ما تكسر الـ HTML
function attEscapeAttr(s){
  return String(s||'').replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}

async function loadAttendance(){
  const from = document.getElementById('att-from')?.value||'';
  const to   = document.getElementById('att-to')?.value||'';
  const grp  = document.getElementById('att-group').value;

  let data = cachedData.attendance||[];

  // فلتر التاريخ
  if(from) data = data.filter(a=>(a.date||'')>=from);
  if(to)   data = data.filter(a=>(a.date||'')<=to);

  // فلتر المجموعة
  if(grp!=='all') data = data.filter(a=>a.grp===grp);

  // ── خطوة 1: دمج السجلات — منسق + يوم = سجل واحد ──
  const dayMap = {};
  data.forEach(a=>{
    const key = (a.name||'')+'||'+(a.date||'');
    if(!dayMap[key]) dayMap[key]={
      name:a.name, route:a.route||'—', grp:a.grp||'—', date:a.date,
      timeIn:null, timeOut:null
    };
    const r=dayMap[key];
    if(a.time_in  &&(!r.timeIn ||a.time_in <r.timeIn))  r.timeIn =a.time_in;
    if(a.time_out &&(!r.timeOut||a.time_out>r.timeOut)) r.timeOut=a.time_out;
  });

  // ── خطوة 1.5: تطبيق تعديلات الحضور اليدوية (attendance_edits) على dayMap قبل حساب أي إحصائيات ──
  // كده أي تعديل (حاضر/غائب/وقت) بيتحسب صح في كل مكان: الإحصائيات، تفاصيل الأيام، والتصدير.
  const editsByDay = {};
  try{
    const H = {'apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`};
    let eUrl = `${SUPABASE_URL}/rest/v1/attendance_edits?select=*&limit=5000`;
    if(from) eUrl += `&date=gte.${from}`;
    if(to)   eUrl += `&date=lte.${to}`;
    const eRes = await fetch(eUrl,{headers:H});
    const edits = eRes.ok ? await eRes.json().catch(()=>[]) : [];
    (Array.isArray(edits)?edits:[]).forEach(ed=>{
      if(!ed.name || !ed.date) return;
      const key = ed.name+'||'+ed.date;
      editsByDay[key] = ed;
      // لو فيه فلتر مجموعة مفعّل، منطبقش تغيير الحالة إلا لو الشخص فعلاً في نفس المجموعة
      // (عشان مانخبطش إحصائيات مجموعة تانية) — الملاحظة بس بتفضل متاحة في كل الأحوال.
      if(grp!=='all'){
        const repObj = (typeof REPS!=='undefined'?REPS:[]).find(r=>(r.name||r.staff_name)===ed.name);
        const repGrp = repObj?.grp||repObj?.group||'';
        if(repGrp !== grp) return;
      }
      if(ed.status==='present'){
        if(!dayMap[key]){
          const repObj = (typeof REPS!=='undefined'?REPS:[]).find(r=>(r.name||r.staff_name)===ed.name);
          dayMap[key] = { name:ed.name, route:repObj?.route||'—', grp:repObj?.grp||repObj?.group||'—', date:ed.date, timeIn:null, timeOut:null };
        }
        if(ed.time_in)  dayMap[key].timeIn  = ed.time_in;
        if(ed.time_out) dayMap[key].timeOut = ed.time_out;
        dayMap[key].manualEdit = true;
      } else if(ed.status==='absent'){
        delete dayMap[key];
      }
    });
  }catch(e){ /* لو الجلب فشل، تفضل التعديلات صفر بدل ما توقف باقي الجدول */ }

  // ── خطوة 2: تجميع لكل منسق ──
  const coordMap = {};
  Object.values(dayMap).forEach(r=>{
    const n = r.name||'';
    if(!coordMap[n]) coordMap[n]={
      name:n, route:r.route, grp:r.grp,
      presentSet: new Set(), totalHrs:0
    };
    const c = coordMap[n];
    c.presentSet.add(r.date);
    if(r.timeIn&&r.timeOut){
      const [h1,m1]=r.timeIn.split(':').map(Number);
      const [h2,m2]=r.timeOut.split(':').map(Number);
      const diff=((h2*60+m2)-(h1*60+m1))/60;
      if(diff>0&&diff<24) c.totalHrs+=diff;
    }
  });

  // ── خطوة 2.5: جلسات الدعم الميداني — من جدول field_support_logs (لكل منسق: عدد الجلسات + عدد الفروع المختلفة) ──
  // وكمان بنبني خريطة يوم-بيوم (منسق+تاريخ) عشان تفاصيل "عرض الأيام" تقدر تعرض جلسات الدعم والمأموريات لكل يوم.
  const supportByRep = {};
  const supportByDay = {};   // key: name||date -> [{branch_name, support_type, status, supervisor_name}]
  const assignByDay  = {};   // key: name||date -> [{branch_name, status, note, supervisor_name}]
  try{
    const H = {'apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`};
    let sUrl = `${SUPABASE_URL}/rest/v1/field_support_logs?select=rep_name,branch_name,visit_date,support_type,status,supervisor_name&limit=5000`;
    if(from) sUrl += `&visit_date=gte.${from}`;
    if(to)   sUrl += `&visit_date=lte.${to}`;
    const sRes = await fetch(sUrl,{headers:H});
    const sLogs = sRes.ok ? await sRes.json().catch(()=>[]) : [];
    (Array.isArray(sLogs)?sLogs:[]).forEach(s=>{
      const n = s.rep_name; if(!n) return;
      if(!supportByRep[n]) supportByRep[n] = {sessions:0, branches:new Set()};
      supportByRep[n].sessions++;
      if(s.branch_name) supportByRep[n].branches.add(s.branch_name);
      const dKey = n+'||'+(s.visit_date||'');
      if(!supportByDay[dKey]) supportByDay[dKey]=[];
      supportByDay[dKey].push(s);
    });

    let aUrl = `${SUPABASE_URL}/rest/v1/assignments?select=rep_name,branch_name,visit_date,directed_date,status,note,supervisor_name&limit=5000`;
    if(from) aUrl += `&visit_date=gte.${from}`;
    if(to)   aUrl += `&visit_date=lte.${to}`;
    const aRes = await fetch(aUrl,{headers:H});
    const aLogs = aRes.ok ? await aRes.json().catch(()=>[]) : [];
    (Array.isArray(aLogs)?aLogs:[]).forEach(a=>{
      const n = a.rep_name; if(!n) return;
      const d = a.visit_date||a.directed_date||'';
      const dKey = n+'||'+d;
      if(!assignByDay[dKey]) assignByDay[dKey]=[];
      assignByDay[dKey].push(a);
    });
  }catch(e){ /* لو الجلب فشل، تفضل الأعمدة صفر بدل ما توقف باقي الجدول */ }

  // ── خطوة 3: حساب الغياب مع الراحة الأسبوعية ──
  const totalDays = attDaysBetween(from,to);
  const summaryRows = Object.values(coordMap).map(c=>{
    // جيب day_off من REPS
    const repObj = (typeof REPS!=='undefined'?REPS:[]).find(r=>(r.name||r.staff_name)===c.name);
    const dayOff = repObj?.day_off||'none';
    const empCode = repObj?.emp_code||'';
    const dayOffCount = attCountDayOff(dayOff, from, to);
    const workDays = Math.max(0, totalDays - dayOffCount);
    const present  = c.presentSet.size;
    const absent   = Math.max(0, workDays - present);
    const pct      = workDays ? Math.round(present/workDays*100) : 0;
    const sup = supportByRep[c.name];
    const supportSessions = sup?.sessions||0;
    const supportBranches = sup?.branches?.size||0;
    const notesText = Object.values(editsByDay)
      .filter(e=>e.name===c.name && (e.note || e.reason_type))
      .sort((a,b)=>(a.date||'').localeCompare(b.date||''))
      .map(e=>{
        const rl = ATT_REASON_META[e.reason_type]?.label;
        const parts = [rl, e.note].filter(Boolean).join(' — ');
        return `${e.date}: ${parts}`;
      }).join(' | ');
    return { name:c.name, route:c.route, empCode, present, absent, totalDays, workDays, dayOff, dayOffCount, hrs:c.totalHrs, pct, supportSessions, supportBranches, notes:notesText };
  }).sort((a,b)=>b.present-a.present||a.name.localeCompare(b.name));

  // ── إحصائيات ──
  const totalPresent = summaryRows.reduce((s,r)=>s+r.present,0);
  const totalAbsent  = summaryRows.reduce((s,r)=>s+r.absent,0);
  const totalHrsAll  = summaryRows.reduce((s,r)=>s+r.hrs,0);

  document.getElementById('att-stats').innerHTML=`
    <div class="stat-card green"><div class="stat-n">${summaryRows.length}</div><div class="stat-l">عدد المنسقين</div></div>
    <div class="stat-card blue"><div class="stat-n">${totalDays}</div><div class="stat-l">أيام الفترة</div></div>
    <div class="stat-card green"><div class="stat-n">${totalPresent}</div><div class="stat-l">إجمالي أيام الحضور</div></div>
    <div class="stat-card red"><div class="stat-n">${totalAbsent}</div><div class="stat-l">إجمالي أيام الغياب</div></div>
    <div class="stat-card orange"><div class="stat-n">${totalHrsAll.toFixed(0)}</div><div class="stat-l">إجمالي الساعات</div></div>
    <button class="btn btn-sm" style="background:#FFEBEE;color:#B71C1C" onclick="clearAllRecords('attendance','attendance','الحضور')"><i class="ti ti-trash"></i> مسح الكل</button>
  `;

  // ── رأس الجدول ──
  const thead = document.querySelector('#att-main-table thead tr');
  if(thead) thead.innerHTML=`
    <th>الكود</th>
    <th>المنسق</th>
    <th>خط السير</th>
    <th style="color:#F59E0B">يوم الراحة</th>
    <th style="color:#065F46">أيام الحضور</th>
    <th style="color:#DC2626">أيام الغياب</th>
    <th style="color:#F59E0B">أيام الراحة<br>في الفترة</th>
    <th>أيام العمل<br>الفعلية</th>
    <th>ساعات العمل</th>
    <th style="color:#7C3AED">جلسات دعم</th>
    <th style="color:#7C3AED">فروع</th>
    <th>نسبة الحضور</th>
    <th>تفاصيل</th>
  `;

  // ── جسم الجدول ──
  document.getElementById('att-table').innerHTML = summaryRows.map(r=>`
    <tr style="cursor:pointer" onclick="attShowDetail('${r.name.replace(/'/g,"\\'")}','${from}','${to}')">
      <td style="text-align:center;font-size:11px;color:#6B7280;font-family:monospace">${r.empCode||'—'}</td>
      <td><b>${r.name}</b>${r.notes?` <span title="${attEscapeAttr(r.notes)}" style="cursor:help;display:inline-block;background:#FEF3C7;color:#92400E;border-radius:3px;padding:0 4px;font-size:10px;font-weight:700;vertical-align:middle">📝</span>`:''}</td>
      <td style="font-size:11px">${r.route}</td>
      <td style="text-align:center">${r.dayOff&&r.dayOff!=='none'?`<span style="background:#FEF3C7;color:#92400E;padding:2px 8px;border-radius:20px;font-size:11px">${attDayOffLabel(r.dayOff)}</span>`:`<span style="color:#9CA3AF;font-size:11px">—</span>`}</td>
      <td style="color:#065F46;font-weight:700;font-size:15px">${r.present}</td>
      <td style="color:#DC2626;font-weight:700;font-size:15px">${r.absent}</td>
      <td style="color:#D97706;font-weight:700;text-align:center">${r.dayOffCount}</td>
      <td style="color:#6B7280;text-align:center">${r.workDays}</td>
      <td>${r.hrs.toFixed(1)} ساعة</td>
      <td style="text-align:center">
        ${r.supportSessions>0
          ? `<span style="background:#EDE9FE;color:#7C3AED;padding:2px 10px;border-radius:20px;font-weight:700;font-size:13px">${r.supportSessions}</span>`
          : `<span style="color:#9CA3AF;font-size:11px">—</span>`}
      </td>
      <td style="text-align:center">
        ${r.supportBranches>0
          ? `<span style="background:#EDE9FE;color:#7C3AED;padding:2px 10px;border-radius:20px;font-size:12px">${r.supportBranches}</span>`
          : `<span style="color:#9CA3AF;font-size:11px">—</span>`}
      </td>
      <td>
        <div style="display:flex;align-items:center;gap:6px">
          <div style="background:#E5E7EB;border-radius:4px;height:8px;width:60px">
            <div style="background:${r.pct>=80?'#065F46':r.pct>=50?'#D97706':'#DC2626'};border-radius:4px;height:8px;width:${Math.min(r.pct,100)}%"></div>
          </div>
          <span style="font-size:11px">${r.pct}%</span>
        </div>
      </td>
      <td><span style="font-size:10px;color:var(--blue);text-decoration:underline">عرض الأيام</span></td>
    </tr>`
  ).join('')||'<tr><td colspan="13" style="text-align:center;padding:1.5rem;color:var(--text2)">لا توجد بيانات — اختر فترة زمنية ومجموعة</td></tr>';

  window._attRows = summaryRows;
  window._attDayMap = dayMap;
  window._attSupportByDay = supportByDay;
  window._attAssignByDay  = assignByDay;
  window._attEditsByDay   = editsByDay;
}

// عرض تفاصيل أيام منسق معين
function attShowDetail(name, from, to){
  const allDays = attAllDays(from, to);
  const present = new Set(
    Object.values(window._attDayMap||{})
      .filter(r=>r.name===name)
      .map(r=>r.date)
  );
  // جيب يوم الراحة للمنسق
  const repObj = (typeof REPS!=='undefined'?REPS:[]).find(r=>(r.name||r.staff_name)===name);
  const dayOff = repObj?.day_off||'none';
  const dowOff = attDayNameToNum(dayOff);

  const supportMap = window._attSupportByDay||{};
  const assignMap  = window._attAssignByDay||{};
  const editsMap   = window._attEditsByDay||{};
  const supTypeLbl = t => t==='training'?'تدريب':t==='coaching'?'مرافقة':t==='review'?'مراجعة':(t||'دعم ميداني');
  const asgStatusLbl = s => s==='confirmed'?'مؤكدة':s==='pending'?'منتظرة':s==='done'?'منفذة':(s||'—');

  const lines = allDays.map(d=>{
    const rec = Object.values(window._attDayMap||{}).find(r=>r.name===name&&r.date===d);
    const isPresent = present.has(d);
    const isOff = dowOff>=0 && new Date(d).getDay()===dowOff;
    const dKey = name+'||'+d;
    const edit = editsMap[dKey];
    const manualTag = ' <span style="font-size:9px;color:#7C3AED;font-weight:700">(يدوي)</span>';
    const reasonMeta = edit?.reason_type ? ATT_REASON_META[edit.reason_type] : null;
    const reasonChip = reasonMeta
      ? ` <span style="font-size:9px;background:${reasonMeta.bg};color:${reasonMeta.clr};padding:1px 7px;border-radius:10px;font-weight:700">${reasonMeta.icon} ${reasonMeta.label}</span>`
      : '';
    let status;
    if(isPresent)      status=`<span style="color:#065F46;font-weight:700">✅ حاضر</span>${reasonChip||(rec?.manualEdit?manualTag:'')}`;
    else if(isOff)     status=`<span style="color:#D97706;font-weight:700">🏖️ راحة (${attDayOffLabel(dayOff)})</span>`;
    else               status=`<span style="color:#DC2626;font-weight:700">❌ غائب</span>${reasonChip||(edit&&edit.status==='absent'?manualTag:'')}`;

    const supList = supportMap[dKey]||[];
    const asgList = assignMap[dKey]||[];
    const sessionBadges = [
      ...supList.map(s=>`<span style="display:inline-block;background:#EDE9FE;color:#7C3AED;padding:1px 8px;border-radius:20px;font-size:10px;margin:1px">🛠️ ${supTypeLbl(s.support_type)} — ${s.branch_name||'—'}</span>`),
      ...asgList.map(a=>`<span style="display:inline-block;background:#E0F2FE;color:#0369A1;padding:1px 8px;border-radius:20px;font-size:10px;margin:1px">📌 مأمورية (${asgStatusLbl(a.status)}) — ${a.branch_name||'—'}</span>`),
    ].join('') || '<span style="color:#9CA3AF;font-size:10px">—</span>';

    const noteHtml = edit?.note ? `<div style="font-size:10px;color:#6B7280;margin-top:3px">📝 ${edit.note}</div>` : '';

    return `<tr style="background:${isOff&&!isPresent?'#FFFBEB':'inherit'}">
      <td style="padding:6px 10px">${d}</td>
      <td style="padding:6px 10px">${status}${noteHtml}</td>
      <td style="padding:6px 10px">${rec?.timeIn||'—'}</td>
      <td style="padding:6px 10px">${rec?.timeOut||'—'}</td>
      <td style="padding:6px 10px">${sessionBadges}</td>
      <td style="padding:6px 10px;text-align:center">
        <button onclick="attOpenEditRow('${name.replace(/'/g,"\\'")}','${d}')"
          style="background:none;border:1px solid var(--border);border-radius:6px;padding:3px 9px;cursor:pointer;font-size:11px;white-space:nowrap">✏️ تعديل</button>
      </td>
    </tr>`;
  }).join('');

  const modal = document.createElement('div');
  modal.id = 'att-detail-modal';
  modal.style.cssText='position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:9999;display:flex;align-items:center;justify-content:center';
  modal.innerHTML=`
    <div style="background:var(--card-bg,#fff);border-radius:16px;padding:24px;max-width:760px;width:92%;max-height:80vh;overflow-y:auto;direction:rtl;font-family:Cairo,sans-serif">
