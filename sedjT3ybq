function caBuildClientSheetAOA(clientName, items){
  const aoa = [];
  aoa.push([null, clientName]);
  aoa.push([null, 'عقد 2025', null, null, null, 'عقد 2026']);
  const summary = items.filter(it=>it.section==='summary');
  const before = summary.find(it=>(it.item_name||'').includes('بدون'));
  const after = summary.find(it=>(it.item_name||'').includes('بعد'));
  aoa.push([null, 'محقق  2025بدون الخصم ', null, before?before.value_2025:null]);
  aoa.push([null, 'محقق  2025بعد الخصم ', null, after?after.value_2025:null]);

  const pushSection = (sec) => {
    aoa.push([null,'البيان','نسبة الخصم / القيمة','ملاحظات',null,'البيان','نسبة الخصم / القيمة','ملاحظات']);
    items.filter(it=>it.section===sec).forEach(it=>{
      aoa.push([null, it.item_name, it.value_2025, it.extra_2025, null, it.item_name, it.value_2026, it.extra_2026]);
    });
  };
  pushSection('fixed');
  pushSection('percentage');
  pushSection('tier');
  const credit = items.find(it=>it.section==='credit');
  aoa.push([null, credit?credit.extra_2025:'', null, null, null, credit?credit.extra_2026:'']);
  return aoa;
}

