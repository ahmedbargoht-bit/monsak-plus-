function compToggleAll(cb){
  document.querySelectorAll('.comp-row-cb').forEach(c=>c.checked=cb.checked);
  compUpdateDeleteBtn();
}

function compUpdateDeleteBtn(){
  const checked = document.querySelectorAll('.comp-row-cb:checked');
  const btn = document.getElementById('comp-del-btn');
  const cnt = document.getElementById('comp-del-count');
  if(checked.length > 0){
    btn.style.display = 'inline-flex';
    cnt.textContent = checked.length;
  } else {
    btn.style.display = 'none';
    cnt.textContent = '0';
  }
  // تحديث حالة الـ check-all
  const all = document.querySelectorAll('.comp-row-cb');
  const chkAll = document.getElementById('comp-check-all');
  if(chkAll) chkAll.indeterminate = checked.length > 0 && checked.length < all.length;
  if(chkAll && checked.length === all.length && all.length > 0) chkAll.checked = true;
  if(chkAll && checked.length === 0) chkAll.checked = false;
}

async function compDeleteSelected(){
  const checked = [...document.querySelectorAll('.comp-row-cb:checked')];
  if(!checked.length){ showToast('لم تختر أي سجل'); return; }
  if(!confirm(`هل تريد حذف ${checked.length} سجل؟ لا يمكن التراجع.`)) return;

  const H = {'apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`};
  const ids = checked.map(c=>c.dataset.id);

  // حذف دفعة واحدة بـ in filter
  const idsParam = `(${ids.join(',')})`;
  const res = await fetch(`${SUPABASE_URL}/rest/v1/competitor_logs?id=in.${idsParam}`,{method:'DELETE',headers:H});

  if(res.ok){
    showToast(`✓ تم حذف ${ids.length} سجل`);
    // إزالة الصفوف من الـ UI فوراً
    ids.forEach(id=>{ const row=document.getElementById(`comp-row-${id}`); if(row) row.remove(); });
    // تحديث الإحصائيات
    _compData = _compData.filter(r=>!ids.includes(String(r.id)));
    document.getElementById('comp-stat-total').textContent = _compData.length;
    document.getElementById('comp-del-btn').style.display = 'none';
    document.getElementById('comp-del-count').textContent = '0';
    const chkAll = document.getElementById('comp-check-all');
    if(chkAll) chkAll.checked = false;
  } else {
    showToast('حدث خطأ أثناء الحذف');
  }
}

