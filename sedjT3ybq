function filterProdDB(fea, el){
  _pdbFeaFilter = fea;
  document.querySelectorAll('.tab-pill').forEach(t=>t.classList.remove('on'));
  if(el) el.classList.add('on');
  renderProdDB();
}

function renderProdDB(){
  const tbody  = document.getElementById('pdb-tbody');
  if(!tbody) return;
  const catF   = document.getElementById('pdb-cat')?.value||'all';
  const search = (document.getElementById('pdb-search')?.value||'').toLowerCase();
  const rows=[];
  let idx=1;
  Object.entries(PDB||{}).forEach(([fea,cats])=>{
    if(_pdbFeaFilter!=='all' && fea!==_pdbFeaFilter) return;
    Object.entries(cats||{}).forEach(([cat,grps])=>{
      if(catF!=='all' && cat!==catF) return;
      Object.entries(grps||{}).forEach(([grp,prods])=>{
        (prods||[]).forEach((item,itemIdx)=>{
          const isObj = typeof item === 'object' && item !== null;
          const snf   = isObj ? (item.name||JSON.stringify(item)) : String(item);
          const shelf = isObj ? (item.monthsShelf||null) : null;
          const stock = isObj ? (item.monthsStock||null) : null;
          if(search && !snf.toLowerCase().includes(search) && !cat.toLowerCase().includes(search)) return;
          rows.push({idx:idx++,snf,shelf,stock,fea,cat,grp,itemIdx,isObj});
        });
      });
    });
  });
  const countEl = document.getElementById('pdb-count');
  if(countEl) countEl.textContent = `${rows.length} صنف`;
  if(!rows.length){
    tbody.innerHTML=`<tr><td colspan="12" style="text-align:center;padding:2rem;color:#aaa">${Object.keys(PDB||{}).length?'لا توجد نتائج':'لم يتم رفع قاعدة الأصناف بعد — استخدم زرار رفع شيت Excel'}</td></tr>`;
    return;
  }
  tbody.innerHTML=rows.map(r=>{
    const shelfParts=[];
    if(r.shelf!==null) shelfParts.push(`<span title="صلاحية رف" style="background:#E8F5E9;color:#2E7D32;padding:2px 6px;border-radius:4px;font-size:10px;font-weight:700">رف ${r.shelf}ش</span>`);
    if(r.stock!==null) shelfParts.push(`<span title="صلاحية مخزن" style="background:#FFF3E0;color:#E65100;padding:2px 6px;border-radius:4px;font-size:10px;font-weight:700">مخزن ${r.stock}ش</span>`);
    const shelfHtml=shelfParts.length?shelfParts.join(' '):'<span style="color:#bbb;font-size:11px">—</span>';
    const itemKey=encodeURIComponent(JSON.stringify({fea:r.fea,cat:r.cat,grp:r.grp,idx:r.itemIdx,snf:r.snf}));
    // بيانات السعر — من _splPrices (متزامنة مع قسم التسعير في نفس التاب)
    const pr = (typeof _splPrices!=='undefined' ? _splPrices : []).find(x=>x.snf_name===r.snf);
    const price = pr?.price||0;
    const taxPct = pr?.tax_pct||0;
    const priceWithTax = taxPct>0 ? (price*(1+taxPct/100)).toFixed(2) : price.toFixed(2);
    const taxBadge = taxPct>0
      ? `<span style="background:#FFF3E0;color:#E65100;padding:2px 6px;border-radius:8px;font-size:10px">${taxPct}%</span>`
      : `<span style="color:#ccc;font-size:11px">—</span>`;
    const priceBadge = price>0
      ? `<span style="background:#D1FAE5;color:#065F46;padding:2px 6px;border-radius:8px;font-size:10px;font-weight:700">محدد</span>`
      : `<span style="background:#FEE2E2;color:#B91C1C;padding:2px 6px;border-radius:8px;font-size:10px;font-weight:700">لم يحدد</span>`;
    const safeName = r.snf.replace(/'/g,"\\'");
    return `<tr style="${price===0?'background:#FFFBF0':''}">
    <td style="text-align:center">
      <input type="checkbox" class="pdb-chk" data-key="${itemKey}"
        style="width:15px;height:15px;cursor:pointer;accent-color:var(--caramel)"
        onchange="pdbOnCheck()"/>
    </td>
    <td style="color:var(--text2)">${r.idx}</td>
    <td style="font-weight:600">${r.snf}</td>
    <td>${shelfHtml}</td>
    <td><span class="badge b-blue">${r.fea}</span></td>
    <td style="font-size:11px">${r.cat}</td>
    <td style="font-size:11px;color:var(--text2)">${r.grp||'—'}</td>
    <td style="text-align:center;font-weight:700;color:var(--navy)">${price>0?price.toFixed(2)+' ج':'—'}</td>
    <td style="text-align:center">${taxBadge}</td>
    <td style="text-align:center;font-weight:700;color:#1A7A4A">${price>0?priceWithTax+' ج':'—'}</td>
    <td style="text-align:center">${priceBadge}</td>
    <td style="display:flex;gap:4px">
      <button class="btn btn-xs" style="background:#E3F2FD;color:#1565C0" title="تعديل الصنف"
        onclick="editProdFromPDB(decodeURIComponent('${itemKey}'))">
        <i class="ti ti-pencil"></i>
      </button>
      <button class="btn btn-xs" style="background:#EEF6FF;color:#1D4ED8" title="تعديل السعر"
        onclick="splEditPrice('${safeName}',${price},${taxPct},'${(r.cat||'').replace(/'/g,"\\'")}')">
        <i class="ti ti-currency-dollar"></i>
      </button>
      <button class="btn btn-xs" style="background:#FFEBEE;color:#B71C1C" title="حذف الصنف"
        onclick="confirmDeleteProd(decodeURIComponent('${itemKey}'))">
        <i class="ti ti-trash"></i>
      </button>
    </td>
  </tr>`;
  }).join('');
  // reset الـ select-all checkbox
  const chkAll=document.getElementById('pdb-chk-all');
  if(chkAll) chkAll.checked=false;
  pdbOnCheck();
}

// ══ Bulk Selection ══════════════════════════════════════════════
function pdbOnCheck(){
  const all=document.querySelectorAll('.pdb-chk');
  const checked=document.querySelectorAll('.pdb-chk:checked');
  const bar=document.getElementById('pdb-bulk-bar');
  const countEl=document.getElementById('pdb-bulk-count');
  const chkAll=document.getElementById('pdb-chk-all');
  if(bar) bar.style.display=checked.length?'flex':'none';
  if(countEl) countEl.textContent=checked.length+' صنف محدد';
  if(chkAll) chkAll.indeterminate=(checked.length>0&&checked.length<all.length);
  if(chkAll&&checked.length===all.length&&all.length>0) chkAll.checked=true;
  if(chkAll&&checked.length===0) chkAll.checked=false;
}

function pdbToggleAll(val){
  document.querySelectorAll('.pdb-chk').forEach(c=>c.checked=val);
  pdbOnCheck();
}

function pdbClearSelection(){
  document.querySelectorAll('.pdb-chk').forEach(c=>c.checked=false);
  const chkAll=document.getElementById('pdb-chk-all');
  if(chkAll){chkAll.checked=false;chkAll.indeterminate=false;}
  pdbOnCheck();
}

// مخزن مؤقت للـ keys المحددة في التعديل الجماعي
let _pdbBulkKeys = [];

function pdbBulkEditShelf(){
  const checked=[...document.querySelectorAll('.pdb-chk:checked')];
  if(!checked.length) return;
  _pdbBulkKeys=checked.map(c=>JSON.parse(decodeURIComponent(c.dataset.key)));

  // جمع قيم الصلاحية الحالية للعرض
  const firstK=_pdbBulkKeys[0];
  const firstItem=PDB[firstK.fea]?.[firstK.cat]?.[firstK.grp]?.[firstK.idx];
