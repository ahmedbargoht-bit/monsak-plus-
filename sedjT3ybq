// EXPIRY ALERTS — تنبيهات الصلاحية في لوحة الإدارة
// ══════════════════════════════════════════════════════════════

async function adminLoadExpiry(){
  const tbody = document.getElementById('admin-exp-tbody');
  const stats  = document.getElementById('admin-exp-stats');
  const filter = document.getElementById('admin-exp-filter')?.value||'all';
  const grp    = document.getElementById('admin-exp-grp')?.value||'all';
  if(!tbody) return;
  tbody.innerHTML='<tr><td colspan="10" style="text-align:center;padding:1rem">جاري التحميل...</td></tr>';

  try{
    let url = `${SUPABASE_URL}/rest/v1/products?select=*&order=created_at.desc&limit=3000`;
    if(grp!=='all') url += `&grp=eq.${grp}`;
    const res = await fetch(url,{headers:{'apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`}});
    let data = await res.json();
    if(!Array.isArray(data)) data=[];

    // أحدث تسجيل لكل صنف لكل منسق
    const latest={};
    data.forEach(p=>{ const k=`${p.name}__${p.snf}`; if(!latest[k]) latest[k]=p; });

    const alerts=[];
    Object.values(latest).forEach(p=>{
      const sh = calcExpMonths(p.date_shelf, p.months_shelf);
      const st = calcExpMonths(p.date_stock, p.months_stock);
      const worst = Math.min(sh??99, st??99);
      if(worst>3) return;
      alerts.push({...p, shDiff:sh, stDiff:st, worst});
    });

    // فلتر
    let filtered=[...alerts];
    if(filter==='expired')  filtered=filtered.filter(a=>a.worst<0);
    if(filter==='critical') filtered=filtered.filter(a=>a.worst>=0&&a.worst<=2);
    if(filter==='warning')  filtered=filtered.filter(a=>a.worst===3);
    filtered.sort((a,b)=>a.worst-b.worst);

    // إحصائيات
    const expired  = alerts.filter(a=>a.worst<0).length;
    const critical = alerts.filter(a=>a.worst>=0&&a.worst<=2).length;
    const warning  = alerts.filter(a=>a.worst===3).length;

    // badge في السايدبار
    const badge = document.getElementById('nav-expiry-badge');
    const total = expired+critical;
    if(badge){ badge.textContent=total; badge.style.display=total?'':'none'; }

    if(stats) stats.innerHTML=`
      <div class="stat-card red"><div class="stat-n">${expired}</div><div class="stat-l">🔴 منتهية</div></div>
      <div class="stat-card orange"><div class="stat-n">${critical}</div><div class="stat-l">🟠 حرجة</div></div>
      <div class="stat-card yellow"><div class="stat-n">${warning}</div><div class="stat-l">🟡 تحذير</div></div>
      <div class="stat-card blue"><div class="stat-n">${alerts.length}</div><div class="stat-l">إجمالي التنبيهات</div></div>`;

    if(!filtered.length){
      tbody.innerHTML='<tr><td colspan="10" style="text-align:center;padding:1rem;color:var(--text2)">✅ لا توجد تنبيهات</td></tr>';
      return;
    }

    const expBadge = diff => diff==null ? '—' :
      diff<0  ? `<span class="badge b-red">منتهية</span>` :
      diff<=2 ? `<span class="badge b-orange">بعد ${diff} شهر</span>` :
                `<span class="badge b-yellow">بعد ${diff} شهر</span>`;

    const getExpDate = (dateStr, months) => {
      if(!dateStr||!months) return '—';
      const m = typeof months === 'object' ? (months?.months || months?.value || 0) : months;
      const d = new Date(String(dateStr).slice(0,7)+'-01');
      if(isNaN(d)) return '—';
      d.setMonth(d.getMonth()+(+m||0));
      return d.toLocaleDateString('en-US',{month:'short',year:'numeric'});
    };

    tbody.innerHTML=filtered.map((p,i)=>`<tr style="background:${p.worst<0?'#FFF5F5':p.worst<=2?'#FFF8F0':''}">
      <td>${i+1}</td>
      <td><b>${p.name||'—'}</b></td>
      <td style="font-size:11px">${p.branch||'—'}</td>
      <td><span class="badge" style="background:${GROUPS[p.grp]?.color||'#ccc'}22;color:${GROUPS[p.grp]?.color||'#555'}">${GROUPS[p.grp]?.label||p.grp||'—'}</span></td>
      <td style="font-size:11px;max-width:160px">${p.snf||'—'}</td>
      <td>${expBadge(p.shDiff)}</td>
      <td style="font-size:11px">${getExpDate(p.date_shelf,p.months_shelf)}</td>
      <td>${expBadge(p.stDiff)}</td>
