function rdGetDateFilter(){
  const v=document.getElementById('rd-filter-date')?.value||'7';
  const today=localISO();
  let from='', to=today;
  const fromEl=document.getElementById('rd-date-from');
  const toEl=document.getElementById('rd-date-to');
  const toLbl=document.getElementById('rd-to-lbl');
  if(fromEl) fromEl.style.display='none';
  if(toEl) toEl.style.display='none';
  if(toLbl) toLbl.style.display='none';

  if(v==='today'){ from=today; }
  else if(v==='yesterday'){ from=to=localISO(new Date(Date.now()-864e5)); }
  else if(v==='month'){ from=today.slice(0,8)+'01'; }
  else if(!isNaN(+v)){ from=localISO(new Date(Date.now()-(+v)*864e5)); }
  else if(v==='custom'){
    if(fromEl){fromEl.style.display='';} if(toLbl){toLbl.style.display='';} if(toEl){toEl.style.display='';}
    from=fromEl?.value||localISO(new Date(Date.now()-7*864e5));
    to=toEl?.value||today;
  }
  return {from, to};
}

async function rdLoad(){
  const name=window._rdRepName; if(!name) return;
  const {from,to}=rdGetDateFilter();
  const H={'apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`};
  const enc=encodeURIComponent(name);
  const dfCA=`&created_at=gte.${from}T00:00:00&created_at=lte.${to}T23:59:59`;

  // visits: من cachedData (date حقل عربي، نفلتر بـ created_at)
  const visits = (cachedData.visits||[]).filter(v=>{
    if(v.name!==name) return false;
    const iso=(v.created_at||'').slice(0,10);
    return iso>=from && iso<=to;
  });

  const [products,missing,supplyOrders,assignments,supportLogs,attend]=await Promise.all([
    fetch(`${SUPABASE_URL}/rest/v1/products?name=eq.${enc}&select=*&order=created_at.desc${dfCA}&limit=500`,{headers:H}).then(r=>r.ok?r.json():[]).catch(()=>[]),
    fetch(`${SUPABASE_URL}/rest/v1/missing?name=eq.${enc}&select=*&order=created_at.desc${dfCA}&limit=500`,{headers:H}).then(r=>r.ok?r.json():[]).catch(()=>[]),
    fetch(`${SUPABASE_URL}/rest/v1/orders?to_name=eq.${enc}&select=*&order=created_at.desc${dfCA}&limit=200`,{headers:H}).then(r=>r.ok?r.json():[]).catch(()=>[]),
    // مأموريات: الفروع اللي المشرف وجّهها للمنسق ده (جدول assignments) — كانت مش متجابة هنا خالص
    fetch(`${SUPABASE_URL}/rest/v1/assignments?rep_name=eq.${enc}&select=*&order=created_at.desc${dfCA}&limit=200`,{headers:H}).then(r=>r.ok?r.json():[]).catch(()=>[]),
    // دعم الميدان: جلسات الدعم اللي مشرف عملها مع المنسق ده (جدول field_support_logs) — نفس الحال
    fetch(`${SUPABASE_URL}/rest/v1/field_support_logs?rep_name=eq.${enc}&select=*&order=created_at.desc${dfCA}&limit=200`,{headers:H}).then(r=>r.ok?r.json():[]).catch(()=>[]),
    fetch(`${SUPABASE_URL}/rest/v1/attendance?name=eq.${enc}&select=*&order=created_at.desc${dfCA}&limit=200`,{headers:H}).then(r=>r.ok?r.json():[]).catch(()=>[])
  ]);

  // ── دمج الثلاثة مصادر في قائمة واحدة لتاب "المأموريات والدعم" — كان التاب ده معتمد
  // على orders (طلبيات التوريد) بس، وده مختلف تمامًا عن "مأموريات" (assignments، توجيه
  // فرع من المشرف) و"دعم" (field_support_logs، جلسات دعم ميداني)، فكان بيفضل فاضي
  // غالبًا حتى لو المنسق فعلاً عنده مأموريات أو زيارات دعم مسجلة.
  const orders = [
    ...supplyOrders.map(o=>({
      type:'طلبية توريد', date:o.arrival_date||o.created_at, target:o.branch||o.to_route||'—',
      status:o.status, statusLabel: o.status==='done'?'منفذ':o.status==='pending'?'منتظر':o.status||'—',
      statusClass: o.status==='done'?'b-green':o.status==='pending'?'b-orange':'b-gray',
      note:o.note||''
    })),
    ...assignments.map(a=>({
      type:'مأمورية', date:a.visit_date||a.directed_date||a.created_at, target:a.branch_name||'—',
      status:a.status, statusLabel: a.status==='confirmed'?'مؤكدة':a.status==='pending'?'منتظرة':a.status||'—',
      statusClass: a.status==='confirmed'?'b-green':a.status==='pending'?'b-orange':'b-gray',
      note:a.note||''
    })),
    ...supportLogs.map(s=>({
      type:'دعم ميداني', date:s.visit_date||s.created_at, target:s.branch_name||'—',
      status:s.status, statusLabel: s.status==='completed'?'مكتمل':s.status==='active'?'جاري':s.status||'—',
      statusClass: s.status==='completed'?'b-green':s.status==='active'?'b-orange':'b-gray',
      note: s.support_type ? `نوع الدعم: ${s.support_type}${s.supervisor_name?' — '+s.supervisor_name:''}` : (s.supervisor_name||'')
    })),
  ].sort((a,b)=>String(b.date||'').localeCompare(String(a.date||'')));

  // حفظ البيانات الكاملة
  window._rdAllData={visits,products,missing,orders,attend};
  // تحديث قائمة الفروع
  const allBranches=[...new Set([
    ...visits.map(v=>v.branch),
    ...products.map(p=>p.branch),
    ...missing.map(m=>m.branch)
  ].filter(Boolean))].sort();
  const branchSel=document.getElementById('rd-filter-branch');
  if(branchSel){
    const cur=branchSel.value;
    branchSel.innerHTML='<option value="all">كل الفروع ('+visits.length+' زيارة)</option>'+
      allBranches.map(b=>`<option value="${b}" ${b===cur?'selected':''}>${b}</option>`).join('');
  }
  rdRenderData(visits,products,missing,orders,attend);
}

function rdApplyBranchFilter(){
  const branch=document.getElementById('rd-filter-branch')?.value||'all';
  let {visits,products,missing,orders,attend}=window._rdAllData;
  if(branch!=='all'){
    visits=visits.filter(v=>v.branch===branch);
    products=products.filter(p=>p.branch===branch);
    missing=missing.filter(m=>m.branch===branch);
  }
  rdRenderData(visits,products,missing,orders,attend);
}

function rdToggleAllVisits(masterCb){
  document.querySelectorAll('.rd-visit-cb').forEach(cb=>{ cb.checked = masterCb.checked; });
  rdUpdateVisitDelBar();
}

function rdUpdateVisitDelBar(){
  const checked = document.querySelectorAll('.rd-visit-cb:checked');
  const bar = document.getElementById('rd-visits-del-bar');
  const countEl = document.getElementById('rd-visits-sel-count');
  if(bar){
    bar.style.display = checked.length > 0 ? 'flex' : 'none';
  }
  if(countEl) countEl.textContent = checked.length + ' زيارة محددة';
}

async function rdDeleteSelectedVisits(){
  const checked = [...document.querySelectorAll('.rd-visit-cb:checked')];
  if(!checked.length){ showToast('⚠️ لم تحدد أي زيارة'); return; }
  if(!confirm(`⚠️ هيتم حذف ${checked.length} زيارة نهائيًا مع كل ما يتعلق بيها (تقرير الأصناف، النواقص، المرتجعات، وسجل الحضور/الانصراف لنفس اليوم لو معندوش زيارة تانية). لا يمكن التراجع — متأكد؟`)) return;

  const ids = checked.map(cb=>cb.value);
  const H    = {'apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`};
  const HDel = {...H,'Prefer':'return=minimal'};

  // هات بيانات الزيارات المحددة (اسم + تاريخ) من الكاش المحلي عشان نلاقي سجل الحضور المرتبط بيها
  const visitsCache = window._rdAllData?.visits || [];
  const selectedVisits = ids.map(id=>visitsCache.find(v=>String(v.id)===String(id))).filter(Boolean);

  try{
    let failCount = 0;
    // لكل زيارة محددة: امسح كل ما يتعلق بيها (أصناف/نواقص/مرتجعات مربوطة بـ visit_id) ثم الزيارة نفسها
    for(const id of ids){
      const results = await Promise.all([
        fetch(`${SUPABASE_URL}/rest/v1/products?visit_id=eq.${id}`,{method:'DELETE',headers:HDel}),
        fetch(`${SUPABASE_URL}/rest/v1/missing?visit_id=eq.${id}`,{method:'DELETE',headers:HDel}),
        fetch(`${SUPABASE_URL}/rest/v1/returns?visit_id=eq.${id}`,{method:'DELETE',headers:HDel}),
        fetch(`${SUPABASE_URL}/rest/v1/visits?id=eq.${id}`,{method:'DELETE',headers:HDel}),
      ]);
      if(results.some(r=>!r.ok)) failCount++;
    }

    // سجل الحضور مش مربوط بـ visit_id مباشرة (مربوط بالاسم + التاريخ) —
    // امسحه بس لو مفيش زيارة تانية باقية لنفس المنسق في نفس اليوم ده (عشان منمسحش حضور يوم فيه زيارات تانية سليمة)
    for(const v of selectedVisits){
      if(!v.name || !v.date) continue;
      const remain = await fetch(
        `${SUPABASE_URL}/rest/v1/visits?name=eq.${encodeURIComponent(v.name)}&date=eq.${v.date}&select=id&limit=1`,
        {headers:H}
      ).then(r=>r.ok?r.json():[]).catch(()=>[]);
      if(!remain.length){
        await fetch(
          `${SUPABASE_URL}/rest/v1/attendance?name=eq.${encodeURIComponent(v.name)}&date=eq.${v.date}`,
          {method:'DELETE',headers:HDel}
        );
      }
    }

    showToast(failCount
      ? `⚠️ تم الحذف مع ${failCount} خطأ جزئي — راجع البيانات`
      : `✅ تم حذف ${ids.length} زيارة وكل بياناتها المرتبطة بنجاح`);
    // حدّث الكاش المحلي
    if(window._rdAllData?.visits){
      window._rdAllData.visits = window._rdAllData.visits.filter(v=>!ids.includes(String(v.id)));
    }
    rdLoad();
  }catch(e){
    showToast('❌ خطأ في الحذف: ' + e.message);
  }
}

function rdRenderData(visits,products,missing,orders,attend){

  const totalPts=visits.reduce((s,v)=>s+(+v.points||0),0);
  const branches=[...new Set(visits.map(v=>v.branch).filter(Boolean))];
  document.getElementById('rd-stats').innerHTML=`
    <div class="stat-card blue"><div class="stat-n">${visits.length}</div><div class="stat-l">زيارة</div></div>
    <div class="stat-card green"><div class="stat-n">${totalPts}</div><div class="stat-l">نقاط</div></div>
    <div class="stat-card orange"><div class="stat-n">${branches.length}</div><div class="stat-l">فرع مختلف</div></div>
    <div class="stat-card purple"><div class="stat-n">${products.length}</div><div class="stat-l">تسجيل صنف</div></div>
    <div class="stat-card red"><div class="stat-n">${missing.length}</div><div class="stat-l">ناقص</div></div>
    <div class="stat-card yellow"><div class="stat-n">${attend.length}</div><div class="stat-l">يوم حضور</div></div>
    ${(()=>{
      const todayStr = localISO();
      const todayAtt = attend.find(a=>a.date===todayStr);
      if(!todayAtt) return '';
      const timeIn  = todayAtt.time_in  || '—';
      const timeOut = todayAtt.time_out || '—';
      return `<div class="stat-card" style="background:#F3F0FF;border-right:4px solid #7C3AED">
        <div style="font-size:12px;color:#7C3AED;font-weight:700;margin-bottom:6px"><i class="ti ti-clock"></i> اليوم</div>
        <div style="display:flex;justify-content:space-around;gap:8px">
          <div style="text-align:center">
            <div style="font-size:18px;font-weight:900;color:#16A34A">${timeIn}</div>
            <div style="font-size:10px;color:#666">حضور</div>
          </div>
          <div style="color:#ccc;align-self:center">|</div>
          <div style="text-align:center">
            <div style="font-size:18px;font-weight:900;color:${todayAtt.time_out?'#DC2626':'#999'}">${timeOut}</div>
            <div style="font-size:10px;color:#666">انصراف</div>
          </div>
        </div>
      </div>`;
    })()}
  `;

  // ── إحصائيات الفروع وخط السير ──
  const routeStatsEl = document.getElementById('rd-route-stats');
  if(routeStatsEl && visits.length > 0){
    // فروع خط السير
    const totalBranchesInRoute = [...new Set(visits.map(v=>v.branch).filter(Boolean))].length;
    const visitedBranches = totalBranchesInRoute;
    // متوسط الزيارة للفرع
    const branchVisitMap = {};
    visits.forEach(v=>{ if(v.branch){ branchVisitMap[v.branch]=(branchVisitMap[v.branch]||0)+1; } });
    const branchList = Object.entries(branchVisitMap).sort((a,b)=>b[1]-a[1]);
    const avgPerBranch = visitedBranches>0 ? (visits.length/visitedBranches).toFixed(1) : 0;
    // حساب الفترة بالأسابيع والأشهر
    const dates = visits.map(v=>(v.date||v.created_at||'').slice(0,10)).filter(Boolean).sort();
    const firstDate = dates[0]||''; const lastDate = dates[dates.length-1]||'';
    const daysDiff = firstDate&&lastDate ? Math.max(1,Math.round((new Date(lastDate)-new Date(firstDate))/(864e5))+1) : 1;
    const weeks = Math.max(1,(daysDiff/7).toFixed(1));
    const avgPerWeek = (visits.length/weeks).toFixed(1);
    const avgPerMonth = (visits.length/(daysDiff/30)).toFixed(1);

    // حضور وانصراف اليوم المحدد
    const filterDate = rdGetDateFilter();
    const todayAttRows = attend.filter(a=>a.date>=filterDate.from && a.date<=filterDate.to);
    const attWithOut = todayAttRows.find(a=>a.time_out) || todayAttRows[0] || {};
    // أول time_in من الزيارات
    const sortedVisits = [...visits].sort((a,b)=>(a.time_in||'').localeCompare(b.time_in||''));
    const firstTimeIn = sortedVisits.find(v=>v.time_in&&v.time_in!='--')?.time_in || '—';
    const timeOut = attWithOut.time_out || '—';
    const attendHTML = `
      <div style="background:#fff;border:1px solid #DDE3ED;border-radius:12px;padding:12px 16px;margin-bottom:8px;display:flex;align-items:center;gap:16px;flex-wrap:wrap">
        <div style="font-size:13px;font-weight:700;color:var(--navy);margin-left:auto"><i class="ti ti-clock"></i> الحضور والانصراف</div>
        <div style="display:flex;gap:12px;align-items:center">
          <div style="display:flex;align-items:center;gap:6px">
            <span style="width:8px;height:8px;border-radius:50%;background:#16A34A;display:inline-block"></span>
            <span style="font-size:12px;color:#555">حضور:</span>
            <span style="font-size:15px;font-weight:900;color:#16A34A">${firstTimeIn}</span>
          </div>
          <div style="color:#ccc">|</div>
          <div style="display:flex;align-items:center;gap:6px">
            <span style="width:8px;height:8px;border-radius:50%;background:${timeOut!='—'?'#DC2626':'#aaa'};display:inline-block"></span>
            <span style="font-size:12px;color:#555">انصراف:</span>
            <span style="font-size:15px;font-weight:900;color:${timeOut!='—'?'#DC2626':'#aaa'}">${timeOut}</span>
          </div>
        </div>
      </div>`;
    routeStatsEl.innerHTML = attendHTML + `
      <div style="background:#fff;border:1px solid #DDE3ED;border-radius:12px;padding:14px 16px;margin-bottom:8px">
        <div style="font-size:13px;font-weight:700;color:var(--navy);margin-bottom:12px"><i class="ti ti-route"></i> إحصائيات الفروع وخط السير</div>
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:10px;margin-bottom:12px">
          <div style="background:#EEF6FF;border-radius:10px;padding:10px;text-align:center">
            <div style="font-size:26px;font-weight:900;color:var(--blue)">${visits.length}</div>
            <div style="font-size:11px;color:#666">إجمالي الزيارات</div>
          </div>
          <div style="background:#E8F5E9;border-radius:10px;padding:10px;text-align:center">
            <div style="font-size:26px;font-weight:900;color:var(--green)">${visitedBranches}</div>
            <div style="font-size:11px;color:#666">فرع تم زيارته</div>
          </div>
          <div style="background:#FFF3E0;border-radius:10px;padding:10px;text-align:center">
            <div style="font-size:26px;font-weight:900;color:var(--orange)">${avgPerBranch}</div>
            <div style="font-size:11px;color:#666">متوسط زيارات/فرع</div>
          </div>
          <div style="background:#F3E8FF;border-radius:10px;padding:10px;text-align:center">
            <div style="font-size:26px;font-weight:900;color:#6A0DAD">${avgPerWeek}</div>
            <div style="font-size:11px;color:#666">متوسط أسبوعي</div>
          </div>
          <div style="background:#FFEBEE;border-radius:10px;padding:10px;text-align:center">
            <div style="font-size:26px;font-weight:900;color:var(--red)">${avgPerMonth}</div>
            <div style="font-size:11px;color:#666">متوسط شهري</div>
          </div>
        </div>
        ${branchList.length>0?`
        <div style="font-size:12px;font-weight:700;color:#555;margin-bottom:8px">تفاصيل الفروع المزارة:</div>
        <div style="display:flex;flex-wrap:wrap;gap:6px">
          ${branchList.map(([b,cnt])=>`
            <div style="background:#F0F4F8;border-radius:8px;padding:5px 10px;font-size:11px;display:flex;align-items:center;gap:6px">
              <span style="font-weight:700;color:var(--navy)">${b}</span>
              <span style="background:var(--blue);color:#fff;border-radius:99px;padding:1px 7px;font-size:10px;font-weight:700">${cnt} زيارة</span>
            </div>`).join('')}
        </div>` : ''}
      </div>`;
  } else if(routeStatsEl) {
    routeStatsEl.innerHTML='';
  }

  // زيارات
  document.getElementById('rd-visits-body').innerHTML=visits.length
    ? visits.map(v=>`<tr>
        <td style="width:32px;text-align:center"><input type="checkbox" class="rd-visit-cb" value="${v.id}" onchange="rdUpdateVisitDelBar()" style="cursor:pointer"/></td>
        <td style="font-size:11px">${fmtDate((v.date||v.created_at||'').slice(0,10))}</td>
        <td><span style="font-size:11px;background:#EEF6FF;color:#003A80;padding:2px 6px;border-radius:4px">${v.branch||'—'}</span></td>
        <td style="font-size:11px">${v.route||'—'}</td>
        <td style="font-size:11px">${v.time_in||'—'}</td>
        <td style="font-size:11px">${(v.time_out&&v.time_out!='--')?v.time_out:'—'}</td>
        <td style="text-align:center">${v.sku_on||0}</td>
        <td style="text-align:center">${v.sku_stock||0}</td>
        <td style="text-align:center;color:${v.missing_count>0?'var(--red)':'inherit'}">${v.missing_count||0}</td>
        <td style="font-size:11px">${v.display_type||v.client_type||'—'}</td>
        <td style="text-align:center;font-weight:700;color:var(--green)">${v.points||0}</td>
      </tr>`).join('')
    : '<tr><td colspan="11" style="text-align:center;padding:1rem;color:#aaa">لا توجد زيارات</td></tr>';

  // أصناف
  document.getElementById('rd-products-body').innerHTML=products.length
    ? products.map(p=>`<tr>
        <td style="font-size:11px">${fmtDate((p.date||p.created_at||'').slice(0,10))}</td>
        <td style="font-size:11px">${p.branch||'—'}</td>
        <td style="font-size:11px">${p.snf||p.fea||'—'}</td>
        <td style="font-size:11px">${p.cat||'—'}</td>
        <td style="text-align:center">${p.shelf_qty??p.sku_on??'—'}</td>
        <td style="text-align:center">${p.stock_qty??p.sku_stock??'—'}</td>
        <td style="font-size:11px">${p.date_shelf||'—'}</td>
        <td style="font-size:11px">${p.date_stock||p.months_shelf||'—'}</td>
      </tr>`).join('')
    : '<tr><td colspan="8" style="text-align:center;padding:1rem;color:#aaa">لا توجد أصناف</td></tr>';

  // نواقص
  document.getElementById('rd-missing-body').innerHTML=missing.length
    ? missing.map(m=>`<tr>
        <td style="font-size:11px">${fmtDate((m.date||m.created_at||'').slice(0,10))}</td>
        <td style="font-size:11px">${m.branch||'—'}</td>
        <td style="font-size:11px">${m.snf||m.fea||'—'}</td>
        <td style="font-size:11px">${m.cat||'—'}</td>
        <td style="font-size:11px">${m.reason||'—'}</td>
        <td style="font-size:11px">${m.note||'—'}</td>
      </tr>`).join('')
    : '<tr><td colspan="6" style="text-align:center;padding:1rem;color:#aaa">لا توجد نواقص</td></tr>';

  // مأموريات ودعم — دمج طلبيات التوريد + المأموريات الموجّهة + جلسات الدعم الميداني (rdLoad بتحضّرهم موحّدين)
  document.getElementById('rd-orders-body').innerHTML=orders.length
    ? orders.map(o=>`<tr>
        <td><span class="badge b-navy" style="font-size:10px">${o.type||'—'}</span></td>
        <td style="font-size:11px">${fmtDate(String(o.date||'').slice(0,10))}</td>
        <td style="font-size:11px">${o.target||'—'}</td>
        <td><span class="badge ${o.statusClass}">${o.statusLabel}</span></td>
        <td style="font-size:11px">${o.note||'—'}</td>
      </tr>`).join('')
    : '<tr><td colspan="5" style="text-align:center;padding:1rem;color:#aaa">لا توجد مأموريات أو جلسات دعم</td></tr>';

  // حضور
  document.getElementById('rd-attend-body').innerHTML=attend.length
    ? attend.map(a=>{
        let hours='—';
        if(a.time_in&&a.time_out){
          try{
            const [h1,m1]=(a.time_in||'').split(':').map(Number);
            const [h2,m2]=(a.time_out||'').split(':').map(Number);
            const mins=(h2*60+m2)-(h1*60+m1);
            hours=mins>0?`${Math.floor(mins/60)}:${String(mins%60).padStart(2,'0')}`:'—';
          }catch(e){}
        }
        return`<tr>
          <td style="font-size:11px">${a.date||'—'}</td>
          <td style="font-size:11px">${a.time_in||a.check_in||'—'}</td>
          <td style="font-size:11px">${a.time_out||a.check_out||'—'}</td>
          <td style="font-size:11px;font-weight:600">${hours}</td>
        </tr>`;
      }).join('')
    : '<tr><td colspan="4" style="text-align:center;padding:1rem;color:#aaa">لا توجد بيانات حضور</td></tr>';
}


