function redToggleGrpDropdown(){
  const dd = document.getElementById('red-grp-dropdown');
  if(!dd) return;
  const isOpen = dd.style.display !== 'none';
  dd.style.display = isOpen ? 'none' : 'block';
  if(!isOpen){
    setTimeout(()=>{
      function closeDD(e){
        if(!document.getElementById('red-grp-container')?.contains(e.target)){
          dd.style.display = 'none';
          document.removeEventListener('click', closeDD);
        }
      }
