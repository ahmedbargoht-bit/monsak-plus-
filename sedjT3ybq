function rrInit(){
  // تعيين تاريخ افتراضي (هذا الشهر)
  const now = new Date();
  const y = now.getFullYear();
  const m = String(now.getMonth()+1).padStart(2,'0');
  const d = String(now.getDate()).padStart(2,'0');
  if(!document.getElementById('rr-from').value){
    document.getElementById('rr-from').value = `${y}-${m}-01`;
    document.getElementById('rr-to').value   = `${y}-${m}-${d}`;
  }
  rrUpdateLevel();
}

function rrUpdateLevel(){
  const level = document.getElementById('rr-level').value;
  document.getElementById('rr-grp-wrap').style.display   = (level==='group'||level==='route'||level==='rep') ? '' : 'none';
  document.getElementById('rr-route-wrap').style.display = (level==='route'||level==='rep') ? '' : 'none';
  document.getElementById('rr-rep-wrap').style.display   = (level==='rep') ? '' : 'none';
  if(level==='route'||level==='rep') rrUpdateRoutes();
  if(level==='rep') rrUpdateReps();
  document.getElementById('rr-preview-wrap').style.display = 'none';
}

function rrUpdateRoutes(){
  const grp = document.getElementById('rr-group').value;
  const sel = document.getElementById('rr-route');
  const routes = grp==='all' ? [] :
    [...new Set((REPS||[]).filter(r=>r.group===grp).map(r=>r.route).filter(Boolean))].sort();
  sel.innerHTML = '<option value="all">كل خطوط السير</option>' +
    routes.map(r=>`<option value="${r}">${r}</option>`).join('');
  rrUpdateReps();
}

function rrUpdateReps(){
  const grp   = document.getElementById('rr-group').value;
  const route = document.getElementById('rr-route')?.value||'all';
  const sel   = document.getElementById('rr-rep');
  if(!sel) return;
  let reps = (REPS||[]);
  if(grp   !== 'all') reps = reps.filter(r=>r.group===grp);
  if(route !== 'all') reps = reps.filter(r=>r.route===route);
  sel.innerHTML = '<option value="all">كل المنسقين</option>' +
    reps.map(r=>`<option value="${r.name}">${r.name}</option>`).join('');
}

function rrQuickDate(){
  const v = document.getElementById('rr-quick').value;
  if(!v) return;
  const now = new Date();
  let from, to = new Date();
  if(v==='today'){
    from = new Date();
  } else if(v==='week'){
    from = new Date(); from.setDate(from.getDate() - from.getDay());
  } else if(v==='month'){
    from = new Date(now.getFullYear(), now.getMonth(), 1);
  } else if(v==='lastmonth'){
    from = new Date(now.getFullYear(), now.getMonth()-1, 1);
    to   = new Date(now.getFullYear(), now.getMonth(), 0);
  }
  const fmt = d => localISO(d);
  document.getElementById('rr-from').value = fmt(from);
  document.getElementById('rr-to').value   = fmt(to);
  document.getElementById('rr-quick').value = '';
}

function rrGetFiltered(){
  const level = document.getElementById('rr-level').value;
  const grp   = document.getElementById('rr-group')?.value||'all';
  const route = document.getElementById('rr-route')?.value||'all';
  const rep   = document.getElementById('rr-rep')?.value||'all';
  const from  = document.getElementById('rr-from').value;
  const to    = document.getElementById('rr-to').value;

  // بناء قائمة الأسماء المسموح بها
  let allowedNames = null; // null = الكل
  if(level !== 'all'){
    let reps = [...(REPS||[])];
    if(grp   !== 'all') reps = reps.filter(r=>r.group===grp);
    if((level==='route'||level==='rep') && route!=='all') reps = reps.filter(r=>r.route===route);
    if(level==='rep' && rep!=='all') reps = reps.filter(r=>r.name===rep);
    allowedNames = new Set(reps.map(r=>r.name));
  }

  const filterRows = (rows, dateField) => {
    let out = rows;
    if(allowedNames) out = out.filter(r=>allowedNames.has(r.name||''));
    if(grp!=='all' && level!=='rep' && level!=='route') out = out.filter(r=>(r.grp||r.group||'')===grp);
    return _filterExportRows(out, dateField, from, to, level==='all'?'all': grp==='all'?'all':grp);
  };

  // لو level = all أو group نفلتر بـ grp مباشرة بدون allowedNames
  const filterByGrp = (rows, dateField) => {
    let out = [...rows];
    if(allowedNames) out = out.filter(r=>allowedNames.has(r.name||''));
    return _filterExportRows(out, dateField, from, to, (level==='group'&&grp!=='all')?grp:'all');
  };

  const visits   = filterByGrp(cachedData.visits||[],   'date');
  const products = filterByGrp(cachedData.products||[], 'created_at');
  const missing  = filterByGrp(cachedData.missing||[],  'created_at');

  return {visits, products, missing};
}

