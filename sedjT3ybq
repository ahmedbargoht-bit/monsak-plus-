let _repSupervisors = [];   // [{name, grp:[]}] من staff
let _repGroupsData  = [];   // من groups في Supabase
let _repRoutesData  = [];   // من routes في Supabase
let _repBranchesData= [];   // من branches في Supabase

async function repInitModal(){
  const H = {'apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`};

  // جيب كل البيانات من Supabase بالتوازي
  const [staffRes, grpsRes, routesRes, branchesRes] = await Promise.all([
    fetch(`${SUPABASE_URL}/rest/v1/staff?select=name,grp,role,app_access&active=eq.true&order=name.asc`, {headers:H}),
    fetch(`${SUPABASE_URL}/rest/v1/groups?select=key_name,name,color,emoji&order=name.asc`, {headers:H}),
    fetch(`${SUPABASE_URL}/rest/v1/routes?select=name,grp&order=name.asc&limit=500`, {headers:H}),
    fetch(`${SUPABASE_URL}/rest/v1/branches?select=branch_name,route,grp&status=eq.active&order=branch_name.asc&limit=2000`, {headers:H}),
  ]);

  let staffData      = staffRes.ok    ? await staffRes.json()    : [];
  _repGroupsData     = grpsRes.ok     ? await grpsRes.json()     : [];
  _repRoutesData     = routesRes.ok   ? await routesRes.json()   : [];
  _repBranchesData   = branchesRes.ok ? await branchesRes.json() : [];

  // مناديب البيع لازم يتبعوا مشرفي المبيعات بس (app_access يحتوي 'sales-app')
  // مش مشرفي التنسيق (اللي app_access بتاعهم 'mansek-supervisor')
  if(Array.isArray(staffData) && staffData.length){
    staffData = staffData.filter(s=>{
      const acc = Array.isArray(s.app_access) ? s.app_access : (s.app_access ? [s.app_access] : []);
      return acc.includes('sales-app');
    });
  }

  // لو staff فاضي جرّب sales_staff
  if(!Array.isArray(staffData) || !staffData.length){
    const r2 = await fetch(`${SUPABASE_URL}/rest/v1/sales_staff?select=name,sector&active=eq.true&order=name.asc`, {headers:H});
    const sd2 = r2.ok ? await r2.json() : [];
    staffData = (Array.isArray(sd2)?sd2:[]).map(s=>({name:s.name, grp:[], role:'مشرف المجموعة'}));
  }

  // كل staff النشطين — المستخدم يختار المشرف المناسب
  _repSupervisors = (Array.isArray(staffData)?staffData:[])
    .filter(s=> s.name)
    .map(s=>({
      name: s.name,
      grp: Array.isArray(s.grp) ? s.grp : (s.grp ? [s.grp] : [])
    }));

  // ملء قائمة المشرفين
  const supSel = document.getElementById('rep-supervisor');
  if(supSel){
    supSel.innerHTML = '<option value="">اختر المشرف...</option>';
    _repSupervisors.forEach(s=>{
      const o = document.createElement('option');
      o.value = s.name; o.textContent = s.name;
      supSel.appendChild(o);
    });
  }
}

function repOnSupChange(){
  const supName = document.getElementById('rep-supervisor').value;
  const grpsWrap = document.getElementById('rep-grps-wrap');
  const grpsChecks = document.getElementById('rep-grps-checks');
  document.getElementById('rep-routes-wrap').style.display='none';
  document.getElementById('rep-branches-wrap').style.display='none';
  grpsChecks.innerHTML='';
  grpsWrap.style.display='none';
  if(!supName) return;

  const sup = _repSupervisors.find(s=>s.name===supName);
  if(!sup) return;

  // المجموعات المخصصة للمشرف
  const supGrps = _repGroupsData.filter(g=> sup.grp.includes(g.key_name));
  if(!supGrps.length) return;

  supGrps.forEach(g=>{
    const id = `rep-grp-cb-${g.key_name}`;
    grpsChecks.innerHTML += `
      <label style="display:flex;align-items:center;gap:6px;background:#fff;border:1.5px solid ${g.color||'#ccc'};border-radius:20px;padding:4px 12px;cursor:pointer;font-size:12px;font-weight:600;color:${g.color||'#333'}">
        <input type="checkbox" id="${id}" value="${g.key_name}" onchange="repOnGrpChange()" style="accent-color:${g.color||'#005CBF'}"/>
        ${g.emoji||''} ${g.name}
      </label>`;
  });
  grpsWrap.style.display='';

  // لو مجموعة واحدة بس — اختارها تلقائياً
  if(supGrps.length===1){
    const cb = document.getElementById(`rep-grp-cb-${supGrps[0].key_name}`);
    if(cb){ cb.checked=true; repOnGrpChange(); }
  }
}

function repOnGrpChange(){
  const checkedGrps = [...document.querySelectorAll('#rep-grps-checks input:checked')].map(c=>c.value);
  const routesWrap   = document.getElementById('rep-routes-wrap');
  const routesChecks = document.getElementById('rep-routes-checks');
  document.getElementById('rep-branches-wrap').style.display='none';
  routesChecks.innerHTML='';
  routesWrap.style.display='none';
  if(!checkedGrps.length) return;

  // لكل مجموعة محددة، اعرض خطوطها
  checkedGrps.forEach(grp=>{
    const grpInfo = _repGroupsData.find(g=>g.key_name===grp)||{name:grp,color:'#888',emoji:''};
    const routes  = _repRoutesData.filter(r=>r.grp===grp).map(r=>r.name).sort();
    if(!routes.length) return;

    const section = document.createElement('div');
    section.innerHTML = `
      <div style="font-size:11px;font-weight:700;color:${grpInfo.color};margin-bottom:6px">${grpInfo.emoji||''} ${grpInfo.name}</div>
      <div style="display:flex;flex-wrap:wrap;gap:6px">
        ${routes.map(r=>`
          <label style="display:flex;align-items:center;gap:5px;background:#fff;border:1px solid #ddd;border-radius:16px;padding:3px 10px;cursor:pointer;font-size:11px">
            <input type="checkbox" class="rep-route-modal-cb" value="${r}" data-grp="${grp}" onchange="repUpdateBranches()"/>
            ${r}
          </label>`).join('')}
      </div>`;
    routesChecks.appendChild(section);
  });
  routesWrap.style.display='';
  repUpdateBranches();
}

function repUpdateBranches(){
  const checkedRoutes = [...document.querySelectorAll('.rep-route-modal-cb:checked')].map(c=>c.value);
  const wrap  = document.getElementById('rep-branches-wrap');
  const list  = document.getElementById('rep-branches-list');
  const thabitDiv = document.getElementById('rep-thabit-branches');
  const count = document.getElementById('rep-branches-count');
  if(!checkedRoutes.length){ wrap.style.display='none'; return; }

  // افصل الخطوط العادية عن الثابت
  const normalRoutes = checkedRoutes.filter(r=>!r.startsWith('ثابت'));
  const thabitRoutes = checkedRoutes.filter(r=>r.startsWith('ثابت'));

  // فروع الخطوط العادية — عرض ملخص
  const normalBranches = _repBranchesData
    .filter(b=>normalRoutes.includes(b.route))
    .map(b=>b.branch_name).sort();

  if(normalBranches.length){
    list.innerHTML = normalBranches.map(b=>`<span style="display:inline-block;margin-left:8px">🏪 ${b}</span>`).join('');
    list.style.display='';
  } else {
    list.innerHTML='';
    list.style.display='none';
  }

  // فروع الثابت — checkboxes للاختيار
  if(thabitRoutes.length){
    const thabitBranches = _repBranchesData
      .filter(b=>thabitRoutes.includes(b.route))
      .sort((a,b)=>a.branch_name.localeCompare(b.branch_name,'ar'));

    // احتفظ بالاختيارات الحالية
    const currentChecked = new Set([...thabitDiv.querySelectorAll('input:checked')].map(i=>i.value));

    thabitDiv.innerHTML = thabitBranches.map(b=>`
      <label style="display:flex;align-items:center;gap:5px;background:#fff;border:1px solid #BBF7D0;border-radius:16px;padding:3px 10px;cursor:pointer;font-size:11px">
        <input type="checkbox" class="rep-thabit-cb" value="${b.branch_name}" ${currentChecked.has(b.branch_name)?'checked':''}/>
        🏪 ${b.branch_name}
      </label>`).join('');
    thabitDiv.style.display='flex';
  } else {
    thabitDiv.innerHTML='';
    thabitDiv.style.display='none';
  }

  const totalNormal = normalBranches.length;
  const totalThabit = thabitRoutes.length ? thabitDiv.querySelectorAll('input').length : 0;
  const total = totalNormal + totalThabit;
  if(count) count.textContent = `(${total} فرع${thabitRoutes.length?' — اختر من الثابت':''})`;
  wrap.style.display = total>0 ? '' : 'none';
}

async function addRepUser(){
  const name   = document.getElementById('rep-name').value.trim();
  const pass   = document.getElementById('rep-pass').value.trim();
  const sup    = document.getElementById('rep-supervisor').value;
  const dayOff = document.getElementById('rep-dayoff')?.value||'none';
  const okEl   = document.getElementById('rep-add-ok');
  const errEl  = document.getElementById('rep-add-err');
  okEl.textContent=''; errEl.style.display='none';

  // نوع المندوب
  const repTypes = [];
  if(document.getElementById('rep-type-tahhan')?.checked) repTypes.push('سلاسل الطحان');
  if(document.getElementById('rep-type-private')?.checked) repTypes.push('سلاسل الأسواق الخاصة');
  const repType = repTypes.join(',') || 'سلاسل الطحان';

  // اجمع المجموعات والخطوط المختارة
  const checkedGrps   = [...document.querySelectorAll('#rep-grps-checks input:checked')].map(c=>c.value);
  const checkedRoutes = [...document.querySelectorAll('.rep-route-modal-cb:checked')].map(c=>({route:c.value, grp:c.dataset.grp}));

  if(!name||!pass||!sup||!checkedGrps.length||!checkedRoutes.length){
    errEl.style.display='block'; errEl.textContent='يرجى تعبئة كل الحقول واختيار مجموعة وخط سير على الأقل'; return;
  }

  // فروع الثابت المختارة
  const thabitBranches = [...document.querySelectorAll('.rep-thabit-cb:checked')].map(c=>c.value);

  const H = {'Content-Type':'application/json','apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`,'Prefer':'return=minimal'};
  const grp    = checkedGrps[0];
  const route  = checkedRoutes[0].route;
  const routes = checkedRoutes.map(r=>r.route);

  try{
    // 1) احفظ في users
    const r1 = await fetch(`${SUPABASE_URL}/rest/v1/users`,{
      method:'POST', headers:H,
      body:JSON.stringify({
        name, pass_hash:pass,
        role:'sales', level:'rep',
        grp, route,
        routes: routes,
        branches: thabitBranches,
        groups: checkedGrps.join(','),
        supervisors: sup,
        status:'active', goal:0,
        rep_type: repType,
        day_off: dayOff,
      })
    });
    if(!r1.ok && r1.status!==201){
      const err=await r1.json();
      errEl.style.display='block'; errEl.textContent=err?.message||'❌ خطأ في الإضافة'; return;
    }

    // 2) سجّل في sales_route_assignments — صف لكل خط سير مع فروعه
    const assignments = [];
    for(const {route:rt, grp:g} of checkedRoutes){
      const branches = _repBranchesData.filter(b=>b.route===rt).map(b=>b.branch_name);
      if(branches.length){
        branches.forEach(branch_name=> assignments.push({supervisor:sup, grp:g, route:rt, branch_name, active:true}));
      } else {
        assignments.push({supervisor:sup, grp:g, route:rt, branch_name:'', active:true});
      }
    }
    await fetch(`${SUPABASE_URL}/rest/v1/sales_route_assignments`,{
      method:'POST', headers:{...H,'Prefer':'return=minimal'},
      body:JSON.stringify(assignments)
    });

    okEl.textContent='✅ تم إضافة المندوب بنجاح';
    document.getElementById('rep-name').value='';
    document.getElementById('rep-pass').value='';
    setTimeout(()=>{ closeModal('modal-add-rep'); loadRepUsersPanel(); },1500);
  }catch(e){
    errEl.style.display='block'; errEl.textContent='❌ خطأ في الاتصال';
  }
}

