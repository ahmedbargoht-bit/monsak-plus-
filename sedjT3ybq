async function caAddClient(name){
  const H = {'apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`,'Content-Type':'application/json','Prefer':'return=representation'};
  try{
    const r = await fetch(`${SUPABASE_URL}/rest/v1/contract_clients`,{method:'POST',headers:H,body:JSON.stringify({name})});
    if(!r.ok){ showToast('❌ فشل إضافة العميل (ممكن يكون الاسم موجود)'); return; }
    const data = await r.json();
    await caLoadClients();
    if(data && data[0]){
      document.getElementById('ca-client-select').value = data[0].id;
      caSelectClient(data[0].id);
    }
    showToast('✅ تم إضافة العميل');
  }catch(e){ showToast('❌ خطأ في الاتصال'); }
}

async function caDeleteClient(){
  if(!_caCurrentClientId){ showToast('❌ اختار عميل الأول'); return; }
  const client = _caClients.find(c=>String(c.id)===String(_caCurrentClientId));
  if(!confirm(`حذف عميل "${client?client.name:''}" وكل بنود عقوده نهائيًا؟`)) return;
  const H = {'apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`};
  try{
    const r = await fetch(`${SUPABASE_URL}/rest/v1/contract_clients?id=eq.${_caCurrentClientId}`,{method:'DELETE',headers:H});
    if(!r.ok){ showToast('❌ فشل الحذف'); return; }
    _caCurrentClientId = null;
    document.getElementById('ca-client-select').value = '';
    document.getElementById('ca-empty-state').style.display='';
    document.getElementById('ca-content').style.display='none';
    await caLoadClients();
    showToast('✅ تم حذف العميل');
  }catch(e){ showToast('❌ خطأ في الاتصال'); }
}

