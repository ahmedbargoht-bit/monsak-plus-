let _brLastData = []; // آخر بيانات مفلترة ظاهرة في جدول "إدارة الفروع والعملاء" — يستخدمها تصدير Excel/PDF

function brGrpChange(cb){
  const all=document.querySelectorAll('.br-grp-cb');
  if(cb.value==='all'){ all.forEach(c=>{ if(c.value!=='all'){c.checked=false;c.closest('.br-cb-lbl').classList.remove('active');} }); }
  else { const a=document.querySelector('.br-grp-cb[value="all"]'); if(a){a.checked=false;a.closest('.br-cb-lbl').classList.remove('active');} }
  if(![...all].filter(c=>c.value!=='all'&&c.checked).length){ const a=document.querySelector('.br-grp-cb[value="all"]'); if(a){a.checked=true;a.closest('.br-cb-lbl').classList.add('active');} }
  cb.closest('.br-cb-lbl').classList.toggle('active',cb.checked);
  loadBranches();
}

function brStatusChange(cb){
  const all=document.querySelectorAll('.br-status-cb');
  if(cb.value==='all'){ all.forEach(c=>{ if(c.value!=='all'){c.checked=false;c.closest('.br-cb-lbl').classList.remove('active');} }); }
  else { const a=document.querySelector('.br-status-cb[value="all"]'); if(a){a.checked=false;a.closest('.br-cb-lbl').classList.remove('active');} }
  if(![...all].filter(c=>c.value!=='all'&&c.checked).length){ const a=document.querySelector('.br-status-cb[value="all"]'); if(a){a.checked=true;a.closest('.br-cb-lbl').classList.add('active');} }
  cb.closest('.br-cb-lbl').classList.toggle('active',cb.checked);
  loadBranches();
}

async function loadBranches(){
  const selGrps    = [...document.querySelectorAll('.br-grp-cb:checked')].map(c=>c.value).filter(v=>v!=='all');
  const selStatus  = [...document.querySelectorAll('.br-status-cb:checked')].map(c=>c.value).filter(v=>v!=='all');
  const search     = (document.getElementById('br-search')?.value||'').toLowerCase();

  let data = [];
  try{
    const res = await sb('branches',{},{limit:2000});
    if(res && res.length) data = res;
    else {
      Object.entries(BRANCHES_MAP).forEach(([route,branches])=>{
        const rep=REPS.find(r=>r.route===route);
        if(rep){
          (Array.isArray(branches)?branches:[]).forEach(b=>{
            data.push({branch_name:b, route, grp:rep.group, client_type:'A — كبير', status:'active', rep_name:rep.name});
          });
        }
      });
    }
  }catch(e){ console.warn('branches load failed',e); }

  // فلترة
  if(selGrps.length)   data=data.filter(b=>selGrps.includes(b.grp));
  if(selStatus.length) data=data.filter(b=>selStatus.includes(b.status));
  if(search)           data=data.filter(b=>(b.branch_name||'').toLowerCase().includes(search)||(b.route||'').toLowerCase().includes(search));

  // نسخة من البيانات المفلترة الحالية — يستخدمها تصدير Excel/PDF عشان يطابقوا اللي ظاهر على الشاشة بالظبط
  _brLastData = data;

  // إحصاء
  const statsEl=document.getElementById('br-stats');
  if(statsEl) statsEl.innerHTML=`إجمالي: <b>${data.length}</b> فرع · نشط: <b>${data.filter(b=>b.status==='active').length}</b> · متوقف: <b>${data.filter(b=>b.status==='suspended').length}</b> · مغلق: <b>${data.filter(b=>b.status==='closed').length}</b>`;

  const statusLabel = {
    active:'<span class="badge b-green">نشط</span>',
    suspended:'<span class="badge" style="background:#FFF3E0;color:#E65100">متوقف</span>',
    closed:'<span class="badge" style="background:#FFEBEE;color:#B71C1C">مغلق</span>'
  };

  document.getElementById('branches-table').innerHTML = data.map(b=>`<tr>
    <td><b>${b.branch_name||'—'}</b></td>
    <td style="font-size:11px">${b.route||'—'}</td>
    <td><span class="badge" style="background:${GROUPS[b.grp]?.color||'#ccc'}22;color:${GROUPS[b.grp]?.color||'#555'}">${GROUPS[b.grp]?.label||b.grp||'—'}</span></td>
    <td style="font-size:11px;text-align:center">${b.client_type||b.rep_name||'—'}</td>
    <td>${statusLabel[b.status]||statusLabel.active}</td>
    <td>
      <div style="display:flex;gap:4px;align-items:center">
        <button onclick="openEditBranch(${JSON.stringify(b).replace(/"/g,'&quot;')})"
