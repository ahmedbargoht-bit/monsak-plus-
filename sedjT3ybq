  if(_b25) _b25.value = beforeIt?.value_2025||'';
  if(_a25) _a25.value = afterIt?.value_2025||'';
  if(_b26) _b26.value = beforeIt?.value_2026||'';
  if(_a26) _a26.value = afterIt?.value_2026||'';

  document.getElementById('ca-summary').innerHTML = `
    <div class="stat-card blue"><div class="stat-n">${beforeIt&&caIsNum(beforeIt.value_2025)?caNum(beforeIt.value_2025).toLocaleString('en-US'):'—'}</div><div class="stat-l">محقق 2025 قبل الخصم</div></div>
    <div class="stat-card green"><div class="stat-n">${afterIt&&caIsNum(afterIt.value_2025)?caNum(afterIt.value_2025).toLocaleString('en-US'):'—'}</div><div class="stat-l">محقق 2025 بعد الخصم</div></div>
    <div class="stat-card red"><div class="stat-n">${pct2025!==null?pct2025.toLocaleString('en-US',{maximumFractionDigits:2})+'%':'—'}</div><div class="stat-l">نسبة الخصم الفعلية 2025</div></div>
    <div class="stat-card purple"><div class="stat-n">${beforeIt&&caIsNum(beforeIt.value_2026)?caNum(beforeIt.value_2026).toLocaleString('en-US'):'—'}</div><div class="stat-l">محقق 2026 قبل الخصم</div></div>
    <div class="stat-card yellow"><div class="stat-n">${afterIt&&caIsNum(afterIt.value_2026)?caNum(afterIt.value_2026).toLocaleString('en-US'):'—'}</div><div class="stat-l">محقق 2026 بعد الخصم</div></div>
    <div class="stat-card orange"><div class="stat-n">${pct2026!==null?pct2026.toLocaleString('en-US',{maximumFractionDigits:2})+'%':'—'}</div><div class="stat-l">نسبة الخصم الفعلية 2026</div></div>`;

  caRenderSection('fixed', 'ca-table-fixed');
  caRenderSection('fees', 'ca-table-fees');
  caRenderSection('openings', 'ca-table-openings');
