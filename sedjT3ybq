  const coSel = document.getElementById('comp-f-company');
  const coVal = coSel.value;
  coSel.innerHTML = '<option value="">كل الشركات</option>';
  companies.forEach(c=>{ const o=document.createElement('option'); o.value=c; o.textContent=c; coSel.appendChild(o); });
