  const H={'apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`,'Content-Type':'application/json','Prefer':'return=minimal'};
  // جيب بيانات الفرع الحالية
  const [br]=await fetch(`${SUPABASE_URL}/rest/v1/branches?select=rep_name,rep_name2,rep_name3&id=eq.${brId}`,
    {headers:{'apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`}}).then(r=>r.ok?r.json():[]).catch(()=>[]);
  if(!br) return;

  const patch={};
  if(oldRep){
    if(br.rep_name===oldRep)  patch.rep_name=newRep;
    else if(br.rep_name2===oldRep) patch.rep_name2=newRep;
    else if(br.rep_name3===oldRep) patch.rep_name3=newRep;
  } else {
    // إضافة جديدة — أول حقل فاضي
    if(!br.rep_name)  patch.rep_name=newRep;
    else if(!br.rep_name2) patch.rep_name2=newRep;
    else if(!br.rep_name3) patch.rep_name3=newRep;
    else{msg.style.display='block';msg.style.background='#FFEBEE';msg.style.color='#B71C1C';msg.textContent='الفرع ممتلئ (3 منسقين)';return;}
  }

  const ok=await fetch(`${SUPABASE_URL}/rest/v1/branches?id=eq.${brId}`,{method:'PATCH',headers:H,body:JSON.stringify(patch)}).then(r=>r.ok).catch(()=>false);
  if(ok){
    document.getElementById('rd-rep-edit-overlay')?.remove();
    showToast('✅ تم تحديث المنسق');
    openRouteDetail(encodeURIComponent(routeName));
  } else {
    msg.style.display='block';msg.style.background='#FFEBEE';msg.style.color='#B71C1C';msg.textContent='خطأ في الحفظ';
  }
}

