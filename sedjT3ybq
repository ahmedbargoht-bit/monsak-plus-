// التابات المحذوفة — لا تظهر حتى لو محفوظة في localStorage
const REMOVED_PANELS = ['rep-summary','upload','products-db'];

function getNavOrder(){
  try{
    const saved = localStorage.getItem('nav_order');
    if(saved){
      const arr = JSON.parse(saved);
      // امسح أي تاب محذوف
      const cleaned = arr.filter(item=>{
        const id = typeof item==='string'?item:(item?.id||'');
        return !REMOVED_PANELS.includes(id);
      });
      // لو اتغير حجمه — احفظه نظيف
      if(cleaned.length !== arr.length)
        localStorage.setItem('nav_order', JSON.stringify(cleaned));
      return cleaned;
    }
  }catch(e){}
  return JSON.parse(JSON.stringify(NAV_DEFAULT));
}

