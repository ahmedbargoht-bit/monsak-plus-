function exportRepReport(){
  const {visits, products, missing} = rrGetFiltered();
  const cbV  = document.getElementById('rr-cb-visits').checked;
  const cbP  = document.getElementById('rr-cb-products').checked;
  const cbM  = document.getElementById('rr-cb-missing').checked;
  const cbA  = document.getElementById('rr-cb-attendance').checked;
  const cbS  = document.getElementById('rr-cb-summary').checked;

  // فلتر الحضور بنفس معايير rrGetFiltered
  const attendance = cbA || cbS ? rrGetAttendance() : [];

  if(!cbV && !cbP && !cbM && !cbA && !cbS){
    alert('اختر محتوى التقرير أولاً'); return;
  }
  if(!visits.length && !products.length && !missing.length && !attendance.length){
    alert('لا توجد بيانات ضمن الفلتر المحدد'); return;
  }

  const wb = XLSX.utils.book_new();

  // ── شيت الزيارات ──────────────────────────────────────────
  if(cbV && visits.length){
    const rows = visits.map((v,i)=>({
      '#':            i+1,
      'المنسق':       v.name||'',
      'خط السير':     v.route||'',
      'المجموعة':     GROUPS[v.grp]?.label||v.grp||'',
      'الفرع':        v.branch||'',
      'التاريخ':      v.date||'',
      'وقت الدخول':  v.time_in||'',
      'وقت الخروج':  v.time_out||'',
      'نوع العميل':  v.client_type||'',
      'نوع العرض':   v.display_type||'',
      'SKU رف':       v.sku_on||0,
      'SKU مخزن':     v.sku_stock||0,
      'نواقص':        v.missing_count||0,
      'النقاط':       v.points||0,
    }));
    const ws = XLSX.utils.json_to_sheet(rows);
    ws['!cols'] = Object.keys(rows[0]||{}).map(k=>({wch:k.length<6?10:18}));
    rrStyleHeader(ws, rows[0]);
    XLSX.utils.book_append_sheet(wb, ws, 'الزيارات');
  }

  // ── شيت الأصناف ───────────────────────────────────────────
  if(cbP && products.length){
    const rows = products.map((p,i)=>({
      '#':                         i+1,
      'المنسق':                    p.name||'',
      'خط السير':                  p.route||'',
      'المجموعة':                  GROUPS[p.grp]?.label||p.grp||'',
      'الفرع':                     p.branch||'',
      'العلامة':                   p.fea||'',
      'التصنيف':                   p.cat||'',
      'الصنف':                     p.snf||'',
      'كمية الرف':                 p.shelf_qty||0,
      'كمية المخزن':               p.stock_qty||0,
      'تاريخ انتهاء الرف':        p.date_shelf||'',
      'مدة صلاحية الرف (شهر)':    p.months_shelf||'',
      'تاريخ انتهاء المخزن':      p.date_stock||'',
      'مدة صلاحية المخزن (شهر)':  p.months_stock||'',
    }));
    const ws = XLSX.utils.json_to_sheet(rows);
    ws['!cols'] = Object.keys(rows[0]||{}).map(()=>({wch:18}));
    rrStyleHeader(ws, rows[0]);
    XLSX.utils.book_append_sheet(wb, ws, 'الأصناف');
  }

  // ── شيت النواقص ───────────────────────────────────────────
  if(cbM && missing.length){
    const rows = missing.map((m,i)=>({
      '#':        i+1,
      'المنسق':   m.name||'',
      'خط السير': m.route||'',
      'المجموعة': GROUPS[m.grp]?.label||m.grp||'',
      'الفرع':    m.branch||'',
      'العلامة':  m.fea||'',
      'الصنف':    m.snf||'',
      'السبب':    m.reason||'',
      'ملاحظة':   m.note||'',
      'التاريخ':  m.created_at?m.created_at.slice(0,10):'',
    }));
    const ws = XLSX.utils.json_to_sheet(rows);
    ws['!cols'] = Object.keys(rows[0]||{}).map(()=>({wch:18}));
    rrStyleHeader(ws, rows[0]);
    XLSX.utils.book_append_sheet(wb, ws, 'النواقص');
  }

  // ── شيت الحضور والانصراف ─────────────────────────────────
  if(cbA && attendance.length){
    const rows = attendance.map((a,i)=>({
      '#':              i+1,
      'المنسق':         a.name||'',
      'خط السير':       a.route||'',
      'المجموعة':       GROUPS[a.grp]?.label||a.grp||'',
      'التاريخ':        a.date||'',
      'وقت الحضور':    a.time_in||'—',
      'وقت الانصراف':  a.time_out||'—',
      'ساعات العمل':    a.hours!=null ? (+a.hours||0) : '—',
      'موقع الحضور':    a.lat_in&&a.lng_in ? `${a.lat_in}, ${a.lng_in}` : '—',
    }));
    const ws = XLSX.utils.json_to_sheet(rows);
    ws['!cols'] = Object.keys(rows[0]||{}).map(()=>({wch:18}));
    rrStyleHeader(ws, rows[0]);
    XLSX.utils.book_append_sheet(wb, ws, 'الحضور والانصراف');
  }

  // ── شيت ملخص المرتبات ─────────────────────────────────────
  if(cbS){
    const map = {};

    const ensure = (name, route, grp) => {
      if(!map[name]) map[name]={
        name, route:route||'', group:GROUPS[grp]?.label||grp||'',
        visits:0, branches:new Set(), points:0,
        products:0, missing:0,
        workDays:0, totalHours:0, avgHours:0,
        firstIn:'', lastOut:''
      };
    };

    visits.forEach(v=>{
      ensure(v.name, v.route, v.grp);
      map[v.name].visits++;
      map[v.name].points += (+v.points||0);
      if(v.branch) map[v.name].branches.add(v.branch);
    });
    products.forEach(p=>{
      ensure(p.name, p.route, p.grp);
      map[p.name].products++;
    });
    missing.forEach(m=>{
      ensure(m.name, m.route, m.grp);
      map[m.name].missing++;
    });
    attendance.forEach(a=>{
      ensure(a.name, a.route, a.grp);
      if(a.time_in){
        map[a.name].workDays++;
        const h = +a.hours||0;
        map[a.name].totalHours = Math.round((map[a.name].totalHours + h)*10)/10;
        // أول حضور وآخر انصراف للفترة
        if(!map[a.name].firstIn || a.date < map[a.name].firstIn) map[a.name].firstIn = a.date;
        if(!map[a.name].lastOut || a.date > map[a.name].lastOut)  map[a.name].lastOut = a.date;
      }
    });

    const rows = Object.values(map).sort((a,b)=>b.points-a.points).map((r,i)=>({
      '#':                    i+1,
      'المنسق':               r.name,
      'خط السير':             r.route,
      'المجموعة':             r.group,
      'أيام العمل':           r.workDays,
      'إجمالي ساعات العمل':  r.totalHours,
      'متوسط الساعات/يوم':   r.workDays ? Math.round(r.totalHours/r.workDays*10)/10 : 0,
      'عدد الزيارات':         r.visits,
      'عدد الفروع المزارة':   r.branches.size,
      'إجمالي النقاط':        r.points,
      'عدد الأصناف':          r.products,
      'عدد النواقص':          r.missing,
      'أول يوم عمل':          r.firstIn||'',
      'آخر يوم عمل':          r.lastOut||'',
    }));

    if(rows.length){
      const ws = XLSX.utils.json_to_sheet(rows);
      ws['!cols'] = Object.keys(rows[0]||{}).map(()=>({wch:20}));
      rrStyleHeader(ws, rows[0]);
      XLSX.utils.book_append_sheet(wb, ws, 'ملخص المرتبات');
    }
  }

  if(!wb.SheetNames.length){ alert('لا توجد بيانات لتصديرها'); return; }

  const level = document.getElementById('rr-level').value;
  const grp   = document.getElementById('rr-group')?.value||'all';
  const rep   = document.getElementById('rr-rep')?.value||'all';
  const from  = document.getElementById('rr-from').value;
  const to    = document.getElementById('rr-to').value;
  const scope = level==='rep'&&rep!=='all' ? rep :
                level==='group'&&grp!=='all' ? (GROUPS[grp]?.label||grp) : 'الكل';
  const fname = `تقرير_${scope}_${from||''}${to?'_'+to:''}.xlsx`;

  XLSX.writeFile(wb, fname);
  document.getElementById('rr-status').textContent =
    `✓ ${wb.SheetNames.length} شيتات · ${visits.length} زيارة · ${attendance.length} يوم حضور`;
}

// فلترة الحضور بنفس معايير التقرير
function rrGetAttendance(){
  const level = document.getElementById('rr-level').value;
  const grp   = document.getElementById('rr-group')?.value||'all';
  const route = document.getElementById('rr-route')?.value||'all';
  const rep   = document.getElementById('rr-rep')?.value||'all';
  const from  = document.getElementById('rr-from').value;
  const to    = document.getElementById('rr-to').value;

  // بناء قائمة الأسماء المسموح بها
  let allowedNames = null;
  if(level !== 'all'){
    let reps = [...(REPS||[])];
    if(grp   !== 'all') reps = reps.filter(r=>r.group===grp);
    if((level==='route'||level==='rep') && route!=='all') reps = reps.filter(r=>r.route===route);
    if(level==='rep' && rep!=='all') reps = reps.filter(r=>r.name===rep);
    allowedNames = new Set(reps.map(r=>r.name));
  }

  let out = [...(cachedData.attendance||[])];
  if(allowedNames) out = out.filter(a=>allowedNames.has(a.name||''));
  if(grp!=='all' && level==='group') out = out.filter(a=>{
    const repGrp = (REPS||[]).find(r=>r.name===a.name)?.group||'';
    return repGrp===grp;
  });

  // فلتر التاريخ — جدول attendance بيستخدم date بالعربي أحياناً
  if(from||to){
    out = out.filter(a=>{
      const d = _parseAnyDate(a.date||a.created_at||'');
      if(!d) return false;
      if(from && d < _parseAnyDate(from)) return false;
      if(to){
        const toEnd = _parseAnyDate(to); if(toEnd) toEnd.setHours(23,59,59,999);
        if(toEnd && d > toEnd) return false;
      }
      return true;
    });
  }

  // إضافة grp لكل صف (مفيد للملخص)
  out = out.map(a=>({
    ...a,
    grp: (REPS||[]).find(r=>r.name===a.name)?.group || ''
  }));

  return out;
}

