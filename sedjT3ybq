function renderLB(){
  const filterGrp=document.getElementById('lb-filter-group')?.value||'all';
  const {visits}=cachedData;
  const visible=CU.groups;
  let data=visits.filter(v=>visible.includes(v.grp||''));
  if(filterGrp!=='all') data=data.filter(v=>v.grp===filterGrp);

  const scores={},vc={},meta={};
  data.forEach(v=>{
    scores[v.name]=(scores[v.name]||0)+(+v.points||0);
    vc[v.name]=(vc[v.name]||0)+1;
    if(!meta[v.name])meta[v.name]={route:v.route||'',group:v.grp||''};
  });
  const lb=Object.entries(scores).map(([name,score])=>({name,score,visits:vc[name],...meta[name]})).sort((a,b)=>b.score-a.score);
  const max=lb[0]?.score||1;

  document.getElementById('lb-date').textContent=new Date().toLocaleDateString('en-US',{weekday:'long',year:'numeric',month:'long',day:'numeric'});

  // Top 3
  const top3=lb.slice(0,3);
  const order=[top3[1],top3[0],top3[2]].filter(Boolean);
  const pos=['lb-pos-2','lb-pos-1','lb-pos-3'],nums=['2','1','3'];
  document.getElementById('lb-top3').innerHTML=order.map((r,i)=>{
    const ini=r.name.split(' ').map(w=>w[0]).join('').slice(0,2);
    const gc=GROUPS[r.group]?.color||'#005CBF';
    return`<div class="lb-pos ${pos[i]}">
      <div class="lb-av-big" style="border-color:${pos[i]==='lb-pos-1'?'#FFD700':pos[i]==='lb-pos-2'?'#C0C0C0':'#CD7F32'};background:linear-gradient(135deg,${gc}88,${gc})">${ini}</div>
      <div class="lb-pos-name">${r.name}</div>
      <div class="lb-pos-pts">${r.score} نقطة</div>
      <div class="lb-block">${nums[i]}</div>
    </div>`;
  }).join('');

  // Rows
  const rowCls=['top1','top2','top3'];
  document.getElementById('lb-rows').innerHTML=lb.map((r,i)=>{
    const gc=GROUPS[r.group]?.color||'#005CBF';
    const ini=r.name.split(' ').map(w=>w[0]).join('').slice(0,2);
    const pct=Math.round(r.score/max*100);
    const medal=i===0?'🥇':i===1?'🥈':i===2?'🥉':'';
    return`<div class="lb-row-item ${rowCls[i]||'others'}">
      <div class="lb-rank-badge" style="background:${i<3?'transparent':'rgba(255,255,255,.05)'};color:${i===0?'#FFD700':i===1?'#C0C0C0':i===2?'#CD7F32':'rgba(255,255,255,.4)'}">${medal||i+1}</div>
      <div style="width:28px;height:28px;border-radius:6px;background:${gc}33;color:${gc};display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:700;flex-shrink:0">${ini}</div>
      <div style="flex:1;min-width:0">
        <div style="font-size:12px;font-weight:700;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${r.name}</div>
        <div style="font-size:10px;color:rgba(255,255,255,.35)">${r.route||''} · ${r.visits} زيارة</div>
      </div>
      <div class="lb-bar-bg"><div class="lb-bar-fill" style="width:${pct}%;background:${gc}"></div></div>
      <div class="lb-pts-badge" style="color:${i===0?'#FFD700':i===1?'#C0C0C0':i===2?'#CD7F32':'rgba(255,255,255,.7)'}">${r.score}</div>
    </div>`;
  }).join('');
}

