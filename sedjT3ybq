  const pct2025 = caDiscountPct(beforeIt?.value_2025, afterIt?.value_2025);
  const pct2026 = caDiscountPct(beforeIt?.value_2026, afterIt?.value_2026);

  // ملى حقول إدخال أرقام التحقيق الفعلي بآخر قيم محفوظة (لو موجودة)
  const _b25=document.getElementById('ca-sum-before25'), _a25=document.getElementById('ca-sum-after25');
