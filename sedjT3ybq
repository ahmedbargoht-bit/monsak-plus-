// HYPER SHELF — لوحة الرف الذكية
// ══════════════════════════════════════════════════════════════
async function hsLoad(){
  const grpFilter = document.getElementById('hs-grp-filter')?.value||'all';
  const from = document.getElementById('hs-from')?.value||'';
  const to   = document.getElementById('hs-to')?.value||'';

  // فحصنا البيانات الفعلية في visits/products ولقينا أسماء خطوط سير مختلفة ومش موحّدة
  // (مثال: "ثابت هايبر ماركت القاهرة" / "خط سير الهايبر ماركت الجيزة" / "الهواري ماركت+هايبر وان سفنكس" ...)
  // فالمطابقة بالاسم الحرفي كانت بتسقط جزء كبير من البيانات — الأصح اعتماد grp='hyper' (بيشمل كل فروع
  // القاهرة/الجيزة تلقائيًا مهما كان اسم الخط) + مطابقة كلمة "هايبر" لفروع اسكندرية + كلمة "كبار عملاء" لأي مجموعة
  const isHyperGrp = grp => grp === 'hyper';
  const isAlexHyper = (grp, route) => grp === 'alex' && (route||'').includes('هايبر');
  const isKeyAccounts = route => (route||'').includes('كبار عملاء');

  const isHyperRow = v => {
    const grp = v.grp||v.group||'';
    const route = v.route||'';
    return isHyperGrp(grp) || isAlexHyper(grp, route) || isKeyAccounts(route);
  };

  let visits   = (cachedData.visits||[]).filter(isHyperRow);
  let missing  = (cachedData.missing||[]).filter(isHyperRow);

  // cachedData.products محدود بآخر 500 صف بس على مستوى الشركة كلها (كل المجموعات)،
  // ومجموعات الهايبر (hyper/alex/tajmuat) بتتزاحم مع باقي المجموعات (giza/south/cairo) على نفس الـ 500 —
  // فعمليًا بيوصل لكل منسق صفوف قليلة جدًا أو صفر رغم إن الأصناف مسجلة فعلاً في القاعدة.
  // الحل: نجيب أصناف مجموعات الهايبر بس (hyper/alex/tajmuat) مباشرة من القاعدة بحد أعلى مخصص وأكبر،
  // بعيدًا عن الـ 500 العامة، ونكاش النتيجة دقيقتين عشان منضربش القاعدة كل تغيير فلتر
  if(!window._hsProductsCache || (Date.now() - (window._hsProductsCache._t||0)) > 2*60*1000){
    try{
      const H = {'apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`};
      const pr = await fetch(`${SUPABASE_URL}/rest/v1/products?grp=in.(hyper,alex,tajmuat)&select=name,route,branch,snf,fea,cat,grp,shelf_qty,stock_qty,created_at&order=created_at.desc&limit=8000`,{headers:H});
      const data = pr.ok ? await pr.json().catch(()=>[]) : [];
      data._t = Date.now();
      window._hsProductsCache = data;
    }catch(e){ window._hsProductsCache = window._hsProductsCache||[]; }
  }
  let products = (window._hsProductsCache||[]).filter(p=>{
    const grp = p.grp||p.group||'';
    const route = p.route||'';
    return isHyperGrp(grp) || isAlexHyper(grp, route) || isKeyAccounts(route);
  });

  // فلتر الفئة (هايبر القاهرة / هايبر اسكندرية / ثابت كبار عملاء)
  if(grpFilter==='cairo'){
    visits   = visits.filter(v=>isHyperGrp(v.grp||v.group||''));
    missing  = missing.filter(v=>isHyperGrp(v.grp||v.group||''));
    products = products.filter(v=>isHyperGrp(v.grp||v.group||''));
  } else if(grpFilter==='alex'){
    visits   = visits.filter(v=>isAlexHyper(v.grp||v.group||'', v.route||''));
    missing  = missing.filter(v=>isAlexHyper(v.grp||v.group||'', v.route||''));
    products = products.filter(v=>isAlexHyper(v.grp||v.group||'', v.route||''));
  } else if(grpFilter==='key_accounts'){
    visits   = visits.filter(v=>isKeyAccounts(v.route||''));
    missing  = missing.filter(v=>isKeyAccounts(v.route||''));
    products = products.filter(v=>isKeyAccounts(v.route||''));
  }

  // فلتر التاريخ
  if(from||to){
    const filt = v=>{ const d=(v.created_at||'').slice(0,10); return(!from||d>=from)&&(!to||d<=to); };
    visits=visits.filter(filt); missing=missing.filter(filt); products=products.filter(filt);
  }

  hsRenderKPI(visits, missing, products);
  hsRenderMatrix(products);
  hsRenderGauge(missing);
  hsRenderHeatmap(visits, missing);
  hsRenderShelfBars(products);
  hsRenderAging(products);
  hsRenderRepsTable(visits, missing, products);
}

function hsRenderKPI(visits, missing, products){
  const totalVisits   = visits.length;
  const totalBranches = new Set(visits.map(v=>v.branch).filter(Boolean)).size;
  const totalMissing  = missing.length;
  const totalProducts = products.length;
  const totalPoints   = visits.reduce((s,v)=>s+(+v.points||0),0);
  document.getElementById('hs-kpi').innerHTML = `
    <div class="stat-card blue"><div class="stat-n">${totalVisits}</div><div class="stat-l">زيارة هايبر</div></div>
    <div class="stat-card green"><div class="stat-n">${totalBranches}</div><div class="stat-l">فرع مزار</div></div>
    <div class="stat-card red"><div class="stat-n">${totalMissing}</div><div class="stat-l">ناقص حاد</div></div>
    <div class="stat-card purple"><div class="stat-n">${totalProducts}</div><div class="stat-l">تسجيل صنف</div></div>
    <div class="stat-card yellow"><div class="stat-n">${totalPoints}</div><div class="stat-l">إجمالي النقاط</div></div>`;
}

function hsRenderMatrix(products){
  // حساب متوسطات التواجد والسحب لكل صنف
  const snfMap = {};
  products.forEach(p=>{
    const snf = p.snf||p.fea||'غير محدد';
    if(!snfMap[snf]) snfMap[snf]={name:snf,shelf:0,stock:0,count:0};
    snfMap[snf].shelf += (+p.shelf_qty||+p.shelf||+p.sku_on||0);
    snfMap[snf].stock += (+p.stock_qty||+p.stock||+p.sku_stock||0);
    snfMap[snf].count++;
  });
  const items = Object.values(snfMap).map(s=>({
    name:s.name,
    presence: s.count>0?s.shelf/s.count:0,
    sales:    s.count>0?s.stock/s.count:0,
    count:s.count
  })).filter(s=>s.count>0);

  if(!items.length){
    ['hs-q1-items','hs-q2-items','hs-q3-items','hs-q4-items'].forEach(id=>{
      document.getElementById(id).innerHTML='<div style="font-size:10px;color:#aaa">لا توجد بيانات</div>';
    });
    return;
  }

  const avgPres = items.reduce((s,i)=>s+i.presence,0)/items.length;
  const avgSale = items.reduce((s,i)=>s+i.sales,0)/items.length;

  const q1=[],q2=[],q3=[],q4=[];
  items.forEach(i=>{
    const hiPres = i.presence>=avgPres;
    const hiSale = i.sales>=avgSale;
    if(hiPres&&hiSale) q1.push(i);
    else if(hiPres&&!hiSale) q2.push(i);
    else if(!hiPres&&hiSale) q3.push(i);
    else q4.push(i);
  });

  const renderQ = (arr, color) => arr.sort((a,b)=>b.count-a.count).slice(0,8).map(i=>`
    <div style="display:flex;align-items:center;justify-content:space-between;background:rgba(255,255,255,.05);
      border-radius:6px;padding:4px 7px;margin-bottom:3px;font-size:10px">
      <span style="color:${color};font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:1">${i.name}</span>
      <span style="font-size:9px;color:rgba(255,255,255,.5);margin-right:4px">${i.count}</span>
    </div>`).join('')||'<div style="font-size:10px;color:#aaa">—</div>';

  document.getElementById('hs-q1-items').innerHTML = renderQ(q1,'#34d399');
  document.getElementById('hs-q2-items').innerHTML = renderQ(q2,'#fb923c');
  document.getElementById('hs-q3-items').innerHTML = renderQ(q3,'#fbbf24');
  document.getElementById('hs-q4-items').innerHTML = renderQ(q4,'#9ca3af');
}

function hsRenderGauge(missing){
  const total = missing.length;
  // ملء العداد بنسبة مئوية
  const maxMissing = 100;
  const pct = Math.min(total/maxMissing, 1);
  const circumference = 408.4;
  const offset = circumference - pct*circumference;
  const gauge = document.getElementById('hs-gauge-fill');
  if(gauge){
    gauge.style.strokeDashoffset = offset;
    gauge.style.stroke = pct>0.6?'#DC2626':pct>0.3?'#F97316':'#FBBF24';
  }
  document.getElementById('hs-loss-num').textContent = total;

  // أكثر الأصناف نزيفاً
  const snfCount={};
  missing.forEach(m=>{ const s=m.snf||m.fea||'غير محدد'; snfCount[s]=(snfCount[s]||0)+1; });
  const top = Object.entries(snfCount).sort((a,b)=>b[1]-a[1]).slice(0,6);
  const maxV = top[0]?.[1]||1;
  document.getElementById('hs-bleeders').innerHTML = top.map(([name,cnt])=>`
    <div style="display:flex;align-items:center;gap:6px">
      <span style="font-size:11px;font-weight:700;flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--text1)">${name}</span>
      <span style="font-size:10px;background:#FEE2E2;color:#DC2626;padding:1px 6px;border-radius:99px;font-weight:700;flex-shrink:0">${cnt}</span>
    </div>
    <div style="background:#E5E7EB;border-radius:99px;height:3px;margin-bottom:2px">
      <div style="height:3px;border-radius:99px;background:#DC2626;width:${Math.round(cnt/maxV*100)}%"></div>
    </div>`).join('');
}

function hsRenderHeatmap(visits, missing){
  const branchVisits={}, branchMissing={};
  visits.forEach(v=>{ if(v.branch) branchVisits[v.branch]=(branchVisits[v.branch]||0)+1; });
  missing.forEach(m=>{ if(m.branch) branchMissing[m.branch]=(branchMissing[m.branch]||0)+1; });
  const allBranches=[...new Set([...Object.keys(branchVisits),...Object.keys(branchMissing)])].sort();

  if(!allBranches.length){
    document.getElementById('hs-heatmap').innerHTML='<div style="color:var(--text2);font-size:12px">لا توجد بيانات</div>';
    return;
  }

  document.getElementById('hs-heatmap').innerHTML = allBranches.map(b=>{
    const miss=branchMissing[b]||0;
    const vis=branchVisits[b]||0;
    let bg,border,icon,status;
    if(miss===0&&vis>0){ bg='#052e16';border='#16a34a';icon='✅';status='مثالي'; }
    else if(miss>5){
      bg='#450a0a';border='#dc2626';icon='🔴';status=`${miss} ناقص`;
    } else if(miss>0){
      bg='#431407';border='#f59e0b';icon='🟠';status=`${miss} ناقص`;
    } else {
      bg='#111827';border='#374151';icon='⚫';status='لم يُزر';
    }
    const isAlarm = miss>5;
    return`<div style="background:${bg};border:1.5px solid ${border};border-radius:10px;padding:8px 10px;
      min-width:130px;max-width:180px;cursor:default;${isAlarm?'animation:hsPulse 1.5s infinite;':''}"
      title="${b}">
      <div style="font-size:12px;margin-bottom:3px">${icon}</div>
      <div style="font-size:10px;font-weight:700;color:#fff;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${b}</div>
      <div style="font-size:9px;color:${border};margin-top:2px;font-weight:600">${status}</div>
      ${vis?`<div style="font-size:9px;color:rgba(255,255,255,.4);margin-top:1px">${vis} زيارة</div>`:''}
    </div>`;
  }).join('');
}

function hsRenderShelfBars(products){
  const snfMap={};
  products.forEach(p=>{
    const snf=p.snf||p.fea||'غير محدد';
    if(!snfMap[snf])snfMap[snf]={shelf:0,stock:0,count:0};
    snfMap[snf].shelf+=(+p.shelf_qty||+p.sku_on||0);
    snfMap[snf].stock+=(+p.stock_qty||+p.sku_stock||0);
    snfMap[snf].count++;
  });
  const items=Object.entries(snfMap).sort((a,b)=>(b[1].shelf+b[1].stock)-(a[1].shelf+a[1].stock)).slice(0,8);
  if(!items.length){document.getElementById('hs-shelf-bars').innerHTML='<div style="color:var(--text2);font-size:12px">لا توجد بيانات</div>';return;}
  const maxVal=Math.max(...items.map(([,v])=>v.shelf+v.stock),1);
  document.getElementById('hs-shelf-bars').innerHTML=items.map(([name,v])=>{
    const total=v.shelf+v.stock||1;
    const shelfPct=Math.round(v.shelf/total*100);
    const stockPct=100-shelfPct;
    const barW=Math.round((total/maxVal)*100);
    return`<div style="margin-bottom:6px">
      <div style="display:flex;justify-content:space-between;font-size:10px;margin-bottom:3px">
        <span style="font-weight:600;color:var(--text1);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:140px">${name}</span>
        <span style="color:var(--text2);flex-shrink:0">${v.shelf} رف / ${v.stock} مخزن</span>
      </div>
      <div style="background:#E5E7EB;border-radius:99px;height:8px;overflow:hidden;width:${barW}%">
        <div style="height:8px;display:flex">
          <div style="background:#2563EB;width:${shelfPct}%;border-radius:99px 0 0 99px"></div>
          <div style="background:#7C3AED;width:${stockPct}%;border-radius:0 99px 99px 0"></div>
        </div>
      </div>
    </div>`;
  }).join('');
}

function hsRenderAging(products){
  // نفلتر المنتجات اللي بالقرب من الصلاحية (3 شهور أو أقل)
  const today=new Date();
  const aged={30:[],60:[],90:[]};
  products.forEach(p=>{
    if(!p.date_shelf&&!p.months_shelf) return;
    try{
      const mStr=p.date_shelf||'';
      const months=+(p.months_shelf||p.date_stock||0);
      if(!mStr&&!months) return;
      // نحسب من created_at + months
      const prodDate=new Date(p.created_at||today);
      const expDate=new Date(prodDate);
      expDate.setMonth(expDate.getMonth()+(months||3));
      const diffDays=Math.round((expDate-today)/(1000*86400));
      const snf=p.snf||p.fea||'غير محدد';
      if(diffDays<=30&&diffDays>=0) aged[30].push({snf,diffDays,branch:p.branch||'—'});
      else if(diffDays<=60&&diffDays>30) aged[60].push({snf,diffDays,branch:p.branch||'—'});
      else if(diffDays<=90&&diffDays>60) aged[90].push({snf,diffDays,branch:p.branch||'—'});
    }catch(e){}
  });
  document.getElementById('hs-age-30').textContent=aged[30].length;
  document.getElementById('hs-age-60').textContent=aged[60].length;
  document.getElementById('hs-age-90').textContent=aged[90].length;
  const allAged=[...aged[30].map(i=>({...i,zone:30})),...aged[60].map(i=>({...i,zone:60})),...aged[90].map(i=>({...i,zone:90}))];
  document.getElementById('hs-aging-list').innerHTML=allAged.slice(0,20).map(i=>{
    const color=i.zone<=30?'#f87171':i.zone<=60?'#fbbf24':'#34d399';
    const bg=i.zone<=30?'#450a0a':i.zone<=60?'#422006':'#052e16';
    return`<div style="background:${bg};border-radius:7px;padding:5px 8px;display:flex;align-items:center;justify-content:space-between">
      <span style="font-size:10px;color:#fff;font-weight:600;flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${i.snf}</span>
      <span style="font-size:9px;color:rgba(255,255,255,.5);margin:0 6px">${i.branch}</span>
      <span style="font-size:9px;font-weight:700;color:${color};flex-shrink:0">${i.diffDays} يوم</span>
    </div>`;
  }).join('')||'<div style="font-size:11px;color:var(--text2)">لا توجد منتجات قريبة الصلاحية</div>';
}

function hsRenderRepsTable(visits, missing, products){
  const repMap={};
  const visitsByRep={}; // اسم المنسق → كل تواريخ/فروع زياراته (نستخدمها بعدين لتحديد آخر 3 زيارات لنفس الفرع)
  visits.forEach(v=>{
    if(!v.name)return;
    if(!repMap[v.name])repMap[v.name]={name:v.name,branch:v.branch||'—',lastVisit:v.created_at||'',visits:0,skuSet:new Set(),points:0,missing:0,dead:0};
    repMap[v.name].visits++;
    repMap[v.name].points+=(+v.points||0);
    if(v.created_at>repMap[v.name].lastVisit){repMap[v.name].lastVisit=v.created_at;repMap[v.name].branch=v.branch||repMap[v.name].branch;}
    if(!visitsByRep[v.name]) visitsByRep[v.name]=[];
    visitsByRep[v.name].push({date:(v.created_at||'').slice(0,10), branch:v.branch||''});
  });
  missing.forEach(m=>{ if(repMap[m.name]) repMap[m.name].missing++; });

  // أصناف الرف = أصناف الفرع الحالي بس، من تقرير آخر 3 زيارات فعلية لنفس الفرع —
  // لو نفس الصنف اتسجل في أكتر من زيارة من التلاتة، بيتحسب مرة واحدة بس (Set بيمنع التكرار تلقائيًا)
  Object.values(repMap).forEach(r=>{
    const rVisits = (visitsByRep[r.name]||[])
      .filter(v=>v.branch===r.branch)
      .sort((a,b)=>b.date.localeCompare(a.date));
    const last3Dates = new Set();
    for(const v of rVisits){ if(last3Dates.size>=3) break; last3Dates.add(v.date); }
    r._last3Dates = last3Dates;
  });
  (products||[]).forEach(p=>{
    if(!p.name || !repMap[p.name]) return;
    const r = repMap[p.name];
    const pDate = (p.created_at||'').slice(0,10);
    if(!r._last3Dates.has(pDate)) return;
    const snf = p.snf||p.fea;
    if(snf) r.skuSet.add(snf);
  });
  const rows=Object.values(repMap).map(r=>({...r, sku:r.skuSet.size})).sort((a,b)=>b.visits-a.visits);
  document.getElementById('hs-reps-table').innerHTML=rows.map(r=>{
    const lastV=r.lastVisit?(r.lastVisit).slice(0,10):'—';
    const status=r.missing>5?'<span class="badge b-red">خطر</span>':r.missing>0?'<span class="badge b-orange">تنبيه</span>':'<span class="badge b-green">مثالي</span>';
    return`<tr>
      <td><b style="cursor:pointer;color:var(--blue)" onclick="locQuickDetail('${r.name.replace(/'/g,'&#39;')}')">${r.name}</b></td>
      <td style="font-size:11px">${r.branch}</td>
      <td style="font-size:11px">${lastV}</td>
      <td style="text-align:center"><span class="badge b-blue">${r.sku}</span></td>
      <td style="text-align:center"><span class="badge ${r.missing>0?'b-red':'b-green'}">${r.missing}</span></td>
      <td style="text-align:center"><span class="badge b-gray">${r.dead}</span></td>
      <td style="text-align:center"><span class="badge b-purple">${r.points}</span></td>
      <td>${status}</td>
    </tr>`;
  }).join('')||'<tr><td colspan="8" style="text-align:center;padding:1rem;color:var(--text2)">لا توجد بيانات</td></tr>';
}

function rdExport(){
  const name=window._rdRepName||'منسق';
  const {visits,products,missing,orders,attend}=window._rdAllData||{visits:[],products:[],missing:[],orders:[],attend:[]};
  const wb=XLSX.utils.book_new();

  // شيت الزيارات
  if(visits.length){
    const rows=visits.map(v=>({
      'التاريخ':v.date||(v.created_at||'').slice(0,10),
      'الفرع':v.branch||'',
      'خط السير':v.route||'',
      'دخول':v.time_in||'',
      'خروج':v.time_out||'',
      'SKU رف':v.sku_on||0,
      'SKU مخزن':v.sku_stock||0,
      'نواقص':v.missing_count||0,
      'نوع العرض':v.display_type||v.client_type||'',
      'النقاط':v.points||0
    }));
    XLSX.utils.book_append_sheet(wb,XLSX.utils.json_to_sheet(rows),'الزيارات');
  }
  // شيت الأصناف
  if(products.length){
    const rows=products.map(p=>({
      'التاريخ':(p.created_at||'').slice(0,10),
      'الفرع':p.branch||'',
      'الصنف':p.snf||p.fea||'',
      'الفئة':p.cat||'',
      'رف':p.shelf_qty??p.sku_on??'',
      'مخزن':p.stock_qty??p.sku_stock??'',
      'صلاحية رف':p.date_shelf||'',
      'صلاحية مخزن':p.date_stock||''
    }));
    XLSX.utils.book_append_sheet(wb,XLSX.utils.json_to_sheet(rows),'الأصناف');
  }
  // شيت النواقص
  if(missing.length){
    const rows=missing.map(m=>({
      'التاريخ':(m.created_at||'').slice(0,10),
      'الفرع':m.branch||'',
      'الصنف':m.snf||m.fea||'',
      'الفئة':m.cat||'',
      'السبب':m.reason||'',
      'ملاحظة':m.note||''
    }));
    XLSX.utils.book_append_sheet(wb,XLSX.utils.json_to_sheet(rows),'النواقص');
  }
  if(!wb.SheetNames.length){
    XLSX.utils.book_append_sheet(wb,XLSX.utils.json_to_sheet([{ملاحظة:'لا توجد بيانات'}]),'بيانات');
  }
  XLSX.writeFile(wb,`تفاصيل_${name}_${new Date().toLocaleDateString('en-US').replace(/\//g,'-')}.xlsx`);
}

