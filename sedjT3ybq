const ADMIN_PASS = 'admin2026'; // غيّر الباسورد من هنا

async function changeAdminPassword(){
  const current  = document.getElementById('pass-current').value.trim();
  const newPass  = document.getElementById('pass-new').value.trim();
  const confirm  = document.getElementById('pass-confirm').value.trim();
  const msg      = document.getElementById('pass-msg');

  const show = (text, color) => {
    msg.textContent = text;
    msg.style.color = color;
    msg.style.display = 'block';
  };

  if(!current || !newPass || !confirm){ show('❌ أكمل كل الحقول', '#B71C1C'); return; }
  if(newPass !== confirm){ show('❌ الباسورد الجديد مش متطابق', '#B71C1C'); return; }
  if(newPass.length < 4){ show('❌ الباسورد لازم يكون 4 أحرف على الأقل', '#B71C1C'); return; }

  // تحقق من الباسورد الحالي
  let adminPass = ADMIN_PASS;
  try{
    const data = await sb('users',{name:'admin',role:'admin'});
    if(data && data[0]) adminPass = data[0].pass_hash || ADMIN_PASS;
  }catch(e){}

  if(current !== adminPass){ show('❌ الباسورد الحالي غلط', '#B71C1C'); return; }

  show('⏳ جاري الحفظ...', '#F77F00');
  try{
    // حدّث في Supabase
    const existing = await sb('users',{name:'admin',role:'admin'});
    if(existing && existing[0]){
      await fetch(`${SUPABASE_URL}/rest/v1/users?name=eq.admin&role=eq.admin`,{
