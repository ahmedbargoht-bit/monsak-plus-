// تهيئة panel الزيارات
async function vInitPanel(){
  const today = localISO();
  const firstOfMonth = today.slice(0,8)+'01';
  const f = document.getElementById('v-from');
  const t = document.getElementById('v-to');
  if(f && !f.value) f.value = firstOfMonth;
  if(t && !t.value) t.value = today;

  // جلب أسماء المنسقين من Supabase لو مش موجودين في cache
  const sel = document.getElementById('v-rep');
  if(sel && sel.options.length <= 1){
    try{
      const H = {'apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`};
      const grps = CU.level==='gm' ? ['giza','cairo','south','tajmuat','hyper','alex'] : (CU.groups||[]);
      // PostgREST or() syntax: grp.eq.giza,grp.eq.cairo,...
      const grpFilter = grps.map(g=>`grp.eq.${g}`).join(',');
      const url = `${SUPABASE_URL}/rest/v1/users?role=eq.rep&or=(${grpFilter})&select=name,grp&order=name.asc&limit=500`;
      const data = await fetch(url,{headers:H}).then(r=>r.json()).catch(()=>[]);
      if(Array.isArray(data) && data.length){
        // حفظ للاستخدام في vOnGrpChange
        window._vAllReps = data;
        vOnGrpChange();
      }
    }catch(e){ console.warn('vInitPanel:', e); }
  }
}

// تعبئة قائمة المنسقين عند تغيير المجموعة
function vOnGrpChange(){
  const grp = document.getElementById('v-group').value;
  const sel = document.getElementById('v-rep');
  sel.innerHTML = '<option value="all">كل المنسقين</option>';

  // جيب الأسماء من _vAllReps (مجلوبة من Supabase) أو من cachedData.visits
  let names = [];

  if(window._vAllReps && window._vAllReps.length){
    let reps = window._vAllReps;
    if(grp !== 'all') reps = reps.filter(r=>r.grp===grp);
    names = [...new Set(reps.map(r=>r.name).filter(Boolean))];
  } else {
    let reps = (cachedData.visits||[]);
    if(grp !== 'all') reps = reps.filter(v=>v.grp===grp);
    names = [...new Set(reps.map(v=>v.name).filter(Boolean))];
  }

  names.sort().forEach(n=>{
    const o = document.createElement('option');
    o.value = n; o.textContent = n;
    sel.appendChild(o);
  });
}

// حساب ساعات العمل من time_in و time_out
function vCalcMinutes(timeIn, timeOut){
  if(!timeIn || !timeOut) return 0;
  try{
    const [h1,m1] = timeIn.split(':').map(Number);
    const [h2,m2] = timeOut.split(':').map(Number);
    const mins = (h2*60+m2) - (h1*60+m1);
    return mins > 0 ? mins : 0;
  }catch(e){ return 0; }
}

function loadVisits(){
  const from   = document.getElementById('v-from').value;
  const to     = document.getElementById('v-to').value;
  const grp    = document.getElementById('v-group').value;
  const rep    = document.getElementById('v-rep').value;

  let data = cachedData.visits.filter(v=>CU.groups.includes(v.grp||''));

  // فلتر التاريخ — البيانات محفوظة بالعربي نقارن بـ created_at ISO
  if(from || to){
    data = data.filter(v=>{
      const iso = (v.created_at||'').slice(0,10);
      if(from && iso < from) return false;
      if(to   && iso > to)   return false;
      return true;
    });
  }

  if(grp !== 'all') data = data.filter(v=>v.grp===grp);
  if(rep !== 'all') data = data.filter(v=>v.name===rep);

  // ── ملخص الأداء ──
  const totalVisits   = data.length;
  const uniqueBranches = new Set(data.map(v=>v.branch).filter(Boolean)).size;
  const totalMins     = data.reduce((s,v)=>s+vCalcMinutes(v.time_in,v.time_out),0);
  const totalHours    = (totalMins/60).toFixed(1);
  const avgMins       = totalVisits>0 ? Math.round(totalMins/totalVisits) : 0;

  const sumDiv = document.getElementById('v-summary');
  if(totalVisits > 0){
    sumDiv.style.display = 'block';
    document.getElementById('v-sum-visits').textContent = totalVisits;
    document.getElementById('v-sum-hours').textContent  = totalHours;
    document.getElementById('v-sum-avg').textContent    = avgMins;

    // ── فروع تم زيارتها / إجمالي فروع الفلتر المختار ──
    const selGrp = document.getElementById('v-group').value;
    const { SALES_ROUTES_DATA } = window;
    let totalBranchesInFilter = 0;
    if(typeof SALES_ROUTES_DATA !== 'undefined'){
      const routesForGrp = selGrp==='all'
        ? SALES_ROUTES_DATA
        : SALES_ROUTES_DATA.filter(r=>r.grp===selGrp);
      totalBranchesInFilter = routesForGrp.reduce((s,r)=>s+r.branches.length, 0);
    }
    const branchPct = totalBranchesInFilter>0 ? Math.round(uniqueBranches/totalBranchesInFilter*100) : 0;
    document.getElementById('v-sum-visited-branches').textContent = uniqueBranches;
    document.getElementById('v-sum-total-branches').textContent   = totalBranchesInFilter||'—';
    document.getElementById('v-sum-branch-pct-fill').style.width  = Math.min(branchPct,100)+'%';
    document.getElementById('v-sum-branch-pct').textContent       = branchPct+'%';

    // ── أكثر المنسقين زيارات (top 5) ──
    const repMap = {};
    data.forEach(v=>{ repMap[v.name]=(repMap[v.name]||0)+1; });
    const topReps = Object.entries(repMap).sort((a,b)=>b[1]-a[1]).slice(0,5);
    const maxRep  = topReps[0]?.[1]||1;
    const medals  = ['🥇','🥈','🥉','4️⃣','5️⃣'];
    document.getElementById('v-top-reps').innerHTML = topReps.map(([name,cnt],i)=>`
      <div style="display:flex;align-items:center;gap:6px">
        <span style="font-size:12px">${medals[i]||''}</span>
        <span style="font-size:11px;font-weight:700;flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${name}</span>
        <span style="font-size:10px;background:#EEF6FF;color:#1D4ED8;padding:1px 6px;border-radius:99px;font-weight:700">${cnt}</span>
        <div style="width:40px;background:#E5E7EB;border-radius:99px;height:4px">
          <div style="height:4px;border-radius:99px;background:#1D4ED8;width:${Math.round(cnt/maxRep*100)}%"></div>
        </div>
      </div>`).join('');

    // ── الفروع التي سُجّل فيها لوكيشن ──
    const visitedBranches = [...new Set(data.map(v=>v.branch).filter(Boolean))];
    const locData = cachedData.location||[];
    const branchesWithLoc = visitedBranches.filter(b=>{
      // نبحث في location إذا فيه منسق زار هذا الفرع ومعه lat/lng
      return data.some(v=>v.branch===b && v.lat && v.lng);
    });
    // بديل: نحسب الزيارات اللي عندها lat/lng
    const visitsWithLoc = data.filter(v=>v.lat&&v.lng);
    const branchesWithLocSet = new Set(visitsWithLoc.map(v=>v.branch).filter(Boolean));
    const locBranchCount = branchesWithLocSet.size;
    const locPct = uniqueBranches>0 ? Math.round(locBranchCount/uniqueBranches*100) : 0;
    document.getElementById('v-loc-branches').textContent       = locBranchCount;
    document.getElementById('v-loc-branches-total').textContent = uniqueBranches;
    document.getElementById('v-loc-pct-fill').style.width       = Math.min(locPct,100)+'%';
    document.getElementById('v-loc-pct').textContent            = locPct+'%';

    // ── التقارير الصحيحة ──
    // تقرير صحيح = فيه فرع + منسق + وقت حضور + صنف واحد على الأقل (sku_on > 0)
    const validReports = data.filter(v=>v.branch&&v.name&&v.time_in&&(+v.sku_on||0)>0).length;
    const validPct     = totalVisits>0 ? Math.round(validReports/totalVisits*100) : 0;
    document.getElementById('v-valid-reports').textContent  = validReports;
    document.getElementById('v-total-reports').textContent  = totalVisits;
    document.getElementById('v-valid-pct-fill').style.width = Math.min(validPct,100)+'%';
    document.getElementById('v-valid-pct').textContent      = validPct+'%';

  } else {
    sumDiv.style.display = 'none';
  }

  // ── تجميع الزيارات: منسق + يوم = صف واحد ──
  const dayMap = {};
  data.forEach(v=>{
    const isoDate = (v.created_at||'').slice(0,10) || v.date || '';
    const key = (v.name||'') + '||' + isoDate;
    if(!dayMap[key]){
      dayMap[key]={
        name:v.name, grp:v.grp, date:isoDate,
        skuOn:0, missingCount:0, spaceUsed:0, spaceTotal:0, points:0,
        branches:new Set(), ids:[]
      };
    }
    const r = dayMap[key];
    r.skuOn       += (+v.sku_on||0);
    r.missingCount+= (+v.missing_count||0);
    r.spaceUsed   += (+v.space_used||0);
    r.spaceTotal  += (+v.space_total||0);
    r.points      += (+v.points||0);
    if(v.branch) r.branches.add(v.branch);
    r.ids.push(v.id);
  });

  // ── جيب attendance لنفس الفترة ──
  const attData = (cachedData.attendance||[]).filter(a=>{
    const d = (a.date||'').slice(0,10);
    if(from && d < from) return false;
    if(to   && d > to)   return false;
    if(grp !== 'all' && a.grp !== grp) return false;
    if(rep !== 'all' && a.name !== rep) return false;
    return true;
  });

  // بناء map: name+date → {first_in, last_out}
  const attMap = {};
  attData.forEach(a=>{
    const d   = (a.date||'').slice(0,10);
    const key = (a.name||'') + '||' + d;
    if(!attMap[key]) attMap[key] = {timeIn:null, timeOut:null};
    const t = a.time_in || a.time || '';
    if(t){
      if(!attMap[key].timeIn || t < attMap[key].timeIn) attMap[key].timeIn = t;
    }
    const to2 = a.time_out || '';
    if(to2){
      if(!attMap[key].timeOut || to2 > attMap[key].timeOut) attMap[key].timeOut = to2;
    }
  });

  const rows = Object.values(dayMap).sort((a,b)=> b.date.localeCompare(a.date) || a.name.localeCompare(b.name));

  document.getElementById('visits-table').innerHTML = rows.map((r,i)=>{
    const att     = attMap[r.name+'||'+r.date] || {};
    const timeIn  = att.timeIn  || '—';
    const timeOut = att.timeOut || '—';
    const gc      = GROUPS[r.grp]?.color||'#ccc';
    const branchesList = [...r.branches].join('، ') || '—';
    const inBadge     = timeIn!=='—'
      ? `<span style="font-size:11px;background:#E8F5E9;color:#1B5E20;padding:2px 8px;border-radius:6px;font-weight:600">${timeIn}</span>`
      : `<span style="color:#bbb;font-size:11px">—</span>`;
    const outBadge    = timeOut!=='—'
      ? `<span style="font-size:11px;background:#FFEBEE;color:#B71C1C;padding:2px 8px;border-radius:6px;font-weight:600">${timeOut}</span>`
      : `<span style="color:#bbb;font-size:11px">—</span>`;
    return`<tr>
      <td>${i+1}</td>
      <td><b>${r.name}</b></td>
      <td><span class="badge" style="background:${gc}22;color:${gc}">${GROUPS[r.grp]?.label||r.grp}</span></td>
      <td>${fmtDate(r.date)||r.date||'—'}</td>
      <td style="font-size:11px;max-width:260px">${branchesList}</td>
      <td>${inBadge}</td>
      <td>${outBadge}</td>
      <td><button onclick="deleteVisitDayFull('${r.name.replace(/'/g,"\\'")}','${r.date}',${JSON.stringify(r.ids)})" style="background:#FFEBEE;color:#B71C1C;border:none;border-radius:6px;padding:3px 8px;cursor:pointer;font-size:12px" title="حذف كامل لكل بيانات هذا المنسق في هذا اليوم من جميع النظام">🗑</button></td>
    </tr>`;
  }).join('') || '<tr><td colspan="8" style="text-align:center;padding:1rem;color:var(--text2)">لا توجد زيارات</td></tr>';
}

// حذف كامل لكل بيانات منسق معيّن في يوم معيّن من كل النظام — مش بس جدول الزيارات.
// بيمسح من 6 جداول مع بعض: visits, attendance, products, missing, returns, checkout_exceptions
// (كلها بتتسجل بالاسم + التاريخ/created_at من تطبيق المنسق). عملية نهائية ومفيهاش تراجع.
async function deleteVisitDayFull(name, isoDate, visitIds){
  if(!name || !isoDate) return;
  const confirmMsg = `⚠️ حذف نهائي شامل\n\nهيتم حذف كل بيانات "${name}" ليوم ${isoDate} من كل النظام:\n`+
    `الزيارات، الحضور والانصراف، سجل الأصناف، النواقص، المرتجع، طلبات استثناء الانصراف.\n\n`+
    `العملية دي نهائية ومفيهاش تراجع. متأكد؟`;
  if(!confirm(confirmMsg)) return;

  const H = {'apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`};
  const encName = encodeURIComponent(name);
  const dayStart = `${isoDate}T00:00:00`;
  const dayEnd   = `${isoDate}T23:59:59`;

  try{
    const results = await Promise.all([
      // visits — بالـ id المحدد سلفاً (أدق من فلتر تاريخ عام)
      ...(visitIds||[]).map(id=>fetch(`${SUPABASE_URL}/rest/v1/visits?id=eq.${id}`,{method:'DELETE',headers:H})),
      // attendance — بالاسم + التاريخ (حقل date مباشر)
      fetch(`${SUPABASE_URL}/rest/v1/attendance?name=eq.${encName}&date=eq.${isoDate}`,{method:'DELETE',headers:H}),
      // products / missing / returns — بالاسم + مدى created_at لنفس اليوم
      fetch(`${SUPABASE_URL}/rest/v1/products?name=eq.${encName}&created_at=gte.${dayStart}&created_at=lte.${dayEnd}`,{method:'DELETE',headers:H}),
      fetch(`${SUPABASE_URL}/rest/v1/missing?name=eq.${encName}&created_at=gte.${dayStart}&created_at=lte.${dayEnd}`,{method:'DELETE',headers:H}),
      fetch(`${SUPABASE_URL}/rest/v1/returns?name=eq.${encName}&created_at=gte.${dayStart}&created_at=lte.${dayEnd}`,{method:'DELETE',headers:H}),
      // checkout_exceptions — بالاسم (rep_name) + مدى created_at لنفس اليوم
      fetch(`${SUPABASE_URL}/rest/v1/checkout_exceptions?rep_name=eq.${encName}&created_at=gte.${dayStart}&created_at=lte.${dayEnd}`,{method:'DELETE',headers:H}),
    ]);
    const failed = results.filter(r=>!r.ok);
    if(failed.length){ showToast(`⚠️ تم الحذف جزئياً — ${failed.length} جدول فشل`); }
    else{ showToast('✅ تم الحذف الكامل لبيانات هذا اليوم'); }
  }catch(e){
    showToast('❌ خطأ أثناء الحذف: '+e.message);
  }
  refreshData();
  setTimeout(loadVisits,1000);
}

