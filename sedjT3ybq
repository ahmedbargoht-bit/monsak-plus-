      const actual=Math.round(sales[r.name]||0);
      const pct=goal>0?Math.round(actual/goal*100):0;
      const daily=goal>0&&workDays>0?Math.round(goal/workDays):0;
      const clr=pct>=80?'#276749':pct>=60?'#854F0B':'#B91C1C';
