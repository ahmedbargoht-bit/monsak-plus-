// Step 1 → 2 : اختر مشرف → أظهر كل مناديبه وخطوطهم مرة واحدة
async function sgModalLoadReps(){
  const supName   = document.getElementById('sg-modal-sup').value;
  const area      = document.getElementById('sg-modal-reps-area');
  const empty     = document.getElementById('sg-modal-empty');
  const saveBtn   = document.getElementById('sg-modal-save-btn');
  const tbody     = document.getElementById('sg-modal-reps-tbody');

  area.style.display    = 'none';
  empty.style.display   = 'none';
  saveBtn.style.display = 'none';
  tbody.innerHTML       = '';
  if(!supName) return;

  const norm = s => (s||'').trim().replace(/\s+/g,' ');
  const repsList = (_sgData.reps||[]).filter(r => {
    const rSup = norm(r.supervisors);
    const sName = norm(supName);
    return rSup === sName || rSup.startsWith(sName) || sName.startsWith(rSup);
  });
  if(!repsList.length){ empty.style.display='block'; return; }

  // جيب توزيع الخطوط المحفوظ لكل المناديب مرة واحدة (بدل ما نجيبه لكل مندوب لوحده)
  const modalMonth = document.getElementById('sg-modal-month')?.value || document.getElementById('sg-month')?.value || '';
  let allGoals = {};
  try{
    const BASE_H2 = {'apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`};
    const r = await fetch(`${SUPABASE_URL}/rest/v1/products_db?key=eq.sg_route_goals&select=value`,{headers:BASE_H2});
    const rows = await r.json();
    if(rows.length) allGoals = JSON.parse(rows[0].value||'{}');
  }catch(e){ allGoals = {}; }

  let html = '';
  repsList.forEach(rep=>{
    // خطوط السير
    let routes = [];
    if(Array.isArray(rep.routes) && rep.routes.length){
      routes = [...rep.routes];
    } else if(rep.route && rep.route.trim()){
      routes = [rep.route.trim()];
    } else if(rep.grp && rep.grp.trim()){
      routes = [rep.grp.trim()];
    }
    if(!routes.length) routes = ['بدون خط سير'];

    const cacheKey = rep.name + '|' + modalMonth;
    const savedRouteGoals = allGoals[cacheKey] || {};
    const curTotal = _sgData.targets[rep.name]?.goal || 0;
    const hasSaved = Object.keys(savedRouteGoals).length > 0;

    html += `<tr style="background:#EFE6D8">
      <td colspan="2" style="padding:8px 12px;font-weight:800;font-size:12px;color:#3B1F12">👤 ${rep.name}</td>
    </tr>`;
    routes.forEach(route=>{
      const val = hasSaved
        ? (savedRouteGoals[route] || 0)
        : (routes.length === 1 ? curTotal : 0);
      html += `<tr style="border-bottom:0.5px solid var(--border,#eee)">
        <td style="padding:9px 12px 9px 24px;font-weight:600;font-size:12px;color:var(--text-primary,#222)">${route}</td>
        <td style="padding:9px 10px;text-align:center">
          <input type="number" class="sg-modal-route-inp"
            data-rep-name="${rep.name}"
            data-rep-id="${rep.id}"
            data-route="${route}"
            value="${val}" min="0" step="1000"
            oninput="sgModalCalcTotal()"
            style="width:130px;padding:6px 8px;border:1.5px solid var(--border-strong,#ccc);border-radius:6px;font-size:13px;font-weight:700;font-family:Cairo,sans-serif;text-align:center;background:var(--surface-2,#fff);color:var(--text-primary,#222)"/>
        </td>
      </tr>`;
    });
  });

  tbody.innerHTML = html;
  area.style.display    = 'block';
  saveBtn.style.display = 'inline-flex';
  sgModalCalcTotal();
}

function sgModalCalcTotal(){
  let total = 0;
  document.querySelectorAll('.sg-modal-route-inp').forEach(inp=>{ total += parseInt(inp.value)||0; });
  const el = document.getElementById('sg-modal-total');
  if(el) el.textContent = total.toLocaleString('en-US');
}

async function sgModalSave(){
  const BASE_H = {'apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`,'Content-Type':'application/json','Prefer':'return=minimal'};
  const modalMonth = document.getElementById('sg-modal-month')?.value || document.getElementById('sg-month')?.value;
  if(!modalMonth){ showToast('اختر الشهر أولاً'); return; }
  const [yr,mo]  = modalMonth.split('-').map(Number);
  const supName  = document.getElementById('sg-modal-sup').value;
  const inputs   = document.querySelectorAll('.sg-modal-route-inp');
  if(!inputs.length){ showToast('لا يوجد خطوط سير'); return; }

  // جمع كل الخطوط لنفس المندوب → هدف واحد إجمالي + حفظ تفاصيل الخطوط
  const repGoalMap = {}; // repName → {repId, totalGoal, routes:{routeName:goal}}
  inputs.forEach(inp=>{
    const name  = inp.dataset.repName;
    const repId = parseInt(inp.dataset.repId)||null;
    const route = inp.dataset.route||'';
    const goal  = parseInt(inp.value)||0;
    if(!repGoalMap[name]) repGoalMap[name] = {repId, totalGoal:0, routes:{}};
    repGoalMap[name].totalGoal += goal;
    repGoalMap[name].routes[route] = goal;
  });

  const toInsert = [];
  const toUpdate = [];
  Object.entries(repGoalMap).forEach(([name, {repId, totalGoal}])=>{
    const tgtId = _sgData.targets[name]?.id;
    if(tgtId){
      toUpdate.push({ tgtId, goal:totalGoal });
    } else {
      const wdM = parseInt(document.getElementById('sg-workdays-sel')?.value)||26;
      toInsert.push({ rep_name:name, month:`${yr}-${String(mo).padStart(2,'0')}`, target_amount:totalGoal, supervisor_name:supName, work_days:wdM });
    }
    if(!_sgData.targets[name]) _sgData.targets[name]={rep_name:name,goal:0};
    _sgData.targets[name].goal = totalGoal;
  });

  const saveBtn = document.getElementById('sg-modal-save-btn');
  saveBtn.disabled = true;
  saveBtn.innerHTML = '<i class="ti ti-loader-2"></i> جاري الحفظ...';

  try{
    let ok = true;
    if(toInsert.length){
      const res = await fetch(`${SUPABASE_URL}/rest/v1/rep_targets`,{method:'POST',headers:BASE_H,body:JSON.stringify(toInsert)});
      if(!res.ok && res.status!==201 && res.status!==204){ const e=await res.text(); showToast('❌ خطأ إضافة: '+e.substring(0,80)); ok=false; }
    }
    for(const u of toUpdate){
      const res = await fetch(`${SUPABASE_URL}/rest/v1/rep_targets?id=eq.${u.tgtId}`,{method:'PATCH',headers:BASE_H,body:JSON.stringify({target_amount:u.goal})});
      if(!res.ok && res.status!==204){ const e=await res.text(); showToast('❌ خطأ تحديث: '+e.substring(0,80)); ok=false; }
    }
    if(ok){
      // حفظ تفاصيل توزيع الخطوط في products_db
      try{
        const BASE_H3 = {'apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`,'Content-Type':'application/json','Prefer':'return=minimal'};
        const rFetch = await fetch(`${SUPABASE_URL}/rest/v1/products_db?key=eq.sg_route_goals&select=value`,{headers:{'apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`}});
        const rows = await rFetch.json();
        let allGoals = {};
        if(rows.length) allGoals = JSON.parse(rows[0].value||'{}');
        Object.entries(repGoalMap).forEach(([name,{routes}])=>{
          const cKey = name+'|'+`${yr}-${String(mo).padStart(2,'0')}`;
          allGoals[cKey] = routes;
        });
        const payload = JSON.stringify({key:'sg_route_goals', value:JSON.stringify(allGoals)});
        if(rows.length){
          await fetch(`${SUPABASE_URL}/rest/v1/products_db?key=eq.sg_route_goals`,{method:'PATCH',headers:BASE_H3,body:JSON.stringify({value:JSON.stringify(allGoals)})});
        } else {
          await fetch(`${SUPABASE_URL}/rest/v1/products_db`,{method:'POST',headers:BASE_H3,body:payload});
        }
      }catch(e2){ console.warn('route goals cache save failed',e2); }

      showToast(`✅ تم حفظ أهداف ${Object.keys(repGoalMap).length} مندوب بنجاح`);
      sgCloseAddGoals();
      // لازم sgLoad (مش sgRender) عشان يجيب الـ id الحقيقي للصفوف اللي اتضافت لتوها من الداتابيز
      // من غيره لو المستخدم فتح المودال تاني وحفظ، هيعتبرها هدف جديد ويضيف صف مكرر بدل ما يعدّل الموجود
      sgLoad();
    }
  }catch(e){ showToast('❌ '+e.message); }
  finally{ saveBtn.disabled=false; saveBtn.innerHTML='<i class="ti ti-device-floppy"></i> حفظ الأهداف'; }
}

function sgExportPDF(){
