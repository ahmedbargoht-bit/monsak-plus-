function repDynGrpChange(grpsList){
  const wrap   = document.getElementById('red-routes-wrap');
  const checks = document.getElementById('red-routes-checks');
  if(!wrap || !checks) return;
  if(!grpsList) grpsList = [...document.querySelectorAll('.red-grp-cb:checked')].map(c=>c.value);
  if(!grpsList.length){ wrap.style.display='none'; return; }
  checks.innerHTML = '<div style="color:#999;font-size:12px;padding:8px">جاري التحميل...</div>';
  wrap.style.display = '';

  const currentRoutes  = window._repEditCurrentRoutes  || [];
  const currentBranches = window._repEditCurrentBranches || [];

  const buildChecks = (routesData, branchesMap) => {
    const routes = routesData.filter(r=>grpsList.includes(r.grp)).map(r=>r.name).sort();
    if(!routes.length){
      checks.innerHTML='<div style="color:#999;font-size:12px">لا توجد خطوط لهذه المجموعات</div>';
      return;
    }

    let html = '';
    routes.forEach(route => {
      const isThabet = route.startsWith('ثابت');
      const branchesInRoute = (branchesMap && branchesMap[route]) || [];

      if(isThabet && branchesInRoute.length){
        // ثابت → show individual branches as checkboxes under route header
        html += `<div style="margin-bottom:10px">
          <div style="font-size:11px;font-weight:800;color:#731E2E;background:rgba(115,30,46,.08);border-right:3px solid #731E2E;padding:5px 10px;border-radius:0 8px 8px 0;margin-bottom:6px">${route}</div>
          <div style="display:flex;flex-direction:column;gap:5px;padding-right:10px">
            ${branchesInRoute.map(b=>`
              <label style="display:flex;align-items:center;gap:8px;padding:5px 10px;background:#fff;border:1px solid #e5e7eb;border-radius:8px;cursor:pointer;font-size:12px">
                <input type="checkbox" class="red-branch-cb" value="${b}" data-route="${route}"
                  ${currentBranches.includes(b)?'checked':''}
                  style="width:14px;height:14px;accent-color:#731E2E"/>
                🏪 ${b}
              </label>`).join('')}
          </div>
        </div>`;
      } else {
        // خط عادي → single checkbox for whole route
        html += `<label style="display:flex;align-items:center;gap:8px;padding:7px 10px;background:#fff;border:1px solid #e5e7eb;border-radius:10px;cursor:pointer;font-size:12px;font-weight:600;margin-bottom:5px">
          <input type="checkbox" class="red-route-cb" value="${route}"
            ${currentRoutes.includes(route)?'checked':''}
            style="width:15px;height:15px;accent-color:#731E2E"/>
          ${route}
        </label>`;
      }
    });
    checks.innerHTML = html;
  };

  const doLoad = async () => {
    if(!_repRoutesData || !_repRoutesData.length) await repInitModal();
    // Load branches_map if not loaded
    let branchesMap = window._adminBranchesMap || null;
    if(!branchesMap){
      try{
        const H = {'apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`};
        const r = await fetch(`${SUPABASE_URL}/rest/v1/products_db?key=eq.branches_map&select=value&limit=1`,{headers:H});
        const d = r.ok ? await r.json() : [];
        let raw = d[0]?.value || {};
        branchesMap = typeof raw === 'string' ? JSON.parse(raw) : raw;
        window._adminBranchesMap = branchesMap;
      }catch(e){ branchesMap = {}; }
    }
    buildChecks(_repRoutesData, branchesMap);
  };

  doLoad();
}

async function saveRepUserDynamic(){
  const id     = window._repEditId;
  const name   = document.getElementById('red-name')?.value.trim();
  const pass   = document.getElementById('red-pass')?.value.trim();
  const selectedGrps = [...document.querySelectorAll('.red-grp-cb:checked')].map(c=>c.value);
  const grp    = selectedGrps[0] || '';
  const dayOff = document.getElementById('red-dayoff')?.value||'none';
  const msgEl  = document.getElementById('red-msg');

  const checkedRoutes   = [...document.querySelectorAll('.red-route-cb:checked')].map(c=>c.value);
  const checkedBranches = [...document.querySelectorAll('.red-branch-cb:checked')].map(c=>({branch:c.value, route:c.dataset.route}));

  // For ثابت routes — collect unique route names from selected branches
  const thabetRoutes = [...new Set(checkedBranches.map(b=>b.route))];
  const allRoutes = [...checkedRoutes, ...thabetRoutes];

  if(!name||!selectedGrps.length||!allRoutes.length){
