  container.innerHTML=`
    <label style="display:flex;align-items:center;gap:7px;padding:5px 4px;border-bottom:1px solid var(--border);font-weight:700;font-size:12px;cursor:pointer">
      <input type="checkbox" id="spl-cpl-all-cb" onchange="splCPLToggleAll(this)" style="width:14px;height:14px;accent-color:#4B3C1A;cursor:pointer"/>
      تحديد الكل (${clients.length})
    </label>
