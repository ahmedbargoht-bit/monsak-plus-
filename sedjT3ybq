// نفس تعيين عمود التاريخ المستخدم فعلياً في reset_tables_by_date على السيرفر —
// لازم يفضلوا متطابقين، وإلا العداد اللي شايفه المستخدم هنا هيبقى مختلف عن اللي هيتحذف فعلاً
const RESET_DATE_COL = { location:'updated_at', supervisor_execution:'updated_at' };

async function loadResetStats(){
  const wrap = document.getElementById('reset-stats');
  if(!wrap) return;

  const fromDate = document.getElementById('reset-from')?.value||'';
  const toDate   = document.getElementById('reset-to')?.value||'';
  const hasRange = !!(fromDate && toDate);
  const label = document.getElementById('reset-stats-label');
  if(label) label.textContent = hasRange
    ? `أعداد السجلات اللي هتتحذف فعلياً من ${fromDate} إلى ${toDate}`
    : `الإجمالي الكلي للجدول (حدد "من/إلى" فوق عشان تشوف عدد الفترة اللي هتتحذف)`;

  wrap.innerHTML = RESET_TABLES.map(t=>`
    <div style="text-align:center;padding:8px;background:#f5f6fa;border-radius:8px">
      <div class="stat-n" id="cnt-stat-${t}" style="font-size:16px">...</div>
      <div class="stat-l" style="font-size:10px">${t}</div>
    </div>`).join('');

  // ✅ نفس منطق reset_tables_by_date: from_date >= ... AND < to_date + يوم (يشمل يوم "إلى" كامل)
  // بنحسبها بحساب UTC صريح (Date.UTC) مش new Date(str) العادي، عشان توقيت المتصفح المحلي
  // (مثلاً +02:00 مصر) كان بيسبب خطأ يوم كامل في الطرح/الجمع (toISOString بيحول للـ UTC
  // فبيرجّع نفس تاريخ "إلى" بدل اليوم اللي بعده، فكان بيستبعد يوم "إلى" بالكامل من العداد
  // المعروض هنا رغم إن الحذف الفعلي على السيرفر كان هيشمله — تعارض بين المعروض والمنفذ فعلاً)
  let toNextStr = '';
  if(hasRange){
    const [ty,tm,td] = toDate.split('-').map(Number);
    const toNext = new Date(Date.UTC(ty, tm-1, td+1));
    toNextStr = toNext.toISOString().slice(0,10);
  }

  await Promise.all(RESET_TABLES.map(async t=>{
    try{
      let url = `${SUPABASE_URL}/rest/v1/${t}?select=*`;
      if(hasRange){
        const col = RESET_DATE_COL[t] || 'created_at';
        url += `&${col}=gte.${fromDate}&${col}=lt.${toNextStr}`;
      }
      // نستخدم HEAD مع Prefer: count=exact — الأصح لـ Supabase
      const r = await fetch(url,
        {method:'HEAD', headers:{
          'apikey':SUPABASE_KEY,
          'Authorization':`Bearer ${SUPABASE_KEY}`,
          'Prefer':'count=exact'
        }}
      );
      // content-range: 0-X/TOTAL أو */TOTAL
      const cr = r.headers.get('content-range')||'';
      const count = cr.includes('/') ? cr.split('/')[1] : '?';
      const el = document.getElementById(`cnt-stat-${t}`);
      if(el) el.textContent = (+count||0).toLocaleString('en-US');
      const badge = document.getElementById(`cnt-${t}`);
      if(badge){
        badge.textContent = count==='0'||+count===0 ? '' : (+count).toLocaleString('en-US');
        badge.style.cssText = 'background:#2C3E50 !important;color:#fff !important;font-weight:700;font-size:10px;border-radius:999px;padding:2px 8px;display:inline-block;min-width:28px;text-align:center;margin-right:auto';
      }
    }catch(e){
      const el = document.getElementById(`cnt-stat-${t}`);
      if(el) el.textContent = '—';
    }
  }));
}

function resetSelectAll(){
