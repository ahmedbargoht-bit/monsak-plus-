async function sppDeletePlan(id, name){
  confirmDelete('الخطة', name, async()=>{
    const H = {'apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`,'Prefer':'return=minimal'};
    // امسح الـ items المرتبطة أولاً (foreign key)
    const r1 = await fetch(`${SUPABASE_URL}/rest/v1/sales_plan_items?plan_id=eq.${id}`,{method:'DELETE',headers:H});
    if(!r1.ok){ const e=await r1.text().catch(()=>''); showToast('❌ فشل مسح items: '+r1.status+' '+e.slice(0,80)); loadSppPlans(); return; }
    // ثم امسح الخطة نفسها
    const res = await fetch(`${SUPABASE_URL}/rest/v1/sales_plans_plus?id=eq.${id}`,{method:'DELETE',headers:H});
    if(res.ok){
      showToast('🗑️ تم حذف الخطة');
    } else {
      const err = await res.text().catch(()=>'');
      showToast('❌ فشل الحذف: '+res.status+' — '+err.slice(0,80));
    }
    loadSppPlans();
  });
}

