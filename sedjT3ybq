    });
    const gsw=XLSX.utils.aoa_to_sheet(grpAoa,{cellStyles:true});
    const genc=(r,c)=>XLSX.utils.encode_cell({r,c});
    const gsty=(r,c,s)=>{if(!gsw[genc(r,c)])gsw[genc(r,c)]={t:'z',v:''};gsw[genc(r,c)].s=s;};
    gsw['!merges']=[{s:{r:0,c:0},e:{r:0,c:9}},{s:{r:1,c:0},e:{r:1,c:9}},{s:{r:2,c:0},e:{r:2,c:9}}];
