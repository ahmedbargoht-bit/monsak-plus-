async function loadGroupsFilter(){
  const container = document.getElementById('br-grp-filter');
  if(!container) return;

  // المجموعات الثابتة
  const staticGroups = Object.entries(GROUPS).map(([key,v])=>({key_name:key, name:v.label, color:v.color}));

  // المجموعات من Supabase
  let dbGroups=[];
  try{
    const res=await fetch(`${SUPABASE_URL}/rest/v1/groups?select=*&order=name.asc&limit=200`,
      {headers:{'apikey':SUPABASE_KEY,'Authorization':`Bearer ${SUPABASE_KEY}`}});
    if(res.ok) dbGroups=await res.json();
  }catch(e){}

  // دمج بدون تكرار
  const allGroups=[...staticGroups];
  dbGroups.forEach(g=>{
    if(!allGroups.find(s=>s.key_name===g.key_name)){
      allGroups.push({key_name:g.key_name, name:(g.emoji||'')+(g.name||g.key_name), color:g.color||'#888'});
    }
  });

  // احتفظ بالقيم المختارة حالياً
  const checked=[...container.querySelectorAll('.br-grp-cb:checked')].map(c=>c.value);

  container.innerHTML=`<label class="br-cb-lbl ${checked.includes('all')||checked.length===0?'active':''}">
    <input type="checkbox" class="br-grp-cb" value="all" ${checked.includes('all')||checked.length===0?'checked':''} onchange="brGrpChange(this)"/> كل المجموعات
  </label>`;

  allGroups.forEach(g=>{
    const isChecked=checked.includes(g.key_name);
    const lbl=document.createElement('label');
    lbl.className='br-cb-lbl'+(isChecked?' active':'');
    lbl.innerHTML=`<input type="checkbox" class="br-grp-cb" value="${g.key_name}" ${isChecked?'checked':''} onchange="brGrpChange(this)"/> ${g.name}`;
    container.appendChild(lbl);
  });
}


