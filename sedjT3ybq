function splCPLToggleAll(cb){ document.querySelectorAll('.spl-cpl-client-cb').forEach(c=>c.checked=cb.checked); splCPLUpdateClientCount(); }
function splCPLUpdateClientCount(){ const n=document.querySelectorAll('.spl-cpl-client-cb:checked').length; const el=document.getElementById('spl-sp-client-count'); if(el) el.textContent=n?`(${n} عميل)`:'';}
