function loadMissing(){
  const fromVal  = document.getElementById('mi-from')?.value||'';
  const toVal    = document.getElementById('mi-to')?.value||'';
  const grp      = document.getElementById('mi-group').value;
  const branch   = document.getElementById('mi-branch')?.value||'all';
  const search   = document.getElementById('mi-search').value.toLowerCase();
  let data = cachedData.missing.filter(m=>CU.groups.includes(m.grp||''));
  if(fromVal) data = data.filter(m=>m.created_at >= fromVal);
  if(toVal)   data = data.filter(m=>m.created_at <= toVal+'T23:59:59');
  if(grp!=='all') data = data.filter(m=>m.grp===grp);
  if(branch!=='all') data = data.filter(m=>m.branch===branch);
  if(search)      data = data.filter(m=>(m.snf||'').toLowerCase().includes(search)||(m.name||'').toLowerCase().includes(search));

  // تحديث قائمة الفروع
  const branchSel = document.getElementById('mi-branch');
  if(branchSel){
    const allBranches=[...new Set(cachedData.missing.filter(m=>CU.groups.includes(m.grp||'')).map(m=>m.branch).filter(Boolean))].sort();
    const cur=branchSel.value;
    branchSel.innerHTML='<option value="all">كل الفروع</option>'+allBranches.map(b=>`<option value="${b}" ${b===cur?'selected':''}>${b}</option>`).join('');
  }

  // Top missing items
  const counts={};data.forEach(m=>{counts[m.snf]=(counts[m.snf]||0)+1;});
  const topItems=Object.entries(counts).sort((a,b)=>b[1]-a[1]).slice(0,8);
  const maxC=topItems[0]?.[1]||1;
  document.getElementById('top-missing').innerHTML=topItems.map(([name,c])=>`
    <div style="margin-bottom:8px">
      <div style="display:flex;justify-content:space-between;margin-bottom:3px;font-size:11px"><span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:200px">${name}</span><b>${c}</b></div>
      <div style="background:#f0f0f0;border-radius:999px;height:6px;overflow:hidden"><div style="height:100%;border-radius:999px;background:var(--red);width:${Math.round(c/maxC*100)}%"></div></div>
    </div>`).join('')||'<div style="color:var(--text2);font-size:12px;text-align:center;padding:1rem">لا توجد نواقص</div>';

  const reasons={};data.forEach(m=>{if(m.reason)reasons[m.reason]=(reasons[m.reason]||0)+1;});
  const topR=Object.entries(reasons).sort((a,b)=>b[1]-a[1]).slice(0,5);
  document.getElementById('top-reasons').innerHTML=topR.map(([r,c])=>`
    <div style="display:flex;justify-content:space-between;align-items:center;padding:7px 0;border-bottom:1px solid #f5f5f5">
      <span style="font-size:11px">${r}</span><span class="badge b-orange">${c}</span>
    </div>`).join('')||'<div style="color:var(--text2);font-size:12px;text-align:center;padding:1rem">—</div>';

  document.getElementById('missing-table').innerHTML=data.map((m,i)=>`<tr>
    <td style="text-align:center"><input type="checkbox" class="miss-row-cb" data-idx="${i}" onchange="missUpdateCount()" style="width:14px;height:14px;accent-color:#731E2E;cursor:pointer"></td>
    <td><b>${m.name}</b></td>
    <td>${m.branch||'—'}</td>
    <td style="font-weight:600">${m.snf||''}</td>
    <td><span class="badge b-blue">${m.fea||''}</span></td>
    <td><span class="badge b-orange">${m.reason||''}</span></td>
    <td style="font-size:11px;color:var(--text2)">${m.note||'—'}</td>
    <td style="font-size:11px">${m.created_at?new Date(m.created_at).toLocaleDateString('en-US'):'—'}</td>
    <td><button onclick="deleteRecord('missing',${m.id},'missing')" style="background:#FFEBEE;color:#B71C1C;border:none;border-radius:6px;padding:3px 8px;cursor:pointer;font-size:12px">🗑</button></td>
  </tr>`).join('')||'<tr><td colspan="9" style="text-align:center;padding:1rem;color:var(--text2)">لا توجد نواقص</td></tr>';

  // شريط التحديد
  const bar=document.getElementById('miss-select-bar');
  if(bar) bar.style.display=data.length?'flex':'none';
  missUpdateCount();
  window._missData=data;
}

function missToggleAll(cb){
  document.querySelectorAll('.miss-row-cb').forEach(c=>c.checked=cb.checked);
  const h=document.getElementById('miss-hdr-cb'),a=document.getElementById('miss-select-all');
  if(h) h.checked=cb.checked; if(a) a.checked=cb.checked;
  missUpdateCount();
}
function missUpdateCount(){
  const all=document.querySelectorAll('.miss-row-cb'),sel=document.querySelectorAll('.miss-row-cb:checked');
  const el=document.getElementById('miss-sel-count');
  if(el) el.textContent=sel.length+' محدد من '+all.length;
  const allChk=sel.length===all.length&&all.length>0;
  const h=document.getElementById('miss-hdr-cb'),a=document.getElementById('miss-select-all');
  if(h) h.checked=allChk; if(a) a.checked=allChk;
}
function missGetData(onlySelected){
  const all=window._missData||[];
  if(!onlySelected) return all;
  const idxs=new Set([...document.querySelectorAll('.miss-row-cb:checked')].map(c=>+c.dataset.idx));
  return idxs.size?all.filter((_,i)=>idxs.has(i)):all;
}

function missingExportExcel(onlySelected){
  if(typeof XLSX==='undefined'){showToast('جاري تحميل مكتبة Excel...');return;}
  const data=missGetData(onlySelected);
  if(!data.length){showToast('لا توجد بيانات للتصدير','err');return;}

  const C={dark:'2C1F0A',caramel:'4B3C1A',gold:'C8A96E',cream:'EDE5D8',light:'F5F0E8',red:'731E2E',orange:'E65100',white:'FFFFFF',line:'E0D8CC'};
  const fill=c=>({patternType:'solid',fgColor:{rgb:c}});
  const font=(bold,sz,color,italic)=>({bold:!!bold,sz:sz||11,color:{rgb:color||C.dark},italic:!!italic,name:'Arial'});
  const aln=(h,v,wrap)=>({horizontal:h||'right',vertical:v||'center',wrapText:!!wrap,readingOrder:2});
  const brd=(s,c)=>{const b={style:s||'thin',color:{rgb:c||C.line}};return{left:b,right:b,top:b,bottom:b};};

  const grpSel=document.getElementById('mi-group')?.value||'all';
  const branchSel=document.getElementById('mi-branch')?.value||'all';
  const now=new Date().toLocaleDateString('en-US');

  // تجميع حسب المجموعة → خط السير → الفرع
  const groups={};
  data.forEach(m=>{
    const g=m.grp||'other';
    const route=m.route||'—';
    const branch=m.branch||'—';
    if(!groups[g]) groups[g]={};
    if(!groups[g][route]) groups[g][route]={};
    if(!groups[g][route][branch]) groups[g][route][branch]=[];
    groups[g][route][branch].push(m);
  });

  const COLS=['#','المنسق','الفرع','المجموعة','الصنف','الفئة','السبب','ملاحظة','التاريخ'];
  const wb=XLSX.utils.book_new();

  // Sheet رئيسي مرتب
  const aoa=[
    ['الطحان جولدن دايتس — Al Tahhan Golden Dates',...Array(8).fill('')],
    ['النواقص — تقرير تفصيلي مجمع',...Array(8).fill('')],
    [`تاريخ التصدير: ${now}  |  المجموعة: ${grpSel==='all'?'كل المجموعات':grpSel}  |  الفرع: ${branchSel==='all'?'كل الفروع':branchSel}  |  إجمالي: ${data.length}`,...Array(8).fill('')],
    Array(9).fill(''),
    COLS
  ];

  const dataStart=aoa.length;
  let idx=1;
  Object.entries(groups).forEach(([grpKey,routes])=>{
    aoa.push([`🔷 ${GROUPS[grpKey]?.label||grpKey}`,...Array(8).fill('')]);
    Object.entries(routes).forEach(([route,branches])=>{
      aoa.push([`  🛣️ ${route}`,...Array(8).fill('')]);
      Object.entries(branches).forEach(([branch,records])=>{
        records.forEach(m=>{
          const dt=m.created_at?new Date(m.created_at).toLocaleDateString('en-US'):'';
          aoa.push([idx++,m.name||'—',m.branch||'—',GROUPS[m.grp]?.label||m.grp||'—',m.snf||'—',m.fea||'—',m.reason||'—',m.note||'',dt]);
        });
      });
    });
  });

  const ws=XLSX.utils.aoa_to_sheet(aoa,{cellStyles:true});
  const enc=(r,c)=>XLSX.utils.encode_cell({r,c});
  const sty=(r,c,s)=>{if(!ws[enc(r,c)])ws[enc(r,c)]={t:'z',v:''};ws[enc(r,c)].s=s;};

  ws['!merges']=[{s:{r:0,c:0},e:{r:0,c:8}},{s:{r:1,c:0},e:{r:1,c:8}},{s:{r:2,c:0},e:{r:2,c:8}},{s:{r:3,c:0},e:{r:3,c:8}}];
  sty(0,0,{font:font(1,15,C.cream),fill:fill(C.dark),alignment:aln('center'),border:brd('medium',C.dark)});
  sty(1,0,{font:font(1,13,C.dark),fill:fill(C.gold),alignment:aln('center'),border:brd('medium',C.caramel)});
  sty(2,0,{font:font(0,10,C.caramel,true),fill:fill(C.light),alignment:aln('center'),border:brd('thin',C.line)});
  for(let c=0;c<9;c++) sty(3,c,{fill:fill(C.dark)});
  for(let c=0;c<9;c++) sty(4,c,{font:font(1,10,C.cream),fill:fill(C.caramel),alignment:aln('center'),border:brd('medium',C.dark)});

  for(let ri=dataStart;ri<aoa.length;ri++){
    const row=aoa[ri];
    const isGrp=typeof row[0]==='string'&&row[0].includes('🔷');
    const isRoute=typeof row[0]==='string'&&row[0].includes('🛣️');
    if(isGrp){
      ws['!merges'].push({s:{r:ri,c:0},e:{r:ri,c:8}});
      sty(ri,0,{font:font(1,11,C.cream),fill:fill(C.caramel),alignment:aln('right'),border:brd('thin',C.dark)});
    } else if(isRoute){
      ws['!merges'].push({s:{r:ri,c:0},e:{r:ri,c:8}});
      sty(ri,0,{font:font(1,10,'4B3C1A'),fill:fill('EDE5D8'),alignment:aln('right'),border:brd('thin',C.line)});
    } else {
      for(let c=0;c<9;c++){
        let s={font:font(0,9,C.dark),fill:fill(C.white),alignment:aln(c===0?'center':'right',undefined,true),border:brd('thin',C.line)};
        if(c===6) s={...s,font:font(1,9,C.orange)};
        sty(ri,c,s);
      }
    }
  }
  ws['!cols']=[{wch:5},{wch:16},{wch:22},{wch:14},{wch:32},{wch:12},{wch:18},{wch:18},{wch:12}];
  ws['!rows']=[{hpt:36},{hpt:28},{hpt:20},{hpt:8},{hpt:26}];
  XLSX.utils.book_append_sheet(wb,ws,'النواقص الكاملة');

  // Sheet لكل مجموعة
  Object.entries(groups).forEach(([grpKey,routes])=>{
    const grpName=(GROUPS[grpKey]?.label||grpKey).replace(/[^a-zA-Z؀-ۿ0-9 ]/g,'').trim().slice(0,28);
    const grpColor=(GROUPS[grpKey]?.color||'#888888').replace('#','');
    const grpAoa=[
      ['الطحان جولدن دايتس',...Array(8).fill('')],
      [grpName,...Array(8).fill('')],
      Array(9).fill(''),
      COLS
    ];
    let gi=1;
    Object.entries(routes).forEach(([route,branches])=>{
      grpAoa.push([`🛣️ ${route}`,...Array(8).fill('')]);
      Object.entries(branches).forEach(([branch,records])=>{
        records.forEach(m=>{
          const dt=m.created_at?new Date(m.created_at).toLocaleDateString('en-US'):'';
          grpAoa.push([gi++,m.name||'—',m.branch||'—',GROUPS[m.grp]?.label||grpKey,m.snf||'—',m.fea||'—',m.reason||'—',m.note||'',dt]);
        });
      });
    });
    const gsw=XLSX.utils.aoa_to_sheet(grpAoa,{cellStyles:true});
    const ge=(r,c)=>XLSX.utils.encode_cell({r,c});
    const gs=(r,c,s)=>{if(!gsw[ge(r,c)])gsw[ge(r,c)]={t:'z',v:''};gsw[ge(r,c)].s=s;};
    gsw['!merges']=[{s:{r:0,c:0},e:{r:0,c:8}},{s:{r:1,c:0},e:{r:1,c:8}},{s:{r:2,c:0},e:{r:2,c:8}}];
    gs(0,0,{font:font(1,13,C.cream),fill:fill(C.dark),alignment:aln('center'),border:brd('medium',C.dark)});
    gs(1,0,{font:font(1,12,C.cream),fill:fill(grpColor),alignment:aln('center'),border:brd('medium',grpColor)});
    for(let c=0;c<9;c++) gs(2,c,{fill:fill(C.dark)});
    for(let c=0;c<9;c++) gs(3,c,{font:font(1,10,C.cream),fill:fill(C.caramel),alignment:aln('center'),border:brd('medium',C.dark)});
    for(let ri=4;ri<grpAoa.length;ri++){
      const row=grpAoa[ri];
      const isRH=typeof row[0]==='string'&&row[0].includes('🛣️');
      if(isRH){gsw['!merges'].push({s:{r:ri,c:0},e:{r:ri,c:8}});gs(ri,0,{font:font(1,10,'4B3C1A'),fill:fill('EDE5D8'),alignment:aln('right'),border:brd('thin',C.line)});}
      else{for(let c=0;c<9;c++){let s={font:font(0,9,C.dark),fill:fill(C.white),alignment:aln(c===0?'center':'right',undefined,true),border:brd('thin',C.line)};if(c===6)s={...s,font:font(1,9,C.orange)};gs(ri,c,s);}}
    }
    gsw['!cols']=[{wch:5},{wch:16},{wch:22},{wch:14},{wch:32},{wch:12},{wch:18},{wch:18},{wch:12}];
    XLSX.utils.book_append_sheet(wb,gsw,grpName);
  });

  XLSX.writeFile(wb,`نواقص_${localISO()}.xlsx`);
  showToast('✅ تم تصدير النواقص بتصميم احترافي');
}

