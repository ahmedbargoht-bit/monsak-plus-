function saveEditProd(itemKeyStr){
  const k=JSON.parse(itemKeyStr);
  const newSnf=(document.getElementById('edit-snf-input')?.value||'').trim();
  const msg=document.getElementById('edit-snf-msg');
  if(!newSnf){ msg.style.display='block';msg.style.background='#FFEBEE';msg.style.color='#B71C1C';msg.textContent='❌ اسم الصنف مطلوب'; return; }

  if(!PDB[k.fea]?.[k.cat]?.[k.grp]) return;
  const arr=PDB[k.fea][k.cat][k.grp];
  const item=arr[k.idx];
  const isObj=typeof item==='object'&&item!==null;

  const newShelf=document.getElementById('edit-shelf-input')?.value.trim();
  const newStock=document.getElementById('edit-stock-input')?.value.trim();
  const hasShelf=newShelf!==''&&newShelf!==null&&newShelf!==undefined;
  const hasStock=newStock!==''&&newStock!==null&&newStock!==undefined;

  if(isObj||hasShelf||hasStock){
    // نحفظ كـ object
    const updated=isObj?{...item}:{};
    updated.name=newSnf;
    if(hasShelf) updated.monthsShelf=Number(newShelf);
    else if(isObj&&item.monthsShelf!==undefined) updated.monthsShelf=item.monthsShelf;
    if(hasStock) updated.monthsStock=Number(newStock);
    else if(isObj&&item.monthsStock!==undefined) updated.monthsStock=item.monthsStock;
    arr[k.idx]=updated;
  } else {
    // لا صلاحية — نحفظ كـ string عادي
    arr[k.idx]=newSnf;
  }

  try{ localStorage.setItem('pdb_cache',JSON.stringify(PDB)); }catch(e){}
  saveProductsToSupabase(PDB);
  document.getElementById('pdb-edit-overlay')?.remove();
  renderProdDB();
  splSyncProductsFromPDB();
  showToast('✅ تم تعديل الصنف بنجاح');
}

function deleteProdFromPDB(itemKeyStr){
