    rows += `<tr style="border-bottom:0.5px solid var(--border)" id="sg-row-${r.id}">
      <td style="padding:9px 12px;color:var(--text-secondary);font-size:11px">${i+1}</td>
      <td style="padding:9px 12px;font-weight:600;font-size:12px">${r.name}</td>
      <td style="padding:9px 12px;font-size:10px;color:var(--text-secondary)">${routeLabel}</td>
      <td style="padding:9px 8px"><input type="number" class="sg-goal-inp" data-name="${r.name}" data-id="${r.id}" data-tgt-id="${tgtId||''}" value="${goal}" min="0" step="1000" onchange="sgUpdateDaily(this,${workDays})" style="width:90px;padding:4px 7px;border:0.5px solid var(--border-strong);border-radius:6px;font-size:12px;font-family:Cairo,sans-serif;text-align:center;background:var(--surface-1);color:var(--text-primary)"/></td>
      <td style="padding:9px 8px;font-size:11px;font-weight:700;color:#185FA5" id="sg-daily-${r.id}">${daily>0?daily.toLocaleString('en-US')+' ج':'—'}</td>
      <td style="padding:9px 8px;min-width:110px">
        <div style="font-size:11px;font-weight:700;color:${clr};margin-bottom:3px">${actual>0?actual.toLocaleString('en-US')+' ج':'—'}</div>
        <div style="display:flex;align-items:center;gap:5px">
          <div style="flex:1;height:5px;background:var(--border);border-radius:3px;overflow:hidden;min-width:35px"><div style="height:100%;width:${Math.min(pct,100)}%;background:${clr};border-radius:3px"></div></div>
          <span style="font-size:11px;font-weight:700;color:${clr};min-width:28px">${pct}%</span>
        </div>
      </td>
      <td style="padding:9px 8px">${goal>0?sts:'<span style="color:#aaa;font-size:11px">لم يُحدد</span>'}</td>
      <td style="padding:9px 8px;white-space:nowrap">
        <button title="تعديل الهدف" onclick="sgEditGoalRow('${r.id}')" style="background:#EAF0FB;color:#185FA5;border:none;border-radius:5px;padding:4px 8px;font-size:11px;cursor:pointer;margin-left:4px"><i class="ti ti-edit"></i></button>
        <button title="مسح الهدف" onclick="sgDeleteGoal('${encodeURIComponent(r.name)}','${tgtId||''}','${r.id}')" style="background:#FCEBEB;color:#A32D2D;border:none;border-radius:5px;padding:4px 8px;font-size:11px;cursor:pointer"><i class="ti ti-trash"></i></button>
        <button title="حذف المندوب نهائياً" onclick="sgDeleteUser('${r.id}','${encodeURIComponent(r.name)}')" style="background:#F3E5F5;color:#6A1B9A;border:none;border-radius:5px;padding:4px 8px;font-size:11px;cursor:pointer;margin-right:4px"><i class="ti ti-user-x"></i></button>
      </td>
    </tr>`;
  });
  return `<div style="background:var(--surface-2);border:0.5px solid var(--border);border-radius:8px;overflow:hidden;margin-bottom:4px">
    <table style="width:100%;border-collapse:collapse;font-size:12px">
      <thead><tr style="background:#3B1F12">
        <th style="padding:8px 12px;text-align:right;font-size:11px;font-weight:700;color:#F2E4DC">#</th>
        <th style="padding:8px 12px;text-align:right;font-size:11px;font-weight:700;color:#F2E4DC">المندوب</th>
        <th style="padding:8px 12px;text-align:right;font-size:11px;font-weight:700;color:#F2E4DC">الخط</th>
        <th style="padding:8px 12px;text-align:right;font-size:11px;font-weight:700;color:#F2E4DC">الهدف الشهري (ج)</th>
        <th style="padding:8px 12px;text-align:right;font-size:11px;font-weight:700;color:#F2E4DC">الهدف اليومي</th>
        <th style="padding:8px 12px;text-align:right;font-size:11px;font-weight:700;color:#F2E4DC">التحقيق</th>
        <th style="padding:8px 12px;text-align:right;font-size:11px;font-weight:700;color:#F2E4DC">الحالة</th>
        <th style="padding:8px 12px;text-align:right;font-size:11px;font-weight:700;color:#F2E4DC">إجراءات</th>
