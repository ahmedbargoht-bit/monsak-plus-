        <thead><tr style="background:var(--surface-2)">
          <th style="padding:6px 10px;text-align:right">التاريخ</th>
          <th style="padding:6px 10px;text-align:right">الحالة</th>
          <th style="padding:6px 10px;text-align:right">أول حضور</th>
          <th style="padding:6px 10px;text-align:right">آخر انصراف</th>
          <th style="padding:6px 10px;text-align:right">جلسات دعم / مأموريات</th>
          <th style="padding:6px 10px;text-align:center">إجراء</th>
        </tr></thead>
        <tbody>${lines}</tbody>
      </table>
    </div>`;
  modal.onclick=e=>{ if(e.target===modal) modal.remove(); };
  document.body.appendChild(modal);
}

